        "b": 534.9950866699219
      },
      "image_path": "figures/figure_0112.png",
      "next_block_id": "txt_1132",
      "image_hash": "7d3f5fea752bed9aaacd67bd53ab0f509b4ec5cbe7f2a923f740a17144b52bfc",
      "width": 112,
      "height": 203
    },
    {
      "type": "list_item",
      "id": "txt_1132",
      "reading_order": 1298,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.0,
        "t": 529.5986499999999,
        "r": 549.3700000000006,
        "b": 506.35865
      },
      "content": "Spray penetrating oil through the plug hole into the cavity at the end of  the shaft and let it penetrate for 15 minutes."
    },
    {
      "type": "list_item",
      "id": "txt_1133",
      "reading_order": 1299,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99994,
        "t": 503.79864999999995,
        "r": 408.87994000000003,
        "b": 492.55864999999994
      },
      "content": "While waiting, rotate the shaft several times to distribute the oil."
    },
    {
      "type": "list_item",
      "id": "txt_1134",
      "reading_order": 1300,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99992,
        "t": 489.99865,
        "r": 404.3799200000001,
        "b": 478.75865
      },
      "content": "Slide the shaft wrench (A05107A) over the shaft (122) and key."
    },
    {
      "type": "list_item",
      "id": "txt_1135",
      "reading_order": 1301,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99992,
        "t": 476.19866,
        "r": 554.3999200000004,
        "b": 452.95866
      },
      "content": "Rotate the impeller clockwise (viewed from the impeller end of  the shaft) and raise the wrench off  of the work surface."
    },
    {
      "type": "list_item",
      "id": "txt_1136",
      "reading_order": 1302,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99993,
        "t": 450.39867000000004,
        "r": 550.6399300000005,
        "b": 427.15867000000003
      },
      "content": "To loosen the impeller, quickly turn the impeller counter-clockwise (viewed from the impeller end of the shaft) while impacting the wrench handle on the workbench or a solid block."
    },
    {
      "type": "list_item",
      "id": "txt_1137",
      "reading_order": 1303,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99996,
        "t": 424.59868000000006,
        "r": 344.1099599999999,
        "b": 413.35868000000005
      },
      "content": "Repeat step 6 until the impeller becomes loose."
    },
    {
      "type": "list_item",
      "id": "txt_1138",
      "reading_order": 1304,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99996,
        "t": 410.7986900000001,
        "r": 320.8799599999999,
        "b": 399.55869000000007
      },
      "content": "If  step 6 and 7 do not work then do this:"
    },
    {
      "type": "list_item",
      "id": "txt_1139",
      "reading_order": 1305,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99994,
        "t": 395.7986900000001,
        "r": 408.2299400000001,
        "b": 384.55869000000007
      },
      "content": "Place a socket wrench over the cast nut on the impeller hub."
    },
    {
      "type": "list_item",
      "id": "txt_1140",
      "reading_order": 1306,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99992,
        "t": 382.2986900000001,
        "r": 489.00992000000025,
        "b": 371.05869000000007
      },
      "content": "Turn the impeller counter-clockwise (viewed from the impeller end of the shaft)."
    },
    {
      "type": "paragraph",
      "id": "txt_1141",
      "reading_order": 1307,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99992,
        "t": 367.2986900000001,
        "r": 543.6799200000005,
        "b": 344.05869000000007
      },
      "content": "Be sure that the impeller wrench rests on the workbench or a solid block and that the power end is secure on the work surface."
    },
    {
      "type": "list_item",
      "id": "txt_1142",
      "reading_order": 1308,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99992,
        "t": 341.4987000000001,
        "r": 348.72991999999994,
        "b": 330.2587000000001
      },
      "content": "Remove and discard the impeller O-ring (412A)."
    },
    {
      "type": "paragraph",
      "id": "txt_1143",
      "reading_order": 1309,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99992,
        "t": 326.9787100000001,
        "r": 345.4799199999999,
        "b": 315.7387100000001
      },
      "content": "You will insert a new O-ring during reassembly."
    },
    {
      "type": "figure",
      "id": "fig_0113",
      "reading_order": 1310,
      "section": "CAUTION:",
      "bbox": {
        "l": 169.9232635498047,
        "t": 300.4226989746094,
        "r": 294.42608642578125,
        "b": 199.3031005859375
      },
