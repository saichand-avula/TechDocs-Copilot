    {
      "type": "paragraph",
      "id": "txt_1613",
      "reading_order": 1868,
      "section": "CAUTION:",
      "bbox": {
        "l": 176.16944,
        "t": 121.9322900000002,
        "r": 554.7794600000003,
        "b": 86.69229000000018
      },
      "content": "The locknut prevents the bearings from moving away from the shaft shoulder as they cool. Rotate the outer bearing rings relative to each other as they are placed on the shaft to assure good alignment.",
      "section_id": "sec_auto_1842",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1842",
          "title": "CAUTION:"
        }
      ],
      "page": 108,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
