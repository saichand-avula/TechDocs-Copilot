      "bbox": {
        "l": 161.99945,
        "t": 84.68827000000022,
        "r": 434.62945000000013,
        "b": 73.4482700000002
      },
      "content": "Remove the bearing locknut (136) after the bearings (112) are cool.",
      "section_id": "sec_auto_1842",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1842",
          "title": "CAUTION:"
        }
      ],
