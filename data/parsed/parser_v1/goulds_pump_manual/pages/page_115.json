        "l": 161.99991999999997,
        "t": 689.32184,
        "r": 541.9199400000002,
        "b": 666.0818399999999
      },
      "content": "Lubricant helps in the installation process. Be sure that the lubricant is compatible with the O-ring material and the pump-system standards.",
      "section_id": "sec_auto_1939",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1939",
