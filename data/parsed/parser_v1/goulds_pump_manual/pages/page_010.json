      },
      "content": "These are the personnel requirements for Ex-approved products in potentially explosive atmospheres:",
      "section_id": "sec_auto_127",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_127",
