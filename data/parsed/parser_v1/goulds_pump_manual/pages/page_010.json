    },
    {
      "type": "list_item",
      "id": "txt_0114",
      "reading_order": 129,
      "section": "Personnel requirements",
      "bbox": {
        "l": 153.0,
        "t": 715.95272,
        "r": 548.0300000000004,
        "b": 692.71272
      },
      "content": "All work on the product must be carried out by certified electricians and ITT-authorized mechanics. Special rules apply to installations in explosive atmospheres.",
      "section_id": "sec_auto_127",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_127",
          "title": "Personnel requirements"
        }
      ],
      "page": 10,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0115",
      "reading_order": 130,
      "section": "Personnel requirements",
      "bbox": {
        "l": 153.00002,
        "t": 691.25125,
        "r": 558.1800200000005,
        "b": 668.01125
      },
      "content": "All users must know about the risks of  electric current and the chemical and physical characteristics of the gas, the vapor, or both present in hazardous areas.",
      "section_id": "sec_auto_127",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_127",
          "title": "Personnel requirements"
        }
      ],
      "page": 10,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0116",
      "reading_order": 131,
      "section": "Personnel requirements",
      "bbox": {
        "l": 153.00002,
        "t": 666.5497799999999,
        "r": 542.6800200000002,
        "b": 643.30978
      },
      "content": "Any maintenance for Ex-approved products must conform to international and national standards (for example, IEC/EN 60079-17).",
      "section_id": "sec_auto_127",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_127",
          "title": "Personnel requirements"
        }
      ],
      "page": 10,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
