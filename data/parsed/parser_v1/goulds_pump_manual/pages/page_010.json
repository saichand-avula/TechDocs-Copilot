      "section": "Product and product handling requirements",
      "bbox": {
        "l": 152.99992,
        "t": 433.4303,
        "r": 501.0699200000001,
        "b": 422.1903
      },
      "content": "Do not modify the equipment without approval from an authorized ITT representative.",
      "section_id": "sec_auto_133",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_133",
          "title": "Product and product handling requirements"
        }
      ],
      "page": 10,
