    },
    {
      "type": "list_item",
      "id": "txt_0980",
      "reading_order": 1125,
      "section": "NOTICE:",
      "bbox": {
        "l": 143.99723,
        "t": 462.61126,
        "r": 420.3372300000001,
        "b": 451.37126
      },
      "content": "Remove the two grease-relief plugs from the bottom of the frame.",
      "section_id": "sec_auto_1120",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1120",
          "title": "Regrease the grease-lubricated bearings"
        }
      ],
      "page": 65,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0981",
      "reading_order": 1126,
      "section": "NOTICE:",
      "bbox": {
        "l": 143.99723,
        "t": 448.81127000000004,
        "r": 550.8272300000003,
        "b": 425.57127
      },
      "content": "Fill both of  the grease cavities through the fittings with a recommended grease until the fresh grease comes out of the relief  holes.",
      "section_id": "sec_auto_1120",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1120",
          "title": "Regrease the grease-lubricated bearings"
        }
      ],
      "page": 65,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0982",
      "reading_order": 1127,
      "section": "NOTICE:",
      "bbox": {
        "l": 143.9972,
        "t": 423.01128000000006,
        "r": 445.8072100000002,
        "b": 397.25129000000004
      },
      "content": "Make sure that the frame seals are seated in the bearing housing. If  they are not, press them in place with the drains located at the bottom.",
      "section_id": "sec_auto_1120",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1120",
          "title": "Regrease the grease-lubricated bearings"
        }
      ],
      "page": 65,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0983",
