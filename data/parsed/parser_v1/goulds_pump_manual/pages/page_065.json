        "r": 293.0072499999999,
        "b": 465.17125
      },
      "content": "Wipe dirt from the grease fittings.",
      "section_id": "sec_auto_1120",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1120",
