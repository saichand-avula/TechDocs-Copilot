      "section": "NOTICE:",
      "bbox": {
        "l": 143.99721,
        "t": 394.69130000000007,
        "r": 284.7172099999999,
        "b": 383.45130000000006
      },
      "content": "Reinstall the grease-relief  plugs.",
      "section_id": "sec_auto_1120",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1120",
          "title": "Regrease the grease-lubricated bearings"
        }
      ],
      "page": 65,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0984",
      "reading_order": 1129,
      "section": "NOTICE:",
      "bbox": {
        "l": 143.99721,
        "t": 380.8913100000001,
        "r": 268.8572099999999,
        "b": 369.6513100000001
      },
      "content": "Wipe off any excess grease.",
      "section_id": "sec_auto_1120",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1120",
