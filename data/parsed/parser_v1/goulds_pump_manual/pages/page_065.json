        }
      ],
      "page": 65,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0985",
      "reading_order": 1130,
      "section": "NOTICE:",
      "bbox": {
        "l": 143.99721,
        "t": 367.0913200000001,
        "r": 251.7072099999999,
        "b": 355.8513200000001
      },
      "content": "Recheck the alignment.",
      "section_id": "sec_auto_1120",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1120",
          "title": "Regrease the grease-lubricated bearings"
        }
      ],
      "page": 65,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "paragraph",
      "id": "txt_0986",
      "reading_order": 1131,
      "section": "NOTICE:",
      "bbox": {
        "l": 143.99721,
        "t": 349.0913200000001,
        "r": 548.5372100000001,
        "b": 313.8513200000001
      },
      "content": "The bearing temperature usually rises after you regrease due to an excess supply of  grease. Temperatures return to normal in about two to four operating hours as the pump runs and purges the excess grease from the bearings.",
      "section_id": "sec_auto_1120",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1120",
          "title": "Regrease the grease-lubricated bearings"
        }
      ],
      "page": 65,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
