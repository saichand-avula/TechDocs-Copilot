        "b": 96.41291999999999
      },
      "content": "Ex-approved products",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_0109",
      "reading_order": 124,
      "section": "Ex-approved products",
      "bbox": {
        "l": 54.002,
        "t": 93.12194,
        "r": 346.09200000000004,
        "b": 81.88193999999999
      },
      "content": "Follow these special handling instructions if  you have an Ex-approved unit."
    },
    {
      "type": "heading",
      "id": "txt_0110",
      "reading_order": 125,
      "section": "Hazardous liquids",
      "bbox": {
        "l": 54.00004000000001,
