  "blocks": [
    {
      "type": "heading",
      "id": "txt_0080",
      "reading_order": 94,
      "section": "Precautions before work",
      "bbox": {
        "l": 54.0,
        "t": 737.64184,
        "r": 156.91999999999996,
        "b": 726.40184
      },
      "content": "Precautions before work",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_0081",
      "reading_order": 95,
      "section": "Precautions before work",
      "bbox": {
        "l": 144.0,
        "t": 723.12184,
        "r": 554.9700000000005,
        "b": 711.88184
      },
      "content": "Observe these safety precautions before you work with the product or are in connection with the product:"
    },
    {
      "type": "list_item",
      "id": "txt_0082",
      "reading_order": 96,
      "section": "Precautions before work",
      "bbox": {
        "l": 153.00004,
        "t": 708.12184,
        "r": 444.20004000000006,
        "b": 696.88184
      },
      "content": "Provide a suitable barrier around the work area, for example, a guard rail."
    },
    {
      "type": "list_item",
      "id": "txt_0083",
      "reading_order": 97,
      "section": "Precautions before work",
      "bbox": {
        "l": 153.00002,
        "t": 694.32184,
        "r": 374.72002000000003,
        "b": 683.0818399999999
      },
      "content": "Make sure that all safety guards are in place and secure."
    },
    {
      "type": "list_item",
      "id": "txt_0084",
      "reading_order": 98,
      "section": "Precautions before work",
      "bbox": {
        "l": 153.00004,
        "t": 680.52184,
        "r": 344.39004,
        "b": 669.28184
      },
      "content": "Make sure that you have a clear path of  retreat."
    },
    {
      "type": "list_item",
      "id": "txt_0085",
      "reading_order": 99,
      "section": "Precautions before work",
      "bbox": {
        "l": 153.00004,
        "t": 666.7218399999999,
        "r": 506.1300400000003,
        "b": 655.48184
      },
      "content": "Make sure that the product cannot roll or fall over and injure people or damage property."
    },
    {
      "type": "list_item",
      "id": "txt_0086",
      "reading_order": 100,
      "section": "Precautions before work",
      "bbox": {
        "l": 153.0,
        "t": 652.92184,
        "r": 385.2400000000001,
        "b": 641.68184
      },
      "content": "Make sure that the lifting equipment is in good condition."
    },
    {
      "type": "list_item",
      "id": "txt_0087",
      "reading_order": 101,
      "section": "Precautions before work",
      "bbox": {
        "l": 153.0,
        "t": 639.12184,
        "r": 428.12,
        "b": 627.88184
      },
      "content": "Use a lifting harness, a safety line, and a breathing device as required."
    },
    {
      "type": "list_item",
      "id": "txt_0088",
      "reading_order": 102,
      "section": "Precautions before work",
      "bbox": {
        "l": 153.0,
        "t": 625.32184,
        "r": 444.1200000000003,
        "b": 614.08184
      },
      "content": "Allow all system and pump components to cool before you handle them."
    },
    {
      "type": "list_item",
      "id": "txt_0089",
      "reading_order": 103,
      "section": "Precautions before work",
      "bbox": {
        "l": 153.0,
        "t": 611.52184,
        "r": 381.87000000000006,
        "b": 600.28184
      },
      "content": "Make sure that the product has been thoroughly cleaned."
    },
    {
      "type": "list_item",
      "id": "txt_0090",
      "reading_order": 104,
      "section": "Precautions before work",
      "bbox": {
        "l": 153.0,
        "t": 597.7218399999999,
        "r": 398.94,
        "b": 586.4818399999999
      },
      "content": "Disconnect and lock out power before you service the pump."
    },
    {
      "type": "list_item",
      "id": "txt_0091",
      "reading_order": 105,
      "section": "Precautions before work",
      "bbox": {
        "l": 153.0,
        "t": 583.92184,
        "r": 423.3000000000001,
        "b": 572.68184
      },
      "content": "Check the explosion risk before you weld or use electric hand tools."
    },
    {
      "type": "heading",
      "id": "txt_0092",
      "reading_order": 106,
      "section": "Precautions during work",
      "bbox": {
        "l": 54.0,
        "t": 560.40184,
        "r": 158.39,
        "b": 549.16184
      },
      "content": "Precautions during work",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_0093",
      "reading_order": 107,
      "section": "Precautions during work",
      "bbox": {
        "l": 143.99999,
        "t": 542.40184,
        "r": 550.9099900000004,
        "b": 531.16184
      },
      "content": "Observe these safety precautions when you work with the product or are in connection with the product:"
    },
    {
      "type": "list_item",
      "id": "txt_0094",
      "reading_order": 108,
      "section": "Precautions during work",
      "bbox": {
        "l": 153.00004,
        "t": 527.40184,
        "r": 233.14003999999997,
        "b": 516.16184
      },
      "content": "Never work alone."
    },
    {
      "type": "list_item",
      "id": "txt_0095",
      "reading_order": 109,
      "section": "Precautions during work",
      "bbox": {
        "l": 153.00004,
        "t": 513.6018399999999,
        "r": 368.2400400000001,
        "b": 502.3618399999999
      },
      "content": "Always wear protective clothing and hand protection."
    },
    {
      "type": "list_item",
      "id": "txt_0096",
      "reading_order": 110,
      "section": "Precautions during work",
      "bbox": {
        "l": 153.00006000000002,
        "t": 499.8018399999999,
        "r": 278.12005999999997,
        "b": 488.56183999999996
      },
      "content": "Stay clear of  suspended loads."
    },
    {
      "type": "list_item",
      "id": "txt_0097",
      "reading_order": 111,
      "section": "Precautions during work",
      "bbox": {
        "l": 153.00006000000002,
        "t": 486.00184999999993,
        "r": 327.3700599999999,
        "b": 474.7618499999999
      },
      "content": "Always lift the product by its lifting device."
    },
    {
      "type": "list_item",
      "id": "txt_0098",
      "reading_order": 112,
      "section": "Precautions during work",
      "bbox": {
        "l": 153.00006000000002,
        "t": 472.20185999999995,
        "r": 512.3900600000004,
        "b": 460.96185999999994
      },
      "content": "Beware of the risk of  a sudden start if  the product is used with an automatic level control."
    },
    {
      "type": "list_item",
      "id": "txt_0099",
      "reading_order": 113,
      "section": "Precautions during work",
      "bbox": {
        "l": 153.00004,
        "t": 458.40187,
        "r": 360.38004,
        "b": 447.16186999999996
      },
      "content": "Beware of the starting jerk, which can be powerful."
    },
    {
      "type": "list_item",
      "id": "txt_0100",
      "reading_order": 114,
      "section": "Precautions during work",
      "bbox": {
        "l": 153.00004,
        "t": 444.60188,
        "r": 408.9300399999999,
        "b": 433.36188
      },
      "content": "Rinse the components in water after you disassemble the pump."
    },
    {
      "type": "list_item",
      "id": "txt_0101",
      "reading_order": 115,
      "section": "Precautions during work",
      "bbox": {
        "l": 153.00006000000002,
        "t": 430.80189,
        "r": 397.57006,
        "b": 419.56189
      },
      "content": "Do not exceed the maximum working pressure of the pump."
    },
    {
      "type": "list_item",
      "id": "txt_0102",
      "reading_order": 116,
      "section": "Precautions during work",
      "bbox": {
        "l": 153.00008000000003,
        "t": 417.00190000000003,
        "r": 549.31008,
        "b": 381.7619
      },
      "content": "Do not open any vent or drain valve or remove any plugs while the system is pressurized. Make sure that the pump is isolated from the system and that pressure is relieved before you disassemble the pump, remove plugs, or disconnect piping."
    },
    {
      "type": "list_item",
      "id": "txt_0103",
      "reading_order": 117,
      "section": "Precautions during work",
      "bbox": {
        "l": 153.00004,
        "t": 379.20191000000005,
        "r": 419.81004000000013,
        "b": 367.96191000000005
      },
      "content": "Never operate a pump without a properly installed coupling guard."
    },
    {
      "type": "paragraph",
      "id": "txt_0104",
      "reading_order": 118,
      "section": "Precautions during work",
      "bbox": {
        "l": 144.00004,
        "t": 344.88193000000007,
        "r": 553.1000400000003,
        "b": 321.64193000000006
      },
      "content": "The product is designed for use in liquids that can be hazardous to your health. Observe these rules when you work with the product:"
    },
    {
      "type": "list_item",
      "id": "txt_0105",
      "reading_order": 119,
      "section": "Precautions during work",
      "bbox": {
        "l": 153.00004,
        "t": 317.88193000000007,
        "r": 533.8900400000003,
        "b": 294.64193000000006
      },
      "content": "Make sure that all personnel who work with biologically hazardous liquids are vaccinated against diseases to which they may be exposed."
    },
    {
      "type": "list_item",
      "id": "txt_0106",
      "reading_order": 120,
      "section": "Precautions during work",
      "bbox": {
        "l": 153.00007,
        "t": 292.0819400000001,
        "r": 297.45006999999987,
        "b": 280.8419400000001
      },
      "content": "Observe strict personal cleanliness."
    },
    {
      "type": "paragraph",
      "id": "txt_0107",
      "reading_order": 121,
      "section": "Precautions during work",
      "bbox": {
        "l": 162.00008000000003,
        "t": 254.04196000000002,
        "r": 555.7900800000003,
        "b": 230.80196
      },
      "content": "Follow these procedures for chemicals or hazardous fluids that have come into contact with your eyes or your skin:"
    },
    {
      "type": "table",
      "id": "tbl_0005",
      "reading_order": 122,
      "section": "Precautions during work",
      "bbox": {
        "l": 160.7306671142578,
        "t": 226.2320556640625,
        "r": 558.898193359375,
        "b": 122.83697509765625
      },
      "markdown": "| Condition                             |   Action | Action                                                                |\n|---------------------------------------|----------|-----------------------------------------------------------------------|\n| Chemicals or hazardous fluids in eyes |       1. | Hold your eyelids apart forcibly with your fingers.                   |\n| Chemicals or hazardous fluids in eyes |       2. | Rinse the eyes with eyewash or running water for at least 15 minutes. |\n| Chemicals or hazardous fluids in eyes |       3. | Seek medical attention.                                               |\n| Chemicals or hazardous fluids on skin |       1. | Remove contaminated clothing.                                         |\n| Chemicals or hazardous fluids on skin |       2. | Wash the skin with soap and water for at least 1 minute.              |\n| Chemicals or hazardous fluids on skin |       3. | Seek medical attention, if necessary.                                 |",
      "rows": 7,
      "cols": 3
    },
    {
      "type": "heading",
      "id": "txt_0108",
      "reading_order": 123,
      "section": "Ex-approved products",
      "bbox": {
        "l": 54.0,
        "t": 112.0369199999999,
