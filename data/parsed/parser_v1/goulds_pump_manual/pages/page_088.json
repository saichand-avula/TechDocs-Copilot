      "bbox": {
        "l": 153.00193,
        "t": 448.1418399999999,
        "r": 555.3919300000002,
        "b": 424.9018399999999
      },
      "content": "Make sure that the parts are clean. Clean the pump parts in solvent in order to remove oil, grease, and dirt.",
      "section_id": "sec_auto_1495",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1495",
