      "source": "pdf_text"
    },
    {
      "type": "admonition",
      "id": "txt_1009",
      "reading_order": 1159,
      "severity": "warning",
      "content": "WARNING: The mechanical seal used in an Ex-classified environment must be properly certified. Prior to startup, make sure that all areas that could leak pumped fluid to the work environment are closed.",
      "section": "WARNING:",
      "bbox": {
        "l": 144.0,
        "t": 390.43183999999985,
        "r": 197.11,
        "b": 379.19183999999984
