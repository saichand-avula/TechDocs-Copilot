    {
      "type": "admonition",
      "id": "txt_1011",
      "reading_order": 1161,
      "severity": "caution",
      "content": "CAUTION: Never operate the pump without liquid supplied to mechanical seal. If  you run a mechanical seal dry, even for a few seconds, this can cause seal damage. Physical injury can occur if  a mechanical seal fails.",
