      "source": "pdf_text"
    },
    {
      "type": "paragraph",
      "id": "txt_1008",
      "reading_order": 1158,
      "section": "Before you start the pump",
      "bbox": {
        "l": 144.00004,
        "t": 170.56089999999983,
        "r": 534.4600400000004,
        "b": 147.32089999999982
      },
      "content": "The life of  a mechanical seal depends on the cleanliness of  the pumped fluid. Due to the diversity of operating conditions, it is not possible to give definite indications as to the life of  a mechanical seal.",
      "section_id": "sec_auto_1156",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1156",
          "title": "Before you start the pump"
        }
      ],
