    {
      "type": "admonition",
      "id": "txt_0644",
      "reading_order": 742,
      "severity": "warning",
      "content": "WARNING: Always disconnect and lock out power to the driver before you perform any installation or maintenance tasks. Failure to disconnect and lock out driver power will result in serious physical injury.",
      "section": "WARNING:",
      "bbox": {
        "l": 144.0,
        "t": 405.16926999999987,
        "r": 197.11,
        "b": 393.92926999999986
      }
    },
    {
      "type": "list_item",
      "id": "txt_0646",
      "reading_order": 744,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00004,
        "t": 350.51380999999986,
        "r": 270.6000399999999,
        "b": 339.27380999999986
      },
      "content": "Remove the coupling guard."
    },
    {
      "type": "list_item",
      "id": "txt_0647",
      "reading_order": 745,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00004,
        "t": 336.95157999999986,
        "r": 517.5600400000004,
        "b": 325.71157999999986
      },
      "content": "Set the indicator so that the button contacts either the shaft end or the face of  the coupling."
    },
    {
      "type": "list_item",
      "id": "txt_0648",
      "reading_order": 746,
      "section": "WARNING:",
      "bbox": {
        "l": 144.0,
        "t": 96.7575599999999,
        "r": 539.1700000000003,
        "b": 85.51755999999989
      },
      "content": "Loosen the jam nuts (423) on the jack bolts (370D) , and then back the bolts out about two turns."
    },
    {
      "type": "list_item",
      "id": "txt_0649",
      "reading_order": 747,
      "section": "WARNING:",
      "bbox": {
        "l": 144.0,
        "t": 83.19536999999991,
        "r": 554.5500000000003,
        "b": 59.9553699999999
      },
      "content": "Tighten the locking bolts evenly (370C), bringing the bearing housing (134A) towards the frame (228) until the impeller contacts the casing."
    },
