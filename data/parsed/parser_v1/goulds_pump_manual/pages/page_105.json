      "bbox": {
        "l": 143.99988,
        "t": 248.60394999999994,
        "r": 405.2498800000001,
        "b": 237.36394999999993
      },
      "content": "Bend the tangs of the lockwasher into the slots of  the locknut.",
      "section_id": "sec_auto_1784",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1784",
          "title": "CAUTION:"
