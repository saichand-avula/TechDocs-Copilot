      "bbox": {
        "l": 162.0,
        "t": 416.43594,
        "r": 541.2700000000003,
        "b": 393.19594
      },
      "content": "Inspect the shaft (122) to ensure that it is clean, dimensionally correct, and is free of  nicks and burrs.",
      "section_id": "sec_auto_1784",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1784",
          "title": "CAUTION:"
        }
      ],
      "page": 105,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_1557",
