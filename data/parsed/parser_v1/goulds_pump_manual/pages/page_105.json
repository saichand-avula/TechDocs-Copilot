      "section": "CAUTION:",
      "bbox": {
        "l": 161.99993,
        "t": 391.46594,
        "r": 385.26993000000004,
        "b": 380.22594
      },
      "content": "Lightly coat the bearing seating with a thin film of  oil.",
      "section_id": "sec_auto_1784",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1784",
          "title": "CAUTION:"
        }
      ],
      "page": 105,
      "chunk_hint": "continue",
      "semantic_role": "description",
