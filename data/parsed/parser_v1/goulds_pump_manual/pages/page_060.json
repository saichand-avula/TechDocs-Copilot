    {
      "type": "heading",
      "id": "txt_0882",
      "reading_order": 1018,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.0,
        "t": 406.06182,
        "r": 194.52999999999997,
        "b": 394.82182
      },
      "content": "CAUTION:",
      "level": 2,
      "role": "section"
    },
    {
      "type": "list_item",
      "id": "txt_0883",
      "reading_order": 1019,
      "section": "CAUTION:",
      "bbox": {
        "l": 153.00002,
        "t": 392.26183000000003,
        "r": 535.2500200000004,
        "b": 357.02183
      },
      "content": "Vary the capacity with the regulating valve in the discharge line. Never throttle the flow from the suction side since this can result in decreased performance, unexpected heat generation, and equipment damage."
    },
    {
      "type": "list_item",
      "id": "txt_0884",
      "reading_order": 1020,
      "section": "CAUTION:",
      "bbox": {
        "l": 152.99987000000002,
        "t": 354.46184000000005,
        "r": 550.2498700000004,
        "b": 331.22184000000004
      },
      "content": "Do not overload the driver. Driver overload can result in unexpected heat generation and equipment damage. The driver can overload in these circumstances:"
    },
    {
      "type": "list_item",
      "id": "txt_0885",
      "reading_order": 1021,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99983000000003,
        "t": 328.6618500000001,
        "r": 424.70983000000007,
        "b": 317.42185000000006
      },
      "content": "The specific gravity of  the pumped fluid is greater than expected."
    },
    {
      "type": "list_item",
      "id": "txt_0886",
      "reading_order": 1022,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99985000000004,
        "t": 314.8618600000001,
        "r": 349.10985,
        "b": 303.6218600000001
      },
      "content": "The pumped fluid exceeds the rated flow rate."
    },
    {
      "type": "list_item",
      "id": "txt_0887",
      "reading_order": 1023,
      "section": "CAUTION:",
      "bbox": {
        "l": 152.99987000000002,
        "t": 301.0618700000001,
        "r": 542.8898700000003,
        "b": 277.8218700000001
      },
      "content": "Make sure to operate the pump at or near the rated conditions. Failure to do so can result in pump damage from cavitation or recirculation."
    },
    {
      "type": "heading",
      "id": "txt_0888",
      "reading_order": 1024,
      "section": "Operation at reduced capacity",
      "bbox": {
        "l": 53.99986,
        "t": 264.06188,
        "r": 181.72985999999997,
        "b": 252.82187999999996
      },
      "content": "Operation at reduced capacity",
      "level": 2,
      "role": "section"
    },
