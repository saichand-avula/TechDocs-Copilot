    {
      "type": "admonition",
      "id": "txt_0889",
      "reading_order": 1027,
      "severity": "warning",
      "content": "WARNING: Never operate any pumping system with a blocked suction and discharge. Operation, even for a brief period under these conditions, can cause confined pumped fluid to overheat, which results in a violent explosion. You must take all necessary measures to avoid this condition.",
      "section": "WARNING:",
      "bbox": {
        "l": 144.0,
        "t": 239.06187999999997,
        "r": 197.11,
        "b": 227.82187999999996
      }
    },
    {
      "type": "heading",
      "id": "txt_0891",
      "reading_order": 1029,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99998,
        "t": 168.54186000000004,
        "r": 194.52997999999997,
        "b": 157.30186000000003
      },
      "content": "CAUTION:",
      "level": 2,
      "role": "section"
    },
    {
      "type": "list_item",
      "id": "txt_0892",
      "reading_order": 1030,
      "section": "CAUTION:",
      "bbox": {
        "l": 153.0,
        "t": 154.74187000000006,
        "r": 545.6600000000003,
        "b": 131.50187000000005
      },
      "content": "Avoid excessive vibration levels. Excessive vibration levels can damage the bearings, stuffing box or seal chamber, and the mechanical seal, which can result in decreased performance."
    },
    {
      "type": "list_item",
      "id": "txt_0893",
      "reading_order": 1031,
      "section": "CAUTION:",
      "bbox": {
        "l": 153.00002,
        "t": 128.94188000000008,
        "r": 496.64002000000016,
        "b": 117.70188000000007
      },
      "content": "Avoid increased radial load. Failure to do so can cause stress on the shaft and bearings."
    },
    {
      "type": "list_item",
      "id": "txt_0894",
      "reading_order": 1032,
      "section": "CAUTION:",
      "bbox": {
        "l": 153.0,
        "t": 115.1418900000001,
        "r": 465.2600000000001,
        "b": 103.9018900000001
      },
      "content": "Avoid heat build-up. Failure to do so can cause rotating parts to score or seize."
    },
    {
      "type": "list_item",
      "id": "txt_0895",
      "reading_order": 1033,
      "section": "CAUTION:",
      "bbox": {
        "l": 153.0,
        "t": 101.34190000000012,
        "r": 506.6800000000001,
        "b": 90.10190000000011
      },
      "content": "Avoid cavitation. Failure to do so can cause damage to the internal surfaces of  the pump."
    }
  ],
