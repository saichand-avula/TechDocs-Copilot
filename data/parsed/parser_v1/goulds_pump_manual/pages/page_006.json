      "bbox": {
        "l": 143.99988,
        "t": 472.82637,
        "r": 537.4698800000004,
        "b": 437.58637
      },
      "content": "Special versions can be supplied with supplementary instruction leaflets. See the sales contract for any modifications or special version characteristics. For instructions, situations, or events that are not considered in this manual or in the sales documents, please contact the nearest ITT representative.",
      "section_id": "sec_auto_20",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_20",
