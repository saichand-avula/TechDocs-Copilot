      "section": "CAUTION:",
      "bbox": {
        "l": 143.99996,
        "t": 285.05906999999996,
        "r": 454.7999600000001,
        "b": 273.81907
      },
      "content": "Slide the shaft wrench (A05107A or A01676A) over the shaft (122) and key."
    },
    {
      "type": "list_item",
      "id": "txt_1119",
      "reading_order": 1280,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99996,
        "t": 271.25908000000004,
        "r": 550.6099600000003,
        "b": 248.01908000000003
      },
      "content": "Rotate the impeller (101) clockwise (viewed from the impeller end of  the shaft) and raise the wrench off  of  the work surface."
    },
    {
      "type": "list_item",
      "id": "txt_1120",
      "reading_order": 1281,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99992,
        "t": 245.45909000000006,
        "r": 550.1899200000005,
        "b": 222.21909000000005
      },
      "content": "To loosen the impeller, quickly turn it counter-clockwise (viewed from the impeller end of  the shaft) while impacting the wrench handle on the workbench or a solid block."
