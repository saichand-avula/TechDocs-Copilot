    },
    {
      "type": "admonition",
      "id": "txt_1023",
      "reading_order": 1174,
      "section": "Tightening of  packing",
      "bbox": {
        "l": 144.00008000000003,
        "t": 521.0018399999999,
        "r": 536.8100900000004,
        "b": 497.76184
      },
      "content": "NOTICE: Never over-tighten packing to the point where less than one drop per second is observed. Over-tightening can cause excessive wear and power consumption during operation.",
      "severity": "note",
      "section_id": "sec_auto_1173",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1173",
          "title": "Tightening of  packing"
        }
      ],
      "page": 67,
      "chunk_hint": "admonition",
      "semantic_role": "note",
      "source": "pdf_text"
    },
    {
      "type": "paragraph",
      "id": "txt_1024",
      "reading_order": 1175,
      "section": "Tightening of  packing",
      "bbox": {
        "l": 144.0001,
        "t": 487.48183,
        "r": 546.8001000000005,
        "b": 476.24183
      },
      "content": "If  you cannot tighten the packing to obtain less than the specified leakage rate, then replace the packing.",
      "section_id": "sec_auto_1173",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1173",
          "title": "Tightening of  packing"
        }
      ],
      "page": 67,
