    {
      "type": "admonition",
      "id": "txt_0342",
      "reading_order": 394,
      "section": "Install the baseplate using jackscrews",
      "bbox": {
        "l": 162.00103,
        "t": 350.12118,
        "r": 528.7710400000003,
        "b": 326.88118
      },
      "content": "NOTICE: Remove all dirt from the mounting pads in order to make sure that you achieve the correct leveling. Failure to do so can result in equipment damage or decreased performance.",
      "severity": "note"
    },
    {
      "type": "list_item",
      "id": "txt_0343",
      "reading_order": 395,
      "section": "Install the baseplate using jackscrews",
      "bbox": {
        "l": 162.00105000000002,
        "t": 316.46522999999996,
        "r": 410.2910500000001,
        "b": 305.22522999999995
      },
      "content": "Put one machinist's level lengthwise on one of  the two pads."
    },
    {
      "type": "list_item",
      "id": "txt_0344",
      "reading_order": 396,
      "section": "Install the baseplate using jackscrews",
      "bbox": {
        "l": 162.00105000000002,
        "t": 303.13725999999997,
        "r": 419.89105000000006,
        "b": 291.89725999999996
      },
      "content": "Put the other machinist's level across the ends of  the two pads."
    },
    {
      "type": "list_item",
      "id": "txt_0345",
      "reading_order": 397,
      "section": "Install the baseplate using jackscrews",
      "bbox": {
        "l": 162.00105000000002,
        "t": 289.80929,
        "r": 415.77105,
        "b": 278.5692899999999
      },
      "content": "Level the pads by adjusting the four jackscrews in the corners."
    },
    {
      "type": "list_item",
      "id": "txt_0346",
      "reading_order": 398,
      "section": "Install the baseplate using jackscrews",
      "bbox": {
        "l": 176.17104,
        "t": 275.2892999999999,
        "r": 550.4910600000004,
        "b": 252.0492999999999
      },
      "content": "Make sure that the machinist's level readings are as close to zero as possible, both lengthwise and across."
    },
    {
      "type": "paragraph",
      "id": "txt_0347",
      "reading_order": 399,
      "section": "Install the baseplate using jackscrews",
      "bbox": {
        "l": 176.17106,
        "t": 248.63336000000004,
        "r": 427.7410600000001,
        "b": 237.39336000000003
      },
      "content": "Use the baseplate-leveling worksheet when you take the readings."
    },
