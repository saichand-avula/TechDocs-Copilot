    },
    {
      "type": "table",
      "id": "tbl_0023",
      "reading_order": 512,
      "section": "Initial alignment (cold alignment) checks",
      "bbox": {
        "l": 142.76524353027344,
        "t": 209.22601318359375,
        "r": 558.9386596679688,
        "b": 104.22625732421875
      },
      "markdown": "| When                           | Why                                                                                                                                                            |\n|--------------------------------|----------------------------------------------------------------------------------------------------------------------------------------------------------------|\n| Before you grout the baseplate | This ensures that alignment can be accomplished.                                                                                                               |\n| After you grout the baseplate  | This ensures that no changes have occurred during the grouting process.                                                                                        |\n| After you connect the piping   | This ensures that pipe strains have not altered the alignment. If changes have occurred, you must alter the piping to remove pipe strains on the pump flanges. |",
      "rows": 4,
      "cols": 2,
      "section_id": "sec_auto_511",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
