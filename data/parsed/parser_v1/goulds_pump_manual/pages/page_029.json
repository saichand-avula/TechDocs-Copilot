      "section": "Initial alignment (cold alignment) checks",
      "bbox": {
        "l": 54.0,
        "t": 228.00181999999995,
        "r": 229.63,
        "b": 216.76181999999994
      },
      "content": "Initial alignment (cold alignment) checks",
      "level": 2,
      "section_id": "sec_auto_511",
      "section_path": [
        {
          "id": "sec_auto_511",
          "title": "Initial alignment (cold alignment) checks"
        }
      ],
      "parent_section_id": null,
      "section_level": 2,
