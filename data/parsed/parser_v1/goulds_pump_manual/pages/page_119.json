      "next_block_id": "txt_1747",
      "image_hash": "d8f94fe7ab918f695e03ced468d8f3c5b4bfcd6bf7da5a8cc86f91e18ae271d3",
      "width": 193,
      "height": 175
    },
    {
      "type": "paragraph",
      "id": "txt_1747",
      "reading_order": 2033,
      "section": "NOTICE:",
      "bbox": {
        "l": 176.17,
        "t": 523.49,
        "r": 550.3700000000003,
        "b": 500.25
      },
      "content": "Rotate the indicator through 360º. If  the total indicator reading is greater than 0.005 inches (0.13 mm), determine the cause and correct the issue before you proceed."
    },
    {
      "type": "list_item",
      "id": "txt_1748",
      "reading_order": 2034,
      "section": "NOTICE:",
      "bbox": {
        "l": 162.00001999999998,
        "t": 497.98999999999995,
        "r": 286.17001999999985,
        "b": 486.74999999999994
      },
      "content": "Install the shaft sleeve (126)."
    },
    {
      "type": "list_item",
      "id": "txt_1749",
      "reading_order": 2035,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.0,
        "t": 264.03814,
        "r": 384.28999999999996,
        "b": 252.79814
      },
      "content": "Mark the shaft and sleeve at the face of  the seal chamber."
    },
    {
      "type": "list_item",
      "id": "txt_1750",
      "reading_order": 2036,
      "section": "NOTICE:",
      "bbox": {
        "l": 143.99998,
        "t": 250.23815000000002,
        "r": 469.9299800000002,
        "b": 238.99815
      },
      "content": "Continue the complete reassembly of the pump, except for the mechanical seal."
    },
    {
      "type": "list_item",
      "id": "txt_1751",
      "reading_order": 2037,
      "section": "NOTICE:",
      "bbox": {
        "l": 143.99996,
        "t": 236.43816000000004,
        "r": 430.73996000000005,
        "b": 210.67813999999998
      },
      "content": "Set the impeller clearance. Refer to the Impeller Clearance Setting section for more information."
    },
    {
      "type": "list_item",
      "id": "txt_1752",
      "reading_order": 2038,
      "section": "NOTICE:",
      "bbox": {
        "l": 143.99996,
        "t": 208.11815,
        "r": 454.65996000000024,
        "b": 196.87815
      },
      "content": "Scribe a line on the marked shaft and sleeve at the face of  the seal chamber."
    },
    {
      "type": "list_item",
      "id": "txt_1753",
      "reading_order": 2039,
      "section": "NOTICE:",
      "bbox": {
        "l": 143.99993999999998,
        "t": 194.31816000000003,
        "r": 372.9699399999999,
        "b": 183.07816000000003
      },
      "content": "Remove the casing, the impeller, and the seal chamber."
    },
    {
      "type": "list_item",
      "id": "txt_1754",
      "reading_order": 2040,
      "section": "NOTICE:",
      "bbox": {
        "l": 143.99989999999997,
        "t": 180.51817000000005,
        "r": 552.9999000000003,
        "b": 157.27817000000005
      },
      "content": "If  applicable, slide the gland, with the stationary seat and gland gasket installed, onto the shaft until it contacts the inboard labyrinth oil seal."
    },
    {
      "type": "list_item",
      "id": "txt_1755",
      "reading_order": 2041,
      "section": "NOTICE:",
      "bbox": {
        "l": 143.99989999999997,
        "t": 154.71818000000007,
        "r": 481.86990000000003,
        "b": 128.95816000000002
      },
      "content": "Install the mechanical-seal rotary unit according to the manufacturer's instructions. Use the scribed line and the seal-reference dimension."
    },
    {
      "type": "list_item",
      "id": "txt_1756",
      "reading_order": 2042,
      "section": "NOTICE:",
      "bbox": {
        "l": 143.99984999999995,
        "t": 126.39817000000005,
        "r": 263.94984999999986,
        "b": 115.15817000000004
      },
      "content": "Reinstall the seal chamber."
    },
    {
      "type": "list_item",
      "id": "txt_1757",
      "reading_order": 2043,
      "section": "NOTICE:",
      "bbox": {
        "l": 143.99984999999995,
        "t": 112.59818000000007,
        "r": 546.6698500000002,
        "b": 74.83816000000002
      },
      "content": "Slide the gland on the seal-chamber studs and secure them with the gland nuts. Tighten the nuts evenly so that the gland is seated on the seal-chamber pilot and is perpendicular to the shaft."
    },
    {
      "type": "list_item",
      "id": "txt_1758",
      "reading_order": 2044,
      "section": "NOTICE:",
      "bbox": {
        "l": 143.99984999999995,
        "t": 72.27817000000005,
        "r": 313.1998499999998,
        "b": 61.03817000000004
      },
      "content": "Complete the reassembly of the pump."
    },
    {
