      "width": 199,
      "height": 128
    },
    {
      "type": "list_item",
      "id": "txt_1573",
      "reading_order": 1822,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.00233,
        "t": 428.14007,
        "r": 385.8123300000001,
        "b": 416.90006999999997
      },
      "content": "Install the inboard bearing as follows (see the illustration):"
    },
    {
      "type": "list_item",
      "id": "txt_1574",
      "reading_order": 1823,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.00234,
        "t": 413.14007,
        "r": 385.2823400000001,
        "b": 401.90006999999997
      },
      "content": "Coat the inner surfaces of  the bearings with lubricant."
    },
    {
      "type": "list_item",
      "id": "txt_1575",
      "reading_order": 1824,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.00232,
        "t": 399.64007,
        "r": 549.1423300000004,
        "b": 373.88007999999996
      },
      "content": "Put the inboard bearing (168) onto the shaft (122). The regreasable bearing has a single shield. Make sure that the bearing is installed with the shield"
    },
    {
      "type": "paragraph",
      "id": "txt_1576",
      "reading_order": 1825,
      "section": "CAUTION:",
      "bbox": {
        "l": 176.17233,
        "t": 373.12008,
        "r": 266.95232999999996,
        "b": 361.88007999999996
      },
      "content": "away from the impeller."
    },
    {
      "type": "figure",
      "id": "fig_0187",
      "reading_order": 1826,
      "section": "CAUTION:",
      "bbox": {
        "l": 164.55606079101562,
        "t": 353.2384033203125,
        "r": 299.4887390136719,
        "b": 256.75433349609375
      },
      "image_path": "figures/figure_0187.png",
      "previous_block_id": "txt_1576",
      "next_block_id": "txt_1577",
      "image_hash": "b4b7d6546f200f13ca88b8b65dfeafecf3d5cb3abe7c85b6a97340fb05512895",
      "width": 134,
      "height": 96
    },
    {
      "type": "list_item",
      "id": "txt_1577",
      "reading_order": 1827,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99887999999999,
        "t": 249.47564,
        "r": 472.9888800000002,
        "b": 238.23564
      },
      "content": "Install the remaining parts onto the bearing shaft as follows (see the illustration):"
    },
    {
      "type": "list_item",
      "id": "txt_1578",
      "reading_order": 1828,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99887,
        "t": 234.47564,
        "r": 278.2588699999999,
        "b": 223.23564
      },
      "content": "Install a new O-ring (496)."
    },
    {
      "type": "list_item",
      "id": "txt_1579",
      "reading_order": 1829,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99887,
        "t": 220.97564,
        "r": 534.2688600000002,
        "b": 180.21561999999994
      },
      "content": "Install the outboard labyrinth oil-seal (332A) into the end cover (109A). Place the drain slots of  the oil seal at the bottom position (6 o'clock). Make sure that the edges of  the keyway are free from burrs. To protect the O-ring, cover the"
    },
    {
      "type": "paragraph",
      "id": "txt_1580",
      "reading_order": 1830,
      "section": "CAUTION:",
      "bbox": {
        "l": 176.16881,
        "t": 179.45561999999995,
        "r": 477.7088100000003,
        "b": 168.21561999999994
      },
      "content": "keyway lengthwise with a piece of  electrical tape before you install the oil seal."
    }
  ],
