        "l": 172.75364685058594,
        "t": 736.4027252197266,
        "r": 355.14752197265625,
        "b": 535.5627136230469
      },
      "image_path": "figures/figure_0165.png",
      "next_block_id": "txt_1404",
      "image_hash": "5a040c4f61a039772e2138345e1c99e9d7447af2f3ab5dcbc7ee029f2b0f8f11",
      "width": 182,
      "height": 200
    },
    {
      "type": "list_item",
      "id": "txt_1404",
      "reading_order": 1632,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99788999999998,
        "t": 528.1965399999999,
        "r": 372.20789,
        "b": 516.95654
      },
      "content": "Install the outboard bearing (112A) on the shaft (122)."
    },
    {
      "type": "paragraph",
      "id": "txt_1405",
      "reading_order": 1633,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99791,
        "t": 513.6765399999999,
        "r": 550.1779100000003,
        "b": 490.43654
      },
      "content": "The regreaseable bearing has a single shield. The outboard bearing is installed with the shield toward the impeller."
    },
    {
      "type": "list_item",
      "id": "txt_1406",
      "reading_order": 1634,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99793,
        "t": 487.52078,
        "r": 541.2679300000004,
        "b": 464.28078
      },
      "content": "Inspect the shaft (122) to ensure that it is clean, dimensionally correct, and is free of  nicks and burrs."
    },
    {
      "type": "list_item",
      "id": "txt_1407",
      "reading_order": 1635,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99788999999998,
        "t": 462.4429,
        "r": 385.2678900000001,
        "b": 451.2029
      },
      "content": "Lightly coat the bearing seating with a thin film of  oil."
    },
    {
      "type": "list_item",
      "id": "txt_1408",
      "reading_order": 1636,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99788999999998,
        "t": 449.36502,
        "r": 351.59789,
        "b": 438.12502
      },
      "content": "Remove the bearing (112) from its packaging."
    },
    {
      "type": "list_item",
      "id": "txt_1409",
      "reading_order": 1637,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99788999999998,
        "t": 436.28714,
        "r": 447.9578900000001,
        "b": 425.04714
      },
      "content": "Wipe the preservative from the bearing (112) bore and outer diameter."
    },
    {
      "type": "list_item",
      "id": "txt_1410",
      "reading_order": 1638,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99791,
        "t": 423.20926000000003,
        "r": 534.1779100000006,
        "b": 399.96926
      },
      "content": "Use an induction heater with a demagnetizing cycle to heat the bearing (112) to an inner ring temperature of 230 °F (110 °C)."
    },
    {
      "type": "list_item",
      "id": "txt_1411",
      "reading_order": 1639,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99790000000002,
        "t": 398.13138000000004,
        "r": 532.9179000000001,
        "b": 374.89138
      },
      "content": "Position the bearing (112) on the shaft (122) against the shoulder and snug the locknut (136) against the bearing until it is cool."
    },
    {
      "type": "list_item",
      "id": "txt_1412",
      "reading_order": 1640,
      "section": "CAUTION:",
      "bbox": {
        "l": 176.1779,
        "t": 371.61139000000003,
        "r": 515.5779000000002,
        "b": 360.37139
      },
      "content": "The locknut prevents the bearing from moving away from the shaft shoulder as it cools."
    },
    {
      "type": "list_item",
      "id": "txt_1413",
      "reading_order": 1641,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99785,
        "t": 358.53351000000004,
        "r": 420.18785000000014,
        "b": 347.29351
      },
      "content": "Remove the bearing locknut (136) after the bearing (112) cools."
    },
    {
      "type": "list_item",
      "id": "txt_1414",
      "reading_order": 1642,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99783,
        "t": 345.24005000000005,
        "r": 339.4878299999999,
        "b": 334.00005000000004
      },
      "content": "Put the lockwasher (382) onto the shaft (122)."
    },
    {
      "type": "list_item",
      "id": "txt_1415",
      "reading_order": 1643,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99783,
        "t": 331.94659000000007,
        "r": 449.9978300000002,
        "b": 320.70659000000006
      },
      "content": "Thread the locknut (136) onto the shaft (122) and tighten it until it is snug."
    },
    {
      "type": "list_item",
      "id": "txt_1416",
      "reading_order": 1644,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99781,
        "t": 318.6531300000001,
        "r": 405.2478100000001,
        "b": 307.4131300000001
      },
      "content": "Bend the tangs of the lockwasher into the slots of  the locknut."
    },
    {
      "type": "list_item",
      "id": "txt_1417",
      "reading_order": 1645,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99777,
        "t": 305.3596700000001,
        "r": 400.06779,
        "b": 279.59968000000003
      },
      "content": "Put the bearing-retaining ring (361A) onto the shaft (122). Make sure that the flat side of  the ring is towards the bearing."
    },
    {
      "type": "list_item",
      "id": "txt_1418",
      "reading_order": 1646,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99781,
        "t": 277.5462200000002,
        "r": 371.10781,
        "b": 266.30622000000017
      },
      "content": "Coat the inner surfaces of  the bearings with lubricant."
    },
    {
      "type": "list_item",
      "id": "txt_1419",
      "reading_order": 1647,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99778999999998,
        "t": 264.2527600000001,
        "r": 357.5277899999999,
        "b": 253.01276000000007
      },
      "content": "Put the inboard bearing (168) onto the shaft (122)."
    },
    {
      "type": "paragraph",
      "id": "txt_1420",
      "reading_order": 1648,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99778999999998,
        "t": 249.73277000000007,
        "r": 556.0377900000004,
        "b": 226.49277000000006
      },
      "content": "The regreasable bearing has a single shield. Make sure that the bearing is installed with the shield away from the impeller."
    },
