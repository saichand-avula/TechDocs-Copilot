    {
      "type": "list_item",
      "id": "txt_1278",
      "reading_order": 1483,
      "section": "WARNING:",
      "bbox": {
        "l": 153.00002,
        "t": 210.87480000000005,
        "r": 532.2800200000001,
        "b": 187.63480000000004
      },
      "content": "Never heat the condition monitor to temperatures in excess of  300°F (149°C). Heating to these temperatures could result in death or serious injury.",
      "section_id": "sec_auto_1482",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1482",
          "title": "WARNING:"
        }
      ],
      "page": 87,
      "chunk_hint": "section_start",
      "semantic_role": "overview",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_1279",
      "reading_order": 1484,
      "section": "WARNING:",
      "bbox": {
        "l": 153.00004,
        "t": 185.07481000000007,
        "r": 519.7200400000002,
        "b": 173.83481000000006
      },
      "content": "Never dispose of the condition monitor in a fire. This could result in death or serious injury.",
      "section_id": "sec_auto_1482",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1482",
          "title": "WARNING:"
        }
      ],
      "page": 87,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "paragraph",
      "id": "txt_1280",
      "reading_order": 1485,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00008,
        "t": 145.5548,
        "r": 537.3200800000004,
        "b": 122.31479999999999
      },
      "content": "The battery contained in the condition monitor does not contain enough lithium to qualify as reactive hazardous waste. Use these guidelines when disposing of the condition monitor.",
      "section_id": "sec_auto_1482",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1482",
          "title": "WARNING:"
        }
      ],
      "page": 87,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_1281",
      "reading_order": 1486,
      "section": "WARNING:",
      "bbox": {
        "l": 153.00011999999998,
        "t": 118.5548,
        "r": 474.73012000000017,
        "b": 107.31479999999999
      },
      "content": "The condition monitor is safe for disposal in the normal municipal waste stream.",
      "section_id": "sec_auto_1482",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_1482",
          "title": "WARNING:"
        }
      ],
      "page": 87,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
