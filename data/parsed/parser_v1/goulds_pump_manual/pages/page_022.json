    },
    {
      "type": "list_item",
      "id": "txt_0277",
      "reading_order": 324,
      "section": "J-type bolts",
      "bbox": {
        "l": 152.99801,
        "t": 701.8418399999999,
        "r": 556.9080100000003,
        "b": 678.60184
      },
      "content": "The foundation must be able to absorb any type of vibration and form a permanent, rigid support for the unit."
    },
    {
      "type": "list_item",
      "id": "txt_0278",
      "reading_order": 325,
      "section": "J-type bolts",
      "bbox": {
        "l": 152.998,
        "t": 676.04183,
        "r": 554.7780000000004,
        "b": 652.80183
      },
      "content": "The location and size of  the foundation bolt holes must match those shown on the assembly drawing provided with the pump data package."
    },
    {
      "type": "list_item",
      "id": "txt_0279",
      "reading_order": 326,
      "section": "J-type bolts",
      "bbox": {
        "l": 152.99799,
        "t": 650.2418299999999,
        "r": 479.7879900000002,
        "b": 639.0018299999999
      },
      "content": "The foundation must weigh between two and three times the weight of the pump."
    },
    {
      "type": "list_item",
      "id": "txt_0280",
      "reading_order": 327,
      "section": "J-type bolts",
      "bbox": {
        "l": 152.99796999999998,
        "t": 636.44183,
        "r": 537.0079700000003,
        "b": 613.20183
      },
      "content": "Provide a flat, substantial concrete foundation in order to prevent strain and distortion when you tighten the foundation bolts."
    },
    {
      "type": "list_item",
      "id": "txt_0281",
      "reading_order": 328,
      "section": "J-type bolts",
      "bbox": {
        "l": 152.99796999999998,
        "t": 610.64183,
        "r": 549.9179700000001,
        "b": 587.40183
      },
      "content": "Sleeve-type and J-type foundation bolts are most commonly used. Both designs allow movement for the final bolt adjustment."
    },
    {
