      "section": "Prepare the baseplate for mounting",
      "bbox": {
        "l": 53.99347,
        "t": 162.0013899999999,
        "r": 289.71147,
        "b": 146.37739
      },
      "content": "Prepare the baseplate for mounting",
      "level": 2,
      "role": "section"
    },
    {
      "type": "list_item",
      "id": "txt_0297",
      "reading_order": 346,
      "section": "Prepare the baseplate for mounting",
      "bbox": {
        "l": 144.00148000000002,
        "t": 143.08641,
        "r": 374.58148,
        "b": 131.84641
      },
      "content": "Remove all the attached equipment from the baseplate."
    },
    {
      "type": "list_item",
      "id": "txt_0298",
      "reading_order": 347,
      "section": "Prepare the baseplate for mounting",
      "bbox": {
        "l": 144.00150000000002,
        "t": 129.28642000000002,
        "r": 349.7015,
        "b": 118.04642000000001
      },
      "content": "Clean the underside of the baseplate completely."
    },
    {
      "type": "list_item",
      "id": "txt_0299",
      "reading_order": 348,
      "section": "Prepare the baseplate for mounting",
      "bbox": {
        "l": 144.00150000000002,
        "t": 115.48643000000004,
        "r": 438.72150000000016,
        "b": 89.72640999999999
      },
      "content": "If  applicable, coat the underside of  the baseplate with an epoxy primer. Use an epoxy primer only if you used an epoxy-based grout."
    },
    {
      "type": "list_item",
      "id": "txt_0300",
      "reading_order": 349,
      "section": "Prepare the baseplate for mounting",
      "bbox": {
        "l": 144.0015,
        "t": 87.16642000000002,
        "r": 532.4415000000004,
        "b": 75.92642000000001
      },
      "content": "Remove the rust-proofing coat from the machined mounting pads using an appropriate solvent."
    },
    {
      "type": "list_item",
      "id": "txt_0301",
      "reading_order": 350,
      "section": "Prepare the baseplate for mounting",
      "bbox": {
        "l": 144.0015,
        "t": 73.36643000000004,
        "r": 384.75150000000014,
        "b": 62.12643000000003
      },
      "content": "Remove water and debris from the foundation-bolt holes."
    }
