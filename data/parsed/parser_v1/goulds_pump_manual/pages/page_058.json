      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_969",
          "title": "CAUTION:"
        }
      ],
      "page": 58,
      "chunk_hint": "continue",
      "semantic_role": "description",
