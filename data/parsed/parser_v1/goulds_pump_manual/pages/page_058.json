      "bbox": {
        "l": 153.00002,
        "t": 309.41677000000004,
        "r": 556.9200200000002,
        "b": 286.17677000000003
      },
      "content": "Immediately observe the pressure gauges. If  discharge pressure is not quickly attained, stop the driver, reprime, and attempt to restart the pump.",
      "section_id": "sec_auto_969",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_969",
          "title": "CAUTION:"
        }
      ],
      "page": 58,
      "chunk_hint": "section_start",
      "semantic_role": "overview",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
