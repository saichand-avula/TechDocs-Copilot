      "bbox": {
        "l": 144.00471,
        "t": 521.68999,
        "r": 384.28471,
        "b": 510.44998999999996
      },
      "content": "Mark the shaft and sleeve at the face of  the seal chamber."
    },
    {
      "type": "list_item",
      "id": "txt_1770",
      "reading_order": 2061,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.00466999999998,
        "t": 507.88998999999995,
        "r": 469.9346700000002,
        "b": 496.64999
      },
      "content": "Continue the complete reassembly of the pump, except for the mechanical seal."
    },
    {
      "type": "list_item",
      "id": "txt_1771",
      "reading_order": 2062,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.00468999999998,
        "t": 494.08999,
        "r": 427.4246900000001,
        "b": 468.33
      },
      "content": "Set the impeller clearance. Refer to the Impeller clearance setting section for more information."
    },
    {
      "type": "list_item",
      "id": "txt_1772",
      "reading_order": 2063,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.00468999999998,
        "t": 465.77001,
        "r": 454.6646900000003,
        "b": 454.53001
      },
      "content": "Scribe a line on the marked shaft and sleeve at the face of  the seal chamber."
    },
    {
      "type": "list_item",
      "id": "txt_1773",
      "reading_order": 2064,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.00466999999998,
        "t": 451.97002000000003,
        "r": 372.96466999999996,
        "b": 440.73002
      },
      "content": "Remove the casing, the impeller, and the seal chamber."
    },
    {
      "type": "list_item",
      "id": "txt_1774",
      "reading_order": 2065,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.00463,
        "t": 438.17003000000005,
        "r": 545.7646300000001,
        "b": 400.41004000000004
      },
      "content": "Install the mechanical-seal rotary unit per the manufacturer's instructions. Use the scribed line as the seal-reference dimension. Be sure to secure the rotary unit in place using the set screws in the locking ring."
    },
    {
      "type": "list_item",
      "id": "txt_1775",
      "reading_order": 2066,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.00464,
        "t": 397.85005000000007,
        "r": 506.6346400000002,
        "b": 386.61005000000006
      },
      "content": "Install the gland, with the stationary seat and gland gaskets installed, on the seal chamber."
    },
    {
      "type": "list_item",
      "id": "txt_1776",
      "reading_order": 2067,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.00461,
        "t": 384.0500600000001,
        "r": 263.94460999999995,
        "b": 372.8100600000001
      },
      "content": "Reinstall the seal chamber."
    },
    {
      "type": "list_item",
      "id": "txt_1777",
      "reading_order": 2068,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.00461,
        "t": 370.2500700000001,
        "r": 313.1946099999999,
        "b": 359.0100700000001
      },
      "content": "Complete the reassembly of the pump."
    },
    {
      "type": "heading",
      "id": "txt_1778",
      "reading_order": 2069,
      "section": "Install the impeller",
      "bbox": {
        "l": 53.99861,
        "t": 350.8450400000001,
        "r": 176.93261,
        "b": 335.2210400000001
      },
      "content": "Install the impeller",
      "level": 2,
      "role": "section"
    },
    {
