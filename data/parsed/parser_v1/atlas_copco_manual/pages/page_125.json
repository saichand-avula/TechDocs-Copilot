      },
      "content": "Procedure",
      "level": 2,
      "role": "section"
    },
    {
      "type": "list_item",
      "id": "txt_0968",
      "reading_order": 1388,
      "section": "Procedure",
      "bbox": {
        "l": 90.5697,
        "t": 751.9214000000001,
        "r": 296.3653999999998,
        "b": 739.7444
      },
      "content": "Stop the compressor. Switch off the voltage."
    },
    {
      "type": "list_item",
      "id": "txt_0969",
      "reading_order": 1389,
      "section": "Procedure",
      "bbox": {
        "l": 90.5697,
        "t": 738.7214,
        "r": 554.3373999999988,
        "b": 713.3444
      },
      "content": "Release the snap clips of air filter (AF) and remove the dust trap and the air filter element. Clean the trap. Discard the filter element."
    },
    {
      "type": "list_item",
      "id": "txt_0970",
      "reading_order": 1390,
      "section": "Procedure",
      "bbox": {
        "l": 90.5697,
        "t": 712.3213999999999,
        "r": 249.12369999999999,
        "b": 700.1443999999999
      },
      "content": "Fit the new element and the trap."
    },
    {
      "type": "list_item",
      "id": "txt_0971",
      "reading_order": 1391,
      "section": "Procedure",
      "bbox": {
        "l": 90.5697,
        "t": 699.1213999999999,
        "r": 444.9534000000008,
        "b": 686.9443999999999
      },
      "content": "Reset service indicator (1) by pushing the knob in the extremity of the body."
    },
    {
      "type": "list_item",
      "id": "txt_0972",
      "reading_order": 1392,
      "section": "Procedure",
      "bbox": {
        "l": 90.5697,
        "t": 685.9213999999998,
        "r": 258.10630000000003,
        "b": 673.7443999999998
      },
      "content": "Reset the air filter service warning."
    },
    {
      "type": "list_item",
      "id": "txt_0973",
      "reading_order": 1393,
      "section": "Procedure",
      "bbox": {
        "l": 110.3697,
        "t": 672.7213999999998,
        "r": 529.6562999999998,
        "b": 660.544
      },
      "content": "For compressors equipped with an Elektronikon® Graphic regulator, see section Service menu."
    },
    {
      "type": "heading",
      "id": "txt_0974",
      "reading_order": 1394,
      "section": "9.2    Coolers",
      "bbox": {
        "l": 56.55,
        "t": 637.2,
        "r": 158.56279999999992,
        "b": 619.344
      },
      "content": "9.2    Coolers",
      "level": 2,
      "role": "section"
    },
    {
      "type": "heading",
      "id": "txt_0975",
      "reading_order": 1395,
      "section": "Cleaning",
      "bbox": {
        "l": 56.55,
        "t": 601.475,
        "r": 102.2715,
        "b": 589.199
      },
      "content": "Cleaning",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_0976",
      "reading_order": 1396,
      "section": "Cleaning",
      "bbox": {
        "l": 90.5697,
        "t": 582.1205,
        "r": 282.6087999999997,
        "b": 569.9435
      },
      "content": "Keep the coolers clean to maintain efficiency."
    },
    {
      "type": "heading",
      "id": "txt_0977",
      "reading_order": 1397,
      "section": "On air-cooled compressors:",
      "bbox": {
        "l": 90.5697,
        "t": 562.92,
        "r": 221.0418000000002,
        "b": 550.7429999999999
      },
      "content": "On air-cooled compressors:",
      "level": 2,
      "role": "section"
    },
    {
      "type": "list_item",
      "id": "txt_0978",
      "reading_order": 1398,
      "section": "On air-cooled compressors:",
      "bbox": {
        "l": 90.5697,
        "t": 545.0284999999999,
        "r": 433.69269999999966,
        "b": 530.6954999999999
      },
      "content": "Stop the compressor, close the air outlet valve and switch off the voltage."
    },
    {
      "type": "list_item",
      "id": "txt_0979",
      "reading_order": 1399,
      "section": "On air-cooled compressors:",
      "bbox": {
        "l": 90.5697,
        "t": 529.8485,
        "r": 249.88380000000015,
        "b": 515.5155
      },
      "content": "Cover all parts under the coolers."
    },
    {
      "type": "list_item",
      "id": "txt_0980",
      "reading_order": 1400,
      "section": "On air-cooled compressors:",
      "bbox": {
        "l": 90.5697,
        "t": 503.44849999999997,
        "r": 502.66929999999854,
        "b": 476.7625
      },
      "content": "Remove any dirt from the coolers with a fibre brush. Brush in the direction of the cooling fins. Also remove any dirt from the fan with a fibre brush."
    },
    {
      "type": "list_item",
      "id": "txt_0981",
      "reading_order": 1401,
      "section": "On air-cooled compressors:",
      "bbox": {
        "l": 90.5697,
        "t": 516.6484999999999,
        "r": 372.13449999999995,
        "b": 502.31549999999993
      },
      "content": "Remove the side baffle that encloses the fan compartment."
    },
    {
      "type": "list_item",
      "id": "txt_0982",
      "reading_order": 1402,
      "section": "On air-cooled compressors:",
      "bbox": {
        "l": 90.5697,
        "t": 477.0485,
        "r": 543.9709999999999,
        "b": 450.3625
      },
      "content": "Then clean with an air jet in the reverse direction to normal flow. Use low pressure air; if necessary the pressure may be increased up to 6 bar(e) ."
    },
    {
      "type": "list_item",
      "id": "txt_0983",
      "reading_order": 1403,
      "section": "On air-cooled compressors:",
      "bbox": {
        "l": 90.5697,
        "t": 437.4485,
        "r": 279.1141000000001,
        "b": 423.1155
      },
      "content": "Remove the cover used during cleaning."
    },
    {
      "type": "list_item",
      "id": "txt_0984",
      "reading_order": 1404,
      "section": "On air-cooled compressors:",
      "bbox": {
        "l": 90.5697,
        "t": 450.6485,
        "r": 466.6541999999996,
        "b": 436.3155
      },
      "content": "If it is necessary to wash the coolers with a cleaning agent, consult Atlas Copco."
    },
    {
      "type": "list_item",
      "id": "txt_0985",
      "reading_order": 1405,
      "section": "On air-cooled compressors:",
      "bbox": {
        "l": 90.5697,
        "t": 424.24850000000004,
        "r": 363.1100999999998,
        "b": 409.9155
      },
      "content": "Mount the side baffle that encloses the fan compartment."
    },
    {
      "type": "heading",
      "id": "txt_0986",
      "reading_order": 1406,
      "section": "On water-cooled compressors:",
      "bbox": {
        "l": 90.5697,
        "t": 402.95910000000003,
        "r": 235.29009999999982,
        "b": 390.78210000000007
      },
      "content": "On water-cooled compressors:",
      "level": 2,
      "role": "section"
    },
    {
      "type": "list_item",
      "id": "txt_0987",
      "reading_order": 1407,
      "section": "On water-cooled compressors:",
      "bbox": {
        "l": 90.5697,
        "t": 384.64850000000007,
        "r": 262.65369999999956,
        "b": 370.31550000000004
      },
      "content": "Consult Atlas Copco about cleaning."
    },
