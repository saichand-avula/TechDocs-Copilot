      "bbox": {
        "l": 139.57,
        "t": 543.4165806999999,
        "r": 536.8079964500001,
        "b": 519.1996168
      },
      "content": "Attention: It is only allowed to turn the handle completely in or out. No in-between position is allowed!",
      "section_id": "sec_auto_932",
      "parent_section_id": "sec_5",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_5",
          "title": "5       Energy recovery (optional)"
        },
        {
