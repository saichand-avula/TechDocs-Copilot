    {
      "type": "paragraph",
      "id": "txt_0137",
      "reading_order": 179,
      "section": "Description",
      "bbox": {
        "l": 62.2297,
        "t": 179.88049999999998,
        "r": 531.7801000000005,
        "b": 141.30349999999999
      },
      "content": "Air drawn through filter (AF) and open inlet valve (IV) into compressor element (E) is compressed. A mix of compressed air and oil flows into the air receiver/oil separator (AR) via check valve (CV). The air is discharged through outlet valve (AV) via minimum pressure valve (Vp) and air cooler (Ca).",
      "section_id": "sec_auto_178",
      "parent_section_id": "sec_2",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_2",
          "title": "2       General description"
        },
