    {
      "type": "paragraph",
      "id": "txt_0933",
      "reading_order": 1342,
      "section": "Roto-Inject Fluid",
      "bbox": {
        "l": 57.67,
        "t": 563.3412999999999,
        "r": 533.9270999999995,
        "b": 498.3642999999998
      },
      "content": "Atlas Copco's Roto-Inject Fluid is a specially developed lubricant for use in single stage oil-injected screw compressors. Its specific composition keeps the compressor in excellent condition. Roto-Inject Fluid can be used for compressors operating at ambient temperatures between 0 °C and 40 °C. If the compressor is regularly operating in ambient temperatures between 40 °C and 46 °C , oil lifetime is reduced significantly. In such case it is recommended to use Roto-Xtend Duty Fluid.",
      "section_id": "sec_auto_1341",
      "parent_section_id": "sec_8",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_8",
          "title": "8       Maintenance"
        },
