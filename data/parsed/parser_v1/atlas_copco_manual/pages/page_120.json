    {
      "type": "paragraph",
      "id": "txt_0935",
      "reading_order": 1344,
      "section": "Roto-Xtend Duty Fluid",
      "bbox": {
        "l": 57.670000000000016,
        "t": 460.02159999999975,
        "r": 524.2811999999992,
        "b": 421.4445999999998
      },
      "content": "Atlas Copco's Roto-Xtend Duty Fluid is a high-quality synthetic lubricant for oil-injected screw compressors which keeps the compressor in excellent condition. Because of its excellent oxidation stability, Roto-Xtend Duty Fluid can be used for compressors operating at ambient temperatures between 0 °C and 46 °C .",
      "section_id": "sec_auto_1343",
      "parent_section_id": "sec_8",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_8",
          "title": "8       Maintenance"
        },
