    },
    {
      "type": "paragraph",
      "id": "txt_0051",
      "reading_order": 71,
      "section": "1.3    Safety precautions during operation",
      "bbox": {
        "l": 101.95,
        "t": 738.541,
        "r": 526.3827999999993,
        "b": 699.9639999999999
      },
      "content": "All responsibility for any damage or injury resulting from neglecting these precautions, or nonobservance of the normal caution and care required for installation, operation, maintenance and repair, even if not expressly stated, will be disclaimed by the manufacturer."
    },
    {
      "type": "heading",
      "id": "txt_0052",
      "reading_order": 72,
      "section": "General precautions",
      "bbox": {
        "l": 28.21,
        "t": 678.215,
        "r": 133.21930000000006,
        "b": 665.939
      },
      "content": "General precautions",
      "level": 2,
      "role": "section"
    },
    {
      "type": "list_item",
      "id": "txt_0053",
      "reading_order": 73,
      "section": "General precautions",
      "bbox": {
        "l": 63.190000000000005,
        "t": 658.4414,
        "r": 536.7355999999993,
        "b": 633.0644
      },
      "content": "The operator must employ safe working practices and observe all related work safety requirements and regulations."
    },
    {
      "type": "list_item",
      "id": "txt_0054",
      "reading_order": 74,
      "section": "General precautions",
      "bbox": {
        "l": 63.19000000000001,
        "t": 632.0414,
        "r": 535.9821000000009,
        "b": 606.6643999999999
      },
      "content": "If any of the following statements does not comply with the applicable legislation, the stricter of the two shall apply."
    },
    {
      "type": "list_item",
      "id": "txt_0055",
      "reading_order": 75,
      "section": "General precautions",
      "bbox": {
        "l": 63.19000000000001,
        "t": 605.6413999999999,
        "r": 514.9688000000011,
        "b": 580.2643999999998
      },
      "content": "Installation, operation, maintenance and repair work must only be performed by authorised, trained, specialised personnel."
    },
    {
      "type": "list_item",
      "id": "txt_0056",
      "reading_order": 76,
      "section": "General precautions",
      "bbox": {
        "l": 63.19000000000001,
        "t": 579.2413999999998,
        "r": 515.7388000000013,
        "b": 540.6643999999997
      },
      "content": "The compressor is not considered capable of producing air of breathing quality. For air of breathing quality, the compressed air must be adequately purified according to the applicable legislation and standards."
    },
    {
      "type": "list_item",
      "id": "txt_0057",
      "reading_order": 77,
      "section": "General precautions",
      "bbox": {
        "l": 63.19000000000001,
        "t": 539.6413999999996,
        "r": 537.5275999999991,
        "b": 501.0643999999996
      },
      "content": "Before any maintenance, repair work, adjustment or any other non-routine checks, stop the compressor, press the emergency stop button, switch off the voltage and depressurise the compressor. In addition, the power isolating switch must be opened and locked."
    },
    {
      "type": "list_item",
      "id": "txt_0058",
      "reading_order": 78,
      "section": "General precautions",
      "bbox": {
        "l": 63.19000000000001,
        "t": 500.04139999999956,
        "r": 518.0179999999988,
        "b": 461.4643999999996
      },
      "content": "Never play with compressed air. Do not apply the air to your skin or direct an air stream at people. Never use the air to clean dirt from your clothes. When using the air to clean equipment, do so with extreme caution and wear eye protection."
    },
    {
      "type": "heading",
      "id": "txt_0059",
      "reading_order": 79,
      "section": "Precautions during operation",
      "bbox": {
        "l": 28.210000000000008,
        "t": 442.7753999999996,
        "r": 178.2324,
        "b": 430.4993999999996
      },
      "content": "Precautions during operation",
      "level": 2,
      "role": "section"
    },
    {
      "type": "list_item",
      "id": "txt_0060",
      "reading_order": 80,
      "section": "Precautions during operation",
      "bbox": {
        "l": 63.19000000000001,
        "t": 423.0611999999996,
        "r": 528.5196999999995,
        "b": 384.48419999999965
      },
      "content": "Use only the correct type and size of hose end fittings and connections. When blowing through a hose or air line, ensure that the open end is held securely. A free end will whip and may cause injury. Make sure that a hose is fully depressurized before disconnecting it."
    },
    {
      "type": "list_item",
      "id": "txt_0061",
      "reading_order": 81,
      "section": "Precautions during operation",
      "bbox": {
        "l": 63.19000000000001,
        "t": 383.4611999999996,
        "r": 536.0062999999997,
        "b": 344.8841999999997
      },
      "content": "Persons switching on remotely controlled machines shall take adequate precautions to ensure that there is no one checking or working on the machine. To this end, a suitable notice shall be affixed to the remote start equipment."
    },
    {
      "type": "list_item",
      "id": "txt_0062",
      "reading_order": 82,
      "section": "Precautions during operation",
      "bbox": {
        "l": 63.19000000000001,
        "t": 343.86119999999966,
        "r": 536.7982999999989,
        "b": 318.48419999999965
      },
      "content": "Never operate the machine when there is a possibility of taking in flammable or toxic fumes, vapours or particles."
    },
    {
      "type": "list_item",
      "id": "txt_0063",
      "reading_order": 83,
      "section": "Precautions during operation",
      "bbox": {
        "l": 62.2308,
        "t": 317.46119999999974,
        "r": 367.27289999999977,
        "b": 305.2841999999997
      },
      "content": "Never operate the machine below or in excess of its limit ratings."
    },
    {
      "type": "list_item",
      "id": "txt_0064",
      "reading_order": 84,
      "section": "Precautions during operation",
      "bbox": {
        "l": 63.1911,
        "t": 304.2611999999997,
        "r": 536.029400000001,
        "b": 278.88419999999974
      },
      "content": "Keep all bodywork doors shut during operation. The doors may be opened for short periods only, e.g. to carry out routine checks. Wear ear protectors when opening a door."
    },
    {
      "type": "list_item",
      "id": "txt_0065",
      "reading_order": 85,
      "section": "Precautions during operation",
      "bbox": {
        "l": 63.191100000000006,
        "t": 277.8611999999997,
        "r": 533.0010999999995,
        "b": 252.48419999999976
      },
      "content": "People staying in environments or rooms where the sound pressure level reaches or exceeds 90 dB(A) shall wear ear protectors."
    },
    {
      "type": "list_item",
      "id": "txt_0066",
      "reading_order": 86,
      "section": "Precautions during operation",
      "bbox": {
        "l": 62.231899999999996,
        "t": 251.46119999999974,
        "r": 181.92950000000002,
        "b": 239.28419999999971
      },
      "content": "Periodically check that:"
    },
    {
      "type": "list_item",
      "id": "txt_0067",
      "reading_order": 87,
      "section": "Precautions during operation",
      "bbox": {
        "l": 80.2323,
        "t": 238.2611999999997,
        "r": 293.73239999999987,
        "b": 226.08419999999978
      },
      "content": "All guards are in place and securely fastened"
    },
    {
      "type": "list_item",
      "id": "txt_0068",
      "reading_order": 88,
      "section": "Precautions during operation",
      "bbox": {
        "l": 80.2323,
        "t": 225.06119999999976,
        "r": 476.7162999999993,
        "b": 212.88419999999974
      },
      "content": "All hoses and/or pipes inside the machine are in good condition, secure and not rubbing"
    },
    {
      "type": "list_item",
      "id": "txt_0069",
      "reading_order": 89,
      "section": "Precautions during operation",
      "bbox": {
        "l": 80.2323,
        "t": 211.86119999999983,
        "r": 177.447,
        "b": 199.6841999999998
      },
      "content": "There are no leaks"
    },
    {
      "type": "list_item",
      "id": "txt_0070",
      "reading_order": 90,
      "section": "Precautions during operation",
      "bbox": {
        "l": 80.2323,
        "t": 198.66119999999978,
        "r": 190.21800000000013,
        "b": 186.48419999999976
      },
      "content": "All fasteners are tight"
    },
    {
      "type": "list_item",
      "id": "txt_0071",
      "reading_order": 91,
      "section": "Precautions during operation",
      "bbox": {
        "l": 80.2323,
        "t": 185.46119999999974,
        "r": 305.75649999999973,
        "b": 173.28419999999983
      },
      "content": "All electrical leads are secure and in good order"
    },
    {
      "type": "list_item",
      "id": "txt_0072",
      "reading_order": 92,
      "section": "Precautions during operation",
      "bbox": {
        "l": 80.2323,
        "t": 172.2611999999998,
        "r": 452.76709999999935,
        "b": 160.08419999999978
      },
      "content": "Safety valves and other pressure-relief devices are not obstructed by dirt or paint"
    },
    {
      "type": "list_item",
      "id": "txt_0073",
      "reading_order": 93,
      "section": "Precautions during operation",
      "bbox": {
        "l": 80.2323,
        "t": 159.06119999999987,
        "r": 518.7296999999992,
        "b": 133.6841999999998
      },
      "content": "Air outlet valve and air net, i.e. pipes, couplings, manifolds, valves, hoses, etc. are in good repair, free of wear or abuse"
    },
    {
      "type": "list_item",
      "id": "txt_0074",
      "reading_order": 94,
      "section": "Precautions during operation",
      "bbox": {
        "l": 63.1922,
        "t": 132.66119999999978,
        "r": 535.2747999999991,
        "b": 107.28419999999983
      },
      "content": "If warm cooling air from compressors is used in air heating systems, e.g. to warm up a workroom, take precautions against air pollution and possible contamination of the breathing air."
    },
    {
      "type": "list_item",
      "id": "txt_0075",
      "reading_order": 95,
      "section": "Precautions during operation",
      "bbox": {
        "l": 61.21,
        "t": 106.26099999999997,
        "r": 376.9580000000001,
        "b": 94.08399999999995
      },
      "content": "Do not remove any of, or tamper with, the sound-damping material."
    }
  ],
