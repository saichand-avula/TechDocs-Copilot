    {
      "type": "paragraph",
      "id": "txt_0120",
      "reading_order": 145,
      "section": "Introduction",
      "bbox": {
        "l": 94.7695,
        "t": 681.3015,
        "r": 544.9565999999994,
        "b": 654.7244000000001
      },
      "content": "GA 37+ up to GA 75 are single-stage, oil-injected screw compressors driven by an electric motor. The compressors are available in air-cooled and water-cooled version."
    },
    {
      "type": "heading",
      "id": "txt_0121",
      "reading_order": 146,
      "section": "GA Workplace",
      "bbox": {
        "l": 56.55,
        "t": 626.2553,
        "r": 130.05310000000006,
        "b": 613.9793
      },
      "content": "GA Workplace",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_0122",
      "reading_order": 147,
      "section": "GA Workplace",
      "bbox": {
        "l": 94.7695,
        "t": 606.4817,
        "r": 536.5734999999993,
        "b": 553.9247999999999
      },
      "content": "GA Workplace are enclosed in a sound-insulated bodywork. The compressors are controlled by the Atlas Copco Elektronikon® regulator. The electronic control module is fitted to the door on the right side. An electric cabinet comprising the motor starter is located behind this panel. A condensate trap with Electronic Water Drain (EWD) is provided."
    },
