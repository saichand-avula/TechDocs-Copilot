      "type": "heading",
      "id": "txt_0820",
      "reading_order": 1183,
      "section": "For remote starting and stopping:",
      "bbox": {
        "l": 82.03,
        "t": 745.6809999999999,
        "r": 240.24299999999994,
        "b": 733.5039999999999
      },
      "content": "For remote starting and stopping:",
      "level": 2,
      "section_id": "sec_auto_1183",
      "section_path": [
        {
          "id": "sec_7",
          "title": "7       Operating instructions"
        },
        {
          "id": "sec_auto_1183",
          "title": "For remote starting and stopping:"
        }
      ],
      "parent_section_id": "sec_7",
      "section_level": 2,
