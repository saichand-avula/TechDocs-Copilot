    {
      "type": "paragraph",
      "id": "txt_0597",
      "reading_order": 915,
      "section": "Low temperature rise/high water flow systems",
      "bbox": {
        "l": 90.5697,
        "t": 365.8214,
        "r": 564.6498999999999,
        "b": 340.44440000000003
      },
      "content": "For this type of application, the temperature difference between the water in the energy recovery system and the compressor oil is low. As a consequence, a high water flow is needed for maximum energy recovery.",
      "section_id": "sec_auto_914",
      "parent_section_id": "sec_5",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_5",
          "title": "5       Energy recovery (optional)"
        },
        {
          "id": "sec_auto_914",
          "title": "Low temperature rise/high water flow systems"
        }
      ],
      "page": 87,
      "chunk_hint": "section_start",
      "semantic_role": "overview",
      "source": "pdf_text"
    },
    {
      "type": "paragraph",
      "id": "txt_0598",
      "reading_order": 916,
      "section": "Low temperature rise/high water flow systems",
      "bbox": {
        "l": 90.5697,
        "t": 333.4209,
        "r": 563.8798999999998,
        "b": 308.0439000000001
      },
      "content": "Example: The heated water is used to keep another medium at a moderately high temperature, in a closed circuit, e.g. central heating.",
      "section_id": "sec_auto_914",
      "parent_section_id": "sec_5",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_5",
          "title": "5       Energy recovery (optional)"
        },
        {
          "id": "sec_auto_914",
          "title": "Low temperature rise/high water flow systems"
        }
      ],
