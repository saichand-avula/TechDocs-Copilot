      "bbox": {
        "l": 56.55,
        "t": 289.35490000000004,
        "r": 287.6006,
        "b": 277.0789
      },
      "content": "High temperature rise/low water flow systems",
      "level": 2,
      "section_id": "sec_auto_917",
      "section_path": [
        {
          "id": "sec_5",
          "title": "5       Energy recovery (optional)"
        },
        {
          "id": "sec_auto_917",
          "title": "High temperature rise/low water flow systems"
        }
      ],
      "parent_section_id": "sec_5",
      "section_level": 2,
