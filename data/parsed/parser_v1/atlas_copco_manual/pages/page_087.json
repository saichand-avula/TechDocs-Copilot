    {
      "type": "heading",
      "id": "txt_0596",
      "reading_order": 914,
      "section": "Low temperature rise/high water flow systems",
      "bbox": {
        "l": 56.55,
        "t": 384.57529999999997,
        "r": 289.794,
        "b": 372.29929999999996
      },
      "content": "Low temperature rise/high water flow systems",
      "level": 2,
      "section_id": "sec_auto_914",
      "section_path": [
        {
          "id": "sec_5",
          "title": "5       Energy recovery (optional)"
        },
        {
          "id": "sec_auto_914",
          "title": "Low temperature rise/high water flow systems"
        }
      ],
      "parent_section_id": "sec_5",
