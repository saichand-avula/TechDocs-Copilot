    {
      "type": "paragraph",
      "id": "txt_0195",
      "reading_order": 270,
      "section": "Compressed air circuit",
      "bbox": {
        "l": 62.2297,
        "t": 173.5809999999999,
        "r": 525.0480999999993,
        "b": 108.60400000000004
      },
      "content": "Compressed air enters heat exchanger (1) and is cooled by the outgoing, cold, dried air. Water in the incoming air starts to condense. The air then flows through heat exchanger/evaporator (2), where the refrigerante vaporates, causing the air to be cooled further to close to the evaporating temperature of the refrigerant. Morewater in the air condenses. The cold air then flows through separator (3) where all the condensate is separated from the air. The condensate is automatically drained through outlet (4).",
      "section_id": "sec_auto_269",
      "parent_section_id": "sec_2",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_2",
          "title": "2       General description"
        },
        {
          "id": "sec_auto_269",
          "title": "Compressed air circuit"
        }
      ],
