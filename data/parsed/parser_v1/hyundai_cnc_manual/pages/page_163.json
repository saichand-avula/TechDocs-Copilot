    },
    {
      "type": "paragraph",
      "id": "txt_1183",
      "reading_order": 1520,
      "section": "3-7-3. Specification",
      "bbox": {
        "l": 127.62000000000006,
        "t": 588.9152720000001,
        "r": 541.4981040000011,
        "b": 512.003744928177
      },
      "content": "Seizing power is different depending on the fueled state, used grease, height of soft jaw. When engaging  the  machine  in  chuck  and  operating  within  the  limit  of  maximum  permissible pressure, the actual seizing power decreases as the speed of spindle increases because of a centrifugal power. These relationships between the speed of spindle, power and seizing power are shown in the following graph. Use the following jaw to obtain the seizing power of chuck.",
      "section_id": "sec_3",
      "parent_section_id": null,
      "section_level": 1,
      "section_path": [
        {
          "id": "sec_3",
          "title": "3-7-3. Specification"
        }
      ],
      "page": 163,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
