    {
      "type": "list_item",
      "id": "txt_0781",
      "reading_order": 1022,
      "section": "2-6-1. Filling and Changing Oil",
      "bbox": {
        "l": 127.62,
        "t": 741.9146599999999,
        "r": 521.1805499999989,
        "b": 733.0429409281768
      },
      "content": "Turn OFF the main power switch in the electric control panel at the rear of machine."
    },
    {
      "type": "list_item",
      "id": "txt_0782",
      "reading_order": 1023,
      "section": "2-6-1. Filling and Changing Oil",
      "bbox": {
        "l": 127.62,
        "t": 724.8746479999999,
        "r": 541.4890860000015,
        "b": 699.0230369281768
      },
      "content": "Disassemble the bolt in the left lower cover and place the collection container under the drain plug installed at the rear of hydraulic unit."
    },
    {
      "type": "list_item",
      "id": "txt_0783",
      "reading_order": 1024,
      "section": "2-6-1. Filling and Changing Oil",
      "bbox": {
        "l": 127.61999999999999,
        "t": 690.914864,
        "r": 356.72529600000075,
        "b": 682.0431449281768
      },
      "content": "Loosen the drain plug and collect hydraulic oil."
    },
    {
      "type": "list_item",
      "id": "txt_0784",
      "reading_order": 1025,
      "section": "2-6-1. Filling and Changing Oil",
      "bbox": {
        "l": 127.62,
        "t": 384.9160880000001,
        "r": 300.4870439999999,
        "b": 359.0043569281769
      },
      "content": "When completed, close the drain plug."
    },
    {
      "type": "list_item",
      "id": "txt_0785",
      "reading_order": 1026,
      "section": "2-6-1. Filling and Changing Oil",
      "bbox": {
        "l": 127.61999999999999,
        "t": 350.8961840000001,
        "r": 300.52612199999993,
        "b": 291.0246689281769
      },
      "content": "Open  the  door  for  repairing  in front  of  the  machine  and  the  oil filter  cap  and  then  supply  the hydraulic oil."
    },
    {
      "type": "list_item",
      "id": "txt_0786",
      "reading_order": 1027,
      "section": "2-6-1. Filling and Changing Oil",
      "bbox": {
        "l": 106.37960399999997,
        "t": 197.8967960000001,
        "r": 210.48439799999997,
        "b": 189.02507692817687
      },
      "content": "Changing Coolant"
    },
