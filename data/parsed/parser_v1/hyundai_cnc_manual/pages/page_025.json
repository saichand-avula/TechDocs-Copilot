    },
    {
      "type": "list_item",
      "id": "txt_0178",
      "reading_order": 218,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 92.21951400000003,
        "t": 650.414756,
        "r": 527.1736860000012,
        "b": 624.5631449281769
      },
      "content": "When cleaning  the  machine,  always  stop  its  operation  turn  OFF  and  then  lock  the  main power.",
      "section_id": "sec_4",
      "parent_section_id": null,
      "section_level": 1,
      "section_path": [
        {
          "id": "sec_4",
          "title": "4. Notice When Repairing and Checking"
        }
      ],
      "page": 25,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0179",
      "reading_order": 219,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 92.21951400000005,
        "t": 463.4555840000002,
        "r": 426.8243880000008,
        "b": 454.583864928177
      },
      "content": "When repairing and cleaning the machine, do not use compressed air.",
      "section_id": "sec_4",
      "parent_section_id": null,
      "section_level": 1,
      "section_path": [
        {
          "id": "sec_4",
          "title": "4. Notice When Repairing and Checking"
        }
      ],
      "page": 25,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0180",
      "reading_order": 220,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 92.21951400000005,
        "t": 276.4362920000002,
        "r": 509.08257599999973,
        "b": 267.564572928177
      },
      "content": "When repairing at a high place, use a proper support or ladder and wear a safety helmet.",
      "section_id": "sec_4",
      "parent_section_id": null,
      "section_level": 1,
      "section_path": [
        {
          "id": "sec_4",
          "title": "4. Notice When Repairing and Checking"
        }
      ],
      "page": 25,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
