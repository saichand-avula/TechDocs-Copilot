      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 92.21951400000006,
        "t": 140.4167960000002,
        "r": 401.95474800000073,
        "b": 131.54507692817697
      },
      "content": "Never operate the machine with the cover removed for repairing.",
      "section_id": "sec_4",
      "parent_section_id": null,
      "section_level": 1,
      "section_path": [
        {
          "id": "sec_4",
          "title": "4. Notice When Repairing and Checking"
        }
      ],
