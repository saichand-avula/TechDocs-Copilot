        "t": 252.67527199999995,
        "r": 314.68355399999945,
        "b": 226.82366092817676
      },
      "content": "Remove oil and water left on the floor to prevent workers from slipping.",
      "section_id": "sec_2",
      "parent_section_id": null,
      "section_level": 1,
      "section_path": [
        {
          "id": "sec_2",
