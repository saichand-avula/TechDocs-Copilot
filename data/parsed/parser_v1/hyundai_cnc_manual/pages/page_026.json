        "b": 737.1623611450195
      },
      "image_path": "figures/figure_0043.png",
      "next_block_id": "txt_0183",
      "image_hash": "51f34d3bf0a2ac6ea9524e7e0265738353f26c8031341fbb8ef2f3dcc05c24eb",
      "width": 117,
      "height": 34
    },
    {
      "type": "list_item",
      "id": "txt_0183",
      "reading_order": 228,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 99.299646,
        "t": 718.6947680000001,
        "r": 314.72463599999986,
        "b": 692.7830369281769
      },
      "content": "Before repairing, completely read the installation and Maintenance Manual."
    },
    {
      "type": "list_item",
      "id": "txt_0184",
      "reading_order": 229,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 99.299646,
        "t": 684.6748640000001,
        "r": 314.73666000000026,
        "b": 658.823252928177
      },
      "content": "Keep  enough  parts  in  stock  for  repairing and replacing."
    },
    {
      "type": "list_item",
      "id": "txt_0185",
      "reading_order": 230,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 99.299646,
        "t": 650.6549600000001,
        "r": 314.75168999999994,
        "b": 607.823456928177
      },
      "content": "The person who responsible for maintenance  should  obey  the  instructions on the machine."
    },
    {
      "type": "list_item",
      "id": "txt_0186",
      "reading_order": 231,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 99.299646,
        "t": 599.6551640000001,
        "r": 314.7096060000001,
        "b": 556.8236609281771
      },
      "content": "Clean  the  machine  after  a  completion  of daily  work  to  make  it  easier  to  find  out anything wrong."
    },
    {
      "type": "list_item",
      "id": "txt_0187",
      "reading_order": 232,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 99.299646,
        "t": 548.6553680000002,
        "r": 268.33905000000016,
        "b": 539.7836489281771
      },
      "content": "When repairing, record the work."
    },
    {
      "type": "list_item",
      "id": "txt_0188",
      "reading_order": 233,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 99.299646,
        "t": 463.6957880000003,
        "r": 314.76772199999965,
        "b": 420.80416492817704
      },
      "content": "Do  not  attempt  to  remodel  the  device  or electric circuit such as the limit switches for stoke limit, of interlock of the machine."
    },
    {
      "type": "list_item",
      "id": "txt_0189",
      "reading_order": 234,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 99.299646,
        "t": 412.6959920000003,
        "r": 314.7436739999999,
        "b": 386.78426092817705
      },
      "content": "Check  each  gage  indicates its normal value."
    },
    {
      "type": "list_item",
      "id": "txt_0190",
      "reading_order": 235,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 99.299646,
        "t": 378.6760880000003,
        "r": 314.7045960000002,
        "b": 352.82447692817703
      },
      "content": "Check  the  lubricating  oil  is  supplied  for each wet moving part."
    },
    {
      "type": "list_item",
      "id": "txt_0191",
      "reading_order": 236,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 99.299646,
        "t": 344.6561840000003,
        "r": 314.689566,
        "b": 318.8045729281771
      },
      "content": "Only use the specified hydraulic and lubricating oils and greases in this manual."
    },
    {
      "type": "list_item",
      "id": "txt_0192",
      "reading_order": 237,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 92.220516,
        "t": 310.69640000000027,
        "r": 317.19757200000004,
        "b": 301.82468092817703
      },
      "content": "When cleaning the chip, always wear glove."
    },
    {
      "type": "list_item",
      "id": "txt_0193",
      "reading_order": 238,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 92.220516,
        "t": 293.65638800000033,
        "r": 486.19789800000126,
        "b": 284.7846689281771
      },
      "content": "Filling and changing oil should be performed periodically according to this manual."
    },
    {
      "type": "list_item",
      "id": "txt_0194",
      "reading_order": 239,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 92.220516,
        "t": 276.67649600000027,
        "r": 527.2628639999997,
        "b": 250.82488492817697
      },
      "content": "Apply  each  part  with  rust-proof  oil  after  a  completion  of  work,  especially  if  using  the solvable coolant."
    },
    {
      "type": "list_item",
      "id": "txt_0195",
      "reading_order": 240,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 92.22151799999997,
        "t": 242.65659200000027,
        "r": 476.28811799999994,
        "b": 233.78487292817704
      },
      "content": "Use the specified spanner or wrench when adjusting and repairing the machine."
    },
