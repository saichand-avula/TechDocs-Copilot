        "t": 408.43466,
        "r": 527.1538319999981,
        "b": 382.58304892817677
      },
      "content": "Failure to comply may result in personal light injury or damage to the machine.",
      "section_id": "sec_1",
      "parent_section_id": null,
      "section_level": 1,
      "section_path": [
        {
          "id": "sec_1",
