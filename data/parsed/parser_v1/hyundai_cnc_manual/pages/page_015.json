        "t": 599.4146599999999,
        "r": 458.13688799999886,
        "b": 590.5429409281768
      },
      "content": "Failure to comply may result in personal death.",
      "section_id": "sec_1",
      "parent_section_id": null,
      "section_level": 1,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1. General"
        }
      ],
      "page": 15,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "paragraph",
      "id": "txt_0115",
      "reading_order": 125,
      "section": "1. General",
      "bbox": {
        "l": 248.09966999999997,
        "t": 512.41466,
        "r": 527.1566699999997,
        "b": 486.5630489281768
      },
      "content": "Failure to comply may result in personal severe injury or lethal damage to the machine.",
      "section_id": "sec_1",
      "parent_section_id": null,
      "section_level": 1,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1. General"
        }
      ],
      "page": 15,
      "chunk_hint": "continue",
      "semantic_role": "description",
