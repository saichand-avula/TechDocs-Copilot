    },
    {
      "type": "list_item",
      "id": "txt_0348",
      "reading_order": 455,
      "section": "4. Installation",
      "bbox": {
        "l": 78.00013200000001,
        "t": 673.6947680000001,
        "r": 513.1466879999997,
        "b": 647.843156928177
      },
      "content": "Before  installing  the  machine,  read  and  understand  the  safety  notice  thoroughly  in  this manual."
    },
    {
      "type": "list_item",
      "id": "txt_0349",
      "reading_order": 456,
      "section": "4. Installation",
      "bbox": {
        "l": 78.00113400000002,
        "t": 639.6748640000001,
        "r": 513.1917779999998,
        "b": 613.823252928177
      },
      "content": "While installing, there should be no oil or water on the floor to prevent the workers from slipping."
    },
    {
      "type": "list_item",
      "id": "txt_0350",
      "reading_order": 457,
      "section": "4. Installation",
      "bbox": {
        "l": 78.00213600000002,
        "t": 605.7150800000002,
        "r": 372.53101799999996,
        "b": 596.843360928177
      },
      "content": "Before working, check again it is installed at a proper place."
    },
    {
      "type": "heading",
      "id": "txt_0351",
      "reading_order": 458,
      "section": "4-1. Preparation to Install 4-1-1. Installation Condition",
      "bbox": {
        "l": 70.92,
        "t": 547.394768,
        "r": 335.41493400000024,
        "b": 538.5230489281769
      },
      "content": "4-1. Preparation to Install 4-1-1. Installation Condition",
      "level": 2,
      "role": "section"
    },
    {
      "type": "list_item",
      "id": "txt_0352",
      "reading_order": 459,
      "section": "4-1. Preparation to Install 4-1-1. Installation Condition",
      "bbox": {
        "l": 99.299646,
        "t": 513.374864,
        "r": 347.334726,
        "b": 504.50314492817677
      },
      "content": "When installing the machine, avoid places as below."
    },
    {
      "type": "list_item",
      "id": "txt_0353",
      "reading_order": 460,
      "section": "4-1. Preparation to Install 4-1-1. Installation Condition",
      "bbox": {
        "l": 113.45991,
        "t": 479.35496,
        "r": 497.4794159999999,
        "b": 470.48324092817677
      },
      "content": "Under direct ray of sun and near by heating elements and where the indoor temp."
    },
    {
      "type": "list_item",
      "id": "txt_0354",
      "reading_order": 461,
      "section": "4-1. Preparation to Install 4-1-1. Installation Condition",
      "bbox": {
        "l": 113.45991,
        "t": 462.375068,
        "r": 294.19064999999983,
        "b": 453.50334892817676
      },
      "content": "Heavy dust and high humidity area."
    },
    {
      "type": "list_item",
      "id": "txt_0355",
      "reading_order": 462,
      "section": "4-1. Preparation to Install 4-1-1. Installation Condition",
      "bbox": {
        "l": 113.45991,
        "t": 445.395176,
        "r": 259.7448960000001,
        "b": 436.52345692817676
      },
      "content": "Near the vibrating machine."
    },
    {
      "type": "list_item",
      "id": "txt_0356",
      "reading_order": 463,
      "section": "4-1. Preparation to Install 4-1-1. Installation Condition",
      "bbox": {
        "l": 113.45991,
        "t": 428.355164,
        "r": 255.29200800000024,
        "b": 419.48344492817677
      },
      "content": "Where foundation is weak."
    },
    {
      "type": "list_item",
      "id": "txt_0357",
      "reading_order": 464,
      "section": "4-1. Preparation to Install 4-1-1. Installation Condition",
      "bbox": {
        "l": 113.45991,
        "t": 411.375272,
        "r": 287.476248,
        "b": 402.50355292817676
      },
      "content": "Where ground uneven or inclined."
    },
    {
      "type": "list_item",
      "id": "txt_0358",
      "reading_order": 465,
      "section": "4-1. Preparation to Install 4-1-1. Installation Condition",
      "bbox": {
        "l": 78.0,
        "t": 320.4147680000001,
        "r": 513.057378,
        "b": 294.5030369281768
      },
      "content": "If  you  have  to  install  the  machine  around  vibrating  objects,  install  the  suck  absorbing  pad around it."
    },
    {
      "type": "list_item",
      "id": "txt_0359",
      "reading_order": 466,
      "section": "4-1. Preparation to Install 4-1-1. Installation Condition",
      "bbox": {
        "l": 77.99999999999999,
        "t": 286.3948640000001,
        "r": 513.1275179999999,
        "b": 260.5432529281768
      },
      "content": "It is required to prepare space for maintenance, if optional accessory was attached (See Fig. 4-1)."
    },
