        "t": 405.67476800000003,
        "r": 326.51717399999967,
        "b": 396.8030489281768
      },
      "content": "Do not touch kinds of switch with wet hands.",
      "section_id": "sec_2",
      "parent_section_id": null,
      "section_level": 1,
      "section_path": [
        {
          "id": "sec_2",
