    {
      "type": "heading",
      "id": "txt_0461",
      "reading_order": 524,
      "section": "Electrical Shock Hazard",
      "bbox": {
        "l": 108.8817,
        "t": 615.1351318,
        "r": 219.65509379999995,
        "b": 606.4576174112266
      },
      "content": "Electrical Shock Hazard",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_0462",
      "reading_order": 525,
      "section": "Electrical Shock Hazard",
      "bbox": {
        "l": 47.496161699999995,
        "t": 599.9914768,
        "r": 254.8763043,
        "b": 581.0553574112266
      },
      "content": "Only authorized technicians should perform diagnostic voltage measurements."
    },
    {
      "type": "paragraph",
      "id": "txt_0463",
      "reading_order": 526,
      "section": "Electrical Shock Hazard",
      "bbox": {
        "l": 47.496161699999995,
        "t": 574.5892168,
        "r": 238.59931769999994,
        "b": 555.6530974112267
      },
      "content": "After performing voltage measurements, disconnect power before servicing."
    },
    {
      "type": "paragraph",
      "id": "txt_0464",
      "reading_order": 527,
      "section": "Electrical Shock Hazard",
      "bbox": {
        "l": 47.496161699999995,
        "t": 549.1869568000001,
        "r": 272.26708229999997,
        "b": 530.2508374112267
      },
      "content": "Failure to follow these instructions can result in death or electrical shock."
    },
    {
      "type": "heading",
      "id": "txt_0465",
      "reading_order": 528,
      "section": "Water Inlet Valve",
      "bbox": {
        "l": 36.75,
        "t": 502.112,
        "r": 150.87800000000001,
        "b": 489.9393613445378
      },
      "content": "Water Inlet Valve",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_0466",
      "reading_order": 529,
      "section": "Water Inlet Valve",
      "bbox": {
        "l": 36.75,
        "t": 472.32,
        "r": 266.21999999999997,
        "b": 454.7121008403361
      },
      "content": "This test will check the wiring and components in the fill circuit. The following items are part of the fill circuit."
    },
    {
      "type": "list_item",
      "id": "txt_0467",
      "reading_order": 530,
      "section": "Water Inlet Valve",
      "bbox": {
        "l": 36.75,
        "t": 450.54,
        "r": 132.57,
        "b": 441.2303225806452
      },
      "content": "  Harness/Connection"
    },
    {
      "type": "list_item",
      "id": "txt_0468",
      "reading_order": 531,
      "section": "Water Inlet Valve",
      "bbox": {
        "l": 36.75,
        "t": 437.54,
        "r": 119.16000000000003,
        "b": 428.2303225806452
      },
      "content": "  Water Inlet Valve"
    },
    {
      "type": "list_item",
      "id": "txt_0469",
      "reading_order": 532,
      "section": "Water Inlet Valve",
      "bbox": {
        "l": 36.75,
        "t": 424.54,
        "r": 106.11999999999999,
        "b": 415.2303225806452
      },
      "content": "  Control Board"
    },
    {
      "type": "heading",
      "id": "txt_0470",
      "reading_order": 533,
      "section": "Test Procedure",
      "bbox": {
        "l": 36.75,
        "t": 393.584,
        "r": 110.28600000000003,
        "b": 384.4545210084034
      },
      "content": "Test Procedure",
      "level": 2,
      "role": "section"
    },
    {
      "type": "list_item",
      "id": "txt_0471",
      "reading_order": 534,
      "section": "Test Procedure",
      "bbox": {
        "l": 42.75,
        "t": 379.32,
        "r": 290.32000000000005,
        "b": 331.7121008403361
      },
      "content": "Verify water supply is turned on and supply line is adequate. Check for water siphoning out of the dishwasher (improper drain connection). Check for debris in water line or fill valve inlet screen. Check for proper float switch operation. Repair as necessary."
    },
    {
      "type": "list_item",
      "id": "txt_0472",
      "reading_order": 535,
      "section": "Test Procedure",
      "bbox": {
        "l": 42.75,
        "t": 326.32,
        "r": 221.55999999999997,
        "b": 318.7121008403361
      },
      "content": "Unplug dishwasher or disconnect power."
    },
    {
      "type": "list_item",
      "id": "txt_0473",
      "reading_order": 536,
      "section": "Test Procedure",
      "bbox": {
        "l": 42.75,
        "t": 313.32,
        "r": 273.16,
        "b": 295.7121008403361
      },
      "content": "Remove access panel. Remove control board cover to access control board."
    },
    {
      "type": "list_item",
      "id": "txt_0474",
      "reading_order": 537,
      "section": "Test Procedure",
      "bbox": {
        "l": 42.75,
        "t": 290.32,
        "r": 230.48370000000003,
        "b": 282.7121008403361
      },
      "content": "Unplug connector CN5 from control board."
    },
    {
      "type": "list_item",
      "id": "txt_0475",
      "reading_order": 538,
      "section": "Test Procedure",
      "bbox": {
        "l": 42.75,
        "t": 277.31999999999994,
        "r": 281.87,
        "b": 259.7121008403361
      },
      "content": "Check the inlet valve and harness-using an ohmmeter, measure the resistance between CN5-1 and CN5-2."
    },
    {
      "type": "list_item",
      "id": "txt_0476",
      "reading_order": 539,
      "section": "Test Procedure",
      "bbox": {
        "l": 50.75,
        "t": 255.53999999999996,
        "r": 283.4,
        "b": 236.71210084033612
      },
      "content": "¾ ¾ If the resistance is approximately 24 ohms, the water inlet valve and harness are good. Go to step 7."
    },
    {
      "type": "heading",
      "id": "txt_0477",
      "reading_order": 540,
      "section": "STRIP CIRCUIT - WATER INLET VALVE WATER INLET VALVE",
      "bbox": {
        "l": 6.9348,
        "t": 226.36411999999996,
        "r": 215.51429999999993,
        "b": 209.64192100840341
      },
      "content": "STRIP CIRCUIT - WATER INLET VALVE WATER INLET VALVE",
      "level": 2,
      "role": "section"
    },
    {
      "type": "figure",
      "id": "fig_0051",
      "reading_order": 541,
      "section": "STRIP CIRCUIT - WATER INLET VALVE WATER INLET VALVE",
      "bbox": {
