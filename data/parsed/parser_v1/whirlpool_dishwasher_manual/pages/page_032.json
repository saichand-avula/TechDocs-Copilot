      "figure_number": "Figure 1",
      "image_hash": "d270354af4f9f8a40bf111f153160790ade809793df01e76fef93dd58f8be079",
      "width": 257,
      "height": 154
    },
    {
      "type": "caption",
      "id": "txt_0484",
      "reading_order": 549,
      "section": "STRIP CIRCUIT - WATER INLET VALVE WATER INLET VALVE",
      "bbox": {
        "l": 380.1445,
        "t": 504.0149,
        "r": 481.60149999999993,
        "b": 497.16779075630257
      },
      "content": "Figure 1 - Water Inlet Valve",
      "caption_for": "fig_0052"
    },
    {
      "type": "admonition",
      "id": "txt_0485",
      "reading_order": 550,
      "section": "STRIP CIRCUIT - WATER INLET VALVE WATER INLET VALVE",
      "bbox": {
        "l": 321.375,
        "t": 406.6469,
        "r": 560.1949999999997,
        "b": 389.03900084033614
      },
      "content": "IMPORTANT: The Water Inlet Valve must be connected to the control board to measure voltage accurately!!!",
      "severity": "important"
    },
    {
      "type": "list_item",
      "id": "txt_0486",
      "reading_order": 551,
      "section": "STRIP CIRCUIT - WATER INLET VALVE WATER INLET VALVE",
      "bbox": {
        "l": 317.375,
        "t": 384.86690000000004,
        "r": 548.1150000000001,
        "b": 366.03900084033614
      },
      "content": "¾ ¾ If 12 VDC is not measured, replace the control board and retest."
    },
    {
      "type": "list_item",
      "id": "txt_0487",
      "reading_order": 552,
      "section": "STRIP CIRCUIT - WATER INLET VALVE WATER INLET VALVE",
      "bbox": {
        "l": 317.375,
        "t": 361.86690000000004,
        "r": 519.4550000000002,
        "b": 343.03900084033614
      },
      "content": "¾ ¾ If 12 VDC is measured and water inlet valve is energized, go to step 9."
    },
    {
      "type": "list_item",
      "id": "txt_0488",
      "reading_order": 553,
      "section": "STRIP CIRCUIT - WATER INLET VALVE WATER INLET VALVE",
      "bbox": {
        "l": 309.375,
        "t": 337.6469,
        "r": 533.4050000000002,
        "b": 320.03900084033614
      },
      "content": "Check water level switch, harness, and connections. Replace or repair as necessary."
    },
    {
      "type": "list_item",
      "id": "txt_0489",
      "reading_order": 554,
      "section": "STRIP CIRCUIT - WATER INLET VALVE WATER INLET VALVE",
      "bbox": {
        "l": 304.375,
        "t": 314.6469,
        "r": 488.3650000000001,
        "b": 307.03900084033614
      },
      "content": "Unplug dishwasher or disconnect power."
    },
    {
      "type": "list_item",
      "id": "txt_0490",
      "reading_order": 555,
      "section": "STRIP CIRCUIT - WATER INLET VALVE WATER INLET VALVE",
      "bbox": {
        "l": 304.375,
        "t": 301.6469,
        "r": 455.44500000000033,
        "b": 294.03900084033614
      },
      "content": "Reassemble all parts and panels."
    },
    {
      "type": "list_item",
      "id": "txt_0491",
      "reading_order": 556,
      "section": "STRIP CIRCUIT - WATER INLET VALVE WATER INLET VALVE",
      "bbox": {
        "l": 304.375,
        "t": 288.6469,
        "r": 546.8350000000003,
        "b": 271.03900084033614
      },
      "content": "Plug in dishwasher or reconnect power and run Service Mode Test to verify repair."
    }
  ],
