    {
      "type": "paragraph",
      "id": "txt_0748",
      "reading_order": 838,
      "section": "Drain Pump",
      "bbox": {
        "l": 36.0,
        "t": 472.68,
        "r": 285.1038,
        "b": 415.07210084033613
      },
      "content": "The drain pump is located under the tub and operates on 120 VAC. It is energized for the first 60 seconds of a new cycle and 90 seconds after the wash pump shuts down to remove any water in the dishwasher sump. The drain pump forces water out of the drain line. A check valve flapper on the drain pump prevents the dirty water from reentering the sump.",
      "section_id": "sec_auto_837",
      "parent_section_id": "sec_24",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_24",
          "title": "24' Product and Cabinet Opening Dimensions PRODUCT AND CABINET OPENING DIMENSIONS:"
        },
        {
          "id": "sec_auto_837",
          "title": "Drain Pump"
        }
      ],
      "page": 40,
      "chunk_hint": "section_start",
      "semantic_role": "overview",
      "source": "pdf_text"
    },
    {
      "type": "paragraph",
      "id": "txt_0749",
