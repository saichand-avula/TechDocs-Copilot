      "bbox": {
        "l": 42.375,
        "t": 440.64,
        "r": 266.6449999999998,
        "b": 433.0321008403361
      },
      "content": "Disconnect both dispenser harnesses (see Figure 1).",
      "hyperlink_hint": true,
      "section_id": "sec_auto_979",
      "parent_section_id": "sec_24",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_24",
