      "bbox": {
        "l": 42.375,
        "t": 216.64,
        "r": 293.0249999999999,
        "b": 189.03210084033617
      },
      "content": "To remove the dispenser assembly, use a flat-blade screwdriver to move out the ten (10) snap clips, then push in to disengage from bracket. See Figure 2.",
      "hyperlink_hint": true,
      "section_id": "sec_auto_979",
      "parent_section_id": "sec_24",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_24",
