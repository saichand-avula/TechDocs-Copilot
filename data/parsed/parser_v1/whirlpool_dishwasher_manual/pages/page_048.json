    },
    {
      "type": "list_item",
      "id": "txt_0877",
      "reading_order": 984,
      "section": "Remove Dispenser Assembly",
      "bbox": {
        "l": 309.1875,
        "t": 697.3969000000001,
        "r": 549.3375000000002,
        "b": 679.7890008403361
      },
      "content": "To reinstall the dispenser, press in the ten (10) snap clips inward as shown in Figure 3.",
      "section_id": "sec_auto_979",
      "parent_section_id": "sec_24",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_24",
