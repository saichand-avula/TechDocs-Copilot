      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0624",
      "reading_order": 701,
      "section": "Test Procedure",
      "bbox": {
        "l": 309.0,
        "t": 535.32,
        "r": 555.3900000000002,
        "b": 507.7121008403361
      },
      "content": "Lay the dishwasher on its back. Use a small flat-blade screwdriver to unclip snaps around the drip-pan. Remove drip-pan/float switch to access under tub components.",
      "section_id": "sec_auto_693",
      "parent_section_id": "sec_24",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_24",
          "title": "24' Product and Cabinet Opening Dimensions PRODUCT AND CABINET OPENING DIMENSIONS:"
