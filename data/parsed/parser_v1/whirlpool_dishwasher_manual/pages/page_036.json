      "bbox": {
        "l": 309.0,
        "t": 502.32,
        "r": 488.45959999999997,
        "b": 494.7121008403361
      },
      "content": "Disconnect CN4 from the Control Board.",
      "section_id": "sec_auto_693",
      "parent_section_id": "sec_24",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_24",
          "title": "24' Product and Cabinet Opening Dimensions PRODUCT AND CABINET OPENING DIMENSIONS:"
