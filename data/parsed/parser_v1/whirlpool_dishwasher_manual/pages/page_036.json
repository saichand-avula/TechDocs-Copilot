      "bbox": {
        "l": 309.0,
        "t": 571.32,
        "r": 485.5500000000002,
        "b": 563.7121008403361
      },
      "content": "Unplug dishwasher or disconnect power.",
      "section_id": "sec_auto_693",
      "parent_section_id": "sec_24",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_24",
