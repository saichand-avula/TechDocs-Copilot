        },
        {
          "id": "sec_auto_1016",
          "title": "Remove the Air Breaker Assembly"
        }
      ],
      "page": 50,
      "chunk_hint": "section_start",
      "semantic_role": "overview",
      "source": "pdf_text"
    },
    {
