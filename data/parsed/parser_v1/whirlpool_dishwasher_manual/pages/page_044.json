    {
      "type": "list_item",
      "id": "txt_0834",
      "reading_order": 929,
      "section": "To remove the tub seal or trim:",
      "bbox": {
        "l": 309.0,
        "t": 706.6469000000001,
        "r": 548.8400000000001,
        "b": 689.0390008403361
      },
      "content": "Remove the 2 screws (as indicated in Figure 2) and then pull the trim straight off the lip of the tub.",
      "section_id": "sec_auto_926",
      "parent_section_id": "sec_24",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_24",
          "title": "24' Product and Cabinet Opening Dimensions PRODUCT AND CABINET OPENING DIMENSIONS:"
        },
        {
          "id": "sec_auto_926",
          "title": "To remove the tub seal or trim:"
        }
      ],
      "page": 44,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0835",
      "reading_order": 930,
      "section": "To remove the tub seal or trim:",
      "bbox": {
        "l": 309.0,
        "t": 319.6469,
        "r": 558.5700000000004,
        "b": 259.03900084033614
      },
      "content": "Reverse the above procedures to reinstall. NOTE: When installing the tub seal, make sure it is seated properly in the seal channel. Run your finger over the seal to make sure it is smooth and even for a proper seal. A correctly installed gasket will have both ends of the gasket equally distant from the bottom of the tub.",
