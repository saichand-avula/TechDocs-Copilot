        "r": 163.37000000000003,
        "b": 632.5390008403361
      },
      "content": "Open the dishwasher door.",
      "section_id": "sec_auto_926",
      "parent_section_id": "sec_24",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_24",
