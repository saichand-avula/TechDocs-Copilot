    {
      "type": "list_item",
      "id": "txt_0833",
      "reading_order": 928,
      "section": "To remove the tub seal or trim:",
      "bbox": {
        "l": 42.0,
        "t": 627.1469000000001,
        "r": 293.13480000000004,
        "b": 609.5390008403361
      },
      "content": "Remove the dishwasher tub seal by grasping one end of the seal to peel it away from the seal channel (see Figure 1).",
      "hyperlink_hint": true,
      "section_id": "sec_auto_926",
      "parent_section_id": "sec_24",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_24",
