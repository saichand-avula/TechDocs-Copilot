    },
    {
      "type": "paragraph",
      "id": "txt_0638",
      "reading_order": 718,
      "section": "Overflow Switch",
      "bbox": {
        "l": 54.625,
        "t": 250.20000000000005,
        "r": 308.27500000000003,
        "b": 232.59210084033612
      },
      "content": "The overflow switch is a normally closed switch that is used to detect a possible overflow condition.  If water drips onto the"
    },
    {
      "type": "paragraph",
      "id": "txt_0639",
      "reading_order": 719,
      "section": "Overflow Switch",
      "bbox": {
        "l": 20.9993,
        "t": 217.95608000000004,
        "r": 118.00529999999999,
        "b": 207.14100652840398
      },
      "content": "OVERFLOW SWITCH"
    },
    {
      "type": "heading",
      "id": "txt_0640",
      "reading_order": 720,
      "section": "STRIP CIRCUIT - OVERFLOW SWITCH",
      "bbox": {
        "l": 54.625,
        "t": 206.8139,
        "r": 232.62099999999998,
        "b": 197.68442100840332
      },
      "content": "STRIP CIRCUIT - OVERFLOW SWITCH",
      "level": 2,
      "role": "section"
    },
    {
      "type": "figure",
      "id": "fig_0067",
      "reading_order": 721,
      "section": "STRIP CIRCUIT - OVERFLOW SWITCH",
      "bbox": {
        "l": 84.45047760009766,
        "t": 184.2445068359375,
        "r": 545.2740478515625,
        "b": 73.792724609375
      },
      "image_path": "figures/figure_0067.png",
