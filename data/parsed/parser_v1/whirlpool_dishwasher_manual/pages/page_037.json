      "image_hash": "ef2d25ebef8487f204b84e90866d1d6594b9f24d80c635ac8bfb8d5519499c23",
      "width": 461,
      "height": 110
    },
    {
      "type": "caption",
      "id": "txt_0641",
      "reading_order": 722,
      "section": "STRIP CIRCUIT - OVERFLOW SWITCH",
      "bbox": {
        "l": 266.3079,
        "t": 61.93799999999999,
        "r": 363.32789999999994,
        "b": 55.09089075630254
      },
      "content": "Figure 2 - Overflow Circuit",
      "caption_for": "fig_0067"
    },
    {
      "type": "paragraph",
      "id": "txt_0642",
      "reading_order": 723,
      "section": "STRIP CIRCUIT - OVERFLOW SWITCH",
      "bbox": {
        "l": 321.0,
        "t": 706.82,
        "r": 577.5300000000003,
        "b": 669.2121008403361
      },
      "content": "drip pan, the water will lift the foam float and open the switch. This will signal the control to shut off the water inlet valve and activate the drain pump. An 'E4' Overflow Error Code will be generated."
    },
    {
      "type": "admonition",
      "id": "txt_0643",
      "reading_order": 724,
      "section": "STRIP CIRCUIT - OVERFLOW SWITCH",
      "bbox": {
        "l": 321.0,
        "t": 663.82,
        "r": 556.06,
        "b": 646.2121008403361
      },
      "content": "NOTE : If the overflow switch is disconnected or open, the dishwasher will not start a cycle or perform diagnostics.",
      "severity": "note"
    },
    {
      "type": "heading",
      "id": "txt_0644",
      "reading_order": 725,
      "section": "Test Procedure",
      "bbox": {
        "l": 321.0,
        "t": 624.084,
        "r": 394.53600000000006,
        "b": 614.9545210084034
      },
      "content": "Test Procedure",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_0645",
      "reading_order": 726,
      "section": "Test Procedure",
      "bbox": {
        "l": 321.0,
        "t": 609.82,
        "r": 563.5000000000002,
        "b": 582.2121008403361
      },
      "content": "This test will check the wiring to the Overflow Switch, the switch itself, and the control board. The following items are part of the Overflow circuit."
    },
    {
      "type": "list_item",
      "id": "txt_0646",
      "reading_order": 727,
      "section": "Test Procedure",
      "bbox": {
        "l": 321.0,
        "t": 578.04,
        "r": 416.8200000000001,
        "b": 568.7303225806452
      },
      "content": "  Harness/Connection"
    },
    {
      "type": "list_item",
      "id": "txt_0647",
      "reading_order": 728,
      "section": "Test Procedure",
      "bbox": {
        "l": 321.0,
        "t": 565.04,
        "r": 400.09999999999997,
        "b": 555.7303225806452
      },
      "content": "  Overflow Switch"
    },
    {
      "type": "list_item",
      "id": "txt_0648",
      "reading_order": 729,
      "section": "Test Procedure",
      "bbox": {
        "l": 321.0,
        "t": 552.04,
        "r": 390.37,
        "b": 542.7303225806452
      },
      "content": "  Control Board"
    },
    {
      "type": "list_item",
      "id": "txt_0649",
      "reading_order": 730,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 524.82,
        "r": 503.5500000000002,
        "b": 517.2121008403361
      },
      "content": "Unplug dishwasher or disconnect power."
    },
    {
      "type": "list_item",
      "id": "txt_0650",
      "reading_order": 731,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 511.82,
        "r": 557.4100000000001,
        "b": 494.2121008403361
      },
      "content": "Remove access panel. Remove control board cover to access control board."
    },
    {
      "type": "list_item",
      "id": "txt_0651",
      "reading_order": 732,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 488.82,
        "r": 569.5000000000001,
        "b": 461.2121008403361
      },
      "content": "Lay the dishwasher on its back. Use a small flat-blade screwdriver to unclip snaps around the drip-pan. Pull away drip-pan but keep float switch harness connected."
    },
    {
      "type": "list_item",
      "id": "txt_0652",
      "reading_order": 733,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 455.82,
        "r": 506.45959999999997,
        "b": 448.2121008403361
      },
      "content": "Disconnect CN4 from the Control Board."
    },
    {
      "type": "list_item",
      "id": "txt_0653",
      "reading_order": 734,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 442.82,
        "r": 575.0800000000002,
        "b": 415.2121008403361
      },
      "content": "Check the overflow switch-using an ohmmeter, measure the resistance between CN4-2 and CN4-3 with the overflow switch closed/float down (normal position)."
    },
    {
      "type": "list_item",
      "id": "txt_0654",
      "reading_order": 735,
      "section": "Test Procedure",
      "bbox": {
        "l": 335.0,
        "t": 411.04,
        "r": 523.0200000000002,
        "b": 401.7303225806452
      },
      "content": "¾ ¾ If 3 ohms or less is measured, go to step 6."
    },
    {
      "type": "list_item",
      "id": "txt_0655",
      "reading_order": 736,
      "section": "Test Procedure",
      "bbox": {
        "l": 335.0,
        "t": 398.04,
        "r": 574.5000000000002,
        "b": 359.2121008403361
      },
      "content": "¾ ¾ If an open circuit or high resistance is measured, check connections and harness continuity between the control board and overflow switch. If harness is good, replace switch and retest."
    },
    {
      "type": "list_item",
      "id": "txt_0656",
      "reading_order": 737,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 353.82,
        "r": 572.0399999999998,
        "b": 336.2121008403361
      },
      "content": "Using an ohmmeter; measure the resistance between CN4-2 and CN4-3 with the overflow switch open/float up."
    },
    {
      "type": "list_item",
      "id": "txt_0657",
      "reading_order": 738,
      "section": "Test Procedure",
      "bbox": {
        "l": 335.0,
        "t": 332.04,
        "r": 483.5700000000001,
        "b": 322.7303225806452
      },
      "content": "¾ ¾ If reading is infinite, go to step 7."
    },
    {
      "type": "list_item",
      "id": "txt_0658",
      "reading_order": 739,
      "section": "Test Procedure",
      "bbox": {
        "l": 335.0,
        "t": 319.04,
        "r": 572.5900000000001,
        "b": 300.2121008403361
      },
      "content": "¾ ¾ If 3 ohms or less is measured, or float/overflow switch is damaged, replace switch and retest."
    },
    {
      "type": "list_item",
      "id": "txt_0659",
      "reading_order": 740,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 294.82,
        "r": 573.0500000000002,
        "b": 277.2121008403361
      },
      "content": "If the preceding steps did not correct the overflow switch problem, replace the control board and retest."
    },
    {
      "type": "list_item",
      "id": "txt_0660",
      "reading_order": 741,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 271.81999999999994,
        "r": 505.8100000000002,
        "b": 264.2121008403361
      },
      "content": "Unplug dishwasher or disconnect power."
    },
    {
      "type": "list_item",
      "id": "txt_0661",
      "reading_order": 742,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 258.81999999999994,
        "r": 473.07000000000033,
        "b": 251.21210084033612
      },
      "content": "Reassemble all parts and panels."
    },
    {
      "type": "list_item",
      "id": "txt_0662",
      "reading_order": 743,
      "section": "Test Procedure",
      "bbox": {
        "l": 322.0,
        "t": 245.81999999999994,
        "r": 564.4600000000003,
        "b": 228.21210084033612
      },
      "content": "Plug in dishwasher or reconnect power and run Service Mode Test on page 2-3 to verify repair."
    },
    {
      "type": "paragraph",
      "id": "txt_0663",
      "reading_order": 744,
      "section": "Test Procedure",
      "bbox": {
        "l": 539.6313,
        "t": 44.86829999999998,
        "r": 555.8369,
        "b": 32.765719354838666
      },
      "content": "n"
    }
  ],
