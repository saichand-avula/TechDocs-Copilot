    {
      "type": "heading",
      "id": "txt_0110",
      "reading_order": 125,
      "section": "Underside of countertop to floor",
      "bbox": {
        "l": 304.56787299999996,
        "t": 194.52649999999994,
        "r": 457.3791041000001,
        "b": 186.02141334358976
      },
      "content": "Underside of countertop to floor",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_0111",
      "reading_order": 126,
      "section": "Underside of countertop to floor",
      "bbox": {
        "l": 304.5666,
        "t": 179.92949999999996,
        "r": 542.970012,
        "b": 162.33832976470592
      },
      "content": "The enclosure must be at least 18\" wide, 24\" (61 cm) deep, and 32½\" (82.5 cm) high."
    },
    {
      "type": "paragraph",
      "id": "txt_0112",
      "reading_order": 127,
      "section": "Underside of countertop to floor",
      "bbox": {
        "l": 304.5666,
        "t": 158.08747200000005,
        "r": 536.177892,
        "b": 130.56729476470593
      },
      "content": "For the front door of the dishwasher to be flush with the leading edge of the counter top, the counter top must be at least 24\" (61 cm) deep."
    },
    {
      "type": "paragraph",
      "id": "txt_0113",
      "reading_order": 128,
      "section": "Underside of countertop to floor",
      "bbox": {
        "l": 304.5666,
        "t": 126.31643700000006,
        "r": 544.927215,
        "b": 108.7252667647059
      },
      "content": "This dishwasher is designed to be enclosed on the top and on both sides by a standard residential kitchen cabinet unit."
    },
    {
      "type": "paragraph",
      "id": "txt_0114",
      "reading_order": 129,
      "section": "Underside of countertop to floor",
      "bbox": {
        "l": 304.5666,
        "t": 104.47440900000004,
        "r": 529.2070320000001,
        "b": 86.88323876470588
      },
      "content": "The installation enclosure must be clean and free of any obstructions."
    },
    {
      "type": "admonition",
      "id": "txt_0115",
      "reading_order": 130,
      "section": "Underside of countertop to floor",
      "bbox": {
        "l": 304.5666,
        "t": 82.61609999999996,
        "r": 554.9215440000003,
        "b": 55.094036764705834
      },
      "content": "NOTE: ADA installation, 32½\" (82.5 cm) beneath 34\" (86.4 cm) high countertops may be accomplished by adjusting the toekick and leveling legs.",
      "severity": "note"
    }
  ],
