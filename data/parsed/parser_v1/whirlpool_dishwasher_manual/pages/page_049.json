    {
      "type": "list_item",
      "id": "txt_0886",
      "reading_order": 998,
      "section": "Replace Inner Door Panel",
      "bbox": {
        "l": 60.0,
        "t": 459.32,
        "r": 311.21,
        "b": 441.7121008403361
      },
      "content": "Perform the procedures on page 4-3, 'Remove the Control Panel' prior to performing the following steps.",
      "section_id": "sec_auto_996",
      "parent_section_id": "sec_24",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_24",
