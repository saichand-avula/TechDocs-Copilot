      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0888",
      "reading_order": 1000,
      "section": "Replace Inner Door Panel",
      "bbox": {
        "l": 60.0,
        "t": 403.32,
        "r": 283.04,
        "b": 385.7121008403361
      },
      "content": "Remove the two (2) screws from the hinge plate (as indicated in Figure 1).",
      "section_id": "sec_auto_996",
      "parent_section_id": "sec_24",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_24",
          "title": "24' Product and Cabinet Opening Dimensions PRODUCT AND CABINET OPENING DIMENSIONS:"
        },
        {
          "id": "sec_auto_996",
          "title": "Replace Inner Door Panel"
        }
      ],
      "page": 49,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0889",
      "reading_order": 1001,
      "section": "Replace Inner Door Panel",
      "bbox": {
        "l": 327.0,
        "t": 706.4738000000001,
        "r": 566.1399999999999,
        "b": 689.8659008403362
      },
      "content": "Remove the two (2) screws from the base side panel on each side (indicated in Figure 2).",
      "section_id": "sec_auto_996",
      "parent_section_id": "sec_24",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_24",
