      "bbox": {
        "l": 60.0,
        "t": 436.32,
        "r": 295.98,
        "b": 408.7121008403361
      },
      "content": "Perform the procedures on page 4-5, 'Remove the Dispenser Assembly' prior to performing the following steps.",
      "section_id": "sec_auto_996",
      "parent_section_id": "sec_24",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_24",
