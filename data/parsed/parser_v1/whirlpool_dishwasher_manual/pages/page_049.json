      "bbox": {
        "l": 327.0,
        "t": 483.4738,
        "r": 554.8600000000001,
        "b": 475.8659008403361
      },
      "content": "Disconnect door spring and door cable (see Figure 3).",
      "hyperlink_hint": true,
      "section_id": "sec_auto_996",
      "parent_section_id": "sec_24",
      "section_level": 2,
      "section_path": [
        {
