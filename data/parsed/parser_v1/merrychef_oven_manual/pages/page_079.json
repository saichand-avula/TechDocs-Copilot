  },
  "blocks": [
    {
      "type": "list_item",
      "id": "txt_1041",
      "reading_order": 1306,
      "section": "IMPORTANT:",
      "bbox": {
        "l": 36.0,
        "t": 788.82601953125,
        "r": 543.7529999999999,
        "b": 768.0213344167462
      },
      "content": "Remove the 3mm white spacers and replace with two blue 5mm spacers, again over the top corners of the door seal. Then carefully close the door ensuring the spacers are still in position."
    },
    {
      "type": "list_item",
      "id": "txt_1042",
      "reading_order": 1307,
      "section": "IMPORTANT:",
      "bbox": {
        "l": 36.0,
        "t": 602.70601953125,
        "r": 247.14899999999997,
        "b": 594.5187304760582
      },
      "content": "Loosen the interlock adjuster and locking nut."
    },
    {
      "type": "list_item",
      "id": "txt_1043",
      "reading_order": 1308,
      "section": "IMPORTANT:",
      "bbox": {
        "l": 36.008999999999986,
        "t": 589.8630195312501,
        "r": 409.02299999999997,
        "b": 581.6757304760582
      },
      "content": "Loosen the two flange head screws just enough to let the microswitch bracket move."
    },
    {
      "type": "list_item",
      "id": "txt_1044",
      "reading_order": 1309,
      "section": "IMPORTANT:",
      "bbox": {
        "l": 36.0,
        "t": 576.90301953125,
        "r": 492.03899999999993,
        "b": 568.7157304760582
      },
      "content": "Pull up the microswitch bracket until is sits against the underside of the insulation (as far as it will travel)."
    },
    {
      "type": "list_item",
      "id": "txt_1045",
      "reading_order": 1310,
      "section": "IMPORTANT:",
      "bbox": {
        "l": 35.98199999999997,
        "t": 564.18601953125,
        "r": 325.24199999999996,
        "b": 555.9987304760582
      },
      "content": "Screw the interlock adjuster to begin closing the switch actuator."
    },
    {
      "type": "list_item",
      "id": "txt_1046",
      "reading_order": 1311,
      "section": "IMPORTANT:",
      "bbox": {
        "l": 35.98199999999997,
        "t": 551.3430195312501,
        "r": 458.55899999999997,
        "b": 543.1557304760582
      },
      "content": "As soon as the secondary door switch (SW2) closes, nip up the two flange head screws to 2.1Nm."
    },
    {
      "type": "list_item",
      "id": "txt_1047",
      "reading_order": 1312,
      "section": "IMPORTANT:",
      "bbox": {
        "l": 35.98200000000003,
        "t": 538.6260195312501,
        "r": 438.516,
        "b": 530.4387304760583
      },
      "content": "Tighten the interlock adjuster locking nut against the bracket using a 7mm spanner to 1Nm."
    },
    {
      "type": "list_item",
      "id": "txt_1048",
      "reading_order": 1313,
      "section": "IMPORTANT:",
      "bbox": {
        "l": 35.97300000000007,
        "t": 525.7830195312501,
        "r": 546.6680999999995,
        "b": 504.7353344167463
      },
      "content": "Remove the spacers, then open and close the appliance door a few times to validate the door switches operate in the correct sequence."
    },
    {
      "type": "list_item",
      "id": "txt_1049",
      "reading_order": 1314,
      "section": "IMPORTANT:",
      "bbox": {
        "l": 35.97300000000007,
        "t": 499.86301953125013,
        "r": 351.054,
        "b": 491.6757304760584
      },
      "content": "Once the panels have been refitted, conduct a microwave leakage test."
    },
