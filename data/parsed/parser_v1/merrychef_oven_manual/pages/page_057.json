      "section": "Earth/insulation test",
      "bbox": {
        "l": 36.0,
        "t": 718.0260195312501,
        "r": 265.743,
        "b": 709.9383344167462
      },
      "content": "Check that the following requirements have been met:"
    },
    {
      "type": "list_item",
      "id": "txt_0638",
      "reading_order": 815,
      "section": "Earth/insulation test",
      "bbox": {
        "l": 54.00000000000003,
        "t": 694.0230195312499,
        "r": 558.765,
        "b": 673.3353344167462
      },
      "content": " The appliance has been disconnected from the power supply and protective measures have been taken to ensure the power cannot be switched on again."
    },
    {
      "type": "list_item",
      "id": "txt_0639",
      "reading_order": 816,
      "section": "Earth/insulation test",
      "bbox": {
        "l": 151.92,
        "t": 656.58601953125,
        "r": 467.64959999999996,
        "b": 648.4983344167462
      },
      "content": "Connect the mains lead  from the appliance to a portable appliance tester"
    },
    {
      "type": "list_item",
      "id": "txt_0640",
      "reading_order": 817,
      "section": "Earth/insulation test",
      "bbox": {
        "l": 151.92,
        "t": 567.3060195312501,
        "r": 560.1,
        "b": 546.9783344167462
      },
      "content": "Connect the earth from the  portable appliance tester to the equipotential bonding point on the oven."
    },
    {
      "type": "list_item",
      "id": "txt_0641",
      "reading_order": 818,
      "section": "Earth/insulation test",
      "bbox": {
        "l": 151.92,
        "t": 472.98601953125,
        "r": 554.2896000000001,
        "b": 464.8983344167462
      },
      "content": "Place the portable appliance tester in an open area, such as the floor, away  from any persons."
    },
