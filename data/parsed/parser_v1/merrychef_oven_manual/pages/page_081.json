        },
        {
          "id": "sec_auto_1387",
          "title": "Preparing a replacement magnetron"
        }
      ],
      "page": 81,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "paragraph",
      "id": "txt_1105",
      "reading_order": 1390,
      "section": "Preparing a replacement magnetron",
      "bbox": {
        "l": 198.1290000000001,
        "t": 221.93391953125,
        "r": 346.3860000000001,
        "b": 188.41223441674617
      },
      "content": "The studs can be removed by knocking them out of the tabs with a hammer.",
      "section_id": "sec_auto_1387",
      "parent_section_id": "sec_6",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_6",
          "title": "6 Replacing components"
        },
        {
          "id": "sec_auto_1387",
          "title": "Preparing a replacement magnetron"
        }
      ],
      "page": 81,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "paragraph",
      "id": "txt_1106",
      "reading_order": 1391,
