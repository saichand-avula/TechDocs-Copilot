      "bbox": {
        "l": 198.12,
        "t": 291.3059195312501,
        "r": 348.30300000000005,
        "b": 229.32623441674616
      },
      "content": "The new magnetrons come with four pressed studs for fixing. These studs need to be removed before fitting the magnetron to the oven. NOTE:",
      "section_id": "sec_auto_1387",
      "parent_section_id": "sec_6",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_6",
