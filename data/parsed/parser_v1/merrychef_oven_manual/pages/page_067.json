      },
      "content": "High voltage magnetron test",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_0858",
      "reading_order": 1081,
      "section": "High voltage magnetron test",
      "bbox": {
        "l": 38.88,
        "t": 757.1460195312501,
        "r": 351.423,
        "b": 749.0583344167462
      },
      "content": "Ensure the following requirements have been met before starting the test:"
    },
    {
      "type": "list_item",
      "id": "txt_0859",
      "reading_order": 1082,
      "section": "High voltage magnetron test",
      "bbox": {
        "l": 56.88000000000005,
        "t": 742.02601953125,
        "r": 551.6910000000001,
        "b": 720.7353344167462
      },
      "content": " The appliance has been disconnected from the power supply and protective measures have been taken to ensure the power cannot be switched on again."
    },
    {
      "type": "list_item",
      "id": "txt_0860",
      "reading_order": 1083,
      "section": "High voltage magnetron test",
      "bbox": {
        "l": 56.871000000000095,
        "t": 716.10601953125,
        "r": 166.48200000000008,
        "b": 707.6583344167462
      },
      "content": " The appliance is cool."
    },
    {
      "type": "list_item",
      "id": "txt_0861",
      "reading_order": 1084,
      "section": "High voltage magnetron test",
      "bbox": {
        "l": 56.86200000000008,
        "t": 703.50601953125,
        "r": 366.99300000000005,
        "b": 695.0583344167462
      },
      "content": " The high voltage capacitors are discharged before commencing work."
    },
    {
      "type": "list_item",
      "id": "txt_0862",
      "reading_order": 1085,
      "section": "High voltage magnetron test",
      "bbox": {
        "l": 56.853000000000065,
        "t": 690.78901953125,
        "r": 273.61800000000005,
        "b": 682.3413344167462
      },
      "content": " The casing of the appliance has been removed."
    },
    {
      "type": "heading",
      "id": "txt_0863",
      "reading_order": 1086,
      "section": "DANGER",
      "bbox": {
        "l": 50.04,
        "t": 659.34601953125,
        "r": 90.063,
        "b": 651.1587304760582
      },
      "content": "DANGER",
      "level": 2,
      "role": "section"
    },
    {
