    {
      "type": "list_item",
      "id": "txt_1119",
      "reading_order": 1408,
      "section": "Fitting a magnetron",
      "bbox": {
        "l": 53.990999999999985,
        "t": 358.14901953125,
        "r": 505.25999999999993,
        "b": 350.0613344167462
      },
      "content": "Ensure the magnetron overheat thermostat is refitted in the same location to ensure correct operation.",
      "section_id": "sec_auto_1406",
      "parent_section_id": "sec_6",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_6",
          "title": "6 Replacing components"
        },
        {
          "id": "sec_auto_1406",
