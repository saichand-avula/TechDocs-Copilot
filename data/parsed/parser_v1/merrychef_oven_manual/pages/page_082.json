      "section": "Fitting a magnetron",
      "bbox": {
        "l": 53.99999999999994,
        "t": 345.30601953125,
        "r": 318.7619999999999,
        "b": 337.2183344167462
      },
      "content": "Ensure the RF (Radio Frequency) gasket is correctly seated.",
      "section_id": "sec_auto_1406",
      "parent_section_id": "sec_6",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_6",
          "title": "6 Replacing components"
        },
        {
          "id": "sec_auto_1406",
