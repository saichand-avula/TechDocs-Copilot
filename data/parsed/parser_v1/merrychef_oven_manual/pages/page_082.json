        "l": 54.0,
        "t": 370.86601953125,
        "r": 362.691,
        "b": 362.7783344167462
      },
      "content": "Follow the steps in the reverse order to fit a replacement magnetron.",
      "section_id": "sec_auto_1406",
      "parent_section_id": "sec_6",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_6",
