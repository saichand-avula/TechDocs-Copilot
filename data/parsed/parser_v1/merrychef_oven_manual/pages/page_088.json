      "reading_order": 1527,
      "section": "Fitting the IO Board",
      "bbox": {
        "l": 36.0,
        "t": 787.84801953125,
        "r": 147.84,
        "b": 777.0644393785782
      },
      "content": "Fitting the IO Board",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_1208",
      "reading_order": 1528,
      "section": "Fitting the IO Board",
      "bbox": {
        "l": 36.0,
        "t": 769.2660195312501,
        "r": 486.90000000000003,
        "b": 761.1783344167462
      },
      "content": "Follow the steps in the reverse order to fit the IO Board. For details see 'IO Terminal Locations' in section 7."
    },
    {
      "type": "paragraph",
      "id": "txt_1209",
      "reading_order": 1529,
      "section": "Fitting the IO Board",
      "bbox": {
        "l": 36.0,
        "t": 753.6690195312501,
        "r": 400.7249999999999,
        "b": 745.5813344167462
      },
      "content": "Refit the Personality Module (PM) removed from the old IO Board to the new IO Board."
    },
    {
      "type": "paragraph",
      "id": "txt_1210",
      "reading_order": 1530,
      "section": "Fitting the IO Board",
      "bbox": {
        "l": 35.981999999999914,
        "t": 738.3060195312501,
        "r": 558.045,
        "b": 714.7383344167462
      },
      "content": "Reason: Replacement IO Boards come WITHOUT a Personality Module as the PMs store individual settings for the appliance. Recommission the under in the Service Settings"
    },
    {
      "type": "admonition",
      "id": "txt_1211",
      "reading_order": 1531,
      "severity": "note",
      "content": "NOTICE: If the electric connections have not been restored properly this may lead to malfunction/damage of the oven.",
      "section": "NOTICE:",
      "bbox": {
        "l": 36.0,
        "t": 692.10591953125,
        "r": 74.34,
        "b": 683.9186304760582
      }
    },
    {
      "type": "heading",
      "id": "txt_1213",
      "reading_order": 1533,
      "section": "6.11 PM (Personality Module) replacement",
      "bbox": {
        "l": 49.56,
        "t": 644.10457953125,
        "r": 354.98616,
        "b": 631.3324086051509
      },
      "content": "6.11 PM (Personality Module) replacement",
      "level": 2,
      "role": "section"
    },
    {
      "type": "list_item",
      "id": "txt_1214",
      "reading_order": 1534,
      "section": "6.11 PM (Personality Module) replacement",
      "bbox": {
        "l": 36.0,
        "t": 603.16801953125,
        "r": 287.52,
        "b": 592.3844393785782
      },
      "content": "Fitting the IO Board Personality Module (PM)"
    },
    {
      "type": "heading",
      "id": "txt_1215",
      "reading_order": 1535,
      "section": "Requirements",
      "bbox": {
        "l": 36.0,
        "t": 568.1280195312501,
        "r": 117.84,
        "b": 557.3444393785783
      },
      "content": "Requirements",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_1216",
      "reading_order": 1536,
      "section": "Requirements",
      "bbox": {
        "l": 36.0,
        "t": 549.5460195312501,
        "r": 265.743,
        "b": 541.4583344167462
      },
      "content": "Check that the following requirements have been met:"
    },
    {
      "type": "list_item",
      "id": "txt_1217",
      "reading_order": 1537,
      "section": "Requirements",
      "bbox": {
        "l": 54.00000000000003,
        "t": 534.42601953125,
        "r": 548.811,
        "b": 513.1353344167462
      },
      "content": " The appliance has been disconnected from the power supply and protective measures have been taken to ensure the power cannot be switched on again."
    },
    {
      "type": "list_item",
      "id": "txt_1218",
      "reading_order": 1538,
      "section": "Requirements",
      "bbox": {
        "l": 53.990999999999985,
        "t": 508.50601953125005,
        "r": 163.611,
        "b": 500.0583344167462
      },
      "content": " The appliance is cool."
    },
    {
      "type": "list_item",
      "id": "txt_1219",
      "reading_order": 1539,
      "section": "Requirements",
      "bbox": {
        "l": 53.990999999999985,
        "t": 496.02301953125004,
        "r": 386.9009999999999,
        "b": 487.5753344167462
      },
      "content": " The side and top panels of the casing of the appliance have been removed."
    },
    {
      "type": "list_item",
      "id": "txt_1220",
      "reading_order": 1540,
      "section": "Requirements",
      "bbox": {
        "l": 53.96399999999994,
        "t": 483.18001953125,
        "r": 363.96899999999994,
        "b": 474.7323344167462
      },
      "content": " The high voltage capacitors are discharged before commencing work."
    },
    {
      "type": "list_item",
      "id": "txt_1221",
      "reading_order": 1541,
      "section": "Requirements",
      "bbox": {
        "l": 53.94599999999997,
        "t": 470.33701953125,
        "r": 241.82099999999997,
        "b": 461.8893344167462
      },
      "content": " Anti-static precautions have been taken."
    },
    {
      "type": "paragraph",
      "id": "txt_1222",
      "reading_order": 1542,
      "section": "Requirements",
      "bbox": {
        "l": 36.0,
        "t": 439.14601953125003,
        "r": 386.091,
        "b": 431.0583344167462
      },
      "content": "The personality module on the IO Board contains the IO Board dedicated firmware."
    },
    {
      "type": "list_item",
      "id": "txt_1223",
      "reading_order": 1543,
      "section": "Requirements",
      "bbox": {
        "l": 54.0,
        "t": 414.42601953125,
        "r": 449.559,
        "b": 406.3383344167462
      },
      "content": "Unplug the old PM from IO Board and fit replacement PM (ensure part number is correct)."
    },
    {
      "type": "list_item",
      "id": "txt_1224",
      "reading_order": 1544,
      "section": "Requirements",
      "bbox": {
        "l": 53.982000000000085,
        "t": 402.42901953125,
        "r": 292.36499999999995,
        "b": 394.3413344167462
      },
      "content": "Refit all oven panels, plug in the oven and switch on."
    },
    {
      "type": "list_item",
      "id": "txt_1225",
      "reading_order": 1545,
      "section": "Requirements",
      "bbox": {
        "l": 53.98199999999997,
        "t": 390.07201953124996,
        "r": 351.76499999999993,
        "b": 381.98433441674615
      },
      "content": "Follow the screen prompts to update the IO firmware if requested."
    },
    {
      "type": "list_item",
      "id": "txt_1226",
      "reading_order": 1546,
      "section": "Requirements",
      "bbox": {
        "l": 54.0,
        "t": 238.86601953125,
        "r": 550.6020000000001,
        "b": 218.53833441674624
      },
      "content": "Check the IO and UI versions are the latest release. If not, execute a firmware update using the latest versions. See section 4.5 for details."
    },
    {
      "type": "list_item",
      "id": "txt_1227",
      "reading_order": 1547,
      "section": "Requirements",
      "bbox": {
        "l": 54.0,
        "t": 214.26601953124998,
        "r": 253.01699999999997,
        "b": 206.17833441674622
      },
      "content": "Recommission the oven in service settings."
    },
    {
