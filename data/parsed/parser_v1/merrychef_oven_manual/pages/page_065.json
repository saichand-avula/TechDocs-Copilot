    },
    {
      "type": "paragraph",
      "id": "txt_0786",
      "reading_order": 998,
      "section": "High voltages and significant currents are present at the high voltage capacitor and HV Circuit.",
      "bbox": {
        "l": 35.98200000000003,
        "t": 578.3490195312501,
        "r": 301.61699999999996,
        "b": 570.2613344167462
      },
      "content": "It is very dangerous to work near this part when the oven is on."
    },
    {
      "type": "paragraph",
      "id": "txt_0787",
      "reading_order": 999,
      "section": "High voltages and significant currents are present at the high voltage capacitor and HV Circuit.",
      "bbox": {
        "l": 35.990999999999985,
        "t": 566.3520195312501,
        "r": 559.008,
        "b": 546.0243344167462
      },
      "content": "NEVER make any electrical measurements on the high voltage circuits, including the magnetron filament, whilst the oven is connected to the mains power supply."
    },
    {
      "type": "list_item",
      "id": "txt_0788",
      "reading_order": 1000,
      "section": "High voltages and significant currents are present at the high voltage capacitor and HV Circuit.",
