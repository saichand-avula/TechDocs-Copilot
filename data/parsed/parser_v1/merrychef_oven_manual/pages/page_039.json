    {
      "type": "heading",
      "id": "txt_0473",
      "reading_order": 600,
      "section": "UI micro SD card & IO PM replacement - firmware update",
      "bbox": {
        "l": 39.12,
        "t": 783.76801953125,
        "r": 361.08000000000004,
        "b": 772.9844393785783
      },
      "content": "UI micro SD card & IO PM replacement - firmware update",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_0474",
      "reading_order": 601,
      "section": "UI micro SD card & IO PM replacement - firmware update",
      "bbox": {
        "l": 36.0,
        "t": 757.0260195312501,
        "r": 559.026,
        "b": 736.0953344167463
      },
      "content": "The user interface (UI) contains the main operating firmware, serial number of your appliance, temperature calibration, event log, communication profiles, cooking profiles, application icons and the recipe images."
    },
    {
      "type": "paragraph",
      "id": "txt_0475",
      "reading_order": 602,
      "section": "UI micro SD card & IO PM replacement - firmware update",
      "bbox": {
        "l": 36.008999999999844,
        "t": 728.8200195312501,
        "r": 317.2139999999998,
        "b": 720.7323344167462
      },
      "content": "The personality module on the IO board contains the IO firmware."
    },
    {
      "type": "paragraph",
      "id": "txt_0476",
      "reading_order": 603,
      "section": "UI micro SD card & IO PM replacement - firmware update",
      "bbox": {
        "l": 35.99099999999987,
        "t": 714.17701953125,
        "r": 324.9989999999998,
        "b": 706.0893344167462
      },
      "content": "UI Firmware may have to be updated on replacement of the SD card."
    },
    {
      "type": "paragraph",
      "id": "txt_0477",
      "reading_order": 604,
      "section": "UI micro SD card & IO PM replacement - firmware update",
      "bbox": {
        "l": 36.0,
        "t": 701.94601953125,
        "r": 552.7800000000001,
        "b": 679.7013344167461
      },
      "content": "On replacement of the IO Personality Module, if a newer IO Firmware version is available, a prompt will appear. Proceed by selecting the tick (an IO firmware USB is not required)."
    },
    {
      "type": "paragraph",
      "id": "txt_0478",
      "reading_order": 605,
      "section": "UI micro SD card & IO PM replacement - firmware update",
      "bbox": {
        "l": 36.0,
        "t": 657.5460195312501,
        "r": 215.946,
        "b": 649.4583344167462
      },
      "content": "See section 6.11 for replacing components"
    },
    {
