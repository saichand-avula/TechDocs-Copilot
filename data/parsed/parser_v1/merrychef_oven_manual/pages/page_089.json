    {
      "type": "heading",
      "id": "txt_1238",
      "reading_order": 1560,
      "section": "Removing the stirrer motor",
      "bbox": {
        "l": 36.0,
        "t": 562.12791953125,
        "r": 191.04000000000002,
        "b": 551.3443393785782
      },
      "content": "Removing the stirrer motor",
      "level": 2,
      "role": "section"
    },
    {
      "type": "list_item",
      "id": "txt_1239",
      "reading_order": 1561,
      "section": "Removing the stirrer motor",
      "bbox": {
        "l": 54.0,
        "t": 543.5460195312501,
        "r": 331.60499999999996,
        "b": 535.4583344167462
      },
      "content": "Unplug the stirrer motor from the IO Board, connection X112."
    },
    {
      "type": "list_item",
      "id": "txt_1240",
      "reading_order": 1562,
      "section": "Removing the stirrer motor",
      "bbox": {
        "l": 53.98199999999997,
        "t": 530.7030195312501,
        "r": 415.84499999999997,
        "b": 509.89833441674625
      },
      "content": "Unfasten the two M3 x 8 Poszi screws holding the motor to the waveguide and lift out."
    },
    {
      "type": "heading",
      "id": "txt_1241",
      "reading_order": 1563,
      "section": "Removing the microwave stirrer",
      "bbox": {
        "l": 36.0,
        "t": 488.68801953125,
        "r": 217.08,
        "b": 477.9044393785783
      },
      "content": "Removing the microwave stirrer",
      "level": 2,
      "role": "section"
    },
    {
      "type": "list_item",
      "id": "txt_1242",
      "reading_order": 1564,
      "section": "Removing the microwave stirrer",
      "bbox": {
        "l": 54.0,
        "t": 457.14601953125003,
        "r": 367.245,
        "b": 449.0583344167462
      },
      "content": "Unfasten the two M7 Hex screws at the front of the jet/impinger plate."
    },
    {
      "type": "list_item",
      "id": "txt_1243",
      "reading_order": 1565,
      "section": "Removing the microwave stirrer",
      "bbox": {
        "l": 53.98200000000003,
        "t": 444.18601953125005,
        "r": 485.54999999999995,
        "b": 436.09833441674624
      },
      "content": "Drop down the jet/impinger plate slightly at the front and slide forward to release to two rear tabs."
    },
    {
      "type": "list_item",
      "id": "txt_1244",
      "reading_order": 1566,
      "section": "Removing the microwave stirrer",
      "bbox": {
        "l": 53.97300000000001,
        "t": 431.46901953125007,
        "r": 300.63599999999997,
        "b": 423.38133441674626
      },
      "content": "The plate will then drop down and forward to remove."
    },
