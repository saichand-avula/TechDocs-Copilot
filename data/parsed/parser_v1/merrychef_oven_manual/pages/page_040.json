    {
      "type": "paragraph",
      "id": "txt_0494",
      "reading_order": 635,
      "section": "Confirming the firmware updates",
      "bbox": {
        "l": 35.9910000000001,
        "t": 198.68401953125,
        "r": 552.0510000000002,
        "b": 165.16233441674626
      },
      "content": "After an update of the appliance firmware check to ensure the latest firmware has been successfully loaded on to the oven. Once the oven is switched back on, it will cycle through the Welbilt brand names until reaching the Merrychef 'Expanding Your Opportunities' screen. Select the information 'i' button."
    },
    {
      "type": "paragraph",
      "id": "txt_0495",
      "reading_order": 636,
      "section": "Confirming the firmware updates",
      "bbox": {
        "l": 36.0,
        "t": 137.82601953125004,
        "r": 557.469,
        "b": 116.89533441674621
      },
      "content": "Review the data displayed. Select the back arrow to return to the previous screen. The information can also be selected from the main screen/ settings."
    },
