      "bbox": {
        "l": 26.04,
        "t": 158.46601953125003,
        "r": 302.09700000000004,
        "b": 150.37833441674616
      },
      "content": "Follow the steps in the reverse order to refit the door to the oven.",
      "section_id": "sec_auto_1250",
      "parent_section_id": "sec_6",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_6",
          "title": "6 Replacing components"
        },
        {
          "id": "sec_auto_1250",
