        "r": 558.918,
        "b": 205.46433441674617
      },
      "content": " Pass on the user manuals included in the customer documentation with the microwave combination oven if it changes ownership.",
      "section_id": "sec_auto_112",
      "parent_section_id": "sec_2",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_2",
