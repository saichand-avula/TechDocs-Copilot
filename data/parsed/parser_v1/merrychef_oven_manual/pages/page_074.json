        "r": 148.371,
        "b": 244.59873047605822
      },
      "content": "Remove top panel first."
    },
    {
      "type": "paragraph",
      "id": "txt_0954",
      "reading_order": 1197,
      "section": "Removing the panels of the casing",
      "bbox": {
        "l": 38.751000000000005,
        "t": 237.42301953125002,
        "r": 192.048,
        "b": 190.6893344167462
      },
      "content": "Unfasten the M5.5 hex head flange bolts at the back panel of the appliance attaching the top panel to the back panel."
    },
    {
      "type": "paragraph",
      "id": "txt_0955",
      "reading_order": 1198,
      "section": "Removing the panels of the casing",
      "bbox": {
        "l": 53.150999999999996,
        "t": 183.41401953125,
        "r": 119.571,
        "b": 175.32633441674625
      },
      "content": "X12 = two bolts"
    },
    {
      "type": "paragraph",
      "id": "txt_0956",
      "reading_order": 1199,
      "section": "Removing the panels of the casing",
      "bbox": {
        "l": 53.150999999999996,
        "t": 167.93401953125,
        "r": 125.574,
        "b": 159.84633441674623
      },
      "content": "X16 = three bolts"
    },
    {
      "type": "paragraph",
      "id": "txt_0957",
      "reading_order": 1200,
      "section": "Removing the panels of the casing",
      "bbox": {
        "l": 38.75099999999999,
        "t": 152.69701953125002,
        "r": 197.21399999999994,
        "b": 131.7663344167463
      },
      "content": "Lift the top panel at the rear and pull out from the front fixing to remove it."
    },
    {
