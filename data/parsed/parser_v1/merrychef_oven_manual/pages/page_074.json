    {
      "type": "paragraph",
      "id": "txt_0963",
      "reading_order": 1208,
      "section": "Removing the panels of the casing",
      "bbox": {
        "l": 400.79399999999987,
        "t": 237.16201953125005,
        "r": 556.8539999999999,
        "b": 164.7423344167463
      },
      "content": "Unfasten the six M5.5 hex head flange bolts attaching the back panel to the cooling duct (two bolts), the exhaust pipe & cover box (one bolt) and the base  plate (three bolts) of the appliance."
    },
    {
      "type": "paragraph",
      "id": "txt_0964",
      "reading_order": 1209,
      "section": "Removing the panels of the casing",
      "bbox": {
        "l": 400.79399999999987,
        "t": 157.46701953125012,
        "r": 548.6909999999999,
        "b": 136.53633441674629
      },
      "content": "Move the back panel up to remove it."
    },
    {
