        "t": 252.53401953125012,
        "r": 328.2539999999999,
        "b": 244.34673047605827
      },
      "content": "Removing the side panels:"
    },
    {
      "type": "paragraph",
      "id": "txt_0959",
      "reading_order": 1203,
      "section": "Removing the panels of the casing",
      "bbox": {
        "l": 206.39399999999998,
        "t": 237.17101953125007,
        "r": 369.77099999999996,
        "b": 190.43733441674624
      },
      "content": "Unfasten the six M5.5 hex head flange bolts (three per side) at the back panel of the appliance attaching each side panel to the back panel."
    },
    {
      "type": "paragraph",
      "id": "txt_0960",
      "reading_order": 1204,
      "section": "Removing the panels of the casing",
      "bbox": {
        "l": 206.39399999999995,
        "t": 183.28801953125003,
        "r": 371.21099999999996,
        "b": 149.39733441674628
      },
      "content": "Slide the panels towards the back of the appliance and out at the bottom to remove them."
    },
    {
      "type": "list_item",
      "id": "txt_0961",
      "reading_order": 1205,
      "section": "Removing the panels of the casing",
      "bbox": {
        "l": 36.0,
        "t": 70.74591953125002,
        "r": 387.5399999999999,
        "b": 62.55863047605828
      },
      "content": "Ensure the high voltage capacitors are discharged before commencing any work."
    },
    {
      "type": "list_item",
      "id": "txt_0962",
      "reading_order": 1206,
      "section": "Removing the panels of the casing",
      "bbox": {
        "l": 400.794,
        "t": 252.5250195312501,
        "r": 520.854,
        "b": 244.33773047605837
      },
      "content": "Removing the back panel:"
    },
