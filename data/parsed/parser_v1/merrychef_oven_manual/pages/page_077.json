    {
      "type": "heading",
      "id": "txt_1006",
      "reading_order": 1266,
      "section": "Refitting the door hinge assemblies",
      "bbox": {
        "l": 36.0,
        "t": 380.20801953125,
        "r": 235.92000000000002,
        "b": 369.42443937857826
      },
      "content": "Refitting the door hinge assemblies",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_1007",
      "reading_order": 1267,
      "section": "Refitting the door hinge assemblies",
      "bbox": {
        "l": 26.04,
        "t": 346.26601953125,
        "r": 376.248,
        "b": 338.17833441674617
      },
      "content": "Follow the steps in the reverse order to refit the door hinge assemblies to the oven."
    },
    {
      "type": "list_item",
      "id": "txt_1008",
      "reading_order": 1268,
      "section": "Refitting the door hinge assemblies",
      "bbox": {
        "l": 53.985000000000014,
        "t": 333.90901953125,
        "r": 316.73100000000005,
        "b": 325.46133441674624
      },
      "content": " The hinge assembly bolts should be torqued up to 3.5Nm."
    },
    {
      "type": "list_item",
      "id": "txt_1009",
      "reading_order": 1269,
      "section": "Refitting the door hinge assemblies",
      "bbox": {
        "l": 53.994000000000085,
        "t": 321.19201953125,
        "r": 399.9027000000001,
        "b": 312.74433441674614
      },
      "content": " The switch assembly adjuster and fixing bolts should be torqued up to 2.1Nm."
    },
    {
      "type": "list_item",
      "id": "txt_1010",
      "reading_order": 1270,
      "section": "Refitting the door hinge assemblies",
      "bbox": {
        "l": 54.00300000000004,
        "t": 308.34901953124995,
        "r": 234.55200000000005,
        "b": 299.9013344167462
      },
      "content": " Refit the door as previously described."
    },
    {
      "type": "list_item",
      "id": "txt_1011",
      "reading_order": 1271,
      "section": "Refitting the door hinge assemblies",
      "bbox": {
        "l": 54.01200000000003,
        "t": 295.50601953125,
        "r": 357.05100000000004,
        "b": 287.0583344167462
      },
      "content": " Set the door switch adjustment and ensure the operation is correct."
    },
    {
