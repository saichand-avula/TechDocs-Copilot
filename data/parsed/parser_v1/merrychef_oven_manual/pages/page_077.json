  "blocks": [
    {
      "type": "heading",
      "id": "txt_0999",
      "reading_order": 1256,
      "section": "Removing the door hinge assemblies",
      "bbox": {
        "l": 36.0,
        "t": 787.84801953125,
        "r": 244.92000000000002,
        "b": 777.0644393785782
      },
      "content": "Removing the door hinge assemblies",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_1000",
      "reading_order": 1257,
      "section": "Removing the door hinge assemblies",
      "bbox": {
        "l": 36.0,
        "t": 753.7860195312501,
        "r": 374.07599999999985,
        "b": 745.6983344167462
      },
      "content": "Firstly, follow the steps to remove the door from the oven as detailed previously."
    },
    {
      "type": "list_item",
      "id": "txt_1001",
      "reading_order": 1258,
      "section": "Removing the door hinge assemblies",
      "bbox": {
        "l": 54.0,
        "t": 726.1859195312501,
        "r": 257.4746999999998,
        "b": 693.5012344167462
      },
      "content": "Slacken the flange nuts and unscrew the interlock adjuster from the switch assembly bracket."
    },
    {
      "type": "list_item",
      "id": "txt_1002",
      "reading_order": 1259,
      "section": "Removing the door hinge assemblies",
      "bbox": {
        "l": 54.01799999999998,
        "t": 689.2319195312501,
        "r": 275.46299999999985,
        "b": 656.6642344167462
      },
      "content": "Unfasten and remove the four M4 x10 hex Head Flange Bolts (two each side) securing the switch assemblies from both hinges."
    },
    {
      "type": "list_item",
      "id": "txt_1003",
      "reading_order": 1260,
      "section": "Removing the door hinge assemblies",
      "bbox": {
        "l": 53.99999999999986,
        "t": 652.5119195312501,
        "r": 275.21999999999986,
        "b": 632.1842344167462
      },
      "content": "Ensure the locking pins are fitted to both door hinges."
    },
    {
      "type": "list_item",
      "id": "txt_1004",
      "reading_order": 1261,
      "section": "Removing the door hinge assemblies",
      "bbox": {
        "l": 53.999999999999886,
        "t": 627.7889195312501,
        "r": 548.4600000000003,
        "b": 619.6016304760583
      },
      "content": "Unfasten and remove the four M5 x 10 hex head bolts (two each side) securing the hinge assemblies to the cavity."
    },
    {
      "type": "list_item",
      "id": "txt_1005",
      "reading_order": 1262,
      "section": "Removing the door hinge assemblies",
      "bbox": {
        "l": 53.999999999999886,
        "t": 615.7919195312502,
        "r": 334.14299999999974,
        "b": 607.6046304760583
      },
      "content": "Slide the hinges out through the holes on the cavity front face."
    },
    {
      "type": "figure",
      "id": "fig_0205",
