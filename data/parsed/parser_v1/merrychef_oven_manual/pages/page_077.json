        "r": 438.90299999999996,
        "b": 203.29833441674623
      },
      "content": "Check that the following requirements have been met:"
    },
    {
      "type": "list_item",
      "id": "txt_1016",
      "reading_order": 1277,
      "section": "Requirements",
      "bbox": {
        "l": 227.16,
        "t": 196.38301953125006,
        "r": 571.617,
        "b": 174.97533441674614
      },
      "content": " The appliance has been disconnected from the power supply and protective measures have been taken to ensure the power cannot be switched on again."
    },
    {
      "type": "list_item",
      "id": "txt_1017",
      "reading_order": 1278,
      "section": "Requirements",
      "bbox": {
        "l": 227.1599999999999,
        "t": 170.46301953124998,
        "r": 336.7709999999999,
        "b": 162.0153344167462
      },
      "content": " The appliance is cool."
    },
    {
      "type": "list_item",
      "id": "txt_1018",
      "reading_order": 1279,
      "section": "Requirements",
      "bbox": {
        "l": 227.1599999999999,
        "t": 157.86301953125007,
        "r": 560.196,
        "b": 149.4153344167462
      },
      "content": " The top and side panels of the casing of the appliance have been removed."
    },
    {
      "type": "list_item",
      "id": "txt_1019",
      "reading_order": 1280,
      "section": "Requirements",
      "bbox": {
        "l": 227.13299999999998,
        "t": 145.02301953125004,
        "r": 537.138,
        "b": 136.57533441674627
      },
      "content": " The high voltage capacitors are discharged before commencing work."
    },
    {
      "type": "list_item",
      "id": "txt_1020",
      "reading_order": 1281,
      "section": "Requirements",
      "bbox": {
        "l": 54.0,
        "t": 121.14601953124998,
        "r": 398.9249999999999,
        "b": 112.6983344167462
      },
      "content": " Adjust the microswitches after refitting or replacing old with new door hinges."
    },
    {
      "type": "list_item",
      "id": "txt_1021",
      "reading_order": 1282,
      "section": "Requirements",
      "bbox": {
        "l": 53.98200000000003,
        "t": 108.30301953125002,
        "r": 411.99300000000005,
        "b": 99.85533441674625
      },
      "content": " Adjust the microswitches after refitting the door or replacement of the door seal."
    },
    {
      "type": "list_item",
