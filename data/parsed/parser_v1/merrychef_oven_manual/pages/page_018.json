        },
        {
          "id": "sec_auto_295",
          "title": "Fitted frequency-converter"
        }
      ],
      "page": 18,
      "chunk_hint": "section_start",
      "semantic_role": "overview",
      "source": "pdf_text"
    },
    {
      "type": "paragraph",
      "id": "txt_0251",
      "reading_order": 297,
      "section": "Fitted frequency-converter",
      "bbox": {
        "l": 36.00899999999996,
        "t": 253.62901953124992,
        "r": 541.6019999999999,
        "b": 245.54133441674617
      },
      "content": "These devices may result in a leakage current of more than 3.5 mA per FC drive. Use a suitable RCD for the rated voltage.",
      "section_id": "sec_auto_295",
      "parent_section_id": "sec_2",
