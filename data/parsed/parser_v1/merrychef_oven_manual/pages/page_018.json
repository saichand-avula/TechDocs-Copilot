    {
      "type": "list_item",
      "id": "txt_0255",
      "reading_order": 301,
      "section": "Properties of the residual-current device",
      "bbox": {
        "l": 53.972999999999985,
        "t": 188.58901953124996,
        "r": 558.9989999999999,
        "b": 167.78433441674622
      },
      "content": " 'Time  delayed\"  trip  characteristic  for  RCD  devices  with  trip  threshold  of  30mA*:  prevents  RCD  being tripped  by charging currents of capacitors and parasitic capacitances when appliance is switched on.",
      "section_id": "sec_auto_298",
      "parent_section_id": "sec_2",
      "section_level": 2,
