    {
      "type": "paragraph",
      "id": "txt_0029",
      "reading_order": 43,
      "section": "Warnings",
      "bbox": {
        "l": 151.5,
        "t": 580.5525,
        "r": 467.0625,
        "b": 567.1875
      },
      "content": "Warnings are identified by the WARNING symbol shown above."
    },
    {
      "type": "paragraph",
      "id": "txt_0030",
      "reading_order": 44,
      "section": "Warnings",
      "bbox": {
        "l": 151.5,
        "t": 553.5525,
        "r": 537.1841999999998,
        "b": 526.6875
      },
      "content": "Warnings alert the user to potential serious outcomes (death, injury, or adverse events) to the patient or user."
    },
    {
      "type": "admonition",
      "id": "txt_0031",
      "reading_order": 45,
      "section": "Warnings",
      "bbox": {
        "l": 149.25,
        "t": 507.0525,
        "r": 538.3116000000003,
        "b": 480.1875
      },
      "content": "WARNING:  Explosion  hazard.  Do  not  use  the  N5500  in  the  presence  of flammable anesthetics or gases.",
      "severity": "warning"
    },
    {
      "type": "admonition",
      "id": "txt_0032",
      "reading_order": 46,
      "section": "Warnings",
      "bbox": {
        "l": 149.25,
        "t": 456.8025,
        "r": 537.13105,
        "b": 429.9375
      },
      "content": "WARNING: Do not spray, pour, or spill any liquid on the N5500, its accessories, connectors, switches, or openings in the chassis.",
      "severity": "warning"
    },
    {
      "type": "admonition",
      "id": "txt_0033",
      "reading_order": 47,
      "section": "Warnings",
      "bbox": {
        "l": 149.25,
        "t": 407.3025,
        "r": 536.91975,
        "b": 380.4375
      },
      "content": "WARNING: Do not immerse the N5500 or its accessories in liquid or clean with caustic or abrasive cleaners.",
      "severity": "warning"
    },
    {
      "type": "admonition",
      "id": "txt_0034",
      "reading_order": 48,
      "section": "Warnings",
      "bbox": {
        "l": 149.25,
        "t": 357.0525,
        "r": 537.8119999999999,
        "b": 330.1875
      },
      "content": "WARNING: Ensure that conductive portions of the  electrodes, leads, and cable do not come into contact with any other conductive parts.",
      "severity": "warning"
    },
    {
      "type": "admonition",
      "id": "txt_0035",
      "reading_order": 49,
      "section": "Warnings",
      "bbox": {
        "l": 149.25,
        "t": 306.8025,
        "r": 537.8357500000002,
        "b": 279.9375
      },
      "content": "WARNING: Before attempting to open or disassemble the N5500, disconnect the power cord from the N5500",
      "severity": "warning"
    },
    {
      "type": "admonition",
      "id": "txt_0036",
      "reading_order": 50,
      "section": "Warnings",
      "bbox": {
        "l": 149.25,
        "t": 257.3025,
        "r": 536.4703000000002,
        "b": 230.4375
      },
      "content": "WARNING: The LCD panel contains  toxic  chemicals.  Do  not  ingest  chemicals from a broken LCD panel.",
      "severity": "warning"
    },
    {
      "type": "admonition",
      "id": "txt_0037",
      "reading_order": 51,
      "section": "Warnings",
      "bbox": {
        "l": 149.25,
        "t": 211.5525,
        "r": 538.3140000000003,
        "b": 171.1875
      },
      "content": "WARNING:  The  use  of  accessories,  transducers,  and  cables  other  than  those specified  may  result  in  increased  emission  and/or  decreased  immunity  of  the N5500 patient monitor.",
      "severity": "warning"
    },
    {
      "type": "admonition",
      "id": "txt_0038",
      "reading_order": 52,
      "section": "Warnings",
      "bbox": {
        "l": 149.25,
        "t": 152.3025,
        "r": 535.6614499999998,
        "b": 125.4375
      },
      "content": "WARNING: Do not  silence  the  N5500  audible  alarm  or  decrease  its  volume  if patient safety could be compromised.",
      "severity": "warning"
    }
  ],
