  "blocks": [
    {
      "type": "heading",
      "id": "txt_0265",
      "reading_order": 298,
      "section": "3.3.4.6 Serial Interface Test",
      "bbox": {
        "l": 72.0,
        "t": 700.5525,
        "r": 211.3125,
        "b": 687.1875
      },
      "content": "3.3.4.6 Serial Interface Test",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_0266",
      "reading_order": 299,
      "section": "3.3.4.6 Serial Interface Test",
      "bbox": {
        "l": 148.5,
        "t": 686.25375,
        "r": 539.0625,
        "b": 659.99625
      },
      "content": "Perform the following procedure to test the serial port. The serial connector is Dsub-15, located on the monitor's rear panel, identified with the data interface symbol (RS-232)."
    },
    {
      "type": "list_item",
      "id": "txt_0267",
      "reading_order": 300,
      "section": "3.3.4.6 Serial Interface Test",
      "bbox": {
        "l": 148.5,
        "t": 645.75375,
        "r": 455.0625,
        "b": 632.99625
      },
      "content": "1.Connect a serial cable between the N5500 monitor and PC COM1."
    },
    {
      "type": "list_item",
      "id": "txt_0268",
      "reading_order": 301,
      "section": "3.3.4.6 Serial Interface Test",
      "bbox": {
        "l": 148.5,
        "t": 618.00375,
        "r": 308.0625,
        "b": 605.24625
      },
      "content": "2.Run 'DSUB15 Test.exe' on PC."
    },
    {
      "type": "list_item",
      "id": "txt_0269",
      "reading_order": 302,
      "section": "3.3.4.6 Serial Interface Test",
      "bbox": {
        "l": 148.5,
        "t": 589.50375,
        "r": 308.0625,
        "b": 576.74625
      },
      "content": "3.Set 'BAUDRATE' to cbr57600."
    },
    {
      "type": "list_item",
      "id": "txt_0270",
      "reading_order": 303,
      "section": "3.3.4.6 Serial Interface Test",
      "bbox": {
        "l": 148.5,
        "t": 561.75375,
        "r": 247.3125,
        "b": 548.99625
      },
      "content": "4.Set 'HEX' to Hex."
    },
    {
      "type": "list_item",
      "id": "txt_0271",
      "reading_order": 304,
      "section": "3.3.4.6 Serial Interface Test",
      "bbox": {
        "l": 148.5,
        "t": 534.00375,
        "r": 266.8125,
        "b": 521.24625
      },
      "content": "5.Press the OPEN button."
    },
    {
      "type": "list_item",
      "id": "txt_0272",
      "reading_order": 305,
      "section": "3.3.4.6 Serial Interface Test",
      "bbox": {
        "l": 148.5,
        "t": 505.50375,
        "r": 538.8764999999995,
        "b": 479.24625
      },
      "content": "6.Turn the N5500 monitor on, then enter the service code, 916, in order. The monitor is now set up to 'Central Monitoring System (CMS)' mode."
    },
    {
      "type": "list_item",
      "id": "txt_0273",
      "reading_order": 306,
      "section": "3.3.4.6 Serial Interface Test",
      "bbox": {
        "l": 148.5,
        "t": 463.50375,
        "r": 405.5625,
        "b": 450.74625
      },
      "content": "7.Verify that first two transferred numbers are 55 and 01."
    },
    {
      "type": "list_item",
      "id": "txt_0274",
      "reading_order": 307,
      "section": "3.3.4.6 Serial Interface Test",
      "bbox": {
        "l": 148.5,
        "t": 435.75375,
        "r": 358.3125,
        "b": 422.99625
      },
      "content": "8.Press the CLOSE button to exit the program."
    },
    {
      "type": "list_item",
      "id": "txt_0275",
      "reading_order": 308,
      "section": "3.3.4.6 Serial Interface Test",
      "bbox": {
        "l": 148.5,
        "t": 408.00375,
        "r": 404.8125,
        "b": 395.24625
      },
      "content": "9.Enter the service code, 900, in order to exit CMS mode."
    },
    {
      "type": "heading",
      "id": "txt_0276",
      "reading_order": 309,
      "section": "3.3.4.7 Network Test",
      "bbox": {
        "l": 72.0,
        "t": 380.3025,
        "r": 179.0625,
        "b": 366.9375
      },
      "content": "3.3.4.7 Network Test",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_0277",
      "reading_order": 310,
      "section": "3.3.4.7 Network Test",
      "bbox": {
        "l": 148.5,
        "t": 366.00375,
        "r": 538.4997,
        "b": 339.74625
      },
      "content": "Perform the following procedure to test the Network. The Network connector is located on the monitor's rear panel, identified with the Network symbol."
    },
    {
      "type": "list_item",
      "id": "txt_0278",
      "reading_order": 311,
      "section": "3.3.4.7 Network Test",
      "bbox": {
        "l": 148.5,
        "t": 325.50375,
        "r": 505.3125,
        "b": 312.74625
      },
      "content": "Connect a network line to the N5500 monitor, then turn the N5500 monitor on."
    },
    {
      "type": "list_item",
      "id": "txt_0279",
      "reading_order": 312,
      "section": "3.3.4.7 Network Test",
      "bbox": {
        "l": 148.5,
        "t": 297.00375,
        "r": 537.6873500000003,
        "b": 270.7462499999999
      },
      "content": "Run 'RJ45 Test.exe' on PC connected the network line using the same gateway as the N5500."
    },
    {
      "type": "list_item",
      "id": "txt_0280",
      "reading_order": 313,
      "section": "3.3.4.7 Network Test",
      "bbox": {
        "l": 148.5,
        "t": 255.00374999999997,
        "r": 275.8125,
        "b": 242.24625000000003
      },
      "content": "Press the PROBE button."
    },
    {
      "type": "list_item",
      "id": "txt_0281",
      "reading_order": 314,
      "section": "3.3.4.7 Network Test",
      "bbox": {
        "l": 148.5,
        "t": 227.25374999999997,
        "r": 464.8125,
        "b": 214.49625000000003
      },
      "content": "Verify that the number of N5500 connections to PC found is correct."
    },
    {
      "type": "list_item",
      "id": "txt_0282",
      "reading_order": 315,
      "section": "3.3.4.7 Network Test",
      "bbox": {
        "l": 148.5,
        "t": 199.50374999999997,
        "r": 379.3125,
        "b": 186.74625000000003
      },
      "content": "Press the EXIT button to close 'RJ45 Test.exe'."
    },
    {
      "type": "admonition",
      "id": "txt_0283",
      "reading_order": 316,
      "section": "3.3.4.7 Network Test",
      "bbox": {
        "l": 138.75,
        "t": 158.3025,
        "r": 539.2282999999996,
        "b": 131.4375
      },
      "content": "CAUTION: Do not change any other settings of the test programs while performing the serial test and the Network test.",
      "severity": "caution"
    },
