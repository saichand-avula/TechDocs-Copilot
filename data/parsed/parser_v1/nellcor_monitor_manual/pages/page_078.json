        "r": 470.0625,
        "b": 560.99625
      },
      "content": "To ship the monitor for any reason, follow the instructions in this section.",
      "section_id": "sec_8_1",
      "parent_section_id": "sec_6",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_6",
