    {
      "type": "paragraph",
      "id": "txt_0574",
      "reading_order": 624,
      "section": "Obtaining Replacement Parts",
      "bbox": {
        "l": 147.75,
        "t": 155.25374999999997,
        "r": 539.0620500000002,
        "b": 115.49625000000003
      },
      "content": "Nellcor  Technical  Services  provides  technical  assistance  information  and  replacement parts. To obtain replacement parts, contact Nellcor or your local Nellcor representative. Refer to parts by the part names and part numbers listed in Spare Parts section.",
