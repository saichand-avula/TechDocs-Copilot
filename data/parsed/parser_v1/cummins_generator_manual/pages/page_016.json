      "section": "CONTROL TROUBLESHOOTING",
      "bbox": {
        "l": 342.53819999999996,
        "t": 606.4038068359374,
        "r": 517.8792999999994,
        "b": 596.4882492035387
      },
      "content": "Engine cranks but does not start.",
      "section_id": "sec_auto_247",
      "parent_section_id": "sec_3",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_3",
