        "b": 727.2077469606776
      },
      "content": "CRANKCASE BREATHER",
      "level": 2,
      "section_id": "sec_auto_684",
      "section_path": [
        {
          "id": "sec_8",
          "title": "8. Routine Maintenance"
        },
