    {
      "type": "paragraph",
      "id": "txt_0556",
      "reading_order": 587,
      "section": "COOLING SYSTEM",
      "bbox": {
        "l": 47.56539999999998,
        "t": 718.5436068359375,
        "r": 291.44310000000024,
        "b": 670.7011492035388
      },
      "content": "The cooling system must be filled with coolant before the generator set can be operated. Cooling system capacity is listed in the Specifications section.",
      "section_id": "sec_auto_586",
      "parent_section_id": "sec_8",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_8",
