        "r": 399.9154000000001,
        "b": 588.2534469606776
      },
      "content": "Coolant Level",
      "level": 2,
      "section_id": "sec_auto_597",
      "section_path": [
        {
          "id": "sec_8",
          "title": "8. Routine Maintenance"
        },
        {
          "id": "sec_auto_597",
          "title": "Coolant Level"
        }
      ],
      "parent_section_id": "sec_8",
      "section_level": 2,
      "page": 48,
