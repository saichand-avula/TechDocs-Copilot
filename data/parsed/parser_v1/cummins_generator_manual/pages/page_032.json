  "blocks": [
    {
      "type": "heading",
      "id": "txt_0372",
      "reading_order": 389,
      "section": "Rotor Disassembly",
      "bbox": {
        "l": 47.5654,
        "t": 738.0270068359374,
        "r": 156.5218,
        "b": 727.2077469606776
      },
      "content": "Rotor Disassembly",
      "level": 2,
      "role": "section"
    },
    {
      "type": "list_item",
      "id": "txt_0373",
      "reading_order": 390,
      "section": "Rotor Disassembly",
      "bbox": {
        "l": 55.8425,
        "t": 714.8586068359375,
        "r": 291.6506000000004,
        "b": 666.9568519502826
      },
      "content": "Place the rotor assembly on a wood block in the horizontal position. The drive disc and fan should not be resting on anything, or distortion may occur."
    },
    {
      "type": "list_item",
      "id": "txt_0374",
      "reading_order": 391,
      "section": "Rotor Disassembly",
      "bbox": {
        "l": 55.84140000000001,
        "t": 653.2333068359375,
        "r": 291.5999999999998,
        "b": 618.0331492035388
      },
      "content": "Remove the six bolts that hold the drive disk and fan to the rotor hub.  Remove the drive disk and fan."
    },
    {
      "type": "list_item",
      "id": "txt_0375",
      "reading_order": 392,
      "section": "Rotor Disassembly",
      "bbox": {
        "l": 55.84140000000001,
        "t": 604.2514068359375,
        "r": 291.3701000000002,
        "b": 581.6935492035387
      },
      "content": "Use a gear puller to remove the end bearing from the rotor shaft."
    },
    {
      "type": "admonition",
      "id": "txt_0376",
      "reading_order": 393,
      "section": "Rotor Disassembly",
      "bbox": {
        "l": 69.16560000000001,
        "t": 566.7767068359375,
        "r": 291.4184000000003,
        "b": 518.9321519502827
      },
      "content": "CAUTION The  end  bearing  will  be  damaged if pulled on the outer race.  If the bearing must be removed, replace it; this bearing should not be reused.",
      "severity": "caution"
    },
    {
      "type": "heading",
      "id": "txt_0377",
      "reading_order": 394,
      "section": "Rotor Bearing Replacement",
      "bbox": {
        "l": 47.5654,
        "t": 505.18920683593745,
        "r": 206.01579999999998,
        "b": 494.36994696067757
      },
      "content": "Rotor Bearing Replacement",
      "level": 2,
      "role": "section"
    },
    {
      "type": "list_item",
      "id": "txt_0378",
      "reading_order": 395,
      "section": "Rotor Bearing Replacement",
      "bbox": {
        "l": 55.8425,
        "t": 485.9326068359375,
        "r": 288.29560000000026,
        "b": 476.01704920353876
      },
      "content": "Clean the bearing and shaft mating surfaces."
    },
    {
      "type": "list_item",
      "id": "txt_0379",
      "reading_order": 396,
      "section": "Rotor Bearing Replacement",
      "bbox": {
        "l": 329.2156,
        "t": 737.9888068359376,
        "r": 564.9719999999994,
        "b": 715.4309492035388
      },
      "content": "Apply Loctite #680 adhesive to the shaft mating surface."
    },
    {
      "type": "list_item",
      "id": "txt_0380",
      "reading_order": 397,
      "section": "Rotor Bearing Replacement",
      "bbox": {
        "l": 329.2156,
        "t": 707.6013068359376,
        "r": 564.7091000000005,
        "b": 685.0434492035389
      },
      "content": "Apply Loctite #747 activator to the bearing mating surface."
    },
    {
      "type": "list_item",
      "id": "txt_0381",
      "reading_order": 398,
      "section": "Rotor Bearing Replacement",
      "bbox": {
        "l": 329.2145,
        "t": 677.1577068359377,
        "r": 564.9092999999996,
        "b": 654.599849203539
      },
      "content": "Install the bearing and allow ten minutes curing time before handling the assembly."
    },
    {
      "type": "heading",
      "id": "txt_0382",
      "reading_order": 399,
      "section": "Rotor Reassembly",
      "bbox": {
        "l": 320.9386,
        "t": 640.2884068359375,
        "r": 426.5482000000001,
        "b": 629.4691469606777
      },
      "content": "Rotor Reassembly",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_0383",
      "reading_order": 400,
      "section": "Rotor Reassembly",
      "bbox": {
        "l": 320.9386,
        "t": 613.7184068359375,
        "r": 564.8580999999998,
        "b": 540.5913492035388
      },
      "content": "After  necessary  service  checks  and  repairs  are made, the rotor and generator set are reassembled using the reverse procedure of disassembly except for the rotor as noted below.  Regrease the O-ring using moly grease only.  Apply required torque value shown in Figure 5-9."
    },
    {
      "type": "admonition",
      "id": "txt_0384",
      "reading_order": 401,
      "section": "Rotor Reassembly",
      "bbox": {
        "l": 320.93820000000005,
        "t": 523.8602068359376,
        "r": 565.0545999999997,
        "b": 476.01565195028275
      },
      "content": "CAUTION The drive disk will be damaged if the bolts are tightened and it is not properly centered.  Center the disk accurately before beginning to tighten the drive disk.",
      "severity": "caution"
    },
