    {
      "type": "paragraph",
      "id": "txt_0173",
      "reading_order": 177,
      "section": "Engine Temperature Monitors",
      "bbox": {
        "l": 47.5654,
        "t": 680.2763068359375,
        "r": 291.56849999999986,
        "b": 617.4949068359375
      },
      "content": "Coolant Temperature Sender E2: The resistance of the sender unit changes with the engine coolant temperature and causes a reading on the coolant temperature meter (optional).  The meter range is 100  to 250  F (40  to 121  C).",
      "section_id": "sec_auto_175",
      "parent_section_id": "sec_3",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_3",
          "title": "3. Engine Controls"
        },
        {
          "id": "sec_auto_175",
