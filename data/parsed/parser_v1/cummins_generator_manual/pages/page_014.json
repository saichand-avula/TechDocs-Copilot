    },
    {
      "type": "paragraph",
      "id": "txt_0174",
      "reading_order": 178,
      "section": "Engine Temperature Monitors",
      "bbox": {
        "l": 47.56540000000001,
        "t": 605.9514068359375,
        "r": 291.4013,
        "b": 557.0878492035388
      },
      "content": "High  Coolant  Temperature  Switch  S2: This switch  closes  if  the  coolant  temperature  rises  to 250  F (121  C), activating the fault breaker CB12 and stopping the engine.",
      "section_id": "sec_auto_175",
      "parent_section_id": "sec_3",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_3",
