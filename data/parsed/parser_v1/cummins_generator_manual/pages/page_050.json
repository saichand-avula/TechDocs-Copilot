      "semantic_role": "caution",
      "source": "pdf_text"
    },
    {
      "type": "heading",
      "id": "txt_0577",
      "reading_order": 609,
      "section": "Thermostat",
      "bbox": {
        "l": 47.5645,
        "t": 327.7034068359376,
        "r": 107.45949999999999,
        "b": 317.7857519502827
      },
      "content": "Thermostat",
      "level": 2,
      "section_id": "sec_auto_609",
      "section_path": [
        {
          "id": "sec_8",
          "title": "8. Routine Maintenance"
        },
        {
          "id": "sec_auto_609",
          "title": "Thermostat"
        }
      ],
      "parent_section_id": "sec_8",
      "section_level": 2,
      "page": 50,
      "chunk_hint": "section_heading",
      "semantic_role": "section_heading",
      "source": "pdf_text"
    },
    {
      "type": "paragraph",
      "id": "txt_0578",
      "reading_order": 610,
      "section": "Thermostat",
      "bbox": {
        "l": 47.5645,
        "t": 294.36790683593756,
        "r": 291.6764999999999,
        "b": 221.2408492035388
      },
      "content": "If the engine overheats or does not reach and maintain  a  minimum  operating  temperature,  have  the thermostat removed and tested.  Replace the thermostat with the gasket if necessary.  See the Engine Workshop Manual for instructions on thermostat removal and testing.",
      "section_id": "sec_auto_609",
      "parent_section_id": "sec_8",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_8",
          "title": "8. Routine Maintenance"
        },
        {
          "id": "sec_auto_609",
          "title": "Thermostat"
        }
      ],
      "page": 50,
      "chunk_hint": "section_start",
