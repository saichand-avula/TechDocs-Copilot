      "bbox": {
        "l": 320.9386,
        "t": 594.2538068359374,
        "r": 435.81220000000013,
        "b": 583.4345469606776
      },
      "content": "Testing for Grounds",
      "level": 2,
      "section_id": "sec_auto_467",
      "section_path": [
        {
          "id": "sec_7",
          "title": "7. Generator Set/Regulator Tests"
        },
        {
          "id": "sec_auto_467",
          "title": "Testing for Grounds"
        }
      ],
      "parent_section_id": "sec_7",
