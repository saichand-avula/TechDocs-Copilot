    },
    {
      "type": "list_item",
      "id": "txt_0626",
      "reading_order": 660,
      "section": "Storage Requirements:",
      "bbox": {
        "l": 330.29409999999996,
        "t": 583.9077068359376,
        "r": 564.9890000000005,
        "b": 522.392249203539
      },
      "content": " If  using  bio -diesel  for  seasonal  applications (stored more than 90 days), the generator must be purged before storage by running the engine on pure diesel fuel meeting ASTM D975 for a mininmum of 30 minutes.",
      "section_id": "sec_auto_659",
      "parent_section_id": "sec_8",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_8",
