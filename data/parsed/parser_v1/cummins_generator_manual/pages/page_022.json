      },
      "content": "POWER RELAY CHECK (A11-K12)",
      "level": 2,
      "section_id": "sec_auto_308",
      "section_path": [
        {
          "id": "sec_4",
          "title": "4. Engine Control Service"
        },
        {
          "id": "sec_auto_308",
