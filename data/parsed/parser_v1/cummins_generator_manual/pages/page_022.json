        "l": 329.2117000000001,
        "t": 296.41130683593775,
        "r": 523.4903999999997,
        "b": 286.495749203539
      },
      "content": "Push the generator set STOP button.",
      "section_id": "sec_auto_308",
      "parent_section_id": "sec_4",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_4",
          "title": "4. Engine Control Service"
        },
        {
          "id": "sec_auto_308",
