      "content": "FUEL SOLENOID CHECK (K14)",
      "level": 2,
      "section_id": "sec_auto_298",
      "section_path": [
        {
          "id": "sec_4",
          "title": "4. Engine Control Service"
        },
        {
          "id": "sec_auto_298",
