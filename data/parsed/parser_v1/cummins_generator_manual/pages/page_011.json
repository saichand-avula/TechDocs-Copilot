    {
      "type": "paragraph",
      "id": "txt_0148",
      "reading_order": 150,
      "section": "Switches",
      "bbox": {
        "l": 47.56539999999998,
        "t": 403.4444068359375,
        "r": 291.6807,
        "b": 342.95964920353885
      },
      "content": "Start-Stop/Preheat Switch S11: Starts and stops the unit locally.  Preheat function occurs when the switch is held in the Stop position.  The unit may also be operated from a remote switch wired to receptacle J3 on the rear panel.",
      "section_id": "sec_auto_149",
      "parent_section_id": "sec_3",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_3",
          "title": "3. Engine Controls"
