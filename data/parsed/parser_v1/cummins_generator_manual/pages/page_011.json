      "source": "pdf_text"
    },
    {
      "type": "heading",
      "id": "txt_0144",
      "reading_order": 146,
      "section": "START CONTROL AT SET",
      "bbox": {
        "l": 95.8677,
        "t": 589.3782068359375,
        "r": 243.0429000000001,
        "b": 578.5589469606776
      },
      "content": "START CONTROL AT SET",
      "level": 2,
      "section_id": "sec_auto_146",
      "section_path": [
        {
          "id": "sec_3",
          "title": "3. Engine Controls"
        },
        {
          "id": "sec_auto_146",
          "title": "START CONTROL AT SET"
        }
      ],
      "parent_section_id": "sec_3",
