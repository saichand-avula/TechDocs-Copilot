    {
      "type": "paragraph",
      "id": "txt_0150",
      "reading_order": 152,
      "section": "Circuit Breakers",
      "bbox": {
        "l": 47.56539999999998,
        "t": 304.1752068359375,
        "r": 291.3947,
        "b": 256.3327492035388
      },
      "content": "DC  Control  Breaker  CB11: A  15  ampere  DC breaker providing protection to the control box wiring and remote wiring from short circuits or overload.  Also serves as an emergency stop switch.",
      "section_id": "sec_auto_151",
      "parent_section_id": "sec_3",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_3",
          "title": "3. Engine Controls"
        },
        {
          "id": "sec_auto_151",
          "title": "Circuit Breakers"
        }
      ],
      "page": 11,
      "chunk_hint": "section_start",
      "semantic_role": "overview",
      "source": "pdf_text"
    },
    {
      "type": "paragraph",
      "id": "txt_0151",
      "reading_order": 153,
      "section": "Circuit Breakers",
      "bbox": {
        "l": 47.56539999999998,
        "t": 241.5874068359376,
        "r": 291.5256000000001,
        "b": 206.38724920353877
      },
      "content": "Fault Breaker CB12: A manual reset breaker that shuts down the engine for low oil pressure and high coolant temperatures.",
      "section_id": "sec_auto_151",
      "parent_section_id": "sec_3",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_3",
