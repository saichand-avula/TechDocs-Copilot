    {
      "type": "paragraph",
      "id": "txt_0050",
      "reading_order": 64,
      "section": "1.5 USER QUALIFICATION",
      "bbox": {
        "l": 107.99987590110001,
        "t": 586.98277681,
        "r": 540.0047520404989,
        "b": 518.0882446880331
      },
      "content": "The   infusion system is intended for use at the direction or under the supervision of licensed physicians or certified healthcare professionals who are trained in the use of the infuser and the administration of parenteral and enteral fluids and drugs, and whole blood or red blood cell components. Training should emphasize preventing related IV complications, including appropriate precautions to prevent accidental infusion of air. The epidural route can be used to provide anesthesia or analgesia.",
      "section_id": "sec_1_5",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
