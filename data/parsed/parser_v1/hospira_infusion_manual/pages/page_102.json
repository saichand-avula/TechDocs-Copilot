    },
    {
      "type": "paragraph",
      "id": "txt_0900",
      "reading_order": 979,
      "section": "PERIPHERAL COVER REPLACEMENT",
      "bbox": {
        "l": 72.0,
        "t": 320.28276,
        "r": 503.9651999999998,
        "b": 299.3875290491803
      },
      "content": "Recommended tools for this procedure are a 5/16 nutdriver, custom nutdriver, long needle nose pliers, and a #2 Phillips screwdriver."
    },
    {
      "type": "paragraph",
