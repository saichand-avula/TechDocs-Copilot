      "bbox": {
        "l": 89.99971199999999,
        "t": 266.2836239999999,
        "r": 180.1685880000001,
        "b": 257.52719203278684
      },
      "content": "Cover, Peripheral"
    },
    {
      "type": "paragraph",
      "id": "txt_0903",
      "reading_order": 982,
      "section": "PERIPHERAL COVER REPLACEMENT",
      "bbox": {
