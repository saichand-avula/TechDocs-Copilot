    },
    {
      "type": "paragraph",
      "id": "txt_0905",
      "reading_order": 984,
      "section": "PERIPHERAL COVER REPLACEMENT",
      "bbox": {
        "l": 89.99971199999999,
        "t": 168.2453519999999,
