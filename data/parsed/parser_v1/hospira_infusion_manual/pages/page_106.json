      "section": "Gasket, Shoe",
      "bbox": {
        "l": 89.58039599999992,
        "t": 531.484104,
        "r": 467.1669839999991,
        "b": 522.5886810491803
      },
      "content": "Install the replacement shoe gaskets in the exact reverse order of removal.",
      "section_id": "sec_auto_1042",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1-800-241-4002"
        },
        {
          "id": "sec_auto_1042",
