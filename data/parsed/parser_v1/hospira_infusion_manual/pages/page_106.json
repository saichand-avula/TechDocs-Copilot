      },
      "content": "To replace the shoe gaskets, see Figure 7-8 , then proceed as follows:",
      "hyperlink_hint": true,
      "section_id": "sec_auto_1042",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
