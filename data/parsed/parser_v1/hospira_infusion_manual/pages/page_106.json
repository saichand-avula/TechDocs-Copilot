      "bbox": {
        "l": 89.58039599999992,
        "t": 516.064032,
        "r": 504.117588,
        "b": 495.70863304918026
      },
      "content": "Join the front enclosure, main chassis assembly, and rear enclosure in the exact reverse order of separation.",
      "section_id": "sec_auto_1042",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1-800-241-4002"
        },
        {
          "id": "sec_auto_1042",
          "title": "Gasket, Shoe"
        }
      ],
      "page": 106,
