      "section": "Gasket, Shoe",
      "bbox": {
        "l": 89.57939999999999,
        "t": 616.144104,
        "r": 408.2326679999995,
        "b": 607.2486810491803
      },
      "content": "Turn off the infuser and disconnect the device from AC power.",
      "section_id": "sec_auto_1042",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
