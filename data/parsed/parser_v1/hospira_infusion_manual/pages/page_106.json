        "t": 489.18398399999995,
        "r": 384.51890399999945,
        "b": 480.28856104918026
      },
      "content": "Reinstall the battery and connect the device to AC power.",
      "section_id": "sec_auto_1042",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
