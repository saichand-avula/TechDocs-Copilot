      "section": "Gasket, Shoe",
      "bbox": {
        "l": 89.58039599999995,
        "t": 558.364152,
        "r": 503.9084279999998,
        "b": 538.0087530491803
      },
      "content": "Remove the shoe gaskets from the front and back of the front enclosure as shown in Figure 7-8 .",
      "section_id": "sec_auto_1042",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1-800-241-4002"
        },
        {
          "id": "sec_auto_1042",
