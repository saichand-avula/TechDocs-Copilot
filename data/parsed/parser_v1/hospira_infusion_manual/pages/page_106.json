      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0966",
      "reading_order": 1046,
      "section": "Gasket, Shoe",
      "bbox": {
        "l": 89.57939999999996,
        "t": 585.2442,
        "r": 504.1484640000005,
        "b": 564.8888010491803
      },
      "content": "Separate  the  front  enclosure,  rear  enclosure,  and  main  chassis  assembly as described in Section 7.2.8 .",
      "section_id": "sec_auto_1042",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
