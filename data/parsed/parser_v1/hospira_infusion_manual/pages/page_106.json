      "reading_order": 1045,
      "section": "Gasket, Shoe",
      "bbox": {
        "l": 89.57939999999999,
        "t": 600.664272,
        "r": 344.046444,
        "b": 591.7688490491803
      },
      "content": "Remove the battery as described in Section 7.2.4 .",
      "section_id": "sec_auto_1042",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
