    },
    {
      "type": "paragraph",
      "id": "txt_0785",
      "reading_order": 856,
      "section": "SAFETY AND EQUIPMENT PRECAUTIONS",
      "bbox": {
        "l": 108.0,
        "t": 588.2427600000001,
        "r": 540.0867119999994,
        "b": 567.3475290491804
      },
      "content": "Before  opening  the  front  enclosure  of  the  infuser,  take  all  necessary  precautions  for working on high-voltage equipment."
    },
    {
      "type": "admonition",
      "id": "txt_0786",
      "reading_order": 857,
      "severity": "warning",
      "content": "WARNING: POSSIBLE  EXPLOSION  HAZARD  EXISTS  IF  THE  INFUSER IS SERVICED IN THE PRESENCE OF FLAMMABLE ANESTHETICS.",
      "section": "SAFETY AND EQUIPMENT PRECAUTIONS",
      "bbox": {
        "l": 132.95976000000002,
        "t": 539.5920000000001,
        "r": 185.11629600000015,
        "b": 530.379
      }
    },
    {
      "type": "admonition",
      "id": "txt_0788",
      "reading_order": 859,
      "severity": "warning",
      "content": "WARNING: UNLESS  OTHERWISE  INDICATED,  DISCONNECT  THE  INFUSER FROM  AC  POWER  BEFORE  PERFORMING  ADJUSTMENTS OR REPLACEMENT PROCEDURES.",
      "section": "SAFETY AND EQUIPMENT PRECAUTIONS",
      "bbox": {
        "l": 132.95976000000002,
        "t": 484.631724,
        "r": 185.123268,
        "b": 475.41872400000005
      }
    },
    {
      "type": "admonition",
      "id": "txt_0790",
      "reading_order": 861,
      "section": "SAFETY AND EQUIPMENT PRECAUTIONS",
      "bbox": {
        "l": 108.0,
        "t": 429.651672,
        "r": 540.017987999999,
        "b": 396.46069230936223
      },
      "content": "CAUTION: Use  proper  ESD  grounding  techniques  when  handling  components. Wear an antistatic wrist strap and use an ESD-protected workstation. Store PWAs in antistatic bags before placing them on any surface.",
      "severity": "caution"
    },
