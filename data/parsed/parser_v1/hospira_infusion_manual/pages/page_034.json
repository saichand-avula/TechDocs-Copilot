    {
      "type": "paragraph",
      "id": "txt_0237",
      "reading_order": 267,
      "section": "4.2.1.14 FRONT PANEL ON/OFF KEY",
      "bbox": {
        "l": 71.99999999999997,
        "t": 295.68285681,
        "r": 504.0097565442997,
        "b": 262.7877848320327
      },
      "content": "The ON/OFF key on the front panel provides a start up (STRTUP) signal to wake up the power supply when the system is shutdown. When activated during normal operation, the ON/OFF key interrupts (STRUPD*) the CPU, signaling a request for shutdown.",
      "section_id": "sec_4_2_1_14",
      "parent_section_id": "sec_auto_263",
