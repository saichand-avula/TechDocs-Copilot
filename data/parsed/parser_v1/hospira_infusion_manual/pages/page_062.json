      "section": "CAUTION: Do not place the infuser in service if the self test fails.",
      "bbox": {
        "l": 89.58132303510001,
        "t": 243.243176726,
        "r": 503.98735950499935,
        "b": 222.94741779793276
      },
      "content": "After the self test is complete, the message 'INSERT PLUM SET CLOSE LEVER' appears.",
      "section_id": "sec_auto_575",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_575",
