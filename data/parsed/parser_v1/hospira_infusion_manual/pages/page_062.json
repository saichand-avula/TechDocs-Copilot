        "b": 631.2473249280329
      },
      "content": "To set up the infuser for the PVT, proceed as follows:",
      "section_id": "sec_auto_567",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_567",
