      "reading_order": 582,
      "section": "CAUTION: Do not place the infuser in service if the self test fails.",
      "bbox": {
        "l": 108.0,
        "t": 267.36009,
        "r": 448.44845134310003,
        "b": 250.36742492803273
      },
      "content": " Note: If the SELF TEST screen does not appear, contact Hospira.",
      "section_id": "sec_auto_575",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_575",
