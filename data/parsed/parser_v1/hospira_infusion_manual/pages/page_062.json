      "page": 62,
      "chunk_hint": "section_start",
      "semantic_role": "overview",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0520",
      "reading_order": 569,
      "section": "WARNING: DURING TESTING.",
      "bbox": {
        "l": 89.5805132511,
        "t": 620.1022206890001,
        "r": 416.6274016110996,
        "b": 611.2067888070329
      },
      "content": "Confirm the infuser and appropriate accessories are assembled.",
      "section_id": "sec_auto_567",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_567",
          "title": "WARNING: DURING TESTING."
        }
      ],
      "page": 62,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0521",
      "reading_order": 570,
      "section": "WARNING: DURING TESTING.",
      "bbox": {
        "l": 89.58051325109997,
        "t": 607.9589764970001,
        "r": 504.02648936110046,
        "b": 584.326713819033
      },
      "content": "Hang two sterile water containers at a height of 46 cm ± 15.3 cm above the pumping chamber of the infuser.",
      "section_id": "sec_auto_567",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_567",
          "title": "WARNING: DURING TESTING."
        }
      ],
      "page": 62,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0522",
      "reading_order": 571,
      "section": "WARNING: DURING TESTING.",
      "bbox": {
        "l": 89.58041365099996,
        "t": 577.8020582190002,
        "r": 504.0770862119002,
        "b": 568.906626337033
      },
      "content": "Connect the infuser to AC power, and press the ON/OFF key to turn on the device.",
      "section_id": "sec_auto_567",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_567",
          "title": "WARNING: DURING TESTING."
        }
      ],
      "page": 62,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0523",
      "reading_order": 572,
      "section": "WARNING: DURING TESTING.",
      "bbox": {
        "l": 89.58041365099996,
        "t": 562.3819707370002,
        "r": 503.95069368500043,
        "b": 542.0265513490331
      },
      "content": "Verify  the  infuser  is  in  the unlocked mode.  Toggling  the  [LOCKOUT]  switch alternates between unlocked [DOWN] and locked [UP] modes.",
      "section_id": "sec_auto_567",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_567",
          "title": "WARNING: DURING TESTING."
        }
      ],
      "page": 62,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
