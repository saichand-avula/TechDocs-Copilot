        "r": 503.9401072020999,
        "b": 418.78750488003277
      },
      "content": " Note: Conduct all tests with the infuser connected to AC power unless otherwise specified.",
      "section_id": "sec_auto_575",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
