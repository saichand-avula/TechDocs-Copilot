        "t": 535.5018957490003,
        "r": 203.08468761100013,
        "b": 526.6064638670331
      },
      "content": "Turn off the infuser.",
      "section_id": "sec_auto_567",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_567",
