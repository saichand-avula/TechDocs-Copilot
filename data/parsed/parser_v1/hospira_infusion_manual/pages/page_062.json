    {
      "type": "list_item",
      "id": "txt_0528",
      "reading_order": 577,
      "section": "CAUTION: Do not place the infuser in service if the self test fails.",
      "bbox": {
        "l": 72.0,
        "t": 410.45999,
        "r": 504.01181927410084,
        "b": 357.46786478403277
      },
      "content": " Note: If an alarm condition occurs during the self test, cycle the power and repeat the self test. If the alarm condition recurs, note the message and take corrective action (see Section 6) . Repeat the self test. If the alarm condition continues to recur, remove the infuser from service and contact Hospira.",
      "section_id": "sec_auto_575",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_575",
          "title": "CAUTION: Do not place the infuser in service if the self test fails."
        }
      ],
      "page": 62,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
