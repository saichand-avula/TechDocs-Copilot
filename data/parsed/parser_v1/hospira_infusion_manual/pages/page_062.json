    },
    {
      "type": "list_item",
      "id": "txt_0536",
      "reading_order": 585,
      "section": "CAUTION: Do not place the infuser in service if the self test fails.",
      "bbox": {
        "l": 89.58122343499997,
        "t": 200.94291465590004,
        "r": 504.07102358900096,
        "b": 169.18716822183285
      },
      "content": "Open the  cassette  door  and  insert  a  primed  cassette.  Close  the  cassette  door. The cassette test is complete when the 'CASSETTE TEST IN PROGRESS' message disappears.",
      "section_id": "sec_auto_575",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_575",
