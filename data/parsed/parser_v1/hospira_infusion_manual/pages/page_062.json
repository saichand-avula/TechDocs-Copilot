    {
      "type": "list_item",
      "id": "txt_0535",
      "reading_order": 584,
      "section": "CAUTION: Do not place the infuser in service if the self test fails.",
      "bbox": {
        "l": 89.58012783389998,
        "t": 216.36300213790003,
        "r": 437.22840047799997,
        "b": 207.46757025593286
      },
      "content": "Verify the time and date. To set the time and date, see Section 1.9.2 .",
      "section_id": "sec_auto_575",
      "parent_section_id": null,
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_auto_575",
