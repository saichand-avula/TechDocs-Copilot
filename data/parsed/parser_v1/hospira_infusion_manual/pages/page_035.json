    {
      "type": "paragraph",
      "id": "txt_0243",
      "reading_order": 273,
      "section": "4.2.1.17 NURSE CALL INTERFACE",
      "bbox": {
        "l": 107.99999999999997,
        "t": 602.10277681,
        "r": 539.990533725,
        "b": 557.207884784033
      },
      "content": "A nurse call relay switch on the peripheral PWA indicates alarm conditions to a remote operator.  A  memory-mapped  output  signal  (NURSE)  activates  the  relay  during  alarm conditions. The relay has both normally open and normally closed contacts. A jumper on the peripheral board selects the contact type. The factory setting is normally open.",
      "section_id": "sec_4_2_1_17",
      "parent_section_id": "sec_auto_263",
      "section_level": 4,
      "section_path": [
        {
          "id": "sec_auto_263",
