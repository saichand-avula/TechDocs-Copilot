    {
      "type": "paragraph",
      "id": "txt_0590",
      "reading_order": 640,
      "section": "ALARM LOUDNESS TEST",
      "bbox": {
        "l": 108.0,
        "t": 250.08276681000007,
        "r": 378.3366830221005,
        "b": 241.18733492803278
      },
      "content": "To perform the alarm loudness test, proceed as follows:"
    },
    {
      "type": "list_item",
      "id": "txt_0591",
      "reading_order": 641,
      "section": "ALARM LOUDNESS TEST",
      "bbox": {
        "l": 125.57961685019995,
        "t": 226.08302711390002,
        "r": 316.6066326442,
        "b": 217.18759523193285
      },
      "content": "Press the [A] softkey to select line A."
    },
    {
      "type": "list_item",
      "id": "txt_0592",
      "reading_order": 642,
      "section": "ALARM LOUDNESS TEST",
      "bbox": {
        "l": 125.57961685019995,
        "t": 210.66293963190003,
        "r": 360.48645270019955,
        "b": 201.76750774993275
      },
      "content": "Enter a rate of 400 mL/hr and VTBI of 1 mL."
    },
    {
      "type": "list_item",
      "id": "txt_0593",
      "reading_order": 643,
      "section": "ALARM LOUDNESS TEST",
      "bbox": {
        "l": 125.57961685019995,
        "t": 195.24285214990005,
        "r": 539.9779841124001,
        "b": 174.8874327619328
      },
      "content": "Press [START] and verify the 'CONFIRM PROGRAM?' message is displayed. If rate and VTBI are correct, press [YES]."
    },
    {
      "type": "list_item",
      "id": "txt_0594",
      "reading_order": 644,
      "section": "ALARM LOUDNESS TEST",
      "bbox": {
        "l": 125.5796168501999,
        "t": 168.3627771619,
        "r": 539.8024887362013,
        "b": 148.00735777393277
      },
      "content": "Verify fluid is pumping, the message 'PUMPING' is displayed in the line A status bar, and the line A LED flashes."
    },
    {
      "type": "list_item",
      "id": "txt_0595",
      "reading_order": 645,
      "section": "ALARM LOUDNESS TEST",
      "bbox": {
        "l": 125.5796168501999,
        "t": 141.48270217389995,
        "r": 428.41372090019934,
        "b": 132.58727029193278
      },
      "content": "Verify the alarm sounds when the dose has been delivered."
    },
    {
      "type": "list_item",
      "id": "txt_0596",
      "reading_order": 646,
      "section": "ALARM LOUDNESS TEST",
      "bbox": {
        "l": 125.5796168501999,
        "t": 126.00285463189994,
        "r": 539.9649364993,
        "b": 105.70709570383269
      },
      "content": "Turn the volume control knob between HIGH and LOW (see Figure 5-2) . Verify the alarm loudness changes.",
      "hyperlink_hint": true
    },
    {
      "type": "list_item",
      "id": "txt_0597",
      "reading_order": 647,
      "section": "ALARM LOUDNESS TEST",
      "bbox": {
        "l": 125.57941764999981,
        "t": 99.12268004379996,
        "r": 416.11221214930055,
        "b": 90.22724816183268
      },
      "content": "Press the SILENCE key, and verify the alarm is silenced."
    },
    {
      "type": "list_item",
      "id": "txt_0598",
      "reading_order": 648,
      "section": "ALARM LOUDNESS TEST",
      "bbox": {
        "l": 125.57941764999981,
        "t": 83.70259256179997,
        "r": 205.96755476089993,
        "b": 74.80716067983269
      },
      "content": "Press [STOP]."
    }
