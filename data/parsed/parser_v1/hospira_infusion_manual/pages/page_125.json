        "r": 502.13911200000047,
        "b": 607.2484890491804
      },
      "content": "To replace the opener handle assembly, see Figure 7-16 , then proceed as follows:",
      "hyperlink_hint": true,
      "section_id": "sec_auto_1320",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1-800-241-4002"
        },
        {
          "id": "sec_auto_1320",
          "title": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32"
        }
      ],
      "page": 125,
      "chunk_hint": "section_start",
      "semantic_role": "overview",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_1232",
      "reading_order": 1322,
      "section": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32",
      "bbox": {
        "l": 125.57939999999996,
        "t": 592.1442960000002,
        "r": 444.2336639999992,
        "b": 583.2488730491805
      },
      "content": "Turn off the infuser and disconnect the device from AC power.",
      "section_id": "sec_auto_1320",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1-800-241-4002"
        },
        {
          "id": "sec_auto_1320",
          "title": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32"
        }
      ],
      "page": 125,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_1233",
      "reading_order": 1323,
      "section": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32",
      "bbox": {
        "l": 125.57939999999996,
        "t": 576.6644640000002,
        "r": 380.046444,
        "b": 567.7690410491805
      },
      "content": "Remove the battery as described in Section 7.2.4 .",
      "section_id": "sec_auto_1320",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1-800-241-4002"
        },
        {
          "id": "sec_auto_1320",
          "title": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32"
        }
      ],
      "page": 125,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_1234",
      "reading_order": 1324,
      "section": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32",
      "bbox": {
        "l": 125.57939999999996,
        "t": 561.2443920000002,
        "r": 539.9542439999996,
        "b": 540.8889930491805
      },
      "content": "Separate  the  front  enclosure,  rear  enclosure,  and  main  chassis  assembly as described in Section 7.2.8 .",
      "section_id": "sec_auto_1320",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1-800-241-4002"
        },
        {
          "id": "sec_auto_1320",
          "title": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32"
        }
      ],
      "page": 125,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_1235",
      "reading_order": 1325,
      "section": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32",
      "bbox": {
        "l": 125.58039599999998,
        "t": 534.3643440000002,
        "r": 465.7881,
        "b": 525.4689210491805
      },
      "content": "Remove the mechanism assembly as described in Section 7.2.12.6 .",
      "section_id": "sec_auto_1320",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1-800-241-4002"
        },
        {
          "id": "sec_auto_1320",
          "title": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32"
        }
      ],
      "page": 125,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_1236",
      "reading_order": 1326,
      "section": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32",
      "bbox": {
        "l": 125.58139199999994,
        "t": 518.9442720000002,
        "r": 540.0817319999994,
        "b": 498.58887304918045
      },
      "content": "Open the cassette door. Disengage and fully open the cassette door from the opener handle assembly. Close the opener handle assembly.",
      "section_id": "sec_auto_1320",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1-800-241-4002"
        },
        {
          "id": "sec_auto_1320",
          "title": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32"
        }
      ],
      "page": 125,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_1237",
      "reading_order": 1327,
      "section": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32",
      "bbox": {
        "l": 125.58039599999998,
        "t": 492.06422400000014,
        "r": 386.47064399999937,
        "b": 483.16880104918044
      },
      "content": "Remove the retaining ring and replace, if required.",
      "section_id": "sec_auto_1320",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1-800-241-4002"
        },
        {
          "id": "sec_auto_1320",
          "title": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32"
        }
      ],
      "page": 125,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_1238",
      "reading_order": 1328,
      "section": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32",
      "bbox": {
        "l": 125.58039599999998,
        "t": 476.58439200000015,
        "r": 540.0408960000003,
        "b": 456.28875304918046
      },
      "content": "Insert  the  flat  blade  screwdriver  between  the  opener  handle  assembly  and  the mechanism assembly, and carefully pry the assemblies apart.",
      "section_id": "sec_auto_1320",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1-800-241-4002"
        },
        {
          "id": "sec_auto_1320",
          "title": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32"
        }
      ],
      "page": 125,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_1239",
      "reading_order": 1329,
      "section": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32",
      "bbox": {
        "l": 125.58039599999998,
        "t": 449.70434400000016,
        "r": 540.0189839999991,
        "b": 429.40870504918047
      },
      "content": "Install  the  replacement  opener  handle  assembly  in  the  exact  reverse  order of removal. Confirm the opener handle is aligned properly.",
      "section_id": "sec_auto_1320",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1-800-241-4002"
        },
        {
          "id": "sec_auto_1320",
          "title": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32"
        }
      ],
      "page": 125,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_1240",
      "reading_order": 1330,
      "section": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32",
      "bbox": {
        "l": 125.57939999999996,
        "t": 422.8242960000002,
        "r": 489.5068439999989,
        "b": 413.9288730491805
      },
      "content": "Replace the mechanism assembly in the exact reverse order of removal.",
      "section_id": "sec_auto_1320",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1-800-241-4002"
        },
        {
          "id": "sec_auto_1320",
          "title": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32"
        }
      ],
      "page": 125,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_1241",
      "reading_order": 1331,
      "section": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32",
      "bbox": {
        "l": 119.39921999999996,
        "t": 407.40422400000017,
        "r": 539.9303399999986,
        "b": 387.0488250491805
      },
      "content": "Join the front enclosure, rear enclosure, and main chassis assembly in the exact reverse order of separation.",
      "section_id": "sec_auto_1320",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1-800-241-4002"
        },
        {
          "id": "sec_auto_1320",
          "title": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32"
        }
      ],
      "page": 125,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_1242",
      "reading_order": 1332,
      "section": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32",
      "bbox": {
        "l": 119.39921999999996,
        "t": 380.5241760000002,
        "r": 420.36751199999964,
        "b": 371.6287530491805
      },
      "content": "Reinstall the battery and connect the device to AC power.",
      "section_id": "sec_auto_1320",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1-800-241-4002"
        },
        {
          "id": "sec_auto_1320",
          "title": "Assembly, Opener Handle Ring, Retaining, Push-On, 3/32"
        }
      ],
