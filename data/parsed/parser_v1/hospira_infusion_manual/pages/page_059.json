    {
      "type": "admonition",
      "id": "txt_0486",
      "reading_order": 533,
      "section": "5.1.1 CLEANING",
      "bbox": {
        "l": 108.00000000000003,
        "t": 250.85139499389993,
        "r": 539.9676257019994,
        "b": 217.66038197898547
      },
      "content": "CAUTION: Do not immerse the infuser in liquids. Immersion could damage the device.  Do  not  allow  liquids  to  enter  the  electronics  compartment.  Do  not  spray cleaning solutions toward any openings in the device.",
      "severity": "caution",
      "section_id": "sec_5_1_1",
      "parent_section_id": "sec_5_1",
      "section_level": 3,
      "section_path": [
