    {
      "type": "paragraph",
      "id": "txt_0083",
      "reading_order": 98,
      "section": "Considerations during removal and replacement",
      "bbox": {
        "l": 99.99835999999999,
        "t": 198.28999999999996,
        "r": 413.27835999999985,
        "b": 186.70000000000005
      },
      "content": "Understand the items to take into account when removing and replacing parts.",
      "section_id": "sec_auto_97",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1 Removal and replacement"
        },
        {
          "id": "sec_auto_97",
          "title": "Considerations during removal and replacement"
        }
      ],
      "page": 15,
      "chunk_hint": "section_start",
      "semantic_role": "overview",
      "source": "pdf_text"
    },
    {
      "type": "paragraph",
      "id": "txt_0084",
      "reading_order": 99,
      "section": "Considerations during removal and replacement",
      "bbox": {
        "l": 99.99838,
        "t": 177.28999999999996,
        "r": 229.46837999999994,
        "b": 165.70000000000005
      },
      "content": "This chapter describes the FRUs.",
      "section_id": "sec_auto_97",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1 Removal and replacement"
        },
        {
          "id": "sec_auto_97",
          "title": "Considerations during removal and replacement"
        }
      ],
      "page": 15,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "paragraph",
      "id": "txt_0085",
      "reading_order": 100,
      "section": "Considerations during removal and replacement",
      "bbox": {
        "l": 99.99835000000002,
        "t": 156.28999999999996,
        "r": 529.77835,
        "b": 132.70000000000005
      },
      "content": "Reinstalling FRUs is generally the reverse of removal. Notes are included to provide directions for difficult or critical replacement procedures.",
      "section_id": "sec_auto_97",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1 Removal and replacement"
        },
        {
          "id": "sec_auto_97",
          "title": "Considerations during removal and replacement"
        }
      ],
      "page": 15,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "paragraph",
      "id": "txt_0086",
      "reading_order": 101,
      "section": "Considerations during removal and replacement",
      "bbox": {
        "l": 99.99835,
        "t": 123.28999999999996,
        "r": 512.9683500000003,
        "b": 111.70000000000005
      },
      "content": "HP does not support repairing individual subassemblies or troubleshooting at the PCA component level.",
      "section_id": "sec_auto_97",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
