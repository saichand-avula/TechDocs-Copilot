    {
      "type": "admonition",
      "id": "txt_0132",
      "reading_order": 156,
      "section": "Before performing service",
      "bbox": {
        "l": 91.0,
        "t": 557.79,
        "r": 533.49008,
        "b": 498.2
      },
      "content": "WARNING! Turn the printer off, wait five seconds, and then remove the power cord before attempting to service the printer . If this warning is not followed, severe injury can result as well as damage to the printer. The power must be on for certain functional checks during troubleshooting. However, the power cord must be disconnected during parts removal. AC voltage is still present inside the printer when the power switch is in the off position. The power cord must be disconnected before servicing the printer.",
      "severity": "warning",
      "section_id": "sec_auto_154",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1 Removal and replacement"
        },
        {
          "id": "sec_auto_154",
          "title": "Before performing service"
        }
      ],
      "page": 18,
      "chunk_hint": "admonition",
      "semantic_role": "warning",
      "source": "pdf_text"
    },
    {
