      "section": "CAUTION:",
      "bbox": {
        "l": 113.0,
        "t": 198.41999999999996,
        "r": 334.02,
        "b": 186.83000000000004
      },
      "content": "To install an assembly, reverse the removal steps.",
      "section_id": "sec_auto_734",
      "parent_section_id": "sec_4",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_4",
          "title": "4. Install the transfer roller ."
        },
        {
          "id": "sec_auto_734",
          "title": "Post service test"
        }
      ],
      "page": 62,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "paragraph",
