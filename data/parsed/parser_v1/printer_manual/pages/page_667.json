        "l": 122.0,
        "t": 514.29,
        "r": 343.02,
        "b": 502.70000000000005
      },
      "content": "To install an assembly, reverse the removal steps.",
      "section_id": "sec_auto_6957",
      "parent_section_id": "sec_20",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_20",
