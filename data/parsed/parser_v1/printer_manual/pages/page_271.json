      },
      "content": "Rotate the connector end of the fax PCA out and away from the formatter (callout 1), and then slide it as shown (callout 2) to remove it."
    },
    {
      "type": "list_item",
      "id": "txt_2266",
      "reading_order": 3043,
      "section": "Post service test",
      "bbox": {
        "l": 100.0,
        "t": 458.42,
        "r": 439.85000000000014,
        "b": 446.83
      },
      "content": "Remove the stapler door or stapler blank cover (M527/E52545/M528/E52645)."
    },
    {
      "type": "list_item",
      "id": "txt_2267",
      "reading_order": 3044,
      "section": "Post service test",
      "bbox": {
        "l": 122.0,
        "t": 437.42,
        "r": 239.10999999999996,
        "b": 425.83
      },
      "content": "Do one of the following:"
    },
    {
      "type": "list_item",
      "id": "txt_2268",
      "reading_order": 3045,
      "section": "Post service test",
      "bbox": {
        "l": 143.99998,
        "t": 416.42,
        "r": 319.4899699999999,
        "b": 404.83
      },
      "content": "Stapler models: Open the stapler door."
    },
    {
      "type": "list_item",
      "id": "txt_2269",
      "reading_order": 3046,
      "section": "Post service test",
      "bbox": {
        "l": 144.0,
        "t": 395.17085000000003,
        "r": 551.5299700000005,
        "b": 371.58085
      },
      "content": "Non-stapler models: Use a small flat-blade screw driver to release two tabs (callout 1), and then rotate the cover away from the printer (callout 2)."
    },
    {
      "type": "list_item",
      "id": "txt_2270",
      "reading_order": 3047,
      "section": "Post service test",
      "bbox": {
        "l": 122.0,
        "t": 185.66962999999998,
        "r": 239.10999999999996,
        "b": 174.07963000000007
      },
      "content": "Do one of the following:"
    },
    {
      "type": "list_item",
      "id": "txt_2271",
      "reading_order": 3048,
      "section": "Post service test",
      "bbox": {
        "l": 143.99998,
        "t": 164.66962999999998,
        "r": 476.4899800000001,
        "b": 153.07963000000007
      },
      "content": "Stapler models: Use a small flat-blade screwdriver to release the upper hinge."
    },
    {
      "type": "list_item",
      "id": "txt_2272",
      "reading_order": 3049,
      "section": "Post service test",
      "bbox": {
        "l": 144.00002999999998,
        "t": 143.42048999999997,
        "r": 483.96005000000025,
        "b": 131.83049000000005
      },
      "content": "Non-stapler models: Slide the cover toward the front of the printer to remove it."
    },
