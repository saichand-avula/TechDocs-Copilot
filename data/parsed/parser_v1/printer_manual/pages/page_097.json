      "section": "CAUTION:",
      "bbox": {
        "l": 122.0,
        "t": 514.29,
        "r": 343.02,
        "b": 502.70000000000005
      },
      "content": "To install an assembly, reverse the removal steps.",
      "section_id": "sec_auto_1153",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1. Remove the keyboard."
        },
        {
          "id": "sec_auto_1153",
          "title": "Post service test"
        }
      ],
      "page": 97,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "paragraph",
      "id": "txt_0919",
      "reading_order": 1179,
