    {
      "type": "list_item",
      "id": "txt_4632",
      "reading_order": 6412,
      "section": "6. Remove the formatter.",
      "bbox": {
        "l": 122.0,
        "t": 491.41999999999996,
        "r": 538.4900000000004,
        "b": 467.83
      },
      "content": "M506/E50045/M507/E50145/M527/E52545/M528/E52645: Disconnect all of the connectors and FFCs, remove four screws (callout 1), and then remove the formatter."
    },
    {
      "type": "list_item",
      "id": "txt_4633",
      "reading_order": 6413,
      "section": "6. Remove the formatter.",
      "bbox": {
        "l": 144.0,
        "t": 455.92,
        "r": 548.6000100000001,
        "b": 408.33
      },
      "content": "IMPORTANT: Take note of all empty connectors on the formatter before disconnecting any wire harnesses or flat-flexible cables (FFCs). Some empty connectors might not be visible until other items -like the hard-disk drive-are removed, so pay close attention while removing the formatter and accessories items."
    },
    {
      "type": "list_item",
      "id": "txt_4634",
      "reading_order": 6414,
      "section": "6. Remove the formatter.",
      "bbox": {
        "l": 100.0,
        "t": 219.7732699999999,
        "r": 439.85000000000014,
        "b": 208.18327
      },
      "content": "Remove the stapler door or stapler blank cover (M527/E52545/M528/E52645)."
    },
    {
      "type": "list_item",
      "id": "txt_4635",
      "reading_order": 6415,
      "section": "6. Remove the formatter.",
      "bbox": {
        "l": 122.0,
        "t": 198.7732699999999,
        "r": 239.10999999999996,
        "b": 187.18327
      },
      "content": "Do one of the following:"
    },
    {
      "type": "list_item",
      "id": "txt_4636",
      "reading_order": 6416,
      "section": "6. Remove the formatter.",
      "bbox": {
        "l": 143.99998,
        "t": 177.7732699999999,
        "r": 319.4899699999999,
        "b": 166.18327
      },
      "content": "Stapler models: Open the stapler door."
    },
    {
      "type": "list_item",
      "id": "txt_4637",
      "reading_order": 6417,
      "section": "6. Remove the formatter.",
      "bbox": {
        "l": 144.0,
        "t": 156.52413,
        "r": 551.5299700000005,
        "b": 132.9341300000001
      },
      "content": "Non-stapler models: Use a small flat-blade screw driver to release two tabs (callout 1), and then rotate the cover away from the printer (callout 2)."
    },
