      "section": "CAUTION:",
      "bbox": {
        "l": 113.0,
        "t": 173.41999999999996,
        "r": 334.02,
        "b": 161.83000000000004
      },
      "content": "To install an assembly, reverse the removal steps.",
      "section_id": "sec_13",
      "parent_section_id": null,
      "section_level": 1,
      "section_path": [
        {
          "id": "sec_13",
          "title": "13. Remove the right cover."
