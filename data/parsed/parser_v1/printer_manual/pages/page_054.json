        "l": 113.0,
        "t": 514.29,
        "r": 334.02,
        "b": 502.70000000000005
      },
      "content": "To install an assembly, reverse the removal steps.",
      "section_id": "sec_auto_645",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1 Removal and replacement"
        },
        {
          "id": "sec_auto_645",
          "title": "Post service test"
        }
      ],
      "page": 54,
