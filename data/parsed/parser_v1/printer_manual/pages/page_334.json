        "r": 430.85000000000014,
        "b": 447.47229999999996
      },
      "content": "Remove the stapler door or stapler blank cover (M527/E52545/M528/E52645)."
    },
    {
      "type": "list_item",
      "id": "txt_2797",
      "reading_order": 3752,
      "section": "Post service test",
      "bbox": {
        "l": 113.0,
        "t": 438.0623,
        "r": 230.10999999999996,
        "b": 426.47229999999996
      },
      "content": "Do one of the following:"
    },
    {
      "type": "list_item",
      "id": "txt_2798",
      "reading_order": 3753,
      "section": "Post service test",
      "bbox": {
        "l": 134.99998,
        "t": 417.0623,
        "r": 310.4899699999999,
        "b": 405.47229999999996
      },
      "content": "Stapler models: Open the stapler door."
    },
    {
      "type": "list_item",
      "id": "txt_2799",
      "reading_order": 3754,
      "section": "Post service test",
      "bbox": {
        "l": 135.0,
        "t": 395.81316000000004,
        "r": 542.5299700000005,
        "b": 372.22316
      },
      "content": "Non-stapler models: Use a small flat-blade screw driver to release two tabs (callout 1), and then rotate the cover away from the printer (callout 2)."
    },
    {
      "type": "list_item",
      "id": "txt_2800",
      "reading_order": 3755,
      "section": "Post service test",
      "bbox": {
        "l": 113.0,
        "t": 186.31196999999997,
        "r": 230.10999999999996,
        "b": 174.72197000000006
      },
      "content": "Do one of the following:"
    },
    {
      "type": "list_item",
      "id": "txt_2801",
      "reading_order": 3756,
      "section": "Post service test",
      "bbox": {
        "l": 134.99998,
        "t": 165.31196999999997,
        "r": 467.4899800000001,
        "b": 153.72197000000006
      },
      "content": "Stapler models: Use a small flat-blade screwdriver to release the upper hinge."
    },
    {
      "type": "list_item",
