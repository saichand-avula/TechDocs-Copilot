        "t": 260.16499999999996,
        "r": 490.86989000000005,
        "b": 248.57500000000005
      },
      "content": "Following are the part numbers for the supplies and accessories that are available for the printers.",
      "section_id": "sec_auto_7549",
      "parent_section_id": "sec_2",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_2",
          "title": "2 Parts and diagrams"
        },
        {
          "id": "sec_auto_7549",
          "title": "Supplies and accessories"
        }
      ],
      "page": 711,
      "chunk_hint": "section_start",
