      "bbox": {
        "l": 100.00009999999997,
        "t": 149.16499999999996,
        "r": 323.75009999999986,
        "b": 137.57500000000005
      },
      "content": "On the label of the cartridge that is being replaced.",
      "section_id": "sec_auto_7549",
      "parent_section_id": "sec_2",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_2",
