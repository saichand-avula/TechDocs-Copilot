    {
      "type": "list_item",
      "id": "txt_5471",
      "reading_order": 7554,
      "section": "Supplies and accessories",
      "bbox": {
        "l": 100.00009999999997,
        "t": 127.91584999999998,
        "r": 418.54010000000005,
        "b": 116.32585000000006
      },
      "content": "On a sticker inside the printer . Open the cartridge door to locate the sticker .",
