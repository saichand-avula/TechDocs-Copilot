  "blocks": [
    {
      "type": "list_item",
      "id": "txt_1453",
      "reading_order": 1879,
      "section": "Post service test",
      "bbox": {
        "l": 113.0,
        "t": 732.29,
        "r": 437.54,
        "b": 720.7
      },
      "content": "Rotate the bottom edge of the assembly away from the printer to release it."
    },
    {
      "type": "list_item",
      "id": "txt_1454",
      "reading_order": 1880,
      "section": "Post service test",
      "bbox": {
        "l": 113.0,
        "t": 470.42,
        "r": 295.4299999999999,
        "b": 458.83
      },
      "content": "Pull down on the assembly to remove it."
    },
    {
      "type": "list_item",
      "id": "txt_1455",
      "reading_order": 1881,
      "section": "Post service test",
      "bbox": {
        "l": 91.0,
        "t": 208.54999999999995,
        "r": 201.91999999999996,
        "b": 196.96000000000004
      },
      "content": "Remove the left cover."
    },
    {
      "type": "list_item",
      "id": "txt_1456",
      "reading_order": 1882,
      "section": "Post service test",
      "bbox": {
        "l": 113.0,
        "t": 185.05000999999993,
        "r": 536.92,
        "b": 161.46001
      },
      "content": "IMPORTANT: The black-plastic cassette front and rear guides (located inside the tray cavity) can be easily dislodged. Do not lose the guides when the cover is removed or installed."
    },
    {
      "type": "list_item",
      "id": "txt_1457",
      "reading_order": 1883,
      "section": "Post service test",
      "bbox": {
        "l": 113.0,
        "t": 152.05000999999993,
        "r": 527.1400000000002,
        "b": 140.46001
      },
      "content": "NOTE: An MFP printer is shown in this section. However, the procedure is correct for all printer models."
    },
    {
      "type": "list_item",
      "id": "txt_1458",
      "reading_order": 1884,
      "section": "Post service test",
      "bbox": {
        "l": 113.0,
        "t": 129.54999999999995,
        "r": 519.0200800000003,
        "b": 84.96000000000004
      },
      "content": "Before proceeding, take note of the location of the tabs and bosses on the inside of the cover. When reinstalling the cover, take note of the location of the tabs and bosses on the inside of the cover."
    },
