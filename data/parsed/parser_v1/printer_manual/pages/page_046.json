        "b": 720.7
      },
      "content": "NOTE: The M506/E50045/M507/E50145 printers use a Slim dual in-line memory module (DIMM)."
    },
    {
      "type": "list_item",
      "id": "txt_0477",
      "reading_order": 590,
      "section": "CAUTION:",
      "bbox": {
        "l": 113.0,
        "t": 709.79,
        "r": 486.8699900000004,
        "b": 698.2
      },
      "content": "M506/E50045/M507/E50145 only: Push the DIMM straight on the connector to install it."
    },
    {
      "type": "list_item",
      "id": "txt_0478",
      "reading_order": 591,
      "section": "CAUTION:",
      "bbox": {
        "l": 113.0,
        "t": 447.92,
        "r": 346.09999000000005,
        "b": 436.33
      },
      "content": "M527/E52545/M528/E52645 only: Do the following."
    },
    {
      "type": "list_item",
      "id": "txt_0479",
      "reading_order": 592,
      "section": "CAUTION:",
      "bbox": {
        "l": 135.0,
        "t": 426.92,
        "r": 336.06999999999994,
        "b": 415.33
      },
      "content": "Insert the top edge of the DIMM in the holder."
    },
    {
      "type": "list_item",
      "id": "txt_0480",
      "reading_order": 593,
      "section": "CAUTION:",
      "bbox": {
        "l": 157.0,
        "t": 403.42,
        "r": 500.12,
        "b": 391.83
      },
      "content": "Reinstallation tip: The DIMM is keyed and can only be inserted in the holder one way."
    },
