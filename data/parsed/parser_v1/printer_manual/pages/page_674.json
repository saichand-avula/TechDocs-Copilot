        "l": 113.0,
        "t": 493.28999999999996,
        "r": 334.02,
        "b": 481.70000000000005
      },
      "content": "To install an assembly, reverse the removal steps.",
      "section_id": "sec_auto_7061",
      "parent_section_id": "sec_20",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_20",
