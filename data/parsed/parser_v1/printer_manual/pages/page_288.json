      "section": "CAUTION:",
      "bbox": {
        "l": 113.0,
        "t": 514.29,
        "r": 334.02,
        "b": 502.70000000000005
      },
      "content": "To install an assembly, reverse the removal steps.",
      "section_id": "sec_auto_3103",
      "parent_section_id": "sec_11",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_11",
          "title": "11. Remove the right cover."
        },
        {
          "id": "sec_auto_3103",
          "title": "d. Remove the cover."
        }
      ],
      "page": 288,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_2364",
      "reading_order": 3189,
      "section": "CAUTION:",
      "bbox": {
        "l": 135.00002,
        "t": 493.28999999999996,
        "r": 542.6100400000003,
        "b": 457.7
      },
      "content": "When applicable, special installation instructions are provided for an assembly at the end of the removal procedure. Always completely read the removal instructions and follow all special installation instructions.",
      "section_id": "sec_auto_3103",
      "parent_section_id": "sec_11",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_11",
