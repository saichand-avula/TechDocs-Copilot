      "section": "CAUTION:",
      "bbox": {
        "l": 113.0,
        "t": 161.41999999999996,
        "r": 334.02,
        "b": 149.83000000000004
      },
      "content": "To install an assembly, reverse the removal steps.",
      "section_id": "sec_auto_855",
      "parent_section_id": "sec_4",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_4",
          "title": "4. Install the transfer roller ."
        },
        {
          "id": "sec_auto_855",
          "title": "Post service test"
        }
      ],
      "page": 74,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "list_item",
      "id": "txt_0708",
      "reading_order": 907,
