      "section": "CAUTION:",
      "bbox": {
        "l": 122.0,
        "t": 161.41999999999996,
        "r": 343.02,
        "b": 149.83000000000004
      },
      "content": "To install an assembly, reverse the removal steps.",
      "section_id": "sec_auto_1802",
      "parent_section_id": "sec_1",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_1",
          "title": "1. Remove the keyboard."
        },
        {
          "id": "sec_auto_1802",
          "title": "CAUTION:"
        }
      ],
      "page": 149,
      "chunk_hint": "continue",
      "semantic_role": "description",
      "source": "pdf_text"
    },
    {
      "type": "paragraph",
      "id": "txt_1398",
      "reading_order": 1809,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.00002,
        "t": 140.41999999999996,
        "r": 551.6100400000003,
        "b": 104.83000000000004
      },
      "content": "When applicable, special installation instructions are provided for an assembly at the end of the removal procedure. Always completely read the removal instructions and follow all special installation instructions.",
