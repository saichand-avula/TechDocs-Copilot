    {
      "type": "paragraph",
      "id": "txt_0493",
      "reading_order": 601,
      "section": "4.11 Auto Start",
      "bbox": {
        "l": 77.904,
        "t": 494.5976629101563,
        "r": 541.6032,
        "b": 422.72610136319497
      },
      "content": "When main power is failure, UPS can provide power supply to load through battery system until final voltage 495 V of battery discharge is reached by battery discharge, UPS stops inverter output, and the output is switched to static bypass. When main power is recovered, UPS can start automatically, recover  inverter  output  power  supply,  and  charge  the  battery.  Automatic  start  function  is  also applicable for bypass mode.",
      "section_id": "sec_4_11",
      "parent_section_id": "sec_4",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_4",
          "title": "4 Operation"
        },
        {
          "id": "sec_4_11",
          "title": "4.11 Auto Start"
        }
      ],
      "page": 53,
      "chunk_hint": "section_start",
      "semantic_role": "overview",
      "source": "pdf_text"
    },
