      "content": "power off 'EPO', fault muffle 'SILENCE ON/OFF', and fault clear 'FAULT CLEAR'."
    },
    {
      "type": "list_item",
      "id": "txt_0116",
      "reading_order": 131,
      "section": "2.4 UPS Display Interface",
      "bbox": {
        "l": 92.064,
        "t": 388.1117429101563,
        "r": 541.2103999999993,
        "b": 362.586101363195
      },
      "content": " 4 menu keys and LCD touch screen can be used to select the menu displayed by liquid crystal display screen."
    },
    {
      "type": "list_item",
      "id": "txt_0117",
      "reading_order": 132,
      "section": "2.4 UPS Display Interface",
      "bbox": {
        "l": 92.064,
        "t": 356.91174291015625,
        "r": 341.28568,
        "b": 346.98610136319496
      },
      "content": " ON/OFF is used to turn on/off the UPS system."
    },
    {
      "type": "list_item",
      "id": "txt_0118",
      "reading_order": 133,
      "section": "2.4 UPS Display Interface",
      "bbox": {
        "l": 92.064,
        "t": 341.3117429101563,
        "r": 541.5783999999999,
        "b": 300.186101363195
      },
      "content": " Emergency Power Off key (EPO) is used to quickly shut down in case of emergency. After pressing  EPO  button,  the  UPS  needs  power  off  completely  so  that  the  system  can  exit emergency power off condition."
    },
    {
      "type": "list_item",
      "id": "txt_0119",
      "reading_order": 134,
      "section": "2.4 UPS Display Interface",
      "bbox": {
        "l": 92.064,
        "t": 294.5117429101563,
        "r": 358.08567999999997,
        "b": 284.586101363195
      },
      "content": " FAULT CLEAR is used to clear fault lock condition."
    },
    {
      "type": "list_item",
      "id": "txt_0120",
      "reading_order": 135,
      "section": "2.4 UPS Display Interface",
      "bbox": {
        "l": 92.064,
        "t": 278.91174291015625,
        "r": 399.03568,
        "b": 268.98610136319496
      },
      "content": " SILENCE ON/OFF is used to turn off the warning of buzzer."
    },
