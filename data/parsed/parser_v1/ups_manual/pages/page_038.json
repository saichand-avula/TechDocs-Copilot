    {
      "type": "list_item",
      "id": "txt_0294",
      "reading_order": 361,
      "section": "Public input connection",
      "bbox": {
        "l": 77.904,
        "t": 336.0576629101563,
        "r": 541.61568,
        "b": 248.58610136319498
      },
      "content": "When the bypass input and mains input share the same mains input, 80 ~ 500 kVA UPS needs to be connected to short wires (or copper bar) of bypass input and mains input. 80 ~ 120 kVA and 200 ~ 300 kVA UPS are connected with short wires equipped randomly. 160 kVA UPS uses copper bar connection which is equipped randomly. Switch baffle shall be disassembled during installation. 400 ~ 500 kVA UPS is not equipped with wire and copper bar. (Note: Copper bar of 400 ~ 500 kVA UPS is optional). Make sure that the phase sequence is correct when wiring.",
      "section_id": "sec_auto_360",
      "parent_section_id": "sec_3",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_3",
          "title": "3 Installation"
        },
