    },
    {
      "type": "paragraph",
      "id": "txt_0248",
      "reading_order": 298,
      "section": "3.3.4 Wiring Routing",
      "bbox": {
        "l": 77.904,
        "t": 153.98766291015636,
        "r": 541.60608,
        "b": 128.9161013631949
      },
      "content": "When upper wiring is required, please select power distribution cabinet (for 80 ~ 300 kVA UPS) or maintenance bypass switch cabinet (for 400 ~ 500 kVA UPS)",
