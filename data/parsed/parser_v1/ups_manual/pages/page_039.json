      "image_hash": "4ac4929c3be5d950a9397afe8546f2c1f624f96b3c5972369d0cf3a38f2464fe"
    },
    {
      "type": "admonition",
      "id": "txt_0311",
      "reading_order": 381,
      "section": "3.8.2 Wiring of Parallel UPS System",
      "bbox": {
        "l": 77.784,
        "t": 186.62766291015623,
        "r": 541.5870399999999,
        "b": 111.75610136319494
      },
      "content": "Note: In the configuration design of parallel system, for better current sharing to be obtained by parallel UPS, the input and output cables of each UPS must be same in specifications, the length of power cable from the input terminal to the AC power distribution connection point of each UPS is same as that from output terminal to load connection point, and the input and output impedance of each UPS should be consistent.",
      "severity": "note"
    }
  ],
