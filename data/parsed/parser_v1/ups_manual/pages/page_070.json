        "r": 264.04688,
        "b": 291.4738892084988
      },
      "content": "6.3 Safety Precautions",
      "level": 2,
      "section_number": "6.3",
      "section_id": "sec_6_3",
      "section_path": [
        {
          "id": "sec_6",
