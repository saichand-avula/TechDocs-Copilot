    {
      "type": "paragraph",
      "id": "txt_0588",
      "reading_order": 749,
      "section": "7.2 SNMP Card",
      "bbox": {
        "l": 77.904,
        "t": 691.6676629101563,
        "r": 541.4687199999996,
        "b": 604.196101363195
      },
      "content": "iStars provides users with convenient installation program. You can search for or set the IP address after PC is installed with iSearch software. Log in homepage of iStars through web browser, and then  operating  status  of  UPS  can  be  obtained:  such  as  working  voltage,  current,  frequency, temperature and humidity and so on of UPS. Parameters of equipment and system can be set in web interface: such as set to turn off or test UPS in a certain time; set user permission, user name and IP and so on.",
      "section_id": "sec_7_2",
      "parent_section_id": "sec_7",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_7",
          "title": "7 Annex"
        },
        {
          "id": "sec_7_2",
          "title": "7.2 SNMP Card"
        }
      ],
      "page": 74,
      "chunk_hint": "continue",
