        "t": 249.62327660000005,
        "r": 421.05593639999995,
        "b": 239.6051526875001
      },
      "content": "The fan motor stops when the heat exchange temperature is below 25 ć"
    },
    {
      "type": "paragraph",
      "id": "txt_0094",
      "reading_order": 156,
      "section": "5.1.2.1 Warm boot",
      "bbox": {
