      },
      "content": "The outdoor heat exchanger thermistor is used for controlling target discharge temperature.",
      "section_id": "sec_auto_2892",
      "parent_section_id": "sec_5",
      "section_level": 2,
      "section_path": [
        {
          "id": "sec_5",
