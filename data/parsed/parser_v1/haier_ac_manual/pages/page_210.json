    {
      "type": "heading",
      "id": "txt_1721",
      "reading_order": 2256,
      "section": "(1) POWER Operation",
      "bbox": {
        "l": 301.7392,
        "t": 439.3291844,
        "r": 396.3388265999999,
        "b": 427.4512464
      },
      "content": "(1) POWER Operation",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_1722",
      "reading_order": 2257,
      "section": "(1) POWER Operation",
      "bbox": {
        "l": 301.3643,
        "t": 424.4890568,
        "r": 561.0991967999992,
        "b": 384.66116200000005
      },
      "content": "When you need rapid heating or cooling, you can use this function. In COOL mode, fan speed automatically takes high speed of AUTO fan mode. In HEAT mode, fan speed automatically takes medial speed of AUTO fan mode."
    },
    {
      "type": "heading",
      "id": "txt_1723",
      "reading_order": 2258,
      "section": "(2) SOFT Operation",
      "bbox": {
        "l": 301.7172,
        "t": 382.54818439999997,
        "r": 385.84557839999997,
        "b": 370.6706848
      },
      "content": "(2) SOFT Operation",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_1724",
      "reading_order": 2259,
      "section": "(2) SOFT Operation",
      "bbox": {
        "l": 301.1171462,
        "t": 369.97429580000005,
        "r": 570.1365913999994,
        "b": 339.4389377
      },
      "content": "You can use this function when silence is needed for rest or reading. In SOFT operation mode, fan speed automatically takes low speed of AUTO fan mode."
    },
    {
      "type": "heading",
      "id": "txt_1725",
      "reading_order": 2260,
      "section": "Note ˖",
