    },
    {
      "type": "paragraph",
      "id": "txt_0832",
      "reading_order": 1118,
      "section": "5.1.3.6 Trial running",
      "bbox": {
        "l": 101.777,
        "t": 296.92771519999997,
        "r": 417.5361290700002,
        "b": 287.674938
      },
      "content": "The indicated frequency for trial running is 58Hz, wind volume is strong."
    },
    {
      "type": "paragraph",
      "id": "txt_0833",
      "reading_order": 1119,
      "section": "5.1.3.6 Trial running",
      "bbox": {
        "l": 101.777,
        "t": 281.3698598000001,
        "r": 547.7845599000002,
        "b": 256.5592272
      },
      "content": "The trial running will last for 30 minutes and then the unit will be powered off. The unit will exit the trial running if it receives any remote-control signal during the trial running period."
    },
    {
      "type": "paragraph",
      "id": "txt_0834",
      "reading_order": 1120,
      "section": "5.1.3.6 Trial running",
      "bbox": {
        "l": 101.777,
        "t": 250.25414899999998,
        "r": 290.25422334000024,
        "b": 241.00137180000002
      },
      "content": "There is no low-intense running protection."
    },
    {
      "type": "heading",
      "id": "txt_0835",
      "reading_order": 1121,
      "section": "5.1.3.7 Power failure compensation",
      "bbox": {
        "l": 56.9624,
