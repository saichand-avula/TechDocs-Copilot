    {
      "type": "admonition",
      "id": "txt_0832",
      "reading_order": 1075,
      "severity": "caution",
      "content": "CAUTION: Some parts are sensitive to electrostatic discharge (ESD). Always perform service",
      "section": "CAUTION:",
      "bbox": {
        "l": 144.0,
        "t": 353.53499,
        "r": 181.75,
        "b": 341.94499
      }
    },
    {
      "type": "figure",
      "id": "fig_0230",
      "reading_order": 1077,
      "section": "CAUTION:",
      "bbox": {
        "l": 191.31048257864637,
        "t": 357.6767883300781,
        "r": 210.65864359511048,
        "b": 336.537353515625
      },
      "image_path": "figures/figure_0230.png",
      "decorative": true,
      "width": 19,
      "height": 21,
      "image_hash": "c840a08f424c9b855e512919925808b29f93319ed238930cb7eaaee4e4b2d880",
      "previous_block_id": "txt_0833",
      "next_block_id": "txt_0834"
    },
    {
      "type": "paragraph",
      "id": "txt_0834",
      "reading_order": 1078,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.0,
        "t": 334.92,
        "r": 549.7700400000001,
        "b": 299.33
      },
      "content": "work at an ESD-protected workstation or mat. If an ESD workstation or mat is not available, touch the sheet-metal chassis to provide a static ground before touching an ESD-sensitive assembly. Protect the ESD-sensitive assemblies by placing them in ESD pouches when they are out of the printer."
    },
    {
      "type": "paragraph",
      "id": "txt_0835",
      "reading_order": 1079,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.00004,
        "t": 289.92,
        "r": 548.6300400000002,
        "b": 254.32999999999993
      },
      "content": "If the replacement part is a roller or pad, avoid touching the spongy part of it. Skin oils on the roller or pad can cause paper pickup and/or print-quality problems. HP recommends using disposable gloves when handling rollers or pads or washing your hands before touching rollers or pads."
    },
    {
      "type": "list_item",
      "id": "txt_0836",
      "reading_order": 1080,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.0,
        "t": 244.91999999999996,
        "r": 541.73,
        "b": 221.32999999999993
      },
      "content": "IMPORTANT: Make sure that all of the shipping materials (for example shipping tape) are removed from the replacement part prior to installation."
    },
    {
      "type": "list_item",
      "id": "txt_0837",
      "reading_order": 1081,
      "section": "CAUTION:",
      "bbox": {
        "l": 122.0,
        "t": 210.41999999999996,
        "r": 343.02,
        "b": 198.83000000000004
      },
      "content": "To install an assembly, reverse the removal steps."
    },
    {
      "type": "paragraph",
      "id": "txt_0838",
      "reading_order": 1082,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.00002,
        "t": 189.41999999999996,
        "r": 551.6100400000003,
        "b": 153.83000000000004
      },
      "content": "When applicable, special installation instructions are provided for an assembly at the end of the removal procedure. Always completely read the removal instructions and follow all special installation instructions."
    },
    {
      "type": "list_item",
      "id": "txt_0839",
      "reading_order": 1083,
      "section": "CAUTION:",
      "bbox": {
        "l": 100.00004,
        "t": 144.41999999999996,
        "r": 203.39004,
        "b": 132.83000000000004
      },
      "content": "Install the keyboard."
    },
    {
      "type": "list_item",
      "id": "txt_0840",
      "reading_order": 1084,
      "section": "CAUTION:",
      "bbox": {
        "l": 122.00002,
        "t": 123.41999999999996,
        "r": 473.1600100000003,
        "b": 111.83000000000004
      },
      "content": "Position the flat cable (callout 1) on the keyboard into the keyboard slot (callout 2)."
    }
