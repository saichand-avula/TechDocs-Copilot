  "blocks": [
    {
      "type": "heading",
      "id": "txt_0643",
      "reading_order": 679,
      "section": "Generator Brushes",
      "bbox": {
        "l": 47.564800000000005,
        "t": 715.4070068359374,
        "r": 156.5212,
        "b": 704.5877469606776
      },
      "content": "Generator Brushes",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0644",
      "reading_order": 680,
      "section": "Generator Brushes",
      "bbox": {
        "l": 47.5654,
        "t": 688.3263068359375,
        "r": 291.5409999999997,
        "b": 640.4838492035389
      },
      "content": "The generator should be inspected for brush wear and cleaning as required per the Periodic Maintenance Schedule.  Perform this procedure according to the steps in Section 5 of this manual."
    },
    {
      "type": "paragraph",
      "id": "txt_0645",
      "reading_order": 681,
      "section": "Generator Brushes",
      "bbox": {
        "l": 47.565599999999996,
        "t": 621.0886068359375,
        "r": 291.4785000000001,
        "b": 560.6017519502827
      },
      "content": "WARNING Accidental starting of the generator set can cause severe personal injury or death. Stop the generator set and disable by disconnecting the starting battery cables (negative [-] cable first before inspecting the generator."
    },
    {
      "type": "heading",
      "id": "txt_0646",
      "reading_order": 682,
      "section": "Generator Bearing",
      "bbox": {
        "l": 47.5654,
        "t": 542.2664068359375,
        "r": 153.18099999999998,
        "b": 531.4471469606776
      },
      "content": "Generator Bearing",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0647",
      "reading_order": 683,
      "section": "Generator Bearing",
      "bbox": {
        "l": 47.5654,
        "t": 515.2428068359375,
        "r": 291.55310000000026,
        "b": 442.05854920353886
      },
      "content": "Inspect the bearing for evidence of outer case rotation every 1000 hours of use.  The bearing should be replaced every five years, because the bearing grease gradually deteriorates due to oxidation.  See Section 5 of this manual for information on the generator bearing."
    },
    {
      "type": "heading",
      "id": "txt_0648",
      "reading_order": 684,
      "section": "CRANKCASE BREATHER",
      "bbox": {
        "l": 369.8646,
        "t": 738.0270068359374,
        "r": 515.6886000000001,
        "b": 727.2077469606776
      },
      "content": "CRANKCASE BREATHER",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0649",
      "reading_order": 685,
      "section": "CRANKCASE BREATHER",
      "bbox": {
        "l": 320.9386,
        "t": 718.5436068359375,
        "r": 564.7535999999999,
        "b": 683.3434492035387
      },
      "content": "Clean  the  crankcase  breather  element  at  the scheduled intervals, using the following procedure (see Figure 8-7)."
    },
    {
      "type": "list_item",
      "id": "txt_0650",
      "reading_order": 686,
      "section": "CRANKCASE BREATHER",
      "bbox": {
        "l": 325.2473,
        "t": 670.5253068359375,
        "r": 564.8537000000001,
        "b": 635.2679492035387
      },
      "content": "Remove the cap nuts and gaskets from the top of the cylinder head cover.  Carefully remove the cover.  Avoid damaging the gasket."
    },
    {
      "type": "list_item",
      "id": "txt_0651",
      "reading_order": 687,
      "section": "CRANKCASE BREATHER",
      "bbox": {
        "l": 325.2473,
        "t": 622.5059068359375,
        "r": 564.7535999999997,
        "b": 587.2485492035388
      },
      "content": "From  inside  the  cover,  remove  two  machine screws securing the breather element, plates and shield."
    },
    {
      "type": "list_item",
      "id": "txt_0652",
      "reading_order": 688,
      "section": "CRANKCASE BREATHER",
      "bbox": {
        "l": 325.2473,
        "t": 574.4304068359376,
        "r": 564.9405999999998,
        "b": 539.2302492035388
      },
      "content": "Clean the element in a suitable solvent.  Dry the element, then saturate with engine oil before replacing."
    },
    {
      "type": "paragraph",
      "id": "txt_0653",
      "reading_order": 689,
      "section": "CRANKCASE BREATHER",
      "bbox": {
        "l": 339.6475,
        "t": 525.3342068359375,
        "r": 564.8560000000003,
        "b": 477.4896519502827
      },
      "content": "WARNING Many cleaning solvents present a hazard of severe personal injury or death. Follow the manufacturer's instructions and proceed with care."
    },
    {
      "type": "list_item",
      "id": "txt_0654",
      "reading_order": 690,
      "section": "CRANKCASE BREATHER",
      "bbox": {
        "l": 325.24739999999997,
        "t": 464.67360683593756,
        "r": 564.7845000000003,
        "b": 442.0585492035388
      },
      "content": "If necessary, clean other breather components in solvent before reassembling."
    },
