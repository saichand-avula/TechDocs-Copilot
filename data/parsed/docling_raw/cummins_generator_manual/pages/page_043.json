  "blocks": [
    {
      "type": "heading",
      "id": "txt_0481",
      "reading_order": 509,
      "section": "[E] VOLTAGE REGULATOR REPLACEMENT",
      "bbox": {
        "l": 92.4095,
        "t": 738.0270068359374,
        "r": 246.42230000000006,
        "b": 713.4881469606776
      },
      "content": "[E] VOLTAGE REGULATOR REPLACEMENT",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0482",
      "reading_order": 510,
      "section": "[E] VOLTAGE REGULATOR REPLACEMENT",
      "bbox": {
        "l": 47.5654,
        "t": 701.9326068359375,
        "r": 291.37160000000017,
        "b": 679.3747492035387
      },
      "content": "Use the following procedure for replacing the AC voltage regulator assembly."
    },
    {
      "type": "list_item",
      "id": "txt_0483",
      "reading_order": 511,
      "section": "[E] VOLTAGE REGULATOR REPLACEMENT",
      "bbox": {
        "l": 55.8429,
        "t": 666.5566068359375,
        "r": 291.3892000000002,
        "b": 643.9987492035388
      },
      "content": "Stop  the  generator  set  and  disconnect  the starting battery leads, negative (-) lead first."
    },
    {
      "type": "list_item",
      "id": "txt_0484",
      "reading_order": 512,
      "section": "[E] VOLTAGE REGULATOR REPLACEMENT",
      "bbox": {
        "l": 55.8429,
        "t": 631.1806068359375,
        "r": 291.4738999999996,
        "b": 608.6227492035388
      },
      "content": "Unscrew the voltage regulator from the control box."
    },
    {
      "type": "list_item",
      "id": "txt_0485",
      "reading_order": 513,
      "section": "[E] VOLTAGE REGULATOR REPLACEMENT",
      "bbox": {
        "l": 55.8429,
        "t": 595.8046068359375,
        "r": 291.3408000000002,
        "b": 573.2467492035388
      },
      "content": "Disconnect the regulator from the wiring harness."
    },
    {
      "type": "list_item",
      "id": "txt_0486",
      "reading_order": 514,
      "section": "[E] VOLTAGE REGULATOR REPLACEMENT",
      "bbox": {
        "l": 55.8429,
        "t": 560.4286068359376,
        "r": 291.3649999999997,
        "b": 537.8707492035388
      },
      "content": "Remove the mounting screws from the old voltage regulator, then install the new regulator."
    },
    {
      "type": "list_item",
      "id": "txt_0487",
      "reading_order": 515,
      "section": "[E] VOLTAGE REGULATOR REPLACEMENT",
      "bbox": {
        "l": 55.8429,
        "t": 525.0526068359376,
        "r": 291.3881000000003,
        "b": 502.49474920353884
      },
      "content": "Reconnect the plug connection to the wiring harness."
    },
    {
      "type": "list_item",
      "id": "txt_0488",
      "reading_order": 516,
      "section": "[E] VOLTAGE REGULATOR REPLACEMENT",
      "bbox": {
        "l": 55.8429,
        "t": 489.6766068359376,
        "r": 291.3716000000001,
        "b": 467.11874920353887
      },
      "content": "Set voltage as outlined in [G] Voltage Adjustment."
    },
    {
      "type": "heading",
      "id": "txt_0489",
      "reading_order": 517,
      "section": "[F]",
      "bbox": {
        "l": 161.8016,
        "t": 454.2790068359375,
        "r": 177.12560000000002,
        "b": 443.4597469606776
      },
      "content": "[F]",
      "level": 2
    },
    {
      "type": "heading",
      "id": "txt_0490",
      "reading_order": 518,
      "section": "WIRING HARNESS CHECK",
      "bbox": {
        "l": 93.03320000000001,
        "t": 431.8858068359375,
        "r": 245.83280000000002,
        "b": 421.0665469606776
      },
      "content": "WIRING HARNESS CHECK",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0491",
      "reading_order": 519,
      "section": "WIRING HARNESS CHECK",
      "bbox": {
        "l": 47.5654,
        "t": 409.56730683593753,
        "r": 269.62350000000026,
        "b": 399.65174920353877
      },
      "content": "Carefully check the wiring harness as follows:"
    },
    {
      "type": "list_item",
      "id": "txt_0492",
      "reading_order": 520,
      "section": "WIRING HARNESS CHECK",
      "bbox": {
        "l": 55.8429,
        "t": 386.83360683593753,
        "r": 291.5102000000003,
        "b": 351.5762492035388
      },
      "content": "Inspect all wires for breaks, loose connections, and reversed connections.  Refer to applicable wiring diagram."
    },
    {
      "type": "list_item",
      "id": "txt_0493",
      "reading_order": 521,
      "section": "WIRING HARNESS CHECK",
      "bbox": {
        "l": 55.84179999999999,
        "t": 338.75810683593755,
        "r": 291.51460000000014,
        "b": 303.55794920353884
      },
      "content": "Remove wires from terminals at each end and with an ohmmeter, check each wire end to end for continuity or opens."
    },
    {
      "type": "list_item",
      "id": "txt_0494",
      "reading_order": 522,
      "section": "WIRING HARNESS CHECK",
      "bbox": {
        "l": 55.83960000000002,
        "t": 290.7398068359376,
        "r": 291.3749000000001,
        "b": 242.89734920353885
      },
      "content": "Using an ohmmeter, check each wire to other wires and to ground for possible shorts or insulation breaks under areas covered by wrapping material."
    },
    {
      "type": "list_item",
      "id": "txt_0495",
      "reading_order": 523,
      "section": "WIRING HARNESS CHECK",
      "bbox": {
        "l": 55.83960000000002,
        "t": 230.0792068359376,
        "r": 291.4639999999997,
        "b": 207.52134920353888
      },
      "content": "Reconnect or replace wires/harness according to applicable wiring diagram."
    },
    {
      "type": "heading",
      "id": "txt_0496",
      "reading_order": 524,
      "section": "[G]",
      "bbox": {
        "l": 160.7811,
        "t": 194.68210683593747,
        "r": 178.10910000000004,
        "b": 183.86284696067764
      },
      "content": "[G]",
      "level": 2
    },
    {
      "type": "heading",
      "id": "txt_0497",
      "reading_order": 525,
      "section": "VOLTAGE ADJUSTMENT",
      "bbox": {
        "l": 98.5323,
        "t": 172.34530683593744,
        "r": 240.32190000000006,
        "b": 161.5260469606776
      },
      "content": "VOLTAGE ADJUSTMENT",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0498",
      "reading_order": 526,
      "section": "VOLTAGE ADJUSTMENT",
      "bbox": {
        "l": 47.56539999999998,
        "t": 149.9704068359374,
        "r": 291.4925999999999,
        "b": 127.41254920353867
      },
      "content": "This section describes adjustment of the generator set output voltage.  When checking output voltage, be sure the generator set has stabilized and is running at the correct speed (frequency).  The regulator is adjusted with the set running."
    },
    {
      "type": "paragraph",
      "id": "txt_0499",
      "reading_order": 527,
      "section": "VOLTAGE ADJUSTMENT",
      "bbox": {
        "l": 320.9388,
        "t": 683.9043068359375,
        "r": 564.9374999999995,
        "b": 623.4174519502827
      },
      "content": "WARNING Accidental  starting  of  the  set  can cause severe personal injury or death.  Disconnect both battery cables, negative (-) cable first, when repairs are made to the engine, controls, or generator set."
    },
    {
      "type": "paragraph",
      "id": "txt_0500",
      "reading_order": 528,
      "section": "VOLTAGE ADJUSTMENT",
      "bbox": {
        "l": 320.9388,
        "t": 604.4775068359376,
        "r": 565.2036999999998,
        "b": 518.7060519502828
      },
      "content": "WARNING Contact with high voltage can cause severe personal injury or death.  Do not touch any  exposed  wiring  or  components  with  any part of the body, clothing, tool or jewelry.  Do not use  non-insulated  tools  inside  the  control. Stand on an insulating mat or dry wood platform when the control doors are open."
    },
    {
      "type": "paragraph",
      "id": "txt_0501",
      "reading_order": 529,
      "section": "VOLTAGE ADJUSTMENT",
      "bbox": {
        "l": 320.9388,
        "t": 500.9004068359377,
        "r": 564.8836,
        "b": 465.700249203539
      },
      "content": "Output voltage adjustments are found on the voltage regulator board under the DC control box.  A removable cover protects the board.  See Figure 7-7."
    },
    {
      "type": "list_item",
      "id": "txt_0502",
      "reading_order": 530,
      "section": "VOLTAGE ADJUSTMENT",
      "bbox": {
        "l": 329.21630000000005,
        "t": 447.89250683593775,
        "r": 564.7647999999997,
        "b": 425.334649203539
      },
      "content": "Attach a voltmeter securely to the L1 and L2 leads."
    },
    {
      "type": "list_item",
      "id": "txt_0503",
      "reading_order": 531,
      "section": "VOLTAGE ADJUSTMENT",
      "bbox": {
        "l": 329.21630000000005,
        "t": 407.5269068359378,
        "r": 564.8791999999995,
        "b": 384.96904920353904
      },
      "content": "Start the generator set and place a typical load on its output."
    },
    {
      "type": "list_item",
      "id": "txt_0504",
      "reading_order": 532,
      "section": "VOLTAGE ADJUSTMENT",
      "bbox": {
        "l": 329.21630000000005,
        "t": 367.1613068359378,
        "r": 564.7856999999995,
        "b": 344.60344920353907
      },
      "content": "Use a flat-blade screwdriver to set the voltage adjust potentiometer for correct voltage."
    },
    {
      "type": "paragraph",
      "id": "txt_0505",
      "reading_order": 533,
      "section": "VOLTAGE ADJUSTMENT",
      "bbox": {
        "l": 320.9399,
        "t": 328.95060683593783,
        "r": 565.0067999999997,
        "b": 281.10814920353914
      },
      "content": "For most 60 Hz applications, the ideal setting is 117 VAC at 60-61 hz, measured at the power input of the application.  Retighten the locking nut when complete."
    },
    {
      "type": "paragraph",
      "id": "txt_0506",
      "reading_order": 534,
      "section": "VOLTAGE ADJUSTMENT",
      "bbox": {
        "l": 320.9386,
        "t": 265.4728068359375,
        "r": 564.8086000000009,
        "b": 233.49575693988754
      },
      "content": "Note that the voltage adjustment pot on the voltage regulator board is a 10-turn potentiometer: it may take several turns to change the voltage noticeably."
    },
    {
      "type": "heading",
      "id": "txt_0507",
      "reading_order": 535,
      "section": "[H]",
      "bbox": {
        "l": 434.4945,
        "t": 215.8853068359374,
        "r": 451.15049999999997,
        "b": 205.06604696067757
      },
      "content": "[H]",
      "level": 2
    },
    {
      "type": "heading",
      "id": "txt_0508",
      "reading_order": 536,
      "section": "RECONNECTION",
      "bbox": {
        "l": 394.12890000000004,
        "t": 189.23930683593744,
        "r": 491.46090000000004,
        "b": 178.4200469606776
      },
      "content": "RECONNECTION",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0509",
      "reading_order": 537,
      "section": "RECONNECTION",
      "bbox": {
        "l": 320.9386,
        "t": 162.61290683593745,
        "r": 564.7414999999996,
        "b": 127.41274920353874
      },
      "content": "generator set reconnection is dependent upon the nameplate code. See Section 8 for reconnection diagrams."
    }
  ]
}