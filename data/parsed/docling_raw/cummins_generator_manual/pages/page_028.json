  "blocks": [
    {
      "type": "heading",
      "id": "txt_0329",
      "reading_order": 343,
      "section": "GENERATOR SET SERVICE",
      "bbox": {
        "l": 90.3685,
        "t": 715.9168068359375,
        "r": 248.51050000000004,
        "b": 705.0975469606776
      },
      "content": "GENERATOR SET SERVICE",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0330",
      "reading_order": 344,
      "section": "GENERATOR SET SERVICE",
      "bbox": {
        "l": 47.5654,
        "t": 694.3357068359375,
        "r": 291.43100000000027,
        "b": 659.1355492035387
      },
      "content": "Always disconnect the battery cables (negative [-] first) from the battery to prevent accidental starting of the set while servicing the generator set."
    },
    {
      "type": "paragraph",
      "id": "txt_0331",
      "reading_order": 345,
      "section": "GENERATOR SET SERVICE",
      "bbox": {
        "l": 47.565,
        "t": 647.3940068359375,
        "r": 291.46800000000013,
        "b": 599.5494519502827
      },
      "content": "WARNING Accidental starting of the set while working on it can cause severe injury.  To prevent accidental starting, disconnect the battery cables (negative [-] first) from the battery."
    },
    {
      "type": "paragraph",
      "id": "txt_0332",
      "reading_order": 346,
      "section": "GENERATOR SET SERVICE",
      "bbox": {
        "l": 47.565,
        "t": 588.9444068359376,
        "r": 291.42840000000035,
        "b": 490.53065195028285
      },
      "content": "The negative (-) cable is always disconnected first, and connected last, to prevent arcing if a tool  accidentally  touches  the  frame  or  other grounded metal parts of the set while disconnecting  or  connecting  the  positive  (+)  cable. Arcing can ignite the explosive hydrogen gas given off by the battery, and cause severe injury."
    },
    {
      "type": "heading",
      "id": "txt_0333",
      "reading_order": 347,
      "section": "Brush Inspection/Replacement",
      "bbox": {
        "l": 47.5654,
        "t": 478.3734068359375,
        "r": 224.16459999999998,
        "b": 467.5541469606776
      },
      "content": "Brush Inspection/Replacement",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0334",
      "reading_order": 348,
      "section": "Brush Inspection/Replacement",
      "bbox": {
        "l": 47.5654,
        "t": 455.2051068359375,
        "r": 291.3859000000003,
        "b": 432.64724920353876
      },
      "content": "The generator set should be inspected for brush wear and cleaning every six months."
    },
    {
      "type": "paragraph",
      "id": "txt_0335",
      "reading_order": 349,
      "section": "Brush Inspection/Replacement",
      "bbox": {
        "l": 47.565,
        "t": 419.3185068359375,
        "r": 291.50980000000015,
        "b": 358.8316519502827
      },
      "content": "WARNING Accidental starting of the generator set  can cause severe personal injury or death. Stop the generator set and disable by disconnecting the starting battery cables (negative [-] cable first) before inspecting the generator set."
    },
    {
      "type": "list_item",
      "id": "txt_0336",
      "reading_order": 350,
      "section": "Brush Inspection/Replacement",
      "bbox": {
        "l": 55.8425,
        "t": 350.6081068359376,
        "r": 291.3734,
        "b": 328.05024920353884
      },
      "content": "Remove the access cover for the brush assembly."
    },
    {
      "type": "list_item",
      "id": "txt_0337",
      "reading_order": 351,
      "section": "Brush Inspection/Replacement",
      "bbox": {
        "l": 55.8425,
        "t": 322.1489068359376,
        "r": 291.5989000000002,
        "b": 261.66414920353895
      },
      "content": "Check the brushes for wear with a piece of wire marked off 1 inch (25 mm) from one end (Figure 5-6).  Replace the brush and the spring if the wire goes into the brush holder 1 inch or more."
    },
    {
      "type": "list_item",
      "id": "txt_0338",
      "reading_order": 352,
      "section": "Brush Inspection/Replacement",
      "bbox": {
        "l": 55.84140000000001,
        "t": 255.76280683593768,
        "r": 291.3778,
        "b": 220.56264920353897
      },
      "content": "To replace brushes, remove the brush holder by disconnecting the two leads to the holder and removing the two mounting screws."
    },
    {
      "type": "list_item",
      "id": "txt_0339",
      "reading_order": 353,
      "section": "Brush Inspection/Replacement",
      "bbox": {
        "l": 329.2145,
        "t": 737.9929068359377,
        "r": 564.8521,
        "b": 690.150449203539
      },
      "content": "Install the new brushes and springs in the holder and keep them in place during assembly by inserting a piece of wire through the holder, as shown in Figure 5-7."
    },
    {
      "type": "list_item",
      "id": "txt_0340",
      "reading_order": 354,
      "section": "Brush Inspection/Replacement",
      "bbox": {
        "l": 329.21340000000004,
        "t": 684.4757068359378,
        "r": 564.7453999999997,
        "b": 649.2755492035391
      },
      "content": "Install  the  brush  holder.    After  tightening  the mounting screws, pull out the brush retaining wire."
    },
    {
      "type": "list_item",
      "id": "txt_0341",
      "reading_order": 355,
      "section": "Brush Inspection/Replacement",
      "bbox": {
        "l": 329.21340000000004,
        "t": 643.6008068359379,
        "r": 564.9356999999999,
        "b": 595.7583492035392
      },
      "content": "Connect the F1 lead to the inner brush terminal (nearest the rotor windings).  Connect the F2 lead to the outer brush terminal (nearest the end bell)."
    },
    {
      "type": "heading",
      "id": "txt_0342",
      "reading_order": 356,
      "section": "Slip Ring Inspection/Replacement",
      "bbox": {
        "l": 320.9386,
        "t": 586.3734068359374,
        "r": 514.9389999999997,
        "b": 575.5541469606776
      },
      "content": "Slip Ring Inspection/Replacement",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0343",
      "reading_order": 357,
      "section": "Slip Ring Inspection/Replacement",
      "bbox": {
        "l": 320.9386,
        "t": 565.3027068359376,
        "r": 564.8349999999995,
        "b": 517.4602492035389
      },
      "content": "Inspect the slip rings for grooves, pits or other damage.  If dust has accumulated on any generator set components, they can be cleaned with filtered lowpressure air."
    },
    {
      "type": "list_item",
      "id": "txt_0344",
      "reading_order": 358,
      "section": "Slip Ring Inspection/Replacement",
      "bbox": {
        "l": 329.2161,
        "t": 509.5745068359376,
        "r": 564.7359999999998,
        "b": 487.01664920353886
      },
      "content": "Examine  the  slip  rings  while  servicing  the brushes."
    },
    {
      "type": "list_item",
      "id": "txt_0345",
      "reading_order": 359,
      "section": "Slip Ring Inspection/Replacement",
      "bbox": {
        "l": 329.2161,
        "t": 481.3419068359376,
        "r": 564.8173999999993,
        "b": 446.1417492035389
      },
      "content": "If the rings need cleaning or service, remove the rotor from the generator set and dress the rings on a lathe."
    },
    {
      "type": "paragraph",
      "id": "txt_0346",
      "reading_order": 360,
      "section": "Slip Ring Inspection/Replacement",
      "bbox": {
        "l": 320.9388,
        "t": 437.1767068359375,
        "r": 564.7922999999996,
        "b": 389.2749519502827
      },
      "content": "CAUTION Dressing the slip rings on a lathe improperly may damage the generator set rotor. Make certain that only an experienced technician performs this job."
    },
    {
      "type": "heading",
      "id": "txt_0347",
      "reading_order": 361,
      "section": "Generator Set Bearing",
      "bbox": {
        "l": 320.9386,
        "t": 377.74350683593747,
        "r": 448.6078000000002,
        "b": 366.9242469606776
      },
      "content": "Generator Set Bearing",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0348",
      "reading_order": 362,
      "section": "Generator Set Bearing",
      "bbox": {
        "l": 320.9386,
        "t": 355.1988068359375,
        "r": 564.7436999999995,
        "b": 307.3563492035388
      },
      "content": "Inspect the bearing for evidence of outer case rotation every 1000 hours of use.  The bearing should be replaced every five years, because the bearing grease gradually deteriorates due to oxidation."
    },
    {
      "type": "paragraph",
      "id": "txt_0349",
      "reading_order": 363,
      "section": "Generator Set Bearing",
      "bbox": {
        "l": 320.9386,
        "t": 295.78560683593753,
        "r": 564.7469999999998,
        "b": 260.5854492035388
      },
      "content": "Replace the O-ring if it shows evidence of wear or deterioration.    Renew  grease  if  necessary  (moly only)."
    }
  ]
}