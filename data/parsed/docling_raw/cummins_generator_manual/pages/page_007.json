      },
      "content": "WARNING Incorrect service or replacement of parts can result in severe personal injury, death, and /or equipment damage.  Service personnel must be qualified to perform electrical and mechanical service."
    },
    {
      "type": "heading",
      "id": "txt_0072",
      "reading_order": 74,
      "section": "SAFETY CONSIDERATIONS",
      "bbox": {
        "l": 363.515,
        "t": 519.0790068359375,
        "r": 522.0602000000005,
        "b": 508.2597469606776
      },
      "content": "SAFETY CONSIDERATIONS",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0073",
      "reading_order": 75,
      "section": "SAFETY CONSIDERATIONS",
      "bbox": {
        "l": 320.9386,
        "t": 495.5704068359375,
        "r": 565.0121000000006,
        "b": 400.67225195028277
      },
      "content": "Generator  sets  present  safety  hazards  that  the technician must know about.  Read the precautions on  the  inside  cover  of  this  manual.    Familiarize yourself with the hazards shown in Table 1-1.  When the  hazards are known, approach the job with a safety-conscious attitude.    Being safety-conscious is the best way to avoid injury. Reduce the chance of an accident with the following safeguards."
    },
    {
      "type": "heading",
      "id": "txt_0074",
      "reading_order": 76,
      "section": "Safeguards To Avoid Hazards",
      "bbox": {
        "l": 320.9386,
        "t": 387.0412068359375,
        "r": 490.1997999999999,
        "b": 376.2219469606776
      },
      "content": "Safeguards To Avoid Hazards",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_0075",
      "reading_order": 77,
      "section": "Safeguards To Avoid Hazards",
      "bbox": {
        "l": 329.7826,
        "t": 364.8220068359375,
        "r": 564.7705,
        "b": 339.95394920353874
      },
      "content": " Use Protective Clothing. Protect your body by wearing protective clothing such as:"
    },
    {
      "type": "list_item",
      "id": "txt_0076",
      "reading_order": 78,
      "section": "Safeguards To Avoid Hazards",
      "bbox": {
        "l": 349.7386,
        "t": 327.12080683593746,
        "r": 420.5449999999999,
        "b": 313.62080683593746
      },
      "content": " Safety shoes"
    },
    {
      "type": "list_item",
      "id": "txt_0077",
      "reading_order": 79,
      "section": "Safeguards To Avoid Hazards",
      "bbox": {
        "l": 349.7386,
        "t": 313.45780683593745,
        "r": 391.1706,
        "b": 299.95780683593745
      },
      "content": " Gloves"
    },
    {
      "type": "list_item",
      "id": "txt_0078",
      "reading_order": 80,
      "section": "Safeguards To Avoid Hazards",
      "bbox": {
        "l": 349.7386,
        "t": 299.79480683593744,
        "r": 428.4803999999999,
        "b": 286.29480683593744
      },
      "content": " Safety glasses"
    },
    {
      "type": "list_item",
      "id": "txt_0079",
      "reading_order": 81,
      "section": "Safeguards To Avoid Hazards",
      "bbox": {
        "l": 349.7386,
        "t": 286.18860683593743,
        "r": 404.66869999999994,
        "b": 272.68860683593743
      },
      "content": " Hard hats"
    },
    {
      "type": "paragraph",
      "id": "txt_0080",
      "reading_order": 82,
      "section": "Safeguards To Avoid Hazards",
      "bbox": {
        "l": 342.5385,
        "t": 259.7844068359375,
        "r": 564.9221999999995,
        "b": 237.22654920353875
      },
      "content": "Leave rings and jewelry off.  Do not wear loose clothing that might get caught on equipment."
    },
    {
      "type": "list_item",
      "id": "txt_0081",
      "reading_order": 83,
      "section": "Safeguards To Avoid Hazards",
      "bbox": {
        "l": 329.7827,
        "t": 224.39330683593744,
        "r": 491.0176999999998,
        "b": 210.89330683593744
      },
      "content": " Reduce Workshop Hazards."
    },
    {
      "type": "list_item",
      "id": "txt_0082",
      "reading_order": 84,
      "section": "Safeguards To Avoid Hazards",
      "bbox": {
        "l": 344.1827,
        "t": 199.33500683593752,
        "r": 534.3575999999997,
        "b": 174.4673492035388
      },
      "content": " Keep guards and shields in place on machinery"
    },
    {
      "type": "list_item",
      "id": "txt_0083",
      "reading_order": 85,
      "section": "Safeguards To Avoid Hazards",
      "bbox": {
        "l": 344.1827,
        "t": 173.02950683593747,
        "r": 561.9620999999996,
        "b": 159.52950683593747
      },
      "content": " Maintain equipment in good working order"
    },
    {
      "type": "list_item",
      "id": "txt_0084",
      "reading_order": 86,
      "section": "Safeguards To Avoid Hazards",
      "bbox": {
        "l": 344.1827,
        "t": 159.42320683593744,
        "r": 564.7550000000001,
        "b": 121.91324920353873
      },
      "content": " Store flammable liquids in approved containers away from open flame, spark, pilot light, cigarette, or other ignition source"
    },
    {
      "type": "list_item",
      "id": "txt_0085",
      "reading_order": 87,
      "section": "Safeguards To Avoid Hazards",
      "bbox": {
        "l": 344.1827,
        "t": 120.47520683593746,
        "r": 560.0425999999998,
        "b": 106.97520683593746
      },
      "content": " Keep the workshop clean and well-lighted"
    },
    {
      "type": "list_item",
      "id": "txt_0086",
      "reading_order": 88,
      "section": "Safeguards To Avoid Hazards",
      "bbox": {
        "l": 344.1827,
        "t": 106.81220683593745,
        "r": 495.8135999999998,
        "b": 93.31220683593745
      },
      "content": " Provide adequate ventilation"
    },
    {
      "type": "list_item",
      "id": "txt_0087",
      "reading_order": 89,
      "section": "Safeguards To Avoid Hazards",
      "bbox": {
        "l": 344.1827,
        "t": 93.14920683593755,
        "r": 529.4735999999997,
        "b": 68.33874920353878
      },
      "content": " Keep a fire extinguisher and safety equipment nearby"
    },
    {
      "type": "list_item",
      "id": "txt_0088",
      "reading_order": 90,
      "section": "Safeguards To Avoid Hazards",
      "bbox": {
        "l": 344.1827,
        "t": 66.9003068359375,
        "r": 557.7215999999996,
        "b": 53.4003068359375
      },
      "content": " Be prepared to respond to an emergency"
    }
  ]
