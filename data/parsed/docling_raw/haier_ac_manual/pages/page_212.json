    {
      "type": "list_item",
      "id": "txt_1788",
      "reading_order": 2340,
      "section": "Air Filter cleaning",
      "bbox": {
        "l": 309.0937,
        "t": 567.3598816,
        "r": 469.22717240000014,
        "b": 558.981804
      },
      "content": "Open the inlet grille by pulling it upward."
    },
    {
      "type": "list_item",
      "id": "txt_1789",
      "reading_order": 2341,
      "section": "Air Filter cleaning",
      "bbox": {
        "l": 310.1613168,
        "t": 553.1099116,
        "r": 380.69188259999964,
        "b": 544.731834
      },
      "content": "Remove the filter."
    },
    {
      "type": "paragraph",
      "id": "txt_1790",
      "reading_order": 2342,
      "section": "Air Filter cleaning",
      "bbox": {
        "l": 310.8751,
        "t": 544.1769783999999,
        "r": 467.6335367999999,
        "b": 530.4372697599999
      },
      "content": "Push up the filter's center tab slightly until it is released from the stopper, and remove the filter downward."
    },
    {
      "type": "list_item",
      "id": "txt_1791",
      "reading_order": 2343,
      "section": "Air Filter cleaning",
      "bbox": {
        "l": 309.7994128,
        "t": 528.0118692000001,
        "r": 370.6318561599997,
        "b": 519.6337916000001
      },
      "content": "Clean the filter."
    },
    {
      "type": "figure",
      "id": "fig_0425",
      "reading_order": 2344,
      "section": "Air Filter cleaning",
      "bbox": {
        "l": 476.9267728271229,
        "t": 564.1063232421875,
        "r": 560.1986663422414,
        "b": 521.8726806640625
      },
      "image_path": "figures/figure_0425.png",
      "previous_block_id": "txt_1791",
      "next_block_id": "txt_1792"
    },
    {
      "type": "paragraph",
      "id": "txt_1792",
      "reading_order": 2345,
      "section": "Air Filter cleaning",
      "bbox": {
        "l": 310.8751,
        "t": 518.2045927999999,
        "r": 483.63443919999986,
        "b": 505.04068399999994
      },
      "content": "Use a vacuum cleaner to remove dust, or wash the filter with water.After washing, dry the filter completely in the shade."
    },
    {
      "type": "list_item",
      "id": "txt_1793",
      "reading_order": 2346,
      "section": "Air Filter cleaning",
      "bbox": {
        "l": 309.7994128,
        "t": 502.1176380000001,
        "r": 372.6485661999996,
        "b": 493.73956040000013
      },
      "content": "Attach the filter."
    },
    {
      "type": "paragraph",
      "id": "txt_1794",
      "reading_order": 2347,
      "section": "Air Filter cleaning",
      "bbox": {
        "l": 309.8023416,
        "t": 491.02373839999996,
        "r": 475.16223279999997,
        "b": 461.77426976
      },
      "content": "Attach the filter correctly so that the \"FRONT\" indication is facing to the front.Make sure that the filter is completely fixed behind the stopper.If the right and left filters are not attached correctly, that may cause defects."
    },
    {
      "type": "figure",
      "id": "fig_0426",
      "reading_order": 2348,
      "section": "Air Filter cleaning",
      "bbox": {
        "l": 481.74782940894363,
        "t": 508.6636657714844,
        "r": 555.5815425481114,
        "b": 470.57952880859375
      },
      "image_path": "figures/figure_0426.png",
      "previous_block_id": "txt_1794",
      "next_block_id": "txt_1795"
    },
    {
