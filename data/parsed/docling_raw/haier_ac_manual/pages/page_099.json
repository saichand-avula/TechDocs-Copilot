      "section": "5.1.2.4 Automatic running",
      "bbox": {
        "l": 137.43423217,
        "t": 313.7968936,
        "r": 285.9023210300001,
        "b": 304.5441164
      },
      "content": "Choose Cooling Mode"
    },
    {
      "type": "paragraph",
      "id": "txt_0791",
      "reading_order": 1073,
      "section": "5.1.2.4 Automatic running",
      "bbox": {
