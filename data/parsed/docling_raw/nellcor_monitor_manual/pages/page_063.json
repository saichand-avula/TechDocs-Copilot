      "bbox": {
        "l": 342.0,
        "t": 276.7537500000001,
        "r": 530.8125,
        "b": 263.9962499999999
      },
      "content": "Remove 4 corner screws on the SMPS."
    },
    {
      "type": "list_item",
      "id": "txt_0693",
