    {
      "type": "heading",
      "id": "txt_0823",
      "reading_order": 969,
      "section": "10.1  System Overview",
      "bbox": {
        "l": 72.0,
        "t": 563.1165,
        "r": 213.5625,
        "b": 546.1875
      },
      "content": "10.1  System Overview",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0824",
      "reading_order": 970,
      "section": "10.1  System Overview",
      "bbox": {
        "l": 137.25,
        "t": 532.50375,
        "r": 539.0625000000001,
        "b": 492.74625
      },
      "content": "The N5500 patient monitor is a  multi-function  monitor  for  use  on  adult, pediatric  and neonatal patients; ECG,  heart  rate, non  invasive blood  pressures, arterial   oxygen saturation, pulse rate, respiration rate and temperature."
    },
    {
      "type": "paragraph",
      "id": "txt_0825",
      "reading_order": 971,
      "section": "10.1  System Overview",
      "bbox": {
        "l": 137.25,
        "t": 492.00375,
        "r": 538.3122500000001,
        "b": 465.74625
      },
      "content": "In addition to monitoring and displaying the status of these physiological parameters, the instrument performs various microprocessor-programmed analytical functions;"
    },
    {
      "type": "list_item",
      "id": "txt_0826",
      "reading_order": 972,
      "section": "10.1  System Overview",
      "bbox": {
        "l": 137.25,
        "t": 465.00375,
        "r": 502.3125,
        "b": 452.24625
      },
      "content": "l Creating both visual and audible alarm signals when settable limits are violated;"
    },
    {
      "type": "list_item",
      "id": "txt_0827",
      "reading_order": 973,
      "section": "10.1  System Overview",
      "bbox": {
        "l": 137.25,
        "t": 451.50375,
        "r": 539.0623000000002,
        "b": 425.24625
      },
      "content": "l Creating  and  displaying  warning/error  messages  when  conditions  are  detected  that would degrade or prevent valid measurements;"
    },
    {
      "type": "list_item",
      "id": "txt_0828",
      "reading_order": 974,
      "section": "10.1  System Overview",
      "bbox": {
        "l": 137.25,
        "t": 424.50375,
        "r": 396.5625,
        "b": 411.74625
      },
      "content": "l Creating and displaying graphical  or tabular trend data;"
    },
    {
      "type": "list_item",
      "id": "txt_0829",
      "reading_order": 975,
      "section": "10.1  System Overview",
      "bbox": {
        "l": 137.25,
        "t": 411.00375,
        "r": 517.3125,
        "b": 398.24625
      },
      "content": "l Providing input to an optional recorder for printout of current or tabular trend data."
    },
    {
      "type": "paragraph",
      "id": "txt_0830",
      "reading_order": 976,
      "section": "10.1  System Overview",
      "bbox": {
        "l": 137.25,
        "t": 384.00375,
        "r": 537.5626500000003,
        "b": 357.74625
      },
      "content": "The  monitor  is  essentially  a  battery-powered  instrument.  An  i nternal  charging  unit  is designed to accept only an AC line voltage."
    },
