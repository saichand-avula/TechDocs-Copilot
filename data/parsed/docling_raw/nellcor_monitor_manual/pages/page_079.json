      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0779",
      "reading_order": 910,
      "section": "8.4  Repacking In a Different Carton",
      "bbox": {
        "l": 148.5,
        "t": 664.50375,
        "r": 521.0625,
        "b": 651.74625
      },
      "content": "If the original carton is not available, use the following procedure to pack the N5500:"
    },
    {
      "type": "list_item",
      "id": "txt_0780",
      "reading_order": 911,
      "section": "8.4  Repacking In a Different Carton",
      "bbox": {
        "l": 148.5,
        "t": 637.50375,
        "r": 310.3125,
        "b": 624.74625
      },
      "content": "Place the monitor in a plastic bag."
    },
    {
      "type": "list_item",
      "id": "txt_0781",
      "reading_order": 912,
      "section": "8.4  Repacking In a Different Carton",
      "bbox": {
        "l": 148.5,
        "t": 610.50375,
        "r": 525.5628,
        "b": 584.24625
      },
      "content": "Locate a corrugated cardboard shipping carton with at least 200 pounds per square inch (psi) bursting strength."
    },
    {
      "type": "list_item",
      "id": "txt_0782",
      "reading_order": 913,
      "section": "8.4  Repacking In a Different Carton",
      "bbox": {
        "l": 148.5,
        "t": 570.00375,
        "r": 468.5625,
        "b": 557.24625
      },
      "content": "Fill the bottom of the carton with at least 2 inches of packing material."
    },
    {
      "type": "list_item",
      "id": "txt_0783",
      "reading_order": 914,
      "section": "8.4  Repacking In a Different Carton",
      "bbox": {
        "l": 148.5,
        "t": 543.00375,
        "r": 515.8125000000001,
        "b": 516.74625
      },
      "content": "Place the bagged unit on the layer of packing material and fill the box completely with packing material."
    },
    {
      "type": "list_item",
      "id": "txt_0784",
      "reading_order": 915,
      "section": "8.4  Repacking In a Different Carton",
      "bbox": {
        "l": 148.5,
        "t": 502.50375,
        "r": 311.0625,
        "b": 489.74625
      },
      "content": "Seal the carton with packing tape."
    },
    {
      "type": "list_item",
      "id": "txt_0785",
      "reading_order": 916,
      "section": "8.4  Repacking In a Different Carton",
      "bbox": {
        "l": 148.5,
        "t": 475.50375,
        "r": 509.8122000000002,
        "b": 449.24625
      },
      "content": "Label the carton with the shipping address, return address, and RGA number, if applicable."
    }
  ]
}