    {
      "type": "list_item",
      "id": "txt_0421",
      "reading_order": 455,
      "section": "3.3.5.5 Temperature Operation with a Temperature Simulator",
      "bbox": {
        "l": 147.75,
        "t": 699.75375,
        "r": 323.811375,
        "b": 686.99625
      },
      "content": "Set temperature simulator as follows:"
    },
    {
      "type": "list_item",
      "id": "txt_0422",
      "reading_order": 456,
      "section": "3.3.5.5 Temperature Operation with a Temperature Simulator",
      "bbox": {
        "l": 167.24849999999998,
        "t": 686.25375,
        "r": 317.81175,
        "b": 673.49625
      },
      "content": "l Temperature: 37°C (98.0°F)"
    },
    {
      "type": "list_item",
      "id": "txt_0423",
      "reading_order": 457,
      "section": "3.3.5.5 Temperature Operation with a Temperature Simulator",
      "bbox": {
        "l": 167.249625,
        "t": 672.75375,
        "r": 518.510625,
        "b": 659.99625
      },
      "content": "l Probe type: Monotherm™   Temperature Probes (Probe accuracy: ±0.1°C)"
    },
    {
      "type": "list_item",
      "id": "txt_0424",
      "reading_order": 458,
      "section": "3.3.5.5 Temperature Operation with a Temperature Simulator",
      "bbox": {
        "l": 147.74775000000005,
        "t": 645.75375,
        "r": 539.0611125000001,
        "b": 619.49625
      },
      "content": "After  normal  power-up  sequence,  verify  temperature  reads  37°C  ±0.1°C  (98.6°F ±0.2°F if Fahrenheit is selected as temperature units)."
    },
    {
      "type": "heading",
      "id": "txt_0425",
      "reading_order": 459,
      "section": "6. Turn monitor off.",
      "bbox": {
        "l": 147.7488750000001,
        "t": 605.25375,
        "r": 236.81062500000013,
        "b": 592.49625
      },
      "content": "6. Turn monitor off.",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0426",
      "reading_order": 460,
      "section": "6. Turn monitor off.",
      "bbox": {
        "l": 147.7477500000001,
        "t": 578.25375,
        "r": 538.3105125000001,
        "b": 524.99625
      },
      "content": "Note:  The  accuracy  of  N5500  temperature  measurements  is  ±0.1°C   (±0.2°F)  in  the range  of  25°C  to  45°C and  ±0.2°C in the range of  15° C to  less  than  2 5° C as specified in Specification section. In the procedure  above,  add  the  tolerance of the simulator and the probe to the acceptable range of readings."
    },
    {
      "type": "heading",
      "id": "txt_0427",
      "reading_order": 461,
      "section": "3.4 Safety Tests",
      "bbox": {
        "l": 72.0,
        "t": 514.3665,
        "r": 173.06385000000003,
        "b": 497.4375
      },
      "content": "3.4 Safety Tests",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0428",
      "reading_order": 462,
      "section": "3.4 Safety Tests",
      "bbox": {
        "l": 147.74775,
        "t": 497.25375,
        "r": 538.3127624999997,
        "b": 457.49625
      },
      "content": "N5500 safety  tests  meet  the  standards  of,  and  are  performed  in  accordance with, IEC 60601-1,  Clause  19  (Second  Edition,  1988;  Amendment  1,  1991-11,  Amendment  2, 1995-03), EN60601-1 for instruments classified as Class I and Type CF."
    },
    {
      "type": "heading",
      "id": "txt_0429",
      "reading_order": 463,
      "section": "3.4.1 Protective Earth Continuity",
      "bbox": {
        "l": 71.99925,
        "t": 444.0525,
        "r": 236.81175000000002,
        "b": 430.6875
      },
      "content": "3.4.1 Protective Earth Continuity",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0430",
      "reading_order": 464,
      "section": "3.4.1 Protective Earth Continuity",
      "bbox": {
        "l": 146.99962500000004,
        "t": 429.75375,
        "r": 539.0622374999999,
        "b": 389.99625
      },
      "content": "This test checks the integrity of the power cord ground wire from the AC plug to the instrument chassis ground. The current used for this test is less than or equal  to 4 Volts RMS, 50 to 60 Hz, and 25 Amperes."
    },
    {
      "type": "list_item",
      "id": "txt_0431",
      "reading_order": 465,
      "section": "3.4.1 Protective Earth Continuity",
      "bbox": {
        "l": 146.999625,
        "t": 375.75375,
        "r": 539.0616750000003,
        "b": 349.49625
      },
      "content": "Connect the monitor AC mains plug to the analyzer as recommended by the analyzer operating instructions."
    },
    {
      "type": "list_item",
      "id": "txt_0432",
      "reading_order": 466,
      "section": "3.4.1 Protective Earth Continuity",
      "bbox": {
        "l": 146.99962500000004,
        "t": 335.25375,
        "r": 538.6866000000002,
        "b": 308.99625
      },
      "content": "Connect the analyzer resistance input lead to the equipotential terminal  (ground lug) on the rear of the instrument. Verify that the analyzer indicates 100 milliohms or less."
    },
    {
      "type": "heading",
      "id": "txt_0433",
      "reading_order": 467,
      "section": "3.4.2 Electrical Leakage",
      "bbox": {
        "l": 71.99925000000002,
        "t": 295.5525,
        "r": 194.06175000000002,
        "b": 282.1875
      },
      "content": "3.4.2 Electrical Leakage",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0434",
      "reading_order": 468,
      "section": "3.4.2 Electrical Leakage",
      "bbox": {
        "l": 146.24925000000002,
        "t": 281.25375,
        "r": 424.31212500000004,
        "b": 268.4962499999999
      },
      "content": "The following tests verify the electrical leakage of the monitor."
    },
    {
      "type": "heading",
      "id": "txt_0435",
      "reading_order": 469,
      "section": "3.4.2.1 Earth Leakage Current",
      "bbox": {
        "l": 71.99925000000002,
        "t": 255.0525,
        "r": 225.56175000000002,
        "b": 241.6875
      },
      "content": "3.4.2.1 Earth Leakage Current",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0436",
      "reading_order": 470,
      "section": "3.4.2.1 Earth Leakage Current",
      "bbox": {
        "l": 146.99849999999992,
        "t": 240.75374999999997,
        "r": 538.5642000000003,
        "b": 200.99625000000003
      },
      "content": "This test is in compliance with IEC60601-1 earth  leakage current. The applied voltage for IEC60601-1 the voltage is 264 Volts AC, 50 to 60 Hz. All measurements shall be made with the power switch in both 'On' and 'Off' positions."
    },
    {
      "type": "list_item",
      "id": "txt_0437",
      "reading_order": 471,
      "section": "3.4.2.1 Earth Leakage Current",
      "bbox": {
        "l": 146.99962499999998,
        "t": 186.75374999999997,
        "r": 539.4374250000002,
        "b": 160.49625000000003
      },
      "content": "Connect the monitor AC plug to the electrical safety analyzer as recommended by the analyzer operating instructions."
    },
    {
      "type": "list_item",
      "id": "txt_0438",
      "reading_order": 472,
      "section": "3.4.2.1 Earth Leakage Current",
      "bbox": {
        "l": 146.99962499999998,
        "t": 146.25374999999997,
        "r": 446.06174999999996,
        "b": 133.49625000000003
      },
      "content": "Perform test as recommended by analyzer operating instructions."
    }
  ]
