      "content": "Figure 6. Service Menu"
    },
    {
      "type": "paragraph",
      "id": "txt_0507",
      "reading_order": 551,
      "section": "4.2 Service Menu",
      "bbox": {
        "l": 159.75,
        "t": 153.75374999999997,
        "r": 537.9375000000002,
        "b": 127.49625000000003
      },
      "content": "Note: Select  'YES' on  'Save Factory Default  Setting as Power-On Default', then the monitor will set back to Factory default settings as power-on defaults."
    },
    {
      "type": "list_item",
      "id": "txt_0508",
      "reading_order": 552,
      "section": "4.2 Service Menu",
      "bbox": {
        "l": 149.25,
        "t": 113.25374999999997,
        "r": 392.0625,
        "b": 100.49625000000003
      },
      "content": "Select 'Done'. The Notice screen will be present."
