    {
      "type": "paragraph",
      "id": "txt_1094",
      "reading_order": 1377,
      "section": "Component",
      "bbox": {
        "l": 36.0,
        "t": 495.18601953125,
        "r": 554.94,
        "b": 474.3813344167462
      },
      "content": "Air from the cooling fan is forced across the cooling fins of the magnetron(s) and into the cooling duct, which then vents the warmed air out of the back of the oven."
    },
