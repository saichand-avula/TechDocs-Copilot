        "l": 205.8,
        "t": 431.34601953125,
        "r": 435.54299999999995,
        "b": 423.2583344167462
      },
      "content": "Check that the following requirements have been met:"
    },
    {
      "type": "list_item",
      "id": "txt_1099",
      "reading_order": 1383,
      "section": "Requirements",
      "bbox": {
        "l": 223.79999999999998,
        "t": 416.34301953125004,
        "r": 568.374,
        "b": 395.0523344167462
      },
      "content": " The appliance has been disconnected from the power supply and protective measures have been taken to ensure the power cannot be switched on again."
    },
    {
      "type": "list_item",
      "id": "txt_1100",
      "reading_order": 1384,
      "section": "Requirements",
      "bbox": {
        "l": 223.79099999999994,
        "t": 390.42301953125,
        "r": 333.40199999999993,
        "b": 381.9753344167462
      },
      "content": " The appliance is cool."
    },
    {
      "type": "list_item",
      "id": "txt_1101",
      "reading_order": 1385,
      "section": "Requirements",
      "bbox": {
        "l": 223.78199999999995,
        "t": 377.82301953125,
        "r": 557.682,
        "b": 356.53233441674615
      },
      "content": " The top, rear, left and right panels of the casing of the appliance have been removed."
    },
    {
      "type": "list_item",
      "id": "txt_1102",
      "reading_order": 1386,
      "section": "Requirements",
      "bbox": {
        "l": 223.7819999999999,
        "t": 351.90301953125,
        "r": 533.787,
        "b": 343.45533441674615
      },
      "content": " The high voltage capacitors are discharged before commencing work."
    },
    {
      "type": "heading",
      "id": "txt_1103",
      "reading_order": 1387,
      "section": "Preparing a replacement magnetron",
      "bbox": {
        "l": 36.0,
        "t": 329.20801953125,
        "r": 242.16,
        "b": 318.4244393785782
      },
      "content": "Preparing a replacement magnetron",
      "level": 2
    },
    {
      "type": "figure",
      "id": "fig_0232",
      "reading_order": 1388,
      "section": "Preparing a replacement magnetron",
      "bbox": {
        "l": 36.104026950696216,
