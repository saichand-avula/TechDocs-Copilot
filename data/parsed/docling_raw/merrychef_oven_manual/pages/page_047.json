    {
      "type": "list_item",
      "id": "txt_0558",
      "reading_order": 716,
      "section": "Diagnostic view",
      "bbox": {
        "l": 315.96,
        "t": 766.98591953125,
        "r": 528.7811999999996,
        "b": 746.6582344167462
      },
      "content": "Select 'diagnostic view' from the service settings to check the main  components of the appliance."
    },
    {
      "type": "paragraph",
      "id": "txt_0559",
      "reading_order": 717,
      "section": "Diagnostic view",
      "bbox": {
        "l": 315.96,
        "t": 730.1460195312501,
        "r": 567.1778999999997,
        "b": 709.8183344167462
      },
      "content": "Diagnostic view can also be selected from the 'Event Details' screen in the Event Log."
    },
    {
      "type": "list_item",
      "id": "txt_0560",
      "reading_order": 718,
      "section": "Diagnostic view",
      "bbox": {
        "l": 315.96,
        "t": 681.3059195312501,
        "r": 544.3781999999998,
        "b": 624.3782344167462
      },
      "content": "Select a component symbol to switch on (red). Select again to increase the level (remains red) or turn off (blue). Except  for the magnetron(s), all the component tests will work with the door open or closed."
    },
    {
      "type": "list_item",
      "id": "txt_0561",
      "reading_order": 719,
      "section": "Diagnostic view",
      "bbox": {
        "l": 315.9240000000001,
        "t": 571.74591953125,
        "r": 561.2640000000001,
        "b": 502.34123441674626
      },
      "content": "Remove the air filter at the front of the oven. The colour of the air filter symbol on the display should change from grey to green indicating that the microswitch circuit for the  air filter is operating correctly. Replace the air filter and the colour should change back to grey."
    },
    {
      "type": "list_item",
      "id": "txt_0562",
      "reading_order": 720,
      "section": "Diagnostic view",
      "bbox": {
        "l": 315.96,
        "t": 460.26601953125,
        "r": 578.3468999999999,
        "b": 354.2553344167461
      },
      "content": "Open the oven door. Check the colour of the door symbol changes from grey to green on the display to check that the door microswitch / interlock circuit  is operating. Place door spacers onto the oven door (refer to \"Adjusting the door microswitches / interlocks\" in the 'Replacing components' within section 6.5 for details), to confirm the door switches are adjusted correctly. Close the door and check the colour of the door    symbol on the display."
    },
    {
      "type": "list_item",
      "id": "txt_0563",
      "reading_order": 721,
      "section": "Diagnostic view",
      "bbox": {
        "l": 315.96,
        "t": 328.0260195312501,
        "r": 570.4200000000001,
        "b": 319.9383344167462
      },
      "content": "Select the cooling fan and check if it is operating correctly."
    },
    {
      "type": "paragraph",
      "id": "txt_0564",
      "reading_order": 722,
      "section": "Diagnostic view",
      "bbox": {
        "l": 315.96,
        "t": 310.98601953125,
        "r": 567.3092999999992,
        "b": 277.86443937857825
      },
      "content": "Repeated presses will increase the fan speed, noticed by an increase in the fan noise volume and air flow through the filter (off / 33%, 50%, 85% / 100% / off)."
    },
    {
      "type": "list_item",
      "id": "txt_0565",
      "reading_order": 723,
      "section": "Diagnostic view",
      "bbox": {
        "l": 315.96,
        "t": 185.46601953125003,
        "r": 544.7373,
        "b": 165.13833441674615
      },
      "content": "Select the convection fan and check if it is operating correctly."
    },
    {
      "type": "paragraph",
      "id": "txt_0566",
      "reading_order": 724,
      "section": "Diagnostic view",
      "bbox": {
        "l": 315.96,
        "t": 156.18591953124997,
        "r": 574.2545999999999,
        "b": 135.3044393785783
      },
      "content": "When increasing the fan power gradually, in 10% increments, to 100% the fan noise should become louder."
    }
  ]
}