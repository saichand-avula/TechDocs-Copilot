        "l": 189.71999999999997,
        "t": 510.42601953125,
        "r": 306.657,
        "b": 477.8583344167462
      },
      "content": "Open the filter cover access the USB port and lift the cover up."
    },
    {
      "type": "list_item",
      "id": "txt_0458",
      "reading_order": 577,
      "section": "USB menu downloads & instructions go to Merrychef - Merrychef conneX®12",
      "bbox": {
        "l": 189.72000000000003,
        "t": 464.82301953125,
        "r": 304.02,
        "b": 444.4953344167462
      },
      "content": "Plug in the USB memory stick."
    },
    {
      "type": "list_item",
      "id": "txt_0459",
      "reading_order": 578,
      "section": "USB menu downloads & instructions go to Merrychef - Merrychef conneX®12",
      "bbox": {
        "l": 191.16,
        "t": 391.50601953125,
        "r": 307.9889999999999,
        "b": 383.31873047605825
      },
      "content": "Switch the appliance ON."
    },
    {
      "type": "list_item",
      "id": "txt_0460",
      "reading_order": 579,
      "section": "USB menu downloads & instructions go to Merrychef - Merrychef conneX®12",
      "bbox": {
        "l": 191.39999999999995,
        "t": 359.22601953125,
        "r": 363.18299999999994,
        "b": 326.65833441674613
      },
      "content": "After the Welbilt start-up screens, the oven will display the menu, or choices of menus that can be selected of the USB."
    },
    {
      "type": "list_item",
      "id": "txt_0461",
      "reading_order": 580,
      "section": "USB menu downloads & instructions go to Merrychef - Merrychef conneX®12",
      "bbox": {
        "l": 192.84,
        "t": 295.14601953125,
        "r": 311.82,
        "b": 274.8183344167462
      },
      "content": "Select menu file and then the green tick."
    },
    {
      "type": "list_item",
      "id": "txt_0462",
      "reading_order": 581,
      "section": "USB menu downloads & instructions go to Merrychef - Merrychef conneX®12",
      "bbox": {
        "l": 192.83099999999996,
        "t": 231.90601953124997,
        "r": 325.49099999999993,
        "b": 211.46133441674624
      },
      "content": "Select the tick on completion to end."
    },
    {
      "type": "list_item",
      "id": "txt_0463",
      "reading_order": 582,
      "section": "USB menu downloads & instructions go to Merrychef - Merrychef conneX®12",
      "bbox": {
        "l": 192.83099999999996,
        "t": 197.58901953124996,
        "r": 309.29099999999994,
        "b": 177.2613344167462
      },
      "content": "Unplug the USB memory stick."
    },
    {
