        "b": 419.23415583030965
      },
      "image_path": "figures/figure_0222.png",
      "previous_block_id": "txt_1076",
      "next_block_id": "txt_1077"
    },
    {
      "type": "caption",
      "id": "txt_1077",
      "reading_order": 1352,
      "section": "Requirements",
      "bbox": {
        "l": 197.28,
        "t": 409.98601953125,
        "r": 346.14,
        "b": 363.2523344167462
      },
      "content": "5. Place the new door seal over the door in the same place as the old one and insert the metal clips in each corner."
    },
    {
      "type": "figure",
      "id": "fig_0223",
      "reading_order": 1353,
      "section": "Requirements",
      "bbox": {
        "l": 197.22377768075955,
        "t": 323.6306312947157,
        "r": 343.14375171719604,
        "b": 211.90125331363924
      },
      "image_path": "figures/figure_0223.png",
      "previous_block_id": "txt_1077",
      "next_block_id": "txt_1078"
    },
    {
      "type": "caption",
      "id": "txt_1078",
      "reading_order": 1354,
      "section": "Requirements",
      "bbox": {
        "l": 36.01499999999997,
        "t": 199.85401953124995,
        "r": 324.798,
        "b": 191.6667304760582
      },
      "content": "Note: The door seal can be replaced without removing the door skin"
    },
