        "b": 745.6244393785782
      },
      "content": "Tools required",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1066",
      "reading_order": 1338,
      "section": "Tools required",
      "bbox": {
        "l": 35.999999999999986,
        "t": 737.82601953125,
        "r": 146.22299999999998,
        "b": 683.4153344167461
      },
      "content": "Suitable gloves Stanley / retractable knife High temperature sealant Cloth for wiping residue"
    },
    {
      "type": "list_item",
      "id": "txt_1067",
      "reading_order": 1339,
      "section": "Tools required",
      "bbox": {
        "l": 34.56,
        "t": 652.74591953125,
        "r": 164.34900000000002,
        "b": 606.5072344167462
      },
      "content": "Place a Stanley / retractable knife blade underneath the door seal and go all the way to break the seal."
    },
    {
      "type": "paragraph",
      "id": "txt_1068",
      "reading_order": 1340,
      "section": "Tools required",
      "bbox": {
        "l": 34.56,
        "t": 598.8719195312501,
        "r": 170.703,
        "b": 565.4672344167462
      },
      "content": "Ensure you do all four sides avoiding the metal clips on each corner."
    },
    {
      "type": "paragraph",
      "id": "txt_1069",
      "reading_order": 1341,
      "section": "Tools required",
      "bbox": {
        "l": 34.55999999999999,
        "t": 558.0749195312501,
        "r": 168.77700000000002,
        "b": 524.5532344167462
      },
      "content": "Please ensure all safety aspects are adhered to while working with a sharp knife"
    },
    {
      "type": "figure",
      "id": "fig_0220",
      "reading_order": 1342,
      "section": "Tools required",
      "bbox": {
        "l": 34.8181216877263,
        "t": 500.77766662091904,
        "r": 176.82574951187746,
        "b": 420.483291614487
      },
      "image_path": "figures/figure_0220.png",
      "previous_block_id": "txt_1069",
      "next_block_id": "txt_1070"
    },
    {
      "type": "list_item",
      "id": "txt_1070",
      "reading_order": 1343,
      "section": "Tools required",
      "bbox": {
        "l": 36.24,
        "t": 409.98601953125,
        "r": 173.697,
        "b": 350.40933441674616
      },
      "content": "Apply a continuous thin bead of Merrychef approved high temperature sealant around the existing door seal area. Ensure you do all four sides."
    },
    {
      "type": "list_item",
      "id": "txt_1071",
      "reading_order": 1344,
      "section": "Tools required",
      "bbox": {
        "l": 36.24,
        "t": 315.66601953124996,
        "r": 165.53669999999994,
        "b": 256.08933441674617
      },
      "content": "Leave to dry naturally. It will need 24 hours to dry but the heat of the oven can also be used to dry the sealant, speeding up the process."
    },
    {
      "type": "heading",
      "id": "txt_1072",
      "reading_order": 1345,
      "section": "Requirements",
      "bbox": {
        "l": 199.2,
        "t": 756.88791953125,
        "r": 281.03999999999996,
        "b": 746.1043393785782
      },
      "content": "Requirements",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1073",
      "reading_order": 1346,
      "section": "Requirements",
      "bbox": {
        "l": 199.2,
        "t": 738.4259195312501,
        "r": 428.943,
        "b": 730.3382344167462
      },
      "content": "Check that the following requirements have been met:"
    },
    {
      "type": "list_item",
      "id": "txt_1074",
      "reading_order": 1347,
      "section": "Requirements",
      "bbox": {
        "l": 217.20000000000002,
        "t": 723.4229195312499,
        "r": 562.0170000000002,
        "b": 702.0152344167461
      },
      "content": " The appliance has been disconnected from the power supply and protective measures have been taken to ensure the power cannot be switched on again."
    },
    {
      "type": "list_item",
      "id": "txt_1075",
      "reading_order": 1348,
      "section": "Requirements",
      "bbox": {
        "l": 217.20000000000016,
        "t": 697.5029195312499,
        "r": 326.8110000000001,
        "b": 689.0552344167461
      },
      "content": " The appliance is cool."
    },
    {
      "type": "figure",
      "id": "fig_0221",
      "reading_order": 1349,
      "section": "Requirements",
      "bbox": {
        "l": 194.02521636129646,
        "t": 660.1422757653703,
        "r": 337.56493346773465,
        "b": 564.12817275685
      },
      "image_path": "figures/figure_0221.png",
