    {
      "type": "heading",
      "id": "txt_0364",
      "reading_order": 427,
      "section": "Risk of burns from high temperatures inside the cavity and on the inside of the appliance door.",
      "bbox": {
        "l": 36.0,
        "t": 716.22601953125,
        "r": 461.92499999999995,
        "b": 708.0387304760582
      },
      "content": "Risk of burns from high temperatures inside the cavity and on the inside of the appliance door.",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_0365",
      "reading_order": 428,
      "section": "Risk of burns from high temperatures inside the cavity and on the inside of the appliance door.",
      "bbox": {
        "l": 53.98199999999997,
        "t": 704.4630195312499,
        "r": 558.396,
        "b": 683.1723344167461
      },
      "content": " You may get burnt if you touch any of the interior parts of the cooking chamber, the inside of the appliance door or any parts that were inside the oven during cooking."
    },
    {
      "type": "list_item",
      "id": "txt_0366",
      "reading_order": 429,
      "section": "Risk of burns from high temperatures inside the cavity and on the inside of the appliance door.",
      "bbox": {
        "l": 53.96399999999997,
        "t": 678.5430195312499,
        "r": 558.6300000000001,
        "b": 657.4953344167461
      },
      "content": " Before starting servicing and repair work, wait until the cooking chamber has cooled to below 50°C / 122°F or use the 'Cool-down' function to cool the cooking chamber."
    },
    {
      "type": "list_item",
      "id": "txt_0367",
      "reading_order": 430,
      "section": "Risk of burns from high temperatures inside the cavity and on the inside of the appliance door.",
