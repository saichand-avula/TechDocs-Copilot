      "section": "Risk of fire and/or smoke.",
      "bbox": {
        "l": 36.0,
        "t": 502.02601953125,
        "r": 153.279,
        "b": 493.83873047605823
      },
      "content": "Risk of fire and/or smoke.",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0376",
      "reading_order": 441,
      "section": "Risk of fire and/or smoke.",
      "bbox": {
        "l": 35.95499999999993,
        "t": 489.90301953125,
        "r": 558.4949999999999,
        "b": 468.97233441674615
      },
      "content": "Flames and/or smoke may come out of the oven when switching it on after service/repair. This can be caused by a defective electrical component or electrical connections (wiring) that have been refitted incorrectly."
    },
    {
      "type": "list_item",
      "id": "txt_0377",
      "reading_order": 442,
      "section": "Risk of fire and/or smoke.",
      "bbox": {
        "l": 53.999999999999886,
        "t": 462.06601953125,
        "r": 156.663,
        "b": 453.61833441674617
      },
      "content": " Switch off the oven."
    },
    {
      "type": "list_item",
      "id": "txt_0378",
      "reading_order": 443,
      "section": "Risk of fire and/or smoke.",
      "bbox": {
        "l": 54.0,
        "t": 449.34901953125,
        "r": 300.90599999999984,
        "b": 440.9013344167462
      },
      "content": " Disconnect/isolate the oven from the electrical supply."
    },
    {
      "type": "list_item",
      "id": "txt_0379",
      "reading_order": 444,
      "section": "Risk of fire and/or smoke.",
      "bbox": {
        "l": 54.00899999999993,
        "t": 436.50601953125,
        "r": 269.0009999999999,
        "b": 428.05833441674616
      },
      "content": " Keep the oven door closed to stifle any flames."
    }
  ]
