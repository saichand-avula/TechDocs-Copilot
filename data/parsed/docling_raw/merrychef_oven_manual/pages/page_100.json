      "reading_order": 1781,
      "section": "Mains Cable Entry",
      "bbox": {
        "l": 35.990999999999985,
        "t": 760.3860195312501,
        "r": 360.53099999999995,
        "b": 739.9413344167463
      },
      "content": "The mains cable enters the oven through a PG21 / PG16 cable gland on the base plate angled bracket at the rear righthand side of the oven."
    },
    {
