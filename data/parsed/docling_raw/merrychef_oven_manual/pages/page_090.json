    },
    {
      "type": "heading",
      "id": "txt_1253",
      "reading_order": 1587,
      "section": "IMPORTANT:",
      "bbox": {
        "l": 50.16,
        "t": 189.42601953124995,
        "r": 109.263,
        "b": 181.2387304760582
      },
      "content": "IMPORTANT:",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1254",
      "reading_order": 1588,
      "section": "IMPORTANT:",
      "bbox": {
        "l": 36.003,
        "t": 174.30601953125006,
        "r": 276.87899999999996,
        "b": 166.1187304760582
      },
      "content": "Follow the steps in the reverse order to fit the stirrer."
    },
    {
      "type": "paragraph",
      "id": "txt_1255",
      "reading_order": 1589,
      "section": "IMPORTANT:",
      "bbox": {
        "l": 35.9489999999999,
        "t": 158.82601953125004,
        "r": 517.0889999999999,
        "b": 137.67873047605826
      },
      "content": "When refitting the partition plate fasten the screws on opposite corners/sides in turns and do NOT proceed stringently clockwise or anti-clockwise."
    },
    {
      "type": "paragraph",
      "id": "txt_1256",
      "reading_order": 1590,
      "section": "IMPORTANT:",
      "bbox": {
        "l": 35.95799999999991,
        "t": 130.50301953124995,
        "r": 281.8919999999999,
        "b": 122.3157304760582
      },
      "content": "Tighten the partition plate screws to 2.1 Nm of torque."
    },
    {
      "type": "paragraph",
      "id": "txt_1257",
      "reading_order": 1591,
      "section": "IMPORTANT:",
      "bbox": {
        "l": 35.9489999999999,
        "t": 115.02301953125004,
        "r": 363.95399999999984,
        "b": 106.83573047605819
      },
      "content": "Tighten the jet/impinger plate screws to NO more than 1.8 Nm of torque."
    },
    {
      "type": "paragraph",
      "id": "txt_1258",
      "reading_order": 1592,
      "section": "IMPORTANT:",
      "bbox": {
        "l": 35.93099999999987,
        "t": 99.78601953125008,
        "r": 298.1999999999998,
        "b": 91.59873047605822
      },
      "content": "Tighten the stirrer motor pozidrive screws to 1Nm torque."
    }
  ]
}