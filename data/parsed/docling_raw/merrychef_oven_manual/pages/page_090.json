  "blocks": [
    {
      "type": "list_item",
      "id": "txt_1245",
      "reading_order": 1573,
      "section": "Removing the microwave stirrer",
      "bbox": {
        "l": 54.0,
        "t": 788.94601953125,
        "r": 376.7345999999997,
        "b": 780.8583344167462
      },
      "content": "Unfasten the sixteen M7 hex nuts (nine on the standard power variants)."
    },
    {
      "type": "list_item",
      "id": "txt_1246",
      "reading_order": 1574,
      "section": "Removing the microwave stirrer",
      "bbox": {
        "l": 267.12,
        "t": 603.4260195312501,
        "r": 431.09999999999997,
        "b": 595.3383344167462
      },
      "content": "Carefully remove the partition plate."
    },
    {
      "type": "list_item",
      "id": "txt_1247",
      "reading_order": 1575,
      "section": "Removing the microwave stirrer",
      "bbox": {
        "l": 267.12,
        "t": 590.46601953125,
        "r": 530.5805999999998,
        "b": 543.7323344167462
      },
      "content": "NOTE: The partition plate features a rubber gasket on the side pointing upwards (to the stirrer) when mounted. The rubber gasket prevents grease laden air from soiling the stirrers and needs to be intact at any time."
    },
    {
      "type": "list_item",
      "id": "txt_1248",
      "reading_order": 1576,
      "section": "Removing the microwave stirrer",
      "bbox": {
        "l": 267.12,
        "t": 487.02601953125003,
        "r": 526.4900999999996,
        "b": 466.0983344167462
      },
      "content": "The stirrer(s) is positioned inside the top of the oven cavity, above the partition plate."
    },
    {
      "type": "list_item",
      "id": "txt_1249",
      "reading_order": 1577,
      "section": "Removing the microwave stirrer",
      "bbox": {
        "l": 267.12,
        "t": 422.22601953125,
        "r": 542.0033999999999,
        "b": 388.45533441674615
      },
      "content": "To remove the stirrer from the spindle, turn anti-clockwise (looking up). Hold the stirrer cog located next to the motor cog to prevent the stirrer motor from rotating."
    },
    {
      "type": "list_item",
      "id": "txt_1250",
      "reading_order": 1578,
      "section": "Removing the microwave stirrer",
      "bbox": {
        "l": 267.12,
        "t": 370.62601953125,
        "r": 535.0247999999997,
        "b": 336.7353344167462
      },
      "content": "Remove any remains of the old gasket from the top of the cavity before fitting a new partition plate (comes with gasket) to ensure a good seal."
    },
