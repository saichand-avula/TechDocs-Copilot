      "reading_order": 1584,
      "section": "Fitting the stirrer motor and assembly",
      "bbox": {
        "l": 36.0,
        "t": 238.9680195312501,
        "r": 250.08,
        "b": 228.1844393785783
      },
      "content": "Fitting the stirrer motor and assembly",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1252",
      "reading_order": 1585,
      "section": "Fitting the stirrer motor and assembly",
      "bbox": {
        "l": 36.0,
        "t": 220.38601953124999,
        "r": 333.9989999999999,
        "b": 212.29833441674623
      },
      "content": "Follow the steps in the reverse order to fit the stirrer motor and stirrer."
    },
    {
      "type": "figure",
      "id": "fig_0281",
      "reading_order": 1586,
      "section": "Fitting the stirrer motor and assembly",
