      "section": "Removing a magnetron",
      "bbox": {
        "l": 36.0,
        "t": 787.84801953125,
        "r": 169.56,
        "b": 777.0644393785782
      },
      "content": "Removing a magnetron",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_1111",
      "reading_order": 1398,
      "section": "Removing a magnetron",
      "bbox": {
        "l": 36.0,
        "t": 772.0260195312501,
        "r": 349.85999999999996,
        "b": 763.9383344167462
      },
      "content": "Carefully peal back the sealing tape on the cooling duct (keep for reuse)."
    },
    {
      "type": "list_item",
      "id": "txt_1112",
      "reading_order": 1399,
      "section": "Removing a magnetron",
      "bbox": {
        "l": 36.0,
        "t": 754.74591953125,
        "r": 547.7498999999995,
        "b": 734.4182344167461
      },
      "content": "Unfasten the two M3 x 4 CSK Philips SS Screws and flat washers to disconnect the Cavity Overheat Thermostat from the cooling duct."
    },
    {
      "type": "list_item",
      "id": "txt_1113",
      "reading_order": 1400,
      "section": "Removing a magnetron",
      "bbox": {
        "l": 35.99999999999999,
        "t": 725.34291953125,
        "r": 353.9429999999999,
        "b": 717.2552344167461
      },
      "content": "Unplug the magnetron high temperature thermostat(s) and earth lead(s)."
    },
    {
      "type": "list_item",
      "id": "txt_1114",
      "reading_order": 1401,
      "section": "Removing a magnetron",
      "bbox": {
        "l": 35.99999999999994,
        "t": 708.06291953125,
        "r": 326.8259999999999,
        "b": 699.9752344167462
      },
      "content": "Unclip the wiring loom from the cooling duct (High power conneX)."
    },
    {
      "type": "list_item",
      "id": "txt_1115",
      "reading_order": 1402,
      "section": "Removing a magnetron",
      "bbox": {
        "l": 36.00899999999996,
        "t": 690.7829195312501,
        "r": 534.3056999999993,
        "b": 670.4552344167462
      },
      "content": "Standard power conneX - Unfasten the two Pozidriv screws on the inside of the cooling duct with a long PZ2 Pozidriv screwdriver from the rear of the oven)."
    },
    {
      "type": "list_item",
      "id": "txt_1116",
      "reading_order": 1403,
      "section": "Removing a magnetron",
      "bbox": {
        "l": 36.008999999999986,
        "t": 661.2629195312501,
        "r": 570.0690000000001,
        "b": 653.1752344167462
      },
      "content": "High power conneX - Unfasten the two Pozidrive screws on each magnetron (four in total) on the outside of the cooling duct."
    },
    {
      "type": "figure",
      "id": "fig_0235",
      "reading_order": 1404,
      "section": "Removing a magnetron",
      "bbox": {
        "l": 34.70750289999473,
        "t": 636.1997084800123,
        "r": 192.95882073203651,
        "b": 501.6345088034338
      },
      "image_path": "figures/figure_0235.png",
      "previous_block_id": "txt_1116",
      "next_block_id": "txt_1117"
    },
    {
      "type": "figure",
      "id": "fig_0236",
      "reading_order": 1405,
      "section": "Removing a magnetron",
      "bbox": {
        "l": 41.976900453475785,
        "t": 487.9491900433991,
        "r": 150.02760818235953,
        "b": 413.61284655019693
      },
      "image_path": "figures/figure_0236.png",
      "previous_block_id": "txt_1116",
      "next_block_id": "txt_1117"
    },
    {
      "type": "heading",
      "id": "txt_1117",
      "reading_order": 1406,
      "section": "Fitting a magnetron",
      "bbox": {
        "l": 36.0,
        "t": 389.44801953125,
        "r": 148.56,
        "b": 378.66443937857827
      },
      "content": "Fitting a magnetron",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_1118",
      "reading_order": 1407,
      "section": "Fitting a magnetron",
      "bbox": {
        "l": 54.0,
        "t": 370.86601953125,
        "r": 362.691,
        "b": 362.7783344167462
      },
      "content": "Follow the steps in the reverse order to fit a replacement magnetron."
    },
    {
      "type": "list_item",
      "id": "txt_1119",
      "reading_order": 1408,
      "section": "Fitting a magnetron",
      "bbox": {
        "l": 53.990999999999985,
        "t": 358.14901953125,
        "r": 505.25999999999993,
        "b": 350.0613344167462
      },
      "content": "Ensure the magnetron overheat thermostat is refitted in the same location to ensure correct operation."
    },
    {
      "type": "list_item",
      "id": "txt_1120",
      "reading_order": 1409,
      "section": "Fitting a magnetron",
      "bbox": {
        "l": 53.99999999999994,
        "t": 345.30601953125,
        "r": 318.7619999999999,
        "b": 337.2183344167462
      },
      "content": "Ensure the RF (Radio Frequency) gasket is correctly seated."
    },
    {
      "type": "list_item",
      "id": "txt_1121",
      "reading_order": 1410,
      "section": "Fitting a magnetron",
      "bbox": {
        "l": 53.981999999999914,
        "t": 332.46301953125,
        "r": 546.399,
        "b": 311.53233441674615
      },
      "content": "Fit all of the M8 bolts loosely, then tighten in a cross pattern to ensure the magnetron seats evenly. Torque to 2.1 Nm."
    },
    {
      "type": "list_item",
      "id": "txt_1122",
      "reading_order": 1411,
      "section": "Fitting a magnetron",
      "bbox": {
        "l": 53.981999999999964,
        "t": 306.66001953125,
        "r": 550.962,
        "b": 285.85533441674625
      },
      "content": "Refit the cooling duct, ensuring the high temperature tape is reapplied on the top meeting faces between the duct and magnetron(s). Refit the cavity overheat thermostat, torquing the screws up to 1Nm."
    },
    {
      "type": "heading",
      "id": "txt_1123",
      "reading_order": 1412,
      "section": "WARNING",
      "bbox": {
        "l": 50.04,
        "t": 262.98601953125,
        "r": 97.37999999999998,
        "b": 254.79873047605827
      },
      "content": "WARNING",
      "level": 2
    },
    {
      "type": "figure",
      "id": "fig_0237",
      "reading_order": 1413,
      "section": "WARNING",
      "bbox": {
        "l": 34.3235069433689,
        "t": 267.7232115207901,
        "r": 46.84310865792947,
        "b": 255.82191059223135
      },
      "image_path": "figures/figure_0237.png",
      "previous_block_id": "txt_1123",
      "next_block_id": "txt_1124"
    },
    {
      "type": "paragraph",
      "id": "txt_1124",
      "reading_order": 1414,
      "section": "WARNING",
      "bbox": {
        "l": 36.0,
        "t": 250.86301953125007,
        "r": 557.6040000000002,
        "b": 229.95873047605824
      },
      "content": "Ensure nothing becomes trapped under the magnetron mounting points (e. g. insulation material) while fitting the magnetron. This can lead to microwave leakage."
    },
    {
      "type": "heading",
      "id": "txt_1125",
      "reading_order": 1415,
      "section": "NOTICE:",
      "bbox": {
        "l": 36.0,
        "t": 207.42601953124995,
        "r": 74.34,
        "b": 199.2387304760582
      },
      "content": "NOTICE:",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1126",
      "reading_order": 1416,
      "section": "NOTICE:",
      "bbox": {
        "l": 36.0,
        "t": 191.94601953125004,
        "r": 494.4419999999999,
        "b": 183.85833441674617
      },
      "content": "If the electric connections have not been restored properly this may lead to malfunction/damage of the oven."
    },
    {
      "type": "figure",
      "id": "fig_0238",
      "reading_order": 1417,
      "section": "NOTICE:",
      "bbox": {
        "l": 196.0867233472258,
        "t": 636.6761216395496,
        "r": 297.7725328343819,
        "b": 501.82333555571904
      },
      "image_path": "figures/figure_0238.png",
      "previous_block_id": "txt_1126",
      "next_block_id": "txt_1127"
    },
    {
      "type": "list_item",
      "id": "txt_1127",
      "reading_order": 1418,
      "section": "NOTICE:",
      "bbox": {
        "l": 307.8,
        "t": 631.8660195312501,
        "r": 510.65909999999985,
        "b": 623.7783344167462
      },
      "content": "Disconnect the wiring from the magnetron(s)."
    },
    {
      "type": "list_item",
      "id": "txt_1128",
      "reading_order": 1419,
      "section": "NOTICE:",
      "bbox": {
        "l": 307.8,
        "t": 614.10591953125,
        "r": 557.3537999999998,
        "b": 581.4183344167462
      },
      "content": "Unfasten the four M8 hex cap bolts to remove the magnetron(s). There is one pair of bolts on each side of the magnetron(s)."
    },
    {
      "type": "list_item",
      "id": "txt_1129",
      "reading_order": 1420,
      "section": "NOTICE:",
      "bbox": {
        "l": 307.8,
        "t": 571.74591953125,
        "r": 491.21999999999997,
        "b": 563.6582344167462
      },
      "content": "Lift the magnetron out of the waveguide."
    },
    {
      "type": "list_item",
      "id": "txt_1130",
      "reading_order": 1421,
      "section": "NOTICE:",
      "bbox": {
        "l": 307.8,
        "t": 553.98591953125,
        "r": 566.1090000000002,
        "b": 533.6582344167462
      },
      "content": "Remove the magnetron overheat thermostat(s) and earth tab, for refitment on to the replacement magnetron(s)."
    }
  ]
}