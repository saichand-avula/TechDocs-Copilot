    {
      "type": "heading",
      "id": "txt_0686",
      "reading_order": 878,
      "section": "If a level greater than 5mW/cm² is observed, don't use the appliance until repaired.",
      "bbox": {
        "l": 35.997,
        "t": 178.14901953125002,
        "r": 408.885,
        "b": 169.96173047605816
      },
      "content": "If a level greater than 5mW/cm² is observed, don't use the appliance until repaired.",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_0687",
      "reading_order": 879,
      "section": "If a level greater than 5mW/cm² is observed, don't use the appliance until repaired.",
      "bbox": {
        "l": 54.0,
        "t": 153.66601953124996,
        "r": 558.6390000000001,
        "b": 133.3383344167462
      },
      "content": "Note any leakage that is observed in terms of the level and position on the appliance. Keep this information with the service documentation."
    },
    {
      "type": "list_item",
      "id": "txt_0688",
      "reading_order": 880,
      "section": "If a level greater than 5mW/cm² is observed, don't use the appliance until repaired.",
      "bbox": {
        "l": 53.98200000000008,
        "t": 128.94601953125004,
        "r": 369.06,
        "b": 120.85533441674625
      },
      "content": "On completion of the test, specify the result by selecting 'Pass' or 'Fail'."
    },
    {
      "type": "paragraph",
      "id": "txt_0689",
      "reading_order": 881,
      "section": "If a level greater than 5mW/cm² is observed, don't use the appliance until repaired.",
      "bbox": {
        "l": 50.406000000000006,
        "t": 104.58301953124999,
        "r": 415.1670000000001,
        "b": 96.49533441674623
      },
      "content": "Note: Opening the door during the test will stop the test. Reselect the test to run again."
    },
