        "b": 651.5471357630295
      },
      "image_path": "figures/figure_0396.png",
      "previous_block_id": "txt_1473",
      "next_block_id": "txt_1474"
    },
    {
      "type": "caption",
      "id": "txt_1474",
      "reading_order": 1938,
      "section": "Task B",
      "bbox": {
        "l": 186.47999999999996,
        "t": 647.94901953125,
        "r": 280.503,
        "b": 578.5443344167461
      },
      "content": "9. Enter the password MANAGER to access the settings menu. Use the displayed oven serial number if this is invalid."
    },
    {
      "type": "figure",
      "id": "fig_0397",
      "reading_order": 1939,
      "section": "Task B",
      "bbox": {
        "l": 34.956074759350436,
