    {
      "type": "heading",
      "id": "txt_0499",
      "reading_order": 641,
      "section": "Servicing procedure: overview",
      "bbox": {
        "l": 36.0,
        "t": 718.00791953125,
        "r": 206.64000000000001,
        "b": 707.2243393785782
      },
      "content": "Servicing procedure: overview",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_0500",
      "reading_order": 642,
      "section": "Servicing procedure: overview",
      "bbox": {
        "l": 54.0,
        "t": 702.9060195312501,
        "r": 307.91700000000003,
        "b": 694.7187304760582
      },
      "content": "Disconnect/isolate the appliance from the power supply."
    },
    {
      "type": "list_item",
      "id": "txt_0501",
      "reading_order": 643,
      "section": "Servicing procedure: overview",
      "bbox": {
        "l": 54.00000000000003,
        "t": 690.6660195312501,
        "r": 480.96000000000004,
        "b": 682.4787304760582
      },
      "content": "Check the appliance is correctly installed as described in the conneX Installation and User manual."
    },
    {
      "type": "list_item",
      "id": "txt_0502",
      "reading_order": 644,
      "section": "Servicing procedure: overview",
      "bbox": {
        "l": 53.99999999999994,
        "t": 678.4260195312501,
        "r": 556.65,
        "b": 657.9813344167462
      },
      "content": "Visually check the cleanliness/condition of the power supply/cable, casing, cavity and door of the appliance for signs of wear, damage, distortion etc. If required, refer to the 'Replacing components\" section of this manual (section 6)."
    },
    {
      "type": "list_item",
      "id": "txt_0503",
      "reading_order": 645,
      "section": "Servicing procedure: overview",
      "bbox": {
        "l": 53.9819999999998,
        "t": 653.8290195312501,
        "r": 510.6716999999998,
        "b": 645.6417304760582
      },
      "content": "Complete an \"Earth/Insulation test\" (see section 5.6 of this manual) on the appliance before switching on."
    },
    {
      "type": "list_item",
      "id": "txt_0504",
      "reading_order": 646,
      "section": "Servicing procedure: overview",
      "bbox": {
        "l": 53.96399999999983,
        "t": 641.8320195312501,
        "r": 556.6202999999996,
        "b": 633.6447304760583
      },
      "content": "Check the display for error messages. If an error is shown, refer to the 'Fault Finding' within section 5.3 of this manual."
    },
    {
      "type": "list_item",
      "id": "txt_0505",
      "reading_order": 647,
      "section": "Servicing procedure: overview",
      "bbox": {
        "l": 53.945999999999685,
        "t": 629.4750195312502,
        "r": 558.4409999999997,
        "b": 609.1473344167463
      },
      "content": "If a firmware update is required, follow the instructions under 'Firmware updates' within section 4.5 of this manual before continuing with the service procedure."
    },
    {
