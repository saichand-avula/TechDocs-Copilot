    {
      "type": "heading",
      "id": "txt_1172",
      "reading_order": 1480,
      "section": "Fitting the UI assembly",
      "bbox": {
        "l": 36.0,
        "t": 525.40801953125,
        "r": 165.72,
        "b": 514.6244393785782
      },
      "content": "Fitting the UI assembly",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1173",
      "reading_order": 1481,
      "section": "Fitting the UI assembly",
      "bbox": {
        "l": 36.0,
        "t": 506.94601953125,
        "r": 306.78299999999996,
        "b": 498.8583344167462
      },
      "content": "Follow the steps in the reverse order to replace the UI assembly."
    },
    {
      "type": "list_item",
      "id": "txt_1174",
      "reading_order": 1482,
      "section": "Fitting the UI assembly",
      "bbox": {
        "l": 52.80299999999997,
        "t": 491.94301953125,
        "r": 429.90299999999996,
        "b": 470.7783344167462
      },
      "content": " Ensure the UI is square in the facia panel and refit the clamp using the location pin as a guide."
    },
    {
      "type": "list_item",
      "id": "txt_1175",
      "reading_order": 1483,
      "section": "Fitting the UI assembly",
      "bbox": {
        "l": 52.803000000000004,
        "t": 466.38301953125,
        "r": 424.02599999999995,
        "b": 445.2183344167462
      },
      "content": " Do not overtighten the eight posidrive screws clamping the UI to the glass panel (0.7 Nm)."
    },
    {
      "type": "list_item",
      "id": "txt_1176",
      "reading_order": 1484,
      "section": "Fitting the UI assembly",
      "bbox": {
        "l": 52.80299999999993,
        "t": 440.82301953125,
        "r": 427.9769999999999,
        "b": 419.77533441674615
      },
      "content": " Ensure the cables are not trapped when refitting the panel to the oven and reclip the loom to the underside of the IO board."
    },
    {
      "type": "heading",
      "id": "txt_1177",
      "reading_order": 1485,
      "section": "Replacing the UI assembly for new",
      "bbox": {
        "l": 36.0,
        "t": 395.80801953125,
        "r": 230.76,
        "b": 385.0244393785783
      },
      "content": "Replacing the UI assembly for new",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_1178",
      "reading_order": 1486,
      "section": "Replacing the UI assembly for new",
      "bbox": {
        "l": 54.0,
        "t": 377.22601953125,
        "r": 554.3370000000001,
        "b": 343.45233441674617
      },
      "content": "Ensure that the uSD card is removed from the old UI and fitted to the new assembly. Check that the dip switches are in the off (0) position. Accessed by prizing off the protective cap on the back of the UI assembly before fitting to the oven."
    },
    {
      "type": "list_item",
      "id": "txt_1179",
      "reading_order": 1487,
      "section": "Replacing the UI assembly for new",
      "bbox": {
        "l": 54.0,
        "t": 136.50601953125,
        "r": 292.26599999999996,
        "b": 128.41833441674623
      },
      "content": "Refit all oven panels, plug in the oven and switch on."
    },
