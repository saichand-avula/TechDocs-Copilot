        "r": 168.60000000000002,
        "b": 399.78443937857827
      },
      "content": "Removing the IO Board",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_1198",
      "reading_order": 1513,
      "section": "Removing the IO Board",
      "bbox": {
        "l": 54.0,
        "t": 391.86601953125,
        "r": 374.09399999999994,
        "b": 383.7783344167462
      },
      "content": "Disconnect all the cables connecting the IO board to other components."
    },
    {
      "type": "list_item",
      "id": "txt_1199",
      "reading_order": 1514,
      "section": "Removing the IO Board",
      "bbox": {
        "l": 53.99099999999993,
        "t": 379.14901953125,
        "r": 532.251,
        "b": 358.2183344167462
      },
      "content": "Loosen the two M7 hex nuts under the IO board on either side to remove the assembly from the frame of the cavity."
    },
    {
      "type": "list_item",
      "id": "txt_1200",
      "reading_order": 1515,
      "section": "Removing the IO Board",
      "bbox": {
        "l": 53.99099999999993,
        "t": 149.34301953124998,
        "r": 528.399,
        "b": 141.25533441674622
      },
      "content": "Remove the PM (Personality Module) from the IO Board and place safety aside to refit to the replacement IO."
    },
