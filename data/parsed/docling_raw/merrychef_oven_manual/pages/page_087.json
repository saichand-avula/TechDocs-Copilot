        "l": 36.0,
        "t": 521.94601953125,
        "r": 265.743,
        "b": 513.8583344167462
      },
      "content": "Check that the following requirements have been met:"
    },
    {
      "type": "list_item",
      "id": "txt_1192",
      "reading_order": 1507,
      "section": "Requirements",
      "bbox": {
        "l": 54.0,
        "t": 506.94601953125004,
        "r": 558.765,
        "b": 485.6553344167462
      },
      "content": " The appliance has been disconnected from the power supply and protective measures have been taken to ensure the power cannot be switched on again."
    },
    {
      "type": "list_item",
      "id": "txt_1193",
      "reading_order": 1508,
      "section": "Requirements",
      "bbox": {
        "l": 53.98200000000003,
        "t": 481.02601953125003,
        "r": 163.59300000000002,
        "b": 472.5783344167462
      },
      "content": " The appliance is cool."
    },
    {
      "type": "list_item",
      "id": "txt_1194",
      "reading_order": 1509,
      "section": "Requirements",
      "bbox": {
        "l": 53.97300000000001,
        "t": 468.54301953125,
        "r": 331.452,
        "b": 460.0953344167462
      },
      "content": " The side and top panels of the appliance have been removed."
    },
    {
      "type": "list_item",
      "id": "txt_1195",
      "reading_order": 1510,
      "section": "Requirements",
      "bbox": {
        "l": 53.95500000000004,
        "t": 455.70001953125,
        "r": 363.96000000000004,
        "b": 447.2523344167462
      },
      "content": " The high voltage capacitors are discharged before commencing work."
    },
    {
      "type": "list_item",
      "id": "txt_1196",
      "reading_order": 1511,
      "section": "Requirements",
      "bbox": {
        "l": 53.93700000000007,
        "t": 442.98301953125,
        "r": 241.81200000000007,
        "b": 434.5353344167462
      },
      "content": " Anti-static precautions have been taken."
    },
    {
      "type": "heading",
      "id": "txt_1197",
      "reading_order": 1512,
      "section": "Removing the IO Board",
      "bbox": {
        "l": 36.0,
