        "r": 265.743,
        "b": 726.4983344167462
      },
      "content": "Check that the following requirements have been met:"
    },
    {
      "type": "list_item",
      "id": "txt_1329",
      "reading_order": 1696,
      "section": "Requirements",
      "bbox": {
        "l": 54.00000000000003,
        "t": 719.5830195312499,
        "r": 548.811,
        "b": 698.2923344167461
      },
      "content": " The appliance has been disconnected from the power supply and protective measures have been taken to ensure the power cannot be switched on again."
    },
    {
      "type": "list_item",
      "id": "txt_1330",
      "reading_order": 1697,
      "section": "Requirements",
      "bbox": {
        "l": 53.99099999999993,
        "t": 693.6630195312499,
        "r": 163.60199999999992,
        "b": 685.2153344167461
      },
      "content": " The appliance is cool."
    },
    {
      "type": "list_item",
      "id": "txt_1331",
