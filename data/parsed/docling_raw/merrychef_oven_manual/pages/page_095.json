      "section": "Requirements",
      "bbox": {
        "l": 53.981999999999914,
        "t": 681.30601953125,
        "r": 239.19299999999993,
        "b": 672.8583344167462
      },
      "content": " The casing of the appliance is removed."
    },
    {
      "type": "list_item",
      "id": "txt_1332",
      "reading_order": 1699,
      "section": "Requirements",
      "bbox": {
        "l": 53.97299999999993,
        "t": 668.46301953125,
        "r": 364.10399999999987,
        "b": 660.0153344167462
      },
      "content": " The high voltage capacitors are discharged before commencing work."
    },
    {
      "type": "list_item",
      "id": "txt_1333",
      "reading_order": 1700,
      "section": "Requirements",
      "bbox": {
        "l": 53.963999999999885,
        "t": 655.50301953125,
        "r": 452.8889999999999,
        "b": 647.0553344167462
      },
      "content": " See section 6.13 for convection fan motor assembly removal to access the heating element"
    },
