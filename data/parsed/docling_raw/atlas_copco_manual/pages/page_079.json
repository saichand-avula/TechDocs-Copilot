    {
      "type": "paragraph",
      "id": "txt_0534",
      "reading_order": 828,
      "section": "Overflow warning",
      "bbox": {
        "l": 91.11,
        "t": 683.581,
        "r": 562.8219000000006,
        "b": 631.8039999999999
      },
      "content": "Once the filter has reached a lifetime below 10%, this warning will remain active until new filters are inserted correctly (sensor arm in tower 1 should rest on the filter edge!). When the new filters are installed correctly and the percentage is above 10% (normally between 90% and 100%), press enter to reset the status."
    },
