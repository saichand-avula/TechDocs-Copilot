  "blocks": [
    {
      "type": "figure",
      "id": "fig_0018",
      "reading_order": 96,
      "section": "Precautions during operation",
      "bbox": {
        "l": 519.446533203125,
        "t": 816.084903717041,
        "r": 567.0991821289062,
        "b": 792.9190788269043
      },
      "image_path": "figures/figure_0018.png",
      "previous_block_id": "txt_0075",
      "next_block_id": "txt_0076"
    },
    {
      "type": "list_item",
      "id": "txt_0076",
      "reading_order": 97,
      "section": "Precautions during operation",
      "bbox": {
        "l": 89.55,
        "t": 758.8810000000001,
        "r": 546.3436999999991,
        "b": 720.304
      },
      "content": "Never remove or tamper with the safety devices, guards or insulations fitted on the machine. Every pressure vessel or auxiliary installed outside the machine to contain air above atmospheric pressure shall be protected by a pressure-relieving device or devices as required."
    },
    {
      "type": "figure",
      "id": "fig_0019",
      "reading_order": 98,
      "section": "Precautions during operation",
      "bbox": {
        "l": 88.98111724853516,
        "t": 682.1582489013672,
        "r": 124.88037872314453,
        "b": 647.0466918945312
      },
      "image_path": "figures/figure_0019.png",
      "previous_block_id": "txt_0076",
      "next_block_id": "txt_0077"
    },
    {
      "type": "paragraph",
      "id": "txt_0077",
      "reading_order": 99,
      "section": "Precautions during operation",
      "bbox": {
        "l": 143.54990000000004,
        "t": 692.701,
        "r": 542.5540000000002,
        "b": 667.324
      },
      "content": "Also consult following safety precautions: Safety precautions during installation and Safety precautions during maintenance."
    },
    {
      "type": "paragraph",
      "id": "txt_0078",
      "reading_order": 100,
      "section": "Precautions during operation",
      "bbox": {
        "l": 143.55,
        "t": 666.301,
        "r": 556.7695,
        "b": 627.7239999999999
      },
      "content": "These precautions apply to machinery processing or consuming air or inert gas. Processing of any other gas requires additional safety precautions typical to the application which are not included herein."
    },
    {
      "type": "paragraph",
      "id": "txt_0079",
      "reading_order": 101,
      "section": "Precautions during operation",
      "bbox": {
        "l": 143.55010000000004,
        "t": 626.7009999999999,
        "r": 549.3620999999999,
        "b": 601.3239999999998
      },
      "content": "Some precautions are general and cover several machine types and equipment; hence some statements may not apply to your machine."
    },
    {
      "type": "heading",
      "id": "txt_0080",
      "reading_order": 102,
      "section": "1.4    Safety precautions during maintenance or repair",
      "bbox": {
        "l": 56.55,
        "t": 570.0600000000001,
        "r": 472.0683999999995,
        "b": 552.2040000000001
      },
      "content": "1.4    Safety precautions during maintenance or repair",
      "level": 2
    },
    {
      "type": "figure",
      "id": "fig_0020",
      "reading_order": 103,
      "section": "1.4    Safety precautions during maintenance or repair",
      "bbox": {
        "l": 91.41060638427734,
        "t": 524.9122009277344,
        "r": 128.47256469726562,
        "b": 490.3264465332031
      },
      "image_path": "figures/figure_0020.png",
      "previous_block_id": "txt_0080",
      "next_block_id": "txt_0081"
    },
    {
      "type": "paragraph",
      "id": "txt_0081",
      "reading_order": 104,
      "section": "1.4    Safety precautions during maintenance or repair",
      "bbox": {
        "l": 149.19,
        "t": 532.0210000000001,
        "r": 545.9798000000008,
        "b": 480.2440000000001
      },
      "content": "All responsibility for any damage or injury resulting from neglecting these   precautions, or non-observance of the normal caution and care required for   installation, operation, maintenance and repair, even if not expressly stated, will be disclaimed by the manufacturer."
    },
    {
      "type": "heading",
      "id": "txt_0082",
      "reading_order": 105,
      "section": "General precautions",
      "bbox": {
        "l": 56.55,
        "t": 464.375,
        "r": 166.05389999999994,
        "b": 452.099
      },
      "content": "General precautions",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_0083",
      "reading_order": 106,
      "section": "General precautions",
      "bbox": {
        "l": 91.53,
        "t": 444.6014,
        "r": 509.6388999999997,
        "b": 419.22440000000006
      },
      "content": "The operator must employ safe working practices and observe all related local work safety requirements and regulations."
    },
    {
      "type": "list_item",
      "id": "txt_0084",
      "reading_order": 107,
      "section": "General precautions",
      "bbox": {
        "l": 91.53,
        "t": 418.20140000000004,
        "r": 564.3221000000008,
        "b": 392.8244000000001
      },
      "content": "If any of the following statements does not comply with the applicable legislation, the stricter of the two shall apply."
    },
    {
      "type": "list_item",
      "id": "txt_0085",
      "reading_order": 108,
      "section": "General precautions",
      "bbox": {
        "l": 91.53,
        "t": 391.80140000000006,
        "r": 543.3088000000009,
        "b": 366.4244000000001
      },
      "content": "Installation, operation, maintenance and repair work must only be performed by authorised, trained, specialised personnel."
    },
    {
      "type": "list_item",
      "id": "txt_0086",
      "reading_order": 109,
      "section": "General precautions",
      "bbox": {
        "l": 91.53,
        "t": 365.4014000000001,
        "r": 544.0777000000012,
        "b": 340.0244000000001
      },
      "content": "The compressor is not considered capable of producing air of breathing quality. For air of breathing quality, the compressed air must be adequately purified according to local legislation and standards."
    },
    {
      "type": "list_item",
      "id": "txt_0087",
      "reading_order": 110,
      "section": "General precautions",
      "bbox": {
        "l": 91.53,
        "t": 339.0014000000001,
        "r": 565.7554000000011,
        "b": 300.4244000000001
      },
      "content": "Before any maintenance, repair work, adjustment or any other non-routine checks, stop the compressor, press the emergency stop button, switch off the voltage and depressurise the compressor. In addition, the power isolating switch must be opened and locked."
    },
    {
      "type": "list_item",
      "id": "txt_0088",
      "reading_order": 111,
      "section": "General precautions",
      "bbox": {
        "l": 91.53,
        "t": 299.4014000000002,
        "r": 546.3579999999988,
        "b": 260.8244000000002
      },
      "content": "Never play with compressed air. Do not apply the air to your skin or direct an air stream at people. Never use the air to clean dirt from your clothes. When using the air to clean equipment, do so with extreme caution and wear eye protection."
    },
    {
      "type": "heading",
      "id": "txt_0089",
      "reading_order": 112,
      "section": "Precautions during maintenance or repair",
      "bbox": {
        "l": 56.55,
        "t": 242.13540000000012,
        "r": 278.56960000000015,
        "b": 229.85940000000016
      },
      "content": "Precautions during maintenance or repair",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_0090",
      "reading_order": 113,
      "section": "Precautions during maintenance or repair",
      "bbox": {
        "l": 90.5697,
        "t": 222.4212000000001,
        "r": 235.04150000000016,
        "b": 210.2442000000001
      },
      "content": "Always wear safety glasses."
    },
    {
      "type": "list_item",
      "id": "txt_0091",
      "reading_order": 114,
      "section": "Precautions during maintenance or repair",
      "bbox": {
        "l": 90.5697,
        "t": 209.22120000000018,
        "r": 373.08489999999966,
        "b": 197.04420000000016
      },
      "content": "Use only the correct tools for maintenance and repair work."
    },
    {
      "type": "list_item",
      "id": "txt_0092",
      "reading_order": 115,
      "section": "Precautions during maintenance or repair",
      "bbox": {
        "l": 90.5697,
        "t": 196.02120000000014,
        "r": 238.76940000000008,
        "b": 183.84420000000023
      },
      "content": "Use only genuine spare parts."
    },
    {
      "type": "list_item",
      "id": "txt_0093",
      "reading_order": 116,
      "section": "Precautions during maintenance or repair",
      "bbox": {
        "l": 90.5697,
        "t": 182.8212000000002,
        "r": 478.8509999999998,
        "b": 170.64420000000018
      },
      "content": "All maintenance work shall only be undertaken when the machine has cooled down."
    },
    {
      "type": "list_item",
      "id": "txt_0094",
      "reading_order": 117,
      "section": "Precautions during maintenance or repair",
      "bbox": {
        "l": 90.5697,
        "t": 169.62120000000016,
        "r": 533.6067999999993,
        "b": 144.2442000000002
      },
      "content": "A warning sign bearing a legend such as 'work in progress; do not start' shall be attached to the starting equipment."
    },
    {
      "type": "list_item",
      "id": "txt_0095",
      "reading_order": 118,
      "section": "Precautions during maintenance or repair",
      "bbox": {
        "l": 90.5697,
        "t": 143.22120000000018,
        "r": 564.3462999999995,
        "b": 104.64420000000018
      },
      "content": "Persons switching on remotely controlled machines shall take adequate precautions to ensure that there is no one checking or working on the machine. To this end, a suitable notice shall be affixed to the remote start equipment."
    },
    {
      "type": "list_item",
      "id": "txt_0096",
      "reading_order": 119,
      "section": "Precautions during maintenance or repair",
      "bbox": {
        "l": 90.57,
        "t": 103.67200000000003,
        "r": 461.6245999999995,
        "b": 90.38800000000003
      },
      "content": "Close the compressor air outlet valve before connecting or disconnecting a pipe."
    }
  ]
}