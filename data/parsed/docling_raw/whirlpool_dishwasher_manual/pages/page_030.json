    {
      "type": "heading",
      "id": "txt_0436",
      "reading_order": 495,
      "section": "TESTING DISHWASHER COMPONENTS FROM THE CONTROL BOARD",
      "bbox": {
        "l": 302.2725,
        "t": 684.9494,
        "r": 547.9004999999999,
        "b": 663.8199210084034
      },
      "content": "TESTING DISHWASHER COMPONENTS FROM THE CONTROL BOARD",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0437",
      "reading_order": 496,
      "section": "TESTING DISHWASHER COMPONENTS FROM THE CONTROL BOARD",
      "bbox": {
        "l": 302.2725,
        "t": 658.6854000000001,
        "r": 550.5325,
        "b": 641.0775008403361
      },
      "content": "Before testing any of the components, perform the following checks:"
    },
    {
      "type": "list_item",
      "id": "txt_0438",
      "reading_order": 497,
      "section": "TESTING DISHWASHER COMPONENTS FROM THE CONTROL BOARD",
      "bbox": {
        "l": 316.2725,
        "t": 635.6854000000001,
        "r": 549.8525000000004,
        "b": 598.0775008403361
      },
      "content": "The most common cause for misdiagnosed control failure is poor connections. Therefore, disconnecting, inspecting and reconnecting wires will be necessary throughout test procedures."
    },
    {
      "type": "list_item",
      "id": "txt_0439",
      "reading_order": 498,
      "section": "TESTING DISHWASHER COMPONENTS FROM THE CONTROL BOARD",
      "bbox": {
        "l": 316.2725,
        "t": 592.6854000000001,
        "r": 548.3025000000001,
        "b": 565.0775008403361
      },
      "content": "All tests/checks should be made with a VOM or DVM having a sensitivity of 20,000 ohms-per-volt DC, or greater."
    },
    {
      "type": "list_item",
      "id": "txt_0440",
      "reading_order": 499,
      "section": "TESTING DISHWASHER COMPONENTS FROM THE CONTROL BOARD",
      "bbox": {
        "l": 316.2725,
        "t": 559.6854000000001,
        "r": 548.8024999999999,
        "b": 532.0775008403361
      },
      "content": "Check all connections before replacing components, looking for broken or loose wires, failed terminals, or wires not pressed into connectors far enough."
    },
    {
      "type": "list_item",
      "id": "txt_0441",
      "reading_order": 500,
      "section": "TESTING DISHWASHER COMPONENTS FROM THE CONTROL BOARD",
      "bbox": {
        "l": 316.2725,
        "t": 526.6854000000001,
        "r": 533.7825000000003,
        "b": 509.07750084033614
      },
      "content": "Voltage checks must be made with all connectors attached to the boards."
    },
    {
      "type": "list_item",
      "id": "txt_0442",
      "reading_order": 501,
      "section": "TESTING DISHWASHER COMPONENTS FROM THE CONTROL BOARD",
      "bbox": {
        "l": 316.2725,
        "t": 503.6854,
        "r": 549.6825000000001,
        "b": 476.07750084033614
      },
      "content": "Resistance checks must be made with power cord unplugged or power disconnected, and with wiring harness or connectors disconnected from the control."
    },
    {
      "type": "list_item",
      "id": "txt_0443",
      "reading_order": 502,
      "section": "TESTING DISHWASHER COMPONENTS FROM THE CONTROL BOARD",
      "bbox": {
        "l": 316.2725,
        "t": 470.6854,
        "r": 558.9425000000001,
        "b": 443.07750084033614
      },
      "content": "The testing procedures in this section may require the use of needle probes to measure voltage. Failure to use needle probes will damage the connectors."
    }
  ]
}