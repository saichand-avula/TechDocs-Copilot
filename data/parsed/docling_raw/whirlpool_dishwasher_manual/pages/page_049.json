      },
      "content": "Replace Inner Door Panel",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_0885",
      "reading_order": 997,
      "section": "Replace Inner Door Panel",
      "bbox": {
        "l": 60.0,
        "t": 472.32,
        "r": 236.54999999999998,
        "b": 464.7121008403361
      },
      "content": "Unplug dishwasher or disconnect power."
    },
    {
      "type": "list_item",
      "id": "txt_0886",
      "reading_order": 998,
      "section": "Replace Inner Door Panel",
      "bbox": {
        "l": 60.0,
        "t": 459.32,
        "r": 311.21,
        "b": 441.7121008403361
      },
      "content": "Perform the procedures on page 4-3, 'Remove the Control Panel' prior to performing the following steps."
    },
    {
      "type": "list_item",
      "id": "txt_0887",
      "reading_order": 999,
      "section": "Replace Inner Door Panel",
      "bbox": {
        "l": 60.0,
        "t": 436.32,
        "r": 295.98,
        "b": 408.7121008403361
      },
      "content": "Perform the procedures on page 4-5, 'Remove the Dispenser Assembly' prior to performing the following steps."
    },
    {
      "type": "list_item",
      "id": "txt_0888",
      "reading_order": 1000,
      "section": "Replace Inner Door Panel",
      "bbox": {
        "l": 60.0,
        "t": 403.32,
        "r": 283.04,
        "b": 385.7121008403361
      },
      "content": "Remove the two (2) screws from the hinge plate (as indicated in Figure 1)."
    },
    {
      "type": "list_item",
      "id": "txt_0889",
      "reading_order": 1001,
      "section": "Replace Inner Door Panel",
      "bbox": {
        "l": 327.0,
        "t": 706.4738000000001,
        "r": 566.1399999999999,
        "b": 689.8659008403362
      },
      "content": "Remove the two (2) screws from the base side panel on each side (indicated in Figure 2)."
    },
    {
      "type": "list_item",
      "id": "txt_0890",
      "reading_order": 1002,
      "section": "Replace Inner Door Panel",
      "bbox": {
        "l": 327.0,
        "t": 483.4738,
        "r": 554.8600000000001,
        "b": 475.8659008403361
      },
      "content": "Disconnect door spring and door cable (see Figure 3)."
    },
    {
      "type": "list_item",
      "id": "txt_0891",
      "reading_order": 1003,
      "section": "Replace Inner Door Panel",
      "bbox": {
        "l": 327.0,
        "t": 260.4738,
        "r": 570.0500000000004,
        "b": 243.86590084033605
      },
      "content": "Open the inner door approximately 10° and lift the door until the door hinge separates from the pin. See Figure 4."
    },
