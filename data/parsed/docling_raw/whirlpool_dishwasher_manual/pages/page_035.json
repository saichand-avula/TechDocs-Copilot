    {
      "type": "caption",
      "id": "txt_0587",
      "reading_order": 661,
      "section": "STRIP CIRCUIT - TURBIDITY SENSOR TURBIDITY SENSOR",
      "bbox": {
        "l": 253.3972,
        "t": 66.95450000000005,
        "r": 376.30119999999994,
        "b": 60.10739075630249
      },
      "content": "Figure 2 - Turbidity Sensor Circuit"
    },
    {
      "type": "paragraph",
      "id": "txt_0588",
      "reading_order": 662,
      "section": "STRIP CIRCUIT - TURBIDITY SENSOR TURBIDITY SENSOR",
      "bbox": {
        "l": 321.0,
        "t": 706.82,
        "r": 577.5700000000004,
        "b": 669.2121008403361
      },
      "content": "This test will check the wiring to the Turbidity Sensor, which measures the cloudiness or haziness of the water caused by the amount of suspended solids and particles in the water. The following items are part of the turbidity sensing circuit."
    },
    {
      "type": "list_item",
      "id": "txt_0589",
      "reading_order": 663,
      "section": "STRIP CIRCUIT - TURBIDITY SENSOR TURBIDITY SENSOR",
      "bbox": {
        "l": 321.0,
        "t": 665.04,
        "r": 416.8200000000001,
        "b": 655.7303225806452
      },
      "content": "  Harness/Connection"
    },
    {
      "type": "list_item",
      "id": "txt_0590",
      "reading_order": 664,
      "section": "STRIP CIRCUIT - TURBIDITY SENSOR TURBIDITY SENSOR",
      "bbox": {
        "l": 321.0,
        "t": 652.04,
        "r": 399.70000000000005,
        "b": 642.7303225806452
      },
      "content": "  Turbidity Sensor"
    },
    {
      "type": "list_item",
      "id": "txt_0591",
      "reading_order": 665,
      "section": "STRIP CIRCUIT - TURBIDITY SENSOR TURBIDITY SENSOR",
      "bbox": {
        "l": 321.0,
        "t": 639.04,
        "r": 390.37,
        "b": 629.7303225806452
      },
      "content": "  Control Board"
    },
    {
      "type": "heading",
      "id": "txt_0592",
      "reading_order": 666,
      "section": "Test Procedure",
      "bbox": {
        "l": 321.0,
        "t": 608.084,
        "r": 394.53600000000006,
        "b": 598.9545210084034
      },
      "content": "Test Procedure",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_0593",
      "reading_order": 667,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 580.82,
        "r": 569.4700000000003,
        "b": 553.2121008403361
      },
      "content": "Check the Turbidity Sensor and electrical connections by performing the 'Service Mode Test' on page 2-3. The following steps assume that this step was unsuccessful."
    },
    {
      "type": "list_item",
      "id": "txt_0594",
      "reading_order": 668,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 547.82,
        "r": 503.5500000000002,
        "b": 540.2121008403361
      },
      "content": "Unplug dishwasher or disconnect power."
    },
    {
      "type": "list_item",
      "id": "txt_0595",
      "reading_order": 669,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 534.82,
        "r": 557.4100000000001,
        "b": 517.2121008403361
      },
      "content": "Remove access panel. Remove control board cover to access control board."
    },
    {
      "type": "list_item",
      "id": "txt_0596",
      "reading_order": 670,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 511.82,
        "r": 573.3900000000001,
        "b": 484.2121008403361
      },
      "content": "Lay the dishwasher on its back. Use a small flat-blade screwdriver to unclip snaps around the drip-pan. Remove drip-pan/float switch to access under tub components."
    },
    {
      "type": "list_item",
      "id": "txt_0597",
      "reading_order": 671,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 478.82,
        "r": 568.0800000000003,
        "b": 451.2121008403361
      },
      "content": "Test for 5 VDC-With a voltmeter set to DC, connect the black lead to CN4-2 (GND) and the red lead to CN3-1 (+5V)."
    },
    {
      "type": "list_item",
      "id": "txt_0598",
      "reading_order": 672,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 445.82,
        "r": 500.73000000000013,
        "b": 438.2121008403361
      },
      "content": "Plug in dishwasher or reconnect power."
    },
    {
      "type": "list_item",
      "id": "txt_0599",
      "reading_order": 673,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 432.82,
        "r": 556.6200000000001,
        "b": 415.2121008403361
      },
      "content": "Measure for 5 VDC out of the control between CN4-2 (GND) and CN3-1 (+5V)."
    },
    {
      "type": "list_item",
      "id": "txt_0600",
      "reading_order": 674,
      "section": "Test Procedure",
      "bbox": {
        "l": 335.0,
        "t": 411.04,
        "r": 575.3400000000001,
        "b": 392.2121008403361
      },
      "content": "¾ ¾ If 5 VDC is measured the control is functioning, replace the Turbidity Sensor and retest."
    },
    {
      "type": "list_item",
      "id": "txt_0601",
      "reading_order": 675,
      "section": "Test Procedure",
      "bbox": {
        "l": 335.0,
        "t": 388.04,
        "r": 562.0800000000002,
        "b": 369.2121008403361
      },
      "content": "¾ ¾ If 5 VDC is measured, replace the control board and retest."
    },
    {
      "type": "list_item",
      "id": "txt_0602",
      "reading_order": 676,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 363.82,
        "r": 505.92000000000013,
        "b": 356.2121008403361
      },
      "content": "Unplug dishwasher or disconnect power."
    },
    {
      "type": "list_item",
      "id": "txt_0603",
      "reading_order": 677,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 350.82,
        "r": 473.07000000000033,
        "b": 343.2121008403361
      },
      "content": "Reassemble all parts and panels."
    },
    {
      "type": "list_item",
      "id": "txt_0604",
      "reading_order": 678,
      "section": "Test Procedure",
      "bbox": {
        "l": 322.0,
        "t": 337.82,
        "r": 568.6400000000002,
        "b": 320.2121008403361
      },
      "content": "Plug in dishwasher or reconnect power and run 'Service Mode Test' to verify repair."
    },
    {
      "type": "paragraph",
      "id": "txt_0605",
      "reading_order": 679,
      "section": "Test Procedure",
      "bbox": {
        "l": 540.0396,
        "t": 44.86829999999998,
        "r": 556.2451,
        "b": 32.765719354838666
      },
      "content": "n"
    }
  ]
}