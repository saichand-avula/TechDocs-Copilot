    {
      "type": "paragraph",
      "id": "txt_0932",
      "reading_order": 1059,
      "section": "Remove the Water Valve",
      "bbox": {
        "l": 54.375,
        "t": 472.49309999999997,
        "r": 296.925,
        "b": 454.8852008403361
      },
      "content": "The water valve is mounted on a bracket located on the left side of the front brace."
    },
    {
      "type": "list_item",
      "id": "txt_0933",
      "reading_order": 1060,
      "section": "Remove the Water Valve",
      "bbox": {
        "l": 60.375,
        "t": 436.49309999999997,
        "r": 236.92499999999998,
        "b": 428.8852008403361
      },
      "content": "Unplug dishwasher or disconnect power."
    },
    {
      "type": "list_item",
      "id": "txt_0934",
      "reading_order": 1061,
      "section": "Remove the Water Valve",
      "bbox": {
        "l": 60.375,
        "t": 423.49309999999997,
        "r": 306.145,
        "b": 405.8852008403361
      },
      "content": "Remove the two (2) screws on the kick board (toe panel). See Figure 1."
    },
    {
      "type": "list_item",
      "id": "txt_0935",
      "reading_order": 1062,
      "section": "Remove the Water Valve",
      "bbox": {
        "l": 60.375,
        "t": 400.49309999999997,
        "r": 310.01499999999993,
        "b": 382.8852008403361
      },
      "content": "Remove the two (2) screws on insulating panel (see Figure 1)."
    },
    {
      "type": "list_item",
      "id": "txt_0936",
      "reading_order": 1063,
      "section": "Remove the Water Valve",
      "bbox": {
        "l": 327.0,
        "t": 706.6469000000001,
        "r": 557.4300000000002,
        "b": 689.0390008403361
      },
      "content": "Remove the 2 screws that hold the water valve to the front brace (see Figure 2)."
    },
    {
      "type": "list_item",
      "id": "txt_0937",
      "reading_order": 1064,
      "section": "Remove the Water Valve",
      "bbox": {
        "l": 327.0,
        "t": 683.6469000000001,
        "r": 536.3800000000002,
        "b": 676.0390008403361
      },
      "content": "Remove the fixing flat just like the picture below."
    },
    {
      "type": "list_item",
      "id": "txt_0938",
      "reading_order": 1065,
      "section": "Remove the Water Valve",
      "bbox": {
        "l": 327.0,
        "t": 401.6469,
        "r": 553.7100000000002,
        "b": 394.03900084033614
      },
      "content": "Disconnect the wire from the solenoid (see Figure 3)."
    },
    {
      "type": "list_item",
      "id": "txt_0939",
      "reading_order": 1066,
      "section": "Remove the Water Valve",
      "bbox": {
        "l": 327.0,
        "t": 388.6469,
        "r": 561.97,
        "b": 371.03900084033614
      },
      "content": "Remove the clamp and the outlet hose from the water valve (see Figure 3)."
    },
