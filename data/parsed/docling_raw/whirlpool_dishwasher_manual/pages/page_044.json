      "section": "Removing the Tub Gasket and Trim",
      "bbox": {
        "l": 151.9468,
        "t": 731.505,
        "r": 441.65679999999975,
        "b": 716.7313010526316
      },
      "content": "Removing the Tub Gasket and Trim",
      "level": 2
    },
    {
      "type": "heading",
      "id": "txt_0829",
      "reading_order": 924,
      "section": "Remove the Tub Gasket and Trim",
      "bbox": {
        "l": 36.0,
        "t": 705.9389,
        "r": 254.44800000000006,
        "b": 693.7662613445378
      },
      "content": "Remove the Tub Gasket and Trim",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0830",
      "reading_order": 925,
      "section": "Remove the Tub Gasket and Trim",
      "bbox": {
        "l": 36.0,
        "t": 676.1469000000001,
        "r": 289.71719999999993,
        "b": 658.5390008403361
      },
      "content": "The dishwasher tub seal prevents water leakage. The seal is fitted in a seal channel that lines the rim of the dishwasher tub."
    },
    {
      "type": "heading",
      "id": "txt_0831",
      "reading_order": 926,
      "section": "To remove the tub seal or trim:",
      "bbox": {
        "l": 36.0,
        "t": 653.1469000000001,
        "r": 164.46000000000004,
        "b": 645.5390008403361
      },
      "content": "To remove the tub seal or trim:",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_0832",
      "reading_order": 927,
      "section": "To remove the tub seal or trim:",
      "bbox": {
        "l": 42.0,
        "t": 640.1469000000001,
        "r": 163.37000000000003,
        "b": 632.5390008403361
      },
      "content": "Open the dishwasher door."
    },
    {
      "type": "list_item",
      "id": "txt_0833",
      "reading_order": 928,
      "section": "To remove the tub seal or trim:",
      "bbox": {
        "l": 42.0,
        "t": 627.1469000000001,
        "r": 293.13480000000004,
        "b": 609.5390008403361
      },
      "content": "Remove the dishwasher tub seal by grasping one end of the seal to peel it away from the seal channel (see Figure 1)."
    },
    {
      "type": "list_item",
      "id": "txt_0834",
      "reading_order": 929,
      "section": "To remove the tub seal or trim:",
      "bbox": {
        "l": 309.0,
        "t": 706.6469000000001,
        "r": 548.8400000000001,
        "b": 689.0390008403361
      },
      "content": "Remove the 2 screws (as indicated in Figure 2) and then pull the trim straight off the lip of the tub."
    },
    {
      "type": "list_item",
      "id": "txt_0835",
      "reading_order": 930,
      "section": "To remove the tub seal or trim:",
      "bbox": {
        "l": 309.0,
        "t": 319.6469,
        "r": 558.5700000000004,
        "b": 259.03900084033614
      },
      "content": "Reverse the above procedures to reinstall. NOTE: When installing the tub seal, make sure it is seated properly in the seal channel. Run your finger over the seal to make sure it is smooth and even for a proper seal. A correctly installed gasket will have both ends of the gasket equally distant from the bottom of the tub."
    },
