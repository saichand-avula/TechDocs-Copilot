      "next_block_id": "txt_0610"
    },
    {
      "type": "caption",
      "id": "txt_0610",
      "reading_order": 686,
      "section": "Thermistor",
      "bbox": {
        "l": 103.0576,
        "t": 281.2649,
        "r": 223.9365999999999,
        "b": 274.41779075630257
      },
      "content": "Figure 1 - Location of Thermistor"
    },
    {
      "type": "paragraph",
      "id": "txt_0611",
      "reading_order": 687,
      "section": "Thermistor",
      "bbox": {
        "l": 36.0,
        "t": 262.89689999999996,
        "r": 277.50999999999993,
        "b": 245.28900084033614
      },
      "content": "During the hot wash cycle, the thermistor senses the water temperature and turns the heating element off."
    },
    {
      "type": "paragraph",
      "id": "txt_0612",
      "reading_order": 688,
      "section": "Thermistor",
      "bbox": {
        "l": 36.0,
        "t": 239.89689999999996,
        "r": 279.09,
        "b": 222.28900084033614
      },
      "content": "NOTE : If the thermistor is not operating, the hot wash cycle will set a default time for the heating element to cycle."
    },
    {
      "type": "paragraph",
      "id": "txt_0613",
      "reading_order": 689,
      "section": "Thermistor",
      "bbox": {
        "l": 4.703326,
        "t": 215.618516,
        "r": 63.69085599999998,
        "b": 204.6242578791705
      },
      "content": "HERMISTOR"
    },
