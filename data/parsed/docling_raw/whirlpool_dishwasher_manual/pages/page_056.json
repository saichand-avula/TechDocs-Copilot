      "reading_order": 1101,
      "section": "Remove the Drain Pump",
      "bbox": {
        "l": 42.375,
        "t": 436.32,
        "r": 286.35499999999996,
        "b": 418.7121008403361
      },
      "content": "Remove dishwasher from installation and lay dishwasher on its back."
    },
    {
      "type": "list_item",
      "id": "txt_0967",
