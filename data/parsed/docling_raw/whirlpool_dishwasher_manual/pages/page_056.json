      "section": "Remove the Drain Pump",
      "bbox": {
        "l": 42.375,
        "t": 413.32,
        "r": 289.8849999999999,
        "b": 395.7121008403361
      },
      "content": "Remove the one (1) screw that attaches base cover to the base. Remove base cover and set aside."
    },
    {
      "type": "list_item",
      "id": "txt_0968",
      "reading_order": 1103,
      "section": "Remove the Drain Pump",
      "bbox": {
        "l": 309.0,
        "t": 706.6469000000001,
        "r": 493.26000000000016,
        "b": 699.0390008403361
      },
      "content": "Disconnect wire harness from drain pump."
    },
    {
      "type": "list_item",
      "id": "txt_0969",
