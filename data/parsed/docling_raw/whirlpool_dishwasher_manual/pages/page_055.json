        "l": 60.375,
        "t": 472.49309999999997,
        "r": 236.92499999999998,
        "b": 464.8852008403361
      },
      "content": "Unplug dishwasher or disconnect power."
    },
    {
      "type": "list_item",
      "id": "txt_0951",
      "reading_order": 1083,
      "section": "Remove the Pressure Switch",
      "bbox": {
        "l": 60.375,
        "t": 459.49309999999997,
        "r": 294.79499999999996,
        "b": 441.8852008403361
      },
      "content": "Open the dishwasher door and take out cutlery basket and lower rack."
    },
    {
      "type": "list_item",
      "id": "txt_0952",
      "reading_order": 1084,
      "section": "Remove the Pressure Switch",
      "bbox": {
        "l": 60.375,
        "t": 436.49309999999997,
        "r": 304.35499999999996,
        "b": 418.8852008403361
      },
      "content": "Remove dishwasher from installation and lay dishwasher on its back."
    },
    {
      "type": "list_item",
      "id": "txt_0953",
      "reading_order": 1085,
      "section": "Remove the Pressure Switch",
      "bbox": {
        "l": 60.375,
        "t": 413.49309999999997,
        "r": 307.8849999999998,
        "b": 395.8852008403361
      },
      "content": "Remove the one (1) screw that attaches base cover to the base. Remove base cover and set aside."
    },
    {
      "type": "list_item",
      "id": "txt_0954",
      "reading_order": 1086,
      "section": "Remove the Pressure Switch",
      "bbox": {
        "l": 60.375,
        "t": 390.49309999999997,
        "r": 306.8549999999999,
        "b": 372.8852008403361
      },
      "content": "Release the snap clip that attaches the pressure switch to the base. Remove pressure switch from dishwasher."
    },
    {
      "type": "list_item",
      "id": "txt_0955",
      "reading_order": 1087,
      "section": "Remove the Pressure Switch",
      "bbox": {
        "l": 327.0,
        "t": 706.6469000000001,
        "r": 566.8400000000003,
        "b": 699.0390008403361
      },
      "content": "Disconnect harness from pressure switch (see Figure 2)."
    },
    {
      "type": "list_item",
      "id": "txt_0956",
      "reading_order": 1088,
      "section": "Remove the Pressure Switch",
      "bbox": {
        "l": 327.0,
        "t": 693.6469000000001,
        "r": 552.1300000000001,
        "b": 676.0390008403361
      },
      "content": "Remove the pressure switch hose from the pressure switch. See Figure 2."
    },
