    },
    {
      "type": "heading",
      "id": "txt_0786",
      "reading_order": 880,
      "section": "Test Procedure",
      "bbox": {
        "l": 321.0,
        "t": 706.584,
        "r": 394.53600000000006,
        "b": 697.4545210084034
      },
      "content": "Test Procedure",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_0787",
      "reading_order": 881,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 692.32,
        "r": 503.5500000000002,
        "b": 684.7121008403361
      },
      "content": "Unplug dishwasher or disconnect power."
    },
    {
      "type": "list_item",
      "id": "txt_0788",
      "reading_order": 882,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 679.32,
        "r": 557.4100000000001,
        "b": 661.7121008403361
      },
      "content": "Remove access panel. Remove control board cover to access control board."
    },
    {
      "type": "list_item",
      "id": "txt_0789",
      "reading_order": 883,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 656.32,
        "r": 573.3900000000001,
        "b": 628.7121008403361
      },
      "content": "Lay the dishwasher on its back. Use a small flat-blade screwdriver to unclip snaps around the drip-pan. Remove drip-pan/float switch to access under tub components."
    },
    {
      "type": "list_item",
      "id": "txt_0790",
      "reading_order": 884,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 623.32,
        "r": 575.6400000000001,
        "b": 595.7121008403361
      },
      "content": "Check hose connections between the pressure switch and sump. Ensure hose is routed correctly and not pinched or crimped."
    },
    {
      "type": "list_item",
      "id": "txt_0791",
      "reading_order": 885,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 590.32,
        "r": 574.87,
        "b": 572.7121008403361
      },
      "content": "Verify there is no debris in the hose. Check hose for leaks. Repair or replace as needed."
    },
    {
      "type": "list_item",
      "id": "txt_0792",
      "reading_order": 886,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 567.32,
        "r": 569.7492000000001,
        "b": 549.7121008403361
      },
      "content": "Check the following harnesses for continuity (refer to the following chart)."
    },
    {
      "type": "list_item",
      "id": "txt_0793",
      "reading_order": 887,
      "section": "Test Procedure",
      "bbox": {
        "l": 335.0,
        "t": 482.54,
        "r": 557.5200000000001,
        "b": 453.7121008403361
      },
      "content": "¾ ¾ If an open circuit is detected, check connections between control board, pressure switch, and drain pump. Repair or replace as necessary."
    },
    {
      "type": "list_item",
      "id": "txt_0794",
      "reading_order": 888,
      "section": "Test Procedure",
      "bbox": {
        "l": 335.0,
        "t": 449.54,
        "r": 520.5900000000003,
        "b": 440.2303225806452
      },
      "content": "¾ ¾ If all harness test good, proceed to step 7."
    },
    {
      "type": "list_item",
      "id": "txt_0795",
      "reading_order": 889,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 435.32,
        "r": 572.2800000000002,
        "b": 407.7121008403361
      },
      "content": "Check the pressure switch. Using an ohmmeter, measure the resistance across the pressure switch terminals (refer to the following chart)."
    },
    {
      "type": "list_item",
      "id": "txt_0796",
      "reading_order": 890,
      "section": "Test Procedure",
      "bbox": {
        "l": 335.0,
        "t": 297.04,
        "r": 565.9900000000004,
        "b": 287.7303225806452
      },
      "content": "¾ ¾ If all pressure switch checks pass, continue to step 8."
    },
    {
      "type": "list_item",
      "id": "txt_0797",
      "reading_order": 891,
      "section": "Test Procedure",
      "bbox": {
        "l": 335.0,
        "t": 284.04,
        "r": 548.3400000000003,
        "b": 265.2121008403361
      },
      "content": "¾ ¾ If the preceding checks did not pass, replace the Pressure Switch."
    },
    {
      "type": "list_item",
      "id": "txt_0798",
      "reading_order": 892,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 259.81999999999994,
        "r": 473.07000000000033,
        "b": 252.21210084033612
      },
      "content": "Reassemble all parts and panels."
    },
    {
      "type": "list_item",
      "id": "txt_0799",
      "reading_order": 893,
      "section": "Test Procedure",
      "bbox": {
        "l": 327.0,
        "t": 246.81999999999994,
        "r": 549.7100000000003,
        "b": 239.21210084033612
      },
      "content": "Plug in dishwasher or reconnect power and retest."
    },
    {
      "type": "heading",
      "id": "txt_0800",
      "reading_order": 894,
      "section": "Pressure Switch Continuity Check",
