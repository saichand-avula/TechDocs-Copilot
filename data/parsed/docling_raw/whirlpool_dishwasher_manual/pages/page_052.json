    {
      "type": "paragraph",
      "id": "txt_0921",
      "reading_order": 1044,
      "section": "Remove the Control Board",
      "bbox": {
        "l": 36.375,
        "t": 472.49309999999997,
        "r": 281.405,
        "b": 454.8852008403361
      },
      "content": "The Control Board can be removed from its enclosure at the bottom of the dishwasher."
    },
    {
      "type": "list_item",
      "id": "txt_0922",
      "reading_order": 1045,
      "section": "Remove the Control Board",
      "bbox": {
        "l": 42.375,
        "t": 438.49309999999997,
        "r": 218.92499999999998,
        "b": 430.8852008403361
      },
      "content": "Unplug dishwasher or disconnect power."
    },
    {
      "type": "list_item",
      "id": "txt_0923",
      "reading_order": 1046,
      "section": "Remove the Control Board",
      "bbox": {
        "l": 42.375,
        "t": 425.49309999999997,
        "r": 293.375,
        "b": 407.8852008403361
      },
      "content": "Remove two (2) screws securing the kick board (toe panel) to dishwasher frame (see Figure 1)."
    },
    {
      "type": "list_item",
      "id": "txt_0924",
      "reading_order": 1047,
      "section": "Remove the Control Board",
      "bbox": {
        "l": 309.0,
        "t": 706.6469000000001,
        "r": 539.89,
        "b": 689.0390008403361
      },
      "content": "Remove one (1) cover screw from the control board enclosure (see Figure 2). Remove cover and set aside."
    },
    {
      "type": "list_item",
      "id": "txt_0925",
      "reading_order": 1048,
      "section": "Remove the Control Board",
      "bbox": {
        "l": 309.0,
        "t": 436.6469,
        "r": 517.7200000000003,
        "b": 429.03900084033614
      },
      "content": "Disconnect all harnesses from the control board."
    },
    {
      "type": "list_item",
      "id": "txt_0926",
      "reading_order": 1049,
      "section": "Remove the Control Board",
      "bbox": {
        "l": 309.0,
        "t": 423.6469,
        "r": 558.1700000000002,
        "b": 406.03900084033614
      },
      "content": "Depress the two (2) clips indicated in Figure 3 and remove control board from enclosure."
    },
