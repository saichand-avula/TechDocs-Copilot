    {
      "type": "list_item",
      "id": "txt_0873",
      "reading_order": 980,
      "section": "Remove Dispenser Assembly",
      "bbox": {
        "l": 42.375,
        "t": 476.64,
        "r": 218.92499999999998,
        "b": 469.0321008403361
      },
      "content": "Unplug dishwasher or disconnect power."
    },
    {
      "type": "list_item",
      "id": "txt_0874",
      "reading_order": 981,
      "section": "Remove Dispenser Assembly",
      "bbox": {
        "l": 42.375,
        "t": 463.64,
        "r": 293.6349999999999,
        "b": 446.0321008403361
      },
      "content": "Perform the procedures on page 4-2, 'Remove Outer Door Panel' prior to performing the following steps."
    },
    {
      "type": "list_item",
      "id": "txt_0875",
      "reading_order": 982,
      "section": "Remove Dispenser Assembly",
      "bbox": {
        "l": 42.375,
        "t": 440.64,
        "r": 266.6449999999998,
        "b": 433.0321008403361
      },
      "content": "Disconnect both dispenser harnesses (see Figure 1)."
    },
    {
      "type": "list_item",
      "id": "txt_0876",
      "reading_order": 983,
      "section": "Remove Dispenser Assembly",
      "bbox": {
        "l": 42.375,
        "t": 216.64,
        "r": 293.0249999999999,
        "b": 189.03210084033617
      },
      "content": "To remove the dispenser assembly, use a flat-blade screwdriver to move out the ten (10) snap clips, then push in to disengage from bracket. See Figure 2."
    },
    {
      "type": "list_item",
      "id": "txt_0877",
      "reading_order": 984,
      "section": "Remove Dispenser Assembly",
      "bbox": {
        "l": 309.1875,
        "t": 697.3969000000001,
        "r": 549.3375000000002,
        "b": 679.7890008403361
      },
      "content": "To reinstall the dispenser, press in the ten (10) snap clips inward as shown in Figure 3."
    },
    {
      "type": "list_item",
      "id": "txt_0878",
      "reading_order": 985,
      "section": "Remove Dispenser Assembly",
      "bbox": {
        "l": 309.1875,
        "t": 445.3969,
        "r": 556.2575000000004,
        "b": 427.78900084033614
      },
      "content": "Press detergent dispenser inward into the bracket, ensuring all snap clips engage the assembly (see Figure 4)."
    },
