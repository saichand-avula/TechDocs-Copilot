    {
      "type": "paragraph",
      "id": "txt_0211",
      "reading_order": 249,
      "section": "3.3 Positioning and Installation",
      "bbox": {
        "l": 77.904,
        "t": 382.8576629101563,
        "r": 541.61376,
        "b": 326.586101363195
      },
      "content": "Component arrangement of UPS brings convenience for maintenance, diagnosis and repairing of UPS from front, so it reduces room requirement for side and back. After opening the front door of UPS, you can see the power terminal, auxiliary terminal block, and power operating switch. Selection of location for UPS should ensure:"
    },
    {
      "type": "list_item",
      "id": "txt_0212",
      "reading_order": 250,
      "section": "3.3 Positioning and Installation",
      "bbox": {
        "l": 93.384,
        "t": 320.91174291015625,
        "r": 211.30568,
        "b": 310.98610136319496
      },
      "content": " Convenient wiring"
    },
    {
      "type": "list_item",
      "id": "txt_0213",
      "reading_order": 251,
      "section": "3.3 Positioning and Installation",
      "bbox": {
        "l": 93.384,
        "t": 305.3117429101562,
        "r": 241.54568,
        "b": 295.38610136319494
      },
      "content": " Enough operating space"
    },
    {
      "type": "list_item",
      "id": "txt_0214",
      "reading_order": 252,
      "section": "3.3 Positioning and Installation",
      "bbox": {
        "l": 93.384,
        "t": 289.7117429101563,
        "r": 376.44568,
        "b": 279.78610136319503
      },
      "content": " Good ventilation to meet heat dissipation requirement"
    },
    {
      "type": "list_item",
      "id": "txt_0215",
      "reading_order": 253,
      "section": "3.3 Positioning and Installation",
      "bbox": {
        "l": 93.384,
        "t": 274.1117429101563,
        "r": 242.26568,
        "b": 264.186101363195
      },
      "content": " No corrosive gas around"
    },
    {
      "type": "list_item",
      "id": "txt_0216",
      "reading_order": 254,
      "section": "3.3 Positioning and Installation",
      "bbox": {
        "l": 93.384,
        "t": 258.5117429101563,
        "r": 241.42568,
        "b": 248.58610136319498
      },
      "content": " Away from combustibles"
    },
    {
      "type": "list_item",
      "id": "txt_0217",
      "reading_order": 255,
      "section": "3.3 Positioning and Installation",
      "bbox": {
        "l": 93.384,
        "t": 242.91174291015636,
        "r": 331.56568,
        "b": 232.98610136319496
      },
      "content": " No over-wet and high-temperature resource"
    },
    {
      "type": "list_item",
      "id": "txt_0218",
      "reading_order": 256,
      "section": "3.3 Positioning and Installation",
      "bbox": {
        "l": 93.384,
        "t": 227.31174291015623,
        "r": 277.92568,
        "b": 217.38610136319494
      },
      "content": " Not environment with much dust"
    },
    {
      "type": "list_item",
      "id": "txt_0219",
      "reading_order": 257,
      "section": "3.3 Positioning and Installation",
      "bbox": {
        "l": 93.384,
        "t": 211.68174291015634,
        "r": 269.50568,
        "b": 201.75610136319494
      },
      "content": " Meet fire fighting requirements"
    },
    {
      "type": "list_item",
      "id": "txt_0220",
      "reading_order": 258,
      "section": "3.3 Positioning and Installation",
      "bbox": {
        "l": 77.664,
        "t": 196.89102291015627,
        "r": 541.5601600000001,
        "b": 170.556101363195
      },
      "content": " Optimal  ambient  temperature  for  working:  +20 ℃ ~  +25 ℃ ,  temperature  range  for maximum efficiency of battery."
    },
    {
      "type": "heading",
      "id": "txt_0221",
      "reading_order": 259,
      "section": "3.3.1 Clearance",
      "bbox": {
        "l": 74.664,
        "t": 152.75598291015626,
        "r": 171.506,
        "b": 141.99284478860932
      },
      "content": "3.3.1 Clearance",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0222",
      "reading_order": 260,
      "section": "3.3.1 Clearance",
      "bbox": {
        "l": 77.904,
        "t": 122.78766291015631,
        "r": 541.6156399999999,
        "b": 97.720101363195
      },
      "content": "There is no air grid in side and back of this series of UPS. For 80 ~ 300 kVA UPS, it has no special space requirement to the side and the back. However, for 400 ~ 500 kVA UPS, at least 500 mm should be kept behind the cabinet for the convenience of connection of the UPSs. Besides meeting local stipulations, it should keep enough space in front of UPS so that human can walk freely after full open of front door of UPS. For convenience of daily maintenance, at least 500 mm should be kept behind 80 ~ 500 kVA UPS, at least 700 mm should be kept between top of UPS and ceiling to ensure unblocking of ventilation in above space of it."
    }
  ]
}