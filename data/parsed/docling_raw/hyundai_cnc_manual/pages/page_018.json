  "blocks": [
    {
      "type": "list_item",
      "id": "txt_0131",
      "reading_order": 149,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 92.16,
        "t": 764.6546599999999,
        "r": 527.1732900000003,
        "b": 721.8231569281769
      },
      "content": "There  are  potentially  dangerous  situations  inside  of  the  machine  such  as  rotating workpiece,  feeding  tool  post,  dispersing  coolant  and  hot  chip.  Always  close  the  door  of machine while operating."
    },
    {
      "type": "list_item",
      "id": "txt_0132",
      "reading_order": 150,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 92.16000000000004,
        "t": 543.6755840000002,
        "r": 520.7033759999998,
        "b": 534.8038649281771
      },
      "content": "Install the machine in a sufficiently bright, dry and arranged place free from any obstacles."
    },
    {
      "type": "list_item",
      "id": "txt_0133",
      "reading_order": 151,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 92.16000000000005,
        "t": 509.6556800000003,
        "r": 527.160264000001,
        "b": 483.80406892817706
      },
      "content": "Do not place device workpiece and other items either on the machine moving part or the machine frame."
    },
    {
      "type": "list_item",
      "id": "txt_0134",
      "reading_order": 152,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 92.16000000000004,
        "t": 458.6558840000003,
        "r": 390.586662,
        "b": 449.78416492817706
      },
      "content": "Do not reconstruct the machine without our prior permission."
    },
    {
      "type": "list_item",
      "id": "txt_0135",
      "reading_order": 153,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 92.160396,
        "t": 354.67476800000003,
        "r": 356.85272400000053,
        "b": 345.8030489281768
      },
      "content": "Check the machine regularly according to this manual."
    },
    {
      "type": "list_item",
      "id": "txt_0136",
      "reading_order": 154,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 92.160396,
        "t": 337.694876,
        "r": 354.0801900000006,
        "b": 328.8231569281768
      },
      "content": "Always close the door during the automatic operation."
    },
    {
      "type": "list_item",
      "id": "txt_0137",
      "reading_order": 155,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 92.160396,
        "t": 320.6548640000001,
        "r": 404.1220740000001,
        "b": 311.78314492817685
      },
      "content": "Immediately turn off the main power during a service interruption."
    },
