    },
    {
      "type": "list_item",
      "id": "txt_0177",
      "reading_order": 217,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 92.219514,
        "t": 667.4547680000001,
        "r": 455.8873979999999,
        "b": 658.5830489281769
      },
      "content": "Only the qualified personnel can perform maintenance on the electric device."
    },
    {
      "type": "list_item",
      "id": "txt_0178",
      "reading_order": 218,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 92.21951400000003,
        "t": 650.414756,
        "r": 527.1736860000012,
        "b": 624.5631449281769
      },
      "content": "When cleaning  the  machine,  always  stop  its  operation  turn  OFF  and  then  lock  the  main power."
    },
    {
      "type": "list_item",
      "id": "txt_0179",
      "reading_order": 219,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 92.21951400000005,
        "t": 463.4555840000002,
        "r": 426.8243880000008,
        "b": 454.583864928177
      },
      "content": "When repairing and cleaning the machine, do not use compressed air."
    },
    {
      "type": "list_item",
      "id": "txt_0180",
      "reading_order": 220,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 92.21951400000005,
        "t": 276.4362920000002,
        "r": 509.08257599999973,
        "b": 267.564572928177
      },
      "content": "When repairing at a high place, use a proper support or ladder and wear a safety helmet."
    },
    {
      "type": "list_item",
      "id": "txt_0181",
      "reading_order": 221,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 92.21951400000006,
        "t": 140.4167960000002,
        "r": 401.95474800000073,
        "b": 131.54507692817697
      },
      "content": "Never operate the machine with the cover removed for repairing."
    },
    {
      "type": "list_item",
      "id": "txt_0182",
      "reading_order": 222,
      "section": "4. Notice When Repairing and Checking",
      "bbox": {
        "l": 92.21951400000006,
        "t": 123.43690400000014,
        "r": 455.193012,
        "b": 114.56518492817702
      },
      "content": "While repairing or cleaning the machine, keep the floor free from water or oil."
    },
