    {
      "type": "paragraph",
      "id": "txt_0402",
      "reading_order": 525,
      "section": "6. Cleaning",
      "bbox": {
        "l": 94.5,
        "t": 405.67466,
        "r": 527.3239199999996,
        "b": 379.8230489281768
      },
      "content": "When cleaning, do not use compressed air. Otherwise, it may cause damage allowing foreign matters to enter into the crevice by air pressure."
    }
