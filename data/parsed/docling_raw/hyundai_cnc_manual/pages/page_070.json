    },
    {
      "type": "list_item",
      "id": "txt_0398",
      "reading_order": 519,
      "section": "6. Cleaning",
      "bbox": {
        "l": 99.299646,
        "t": 747.674768,
        "r": 527.3690759999997,
        "b": 721.8231569281769
      },
      "content": "When transporting  the  machine,  there  is  a  risk  of  mixing  with  sand  or  dust.  Therefore secure the saddle or cross slide before cleaning"
    },
    {
      "type": "list_item",
      "id": "txt_0399",
      "reading_order": 520,
      "section": "6. Cleaning",
      "bbox": {
        "l": 99.29964600000002,
        "t": 713.654864,
        "r": 504.38419799999855,
        "b": 704.7831449281769
      },
      "content": "Because each part of this machine has tightened at factory, loosen and then clean it."
    },
    {
      "type": "list_item",
      "id": "txt_0400",
      "reading_order": 521,
      "section": "6. Cleaning",
      "bbox": {
        "l": 99.29964600000002,
        "t": 696.674972,
        "r": 527.333004000001,
        "b": 670.823360928177
      },
      "content": "When cleaning the machine, wipe out the anticorrosive paint using soft cotten clothes wet with kerosene or benzene."
    },
    {
      "type": "list_item",
      "id": "txt_0401",
      "reading_order": 522,
      "section": "6. Cleaning",
      "bbox": {
        "l": 99.299646,
        "t": 475.6958960000003,
        "r": 370.87471200000005,
        "b": 466.82417692817705
      },
      "content": "Remove the moisture all over the machine completely."
    },
