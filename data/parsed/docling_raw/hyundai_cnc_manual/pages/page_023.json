  "blocks": [
    {
      "type": "list_item",
      "id": "txt_0164",
      "reading_order": 196,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 113.46,
        "t": 742.45466,
        "r": 386.40680400000065,
        "b": 733.5829409281769
      },
      "content": "Warm up the spindle and feed system prior to operating."
    },
    {
      "type": "list_item",
      "id": "txt_0165",
      "reading_order": 197,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 113.46,
        "t": 725.4146479999999,
        "r": 411.47484,
        "b": 716.5429289281768
      },
      "content": "When installing the tool, stop the feeding axis and the spindle."
    },
    {
      "type": "list_item",
      "id": "txt_0166",
      "reading_order": 198,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 113.46,
        "t": 708.434756,
        "r": 527.1747779999986,
        "b": 682.5831449281769
      },
      "content": "When installing the tool, pay special attention to the edge of tools. Install it not to be protruded over the specified length."
    },
    {
      "type": "list_item",
      "id": "txt_0167",
      "reading_order": 199,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 113.45999999999998,
        "t": 521.4154640000002,
        "r": 369.1714019999993,
        "b": 512.543744928177
      },
      "content": "After installing the tool, first perform a test operation."
    },
    {
      "type": "list_item",
      "id": "txt_0168",
      "reading_order": 200,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 113.45999999999998,
        "t": 504.4355720000002,
        "r": 527.2188659999998,
        "b": 478.58396092817696
      },
      "content": "When installing the workpiece on the standard chuck, make the outer circumference of jaw positioned in the external diameter of chuck."
    },
    {
      "type": "list_item",
      "id": "txt_0169",
      "reading_order": 201,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 106.38086999999996,
        "t": 470.4156680000002,
        "r": 483.2410859999993,
        "b": 461.543948928177
      },
      "content": "Visually check the switch on the Operating Panel and then operate it correctly."
    },
    {
      "type": "list_item",
      "id": "txt_0170",
      "reading_order": 202,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 106.38086999999996,
        "t": 300.4363880000002,
        "r": 334.83185999999995,
        "b": 291.56466892817696
      },
      "content": "Check the pressure gage indicates correctly."
    },
    {
      "type": "list_item",
      "id": "txt_0171",
      "reading_order": 203,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 106.38086999999996,
        "t": 130.45710800000018,
        "r": 458.23016399999887,
        "b": 121.58538892817694
      },
      "content": "For the machine with special accessory, follow the specified instructions."
    },
