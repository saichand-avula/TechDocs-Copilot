        "r": 271.87811400000004,
        "b": 426.98416492817705
      },
      "content": "The control program is not running."
    },
    {
      "type": "list_item",
      "id": "txt_1385",
      "reading_order": 1883,
      "section": "1-1. Alarm A0. A1",
      "bbox": {
        "l": 92.219514,
        "t": 401.8961000000003,
        "r": 240.2239320000001,
        "b": 393.02438092817704
      },
      "content": "Cause and corrective action"
    },
    {
      "type": "list_item",
      "id": "txt_1386",
      "reading_order": 1884,
      "section": "1-1. Alarm A0. A1",
      "bbox": {
        "l": 113.45991000000001,
        "t": 384.8560880000003,
        "r": 344.75157,
        "b": 375.98436892817705
      },
      "content": "ROM installed improperly or yet to be installed."
    },
    {
      "type": "paragraph",
      "id": "txt_1387",
      "reading_order": 1885,
      "section": "1-1. Alarm A0. A1",
      "bbox": {
        "l": 134.700306,
        "t": 367.8761960000003,
        "r": 527.3560499999999,
        "b": 342.02458492817703
      },
      "content": "Make sure that the ROM is attached properly to the socket and there is no imperfect contact due to a broken or bent pin."
    },
    {
      "type": "list_item",
      "id": "txt_1388",
      "reading_order": 1886,
      "section": "1-1. Alarm A0. A1",
      "bbox": {
        "l": 134.7,
        "t": 338.7203,
        "r": 269.41930800000006,
        "b": 324.0323000000001
      },
      "content": "⇒ Install the ROM properly."
    },
    {
      "type": "list_item",
      "id": "txt_1389",
      "reading_order": 1887,
      "section": "1-1. Alarm A0. A1",
      "bbox": {
        "l": 113.460012,
        "t": 299.89487600000007,
        "r": 242.048676,
        "b": 291.02315692817683
      },
      "content": "Incorrect ROM installed"
    },
    {
      "type": "paragraph",
      "id": "txt_1390",
      "reading_order": 1888,
      "section": "1-1. Alarm A0. A1",
      "bbox": {
        "l": 134.700408,
        "t": 282.854864,
        "r": 527.3751899999999,
        "b": 257.00325292817683
      },
      "content": "The series number of the software is printed on the ROM package and is displayed at power-on."
    },
    {
      "type": "list_item",
      "id": "txt_1391",
      "reading_order": 1889,
      "section": "1-1. Alarm A0. A1",
      "bbox": {
        "l": 134.7,
        "t": 253.76030000000003,
        "r": 302.760858,
        "b": 239.07230000000004
      },
      "content": "⇒ Replace it with the correct ROM."
    },
    {
      "type": "list_item",
      "id": "txt_1392",
      "reading_order": 1890,
      "section": "1-1. Alarm A0. A1",
      "bbox": {
        "l": 113.460012,
        "t": 214.87475599999993,
        "r": 269.772012,
        "b": 206.0030369281768
      },
      "content": "Printed-circuit board defective"
    },
    {
      "type": "list_item",
      "id": "txt_1393",
      "reading_order": 1891,
      "section": "1-1. Alarm A0. A1",
      "bbox": {
        "l": 134.7,
        "t": 202.76030000000003,
        "r": 358.85081400000007,
        "b": 188.07230000000004
      },
      "content": "⇒ Replace it with a normal printed circuit board."
    },
