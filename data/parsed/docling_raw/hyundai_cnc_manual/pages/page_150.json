      },
      "content": "Exchanging solenoid coil"
    },
    {
      "type": "list_item",
      "id": "txt_1047",
      "reading_order": 1353,
      "section": "CAUTION",
      "bbox": {
        "l": 127.620396,
        "t": 738.6746479999999,
        "r": 386.7095400000007,
        "b": 729.8029289281768
      },
      "content": "Loosen and disassemble resin nut from solenoid coil."
    },
    {
      "type": "list_item",
      "id": "txt_1048",
      "reading_order": 1354,
      "section": "CAUTION",
      "bbox": {
        "l": 127.620396,
        "t": 721.694756,
        "r": 313.46734799999996,
        "b": 712.8230369281769
      },
      "content": "Disassemble the washer and O-ring."
    },
    {
      "type": "list_item",
      "id": "txt_1049",
      "reading_order": 1355,
      "section": "CAUTION",
      "bbox": {
        "l": 127.620396,
        "t": 704.714864,
        "r": 541.4894820000004,
        "b": 678.8031329281769
      },
      "content": "Pull out the coil in the axis direction and disassemble it from the body. Reassemble it in the reverse order."
    },
    {
      "type": "figure",
      "id": "fig_0265",
      "reading_order": 1356,
      "section": "CAUTION",
      "bbox": {
        "l": 222.2924041748047,
