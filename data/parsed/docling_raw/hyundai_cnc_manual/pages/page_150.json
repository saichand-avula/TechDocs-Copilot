        "t": 644.9426599999999,
        "r": 345.606162,
        "b": 630.7585342983425
      },
      "content": "CAUTION",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1051",
      "reading_order": 1358,
      "section": "CAUTION",
      "bbox": {
        "l": 189.959898,
        "t": 589.6946479999999,
        "r": 422.220491999999,
        "b": 580.8229289281768
      },
      "content": "Torque the resin nut to 40-50 kgf · cm (4 ~ 5 N · m)."
    },
    {
      "type": "list_item",
      "id": "txt_1052",
      "reading_order": 1359,
      "section": "CAUTION",
      "bbox": {
        "l": 106.379778,
        "t": 521.174756,
        "r": 337.68246000000045,
        "b": 512.3030369281769
      },
      "content": "Disassembling and cleaning the solenoid valve"
    },
    {
      "type": "paragraph",
      "id": "txt_1053",
      "reading_order": 1360,
      "section": "CAUTION",
      "bbox": {
        "l": 127.620174,
        "t": 504.19486400000005,
        "r": 541.4872559999998,
        "b": 495.3231449281768
      },
      "content": "If the solenoid valve clogged with foreign matters, disassemble and clean the body as follows:"
    },
    {
      "type": "list_item",
      "id": "txt_1054",
      "reading_order": 1361,
      "section": "CAUTION",
      "bbox": {
        "l": 127.620174,
        "t": 487.21497200000005,
        "r": 235.63577400000008,
        "b": 478.3432529281768
      },
      "content": "Turn off the power."
    },
    {
      "type": "list_item",
      "id": "txt_1055",
      "reading_order": 1362,
      "section": "CAUTION",
      "bbox": {
        "l": 127.620174,
        "t": 470.17496000000006,
        "r": 238.443378,
        "b": 461.3032409281768
      },
      "content": "Disconnect the coil."
    },
    {
      "type": "list_item",
      "id": "txt_1056",
      "reading_order": 1363,
      "section": "CAUTION",
      "bbox": {
        "l": 127.620174,
        "t": 453.19506800000005,
        "r": 332.2185540000001,
        "b": 444.3233489281768
      },
      "content": "Remove four bolts from the terminal box."
    },
    {
      "type": "list_item",
      "id": "txt_1057",
      "reading_order": 1364,
      "section": "CAUTION",
      "bbox": {
        "l": 127.620174,
        "t": 436.21517600000004,
        "r": 269.537442,
        "b": 427.3434569281768
      },
      "content": "Disconnect the base plate."
    },
    {
      "type": "list_item",
      "id": "txt_1058",
      "reading_order": 1365,
      "section": "CAUTION",
      "bbox": {
        "l": 127.620174,
        "t": 419.17516400000005,
        "r": 299.05836600000026,
        "b": 410.3034449281768
      },
      "content": "Loosen and disconnect cartridge."
    },
    {
      "type": "list_item",
      "id": "txt_1059",
      "reading_order": 1366,
      "section": "CAUTION",
      "bbox": {
        "l": 127.620174,
        "t": 402.19527200000005,
        "r": 328.3508339999995,
        "b": 393.3235529281768
      },
      "content": "Disconnect internal parts from the body."
    },
    {
      "type": "list_item",
      "id": "txt_1060",
      "reading_order": 1367,
      "section": "CAUTION",
      "bbox": {
        "l": 127.620174,
        "t": 385.21538000000004,
        "r": 373.3957439999994,
        "b": 376.3436609281768
      },
      "content": "Pull out the spool from body without forced power."
    },
    {
      "type": "list_item",
      "id": "txt_1061",
      "reading_order": 1368,
      "section": "CAUTION",
      "bbox": {
        "l": 127.620174,
        "t": 368.17536800000005,
        "r": 273.95025,
        "b": 359.3036489281768
      },
      "content": "Clean body and each parts."
    },
    {
      "type": "list_item",
      "id": "txt_1062",
      "reading_order": 1369,
      "section": "CAUTION",
      "bbox": {
        "l": 127.620174,
        "t": 351.19547600000004,
        "r": 421.2202019999999,
        "b": 342.3237569281768
      },
      "content": "Check each parts such as O-ring and then reassemble them."
    },
    {
      "type": "figure",
      "id": "fig_0266",
      "reading_order": 1370,
      "section": "CAUTION",
      "bbox": {
        "l": 222.3138885498047,
        "t": 316.7252197265625,
        "r": 254.35452270507812,
        "b": 285.9976806640625
      },
      "image_path": "figures/figure_0266.png",
      "previous_block_id": "txt_1062",
      "next_block_id": "txt_1063"
    },
    {
      "type": "heading",
      "id": "txt_1063",
      "reading_order": 1371,
      "section": "CAUTION",
      "bbox": {
        "l": 268.26,
        "t": 308.40265999999997,
        "r": 345.606162,
        "b": 294.21853429834255
      },
      "content": "CAUTION",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_1064",
      "reading_order": 1372,
      "section": "CAUTION",
      "bbox": {
        "l": 92.22,
        "t": 270.1947600000001,
        "r": 487.4448719999999,
        "b": 261.32304092817685
      },
      "content": "When assembling the spool in the body of solenoid valve, never push it with a force."
    },
    {
      "type": "list_item",
      "id": "txt_1065",
      "reading_order": 1373,
      "section": "CAUTION",
      "bbox": {
        "l": 92.22,
        "t": 253.21486800000002,
        "r": 345.0947400000002,
        "b": 244.3431489281768
      },
      "content": "Make sure there are no foreign matters in the valve."
    },
    {
      "type": "list_item",
      "id": "txt_1066",
      "reading_order": 1374,
      "section": "CAUTION",
      "bbox": {
        "l": 92.22,
        "t": 236.23497599999996,
        "r": 368.5275119999999,
        "b": 227.36325692817672
      },
      "content": "Torque the cartridge to 390-420 kgf · cm (39 ~ 42 N · m)."
    },
    {
      "type": "list_item",
      "id": "txt_1067",
      "reading_order": 1375,
      "section": "CAUTION",
      "bbox": {
        "l": 127.62017399999999,
        "t": 201.67464799999993,
        "r": 248.45536200000012,
        "b": 192.8029289281768
      },
      "content": "Attach the base plate."
    },
    {
      "type": "figure",
      "id": "fig_0267",
      "reading_order": 1376,
      "section": "CAUTION",
      "bbox": {
        "l": 222.28900146484375,
        "t": 167.292236328125,
        "r": 340.8697204589844,
        "b": 136.65985107421875
      },
