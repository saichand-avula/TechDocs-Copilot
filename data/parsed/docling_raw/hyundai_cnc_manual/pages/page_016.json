    {
      "type": "list_item",
      "id": "txt_0121",
      "reading_order": 132,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 106.379778,
        "t": 696.674768,
        "r": 527.2688760000001,
        "b": 670.8231569281769
      },
      "content": "Do not touch any device in the Electric Control Panel and Operating Panel and in which the mark           is located."
    },
    {
      "type": "list_item",
      "id": "txt_0122",
      "reading_order": 133,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 106.38077999999996,
        "t": 662.654864,
        "r": 527.2588560000007,
        "b": 636.8032529281769
      },
      "content": "Prior to operating the machine, always close the door and check if safety shield located. If the door opened, immediately turn off the main power."
    },
    {
      "type": "list_item",
      "id": "txt_0123",
      "reading_order": 134,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 106.379778,
        "t": 388.694768,
        "r": 314.70559799999995,
        "b": 345.8031449281768
      },
      "content": "Remember where the Emer-gency stop switch  is  to  operate  it  anywhere  at  all times."
    },
    {
      "type": "list_item",
      "id": "txt_0124",
      "reading_order": 135,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 106.37977799999999,
        "t": 337.694972,
        "r": 314.75068800000025,
        "b": 294.8033489281768
      },
      "content": "Before operating the machine, check if the switches are functioned correctly to avoid malfunction."
    },
    {
      "type": "list_item",
      "id": "txt_0125",
      "reading_order": 136,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 106.37977799999999,
        "t": 286.69517599999995,
        "r": 314.6815500000002,
        "b": 260.7834449281768
      },
      "content": "Never touch any rotating part or tool by hands while operating."
    },
    {
      "type": "list_item",
      "id": "txt_0126",
      "reading_order": 137,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 106.37977799999999,
        "t": 252.67527199999995,
        "r": 314.68355399999945,
        "b": 226.82366092817676
      },
      "content": "Remove oil and water left on the floor to prevent workers from slipping."
    },
    {
      "type": "list_item",
      "id": "txt_0127",
      "reading_order": 138,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 106.37977799999999,
        "t": 218.65536799999995,
        "r": 321.76168200000023,
        "b": 192.80375692817677
      },
      "content": "Do not enter the inside of machine except for repairing work."
    },
