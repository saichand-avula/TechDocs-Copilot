      },
      "content": "If using soluble coolant"
    },
    {
      "type": "list_item",
      "id": "txt_0701",
      "reading_order": 920,
      "section": "2-3-5. Filling and Changing Oil",
      "bbox": {
        "l": 92.21973599999998,
        "t": 651.314768,
        "r": 519.787164,
        "b": 642.4430489281768
      },
      "content": "Choose it in consideration of its characteristics such as rustproof, security, cooling, and etc."
    },
    {
      "type": "list_item",
      "id": "txt_0702",
      "reading_order": 921,
      "section": "2-3-5. Filling and Changing Oil",
      "bbox": {
        "l": 92.21973599999995,
        "t": 634.2747559999999,
        "r": 384.057246,
        "b": 625.4030369281768
      },
      "content": "It should not include the contents dangerous to human body."
    },
    {
      "type": "list_item",
      "id": "txt_0703",
      "reading_order": 922,
      "section": "2-3-5. Filling and Changing Oil",
      "bbox": {
        "l": 92.21973599999995,
        "t": 617.294864,
        "r": 326.9873339999999,
        "b": 608.4231449281768
      },
      "content": "It should not be deteriorated during the storage."
    },
    {
      "type": "list_item",
      "id": "txt_0704",
      "reading_order": 923,
      "section": "2-3-5. Filling and Changing Oil",
      "bbox": {
        "l": 92.21973599999995,
        "t": 600.314972,
        "r": 390.16543799999994,
        "b": 591.4432529281769
      },
      "content": "It should not include corrosive or risk elements to the painting."
    },
    {
      "type": "list_item",
      "id": "txt_0705",
      "reading_order": 924,
      "section": "2-3-5. Filling and Changing Oil",
      "bbox": {
        "l": 92.21973599999995,
        "t": 583.27496,
        "r": 462.3405,
        "b": 574.4032409281768
      },
      "content": "It should not include elements melting to rubber products used in the machine."
    },
    {
      "type": "list_item",
      "id": "txt_0706",
      "reading_order": 925,
      "section": "2-3-5. Filling and Changing Oil",
      "bbox": {
        "l": 92.21973599999995,
        "t": 566.295068,
        "r": 438.029975999999,
        "b": 557.4233489281769
      },
      "content": "It should not include the contents which may degrade machine accuracy."
    },
    {
      "type": "list_item",
      "id": "txt_0707",
      "reading_order": 926,
      "section": "2-3-5. Filling and Changing Oil",
      "bbox": {
        "l": 92.21973599999995,
        "t": 549.3151760000001,
        "r": 536.0907059999996,
        "b": 523.4034449281769
      },
      "content": "Add a little rustproof oil when mixing coolant with soluble coolant. Otherwise, it may be rusted as coolant dried."
    },
    {
      "type": "list_item",
      "id": "txt_0708",
      "reading_order": 927,
      "section": "2-3-5. Filling and Changing Oil",
      "bbox": {
        "l": 92.21973599999995,
        "t": 515.2952720000001,
        "r": 536.1257759999988,
        "b": 489.4436609281768
      },
      "content": "When completing work, wipe out the part contacted with coolant. Apply it with rustproof oil after cleaning."
    },
    {
      "type": "list_item",
      "id": "txt_0709",
      "reading_order": 928,
      "section": "2-3-5. Filling and Changing Oil",
      "bbox": {
        "l": 92.21873399999996,
        "t": 481.27536800000007,
        "r": 536.1357959999997,
        "b": 455.42375692817683
      },
      "content": "Take care not to touch coolant with skin. Be sure you should be informed of its user's .instruction for your health."
    },
    {
      "type": "list_item",
      "id": "txt_0710",
      "reading_order": 929,
      "section": "2-3-5. Filling and Changing Oil",
      "bbox": {
        "l": 92.21873399999993,
        "t": 445.3356320000001,
        "r": 536.1157559999998,
        "b": 419.42390092817686
      },
      "content": "The mixing method of soluble coolant with water depends on the kinds of coolant and follow the instructions of the manufacturer."
    },
