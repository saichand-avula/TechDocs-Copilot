      "section": "2-5-2. Filling and Changing Oil",
      "bbox": {
        "l": 83.4,
        "t": 632.2946599999999,
        "r": 535.803,
        "b": 606.4430489281768
      },
      "content": "When filling lubricating oil, wipe out dropped oil on the floor with damp clothes or papers. Otherwise, it may cause personal injury."
    },
    {
      "type": "list_item",
      "id": "txt_0762",
      "reading_order": 998,
      "section": "2-5-2. Filling and Changing Oil",
      "bbox": {
        "l": 106.379778,
        "t": 578.774768,
        "r": 408.28638599999994,
        "b": 569.9030489281769
      },
      "content": "Whenever filling lubricating oil, always clean the waste oil tank."
    },
