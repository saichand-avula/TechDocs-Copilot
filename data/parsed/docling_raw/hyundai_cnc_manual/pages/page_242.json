      "section": "1-20. Alarm AL-32",
      "bbox": {
        "l": 141.839406,
        "t": 282.85496,
        "r": 527.3178239999995,
        "b": 257.0033489281768
      },
      "content": "The  memory in  the  serial  communication  LSI  chip  is  abnormal.  It  is  checked  when power is turned on."
    },
    {
      "type": "list_item",
      "id": "txt_1616",
      "reading_order": 2121,
      "section": "1-20. Alarm AL-32",
      "bbox": {
        "l": 99.299496,
        "t": 248.895176,
        "r": 363.0248939999994,
        "b": 240.02345692817676
      },
      "content": "Cause and corrective action a) LSI chip defective"
    },
    {
      "type": "list_item",
      "id": "txt_1617",
      "reading_order": 2122,
      "section": "1-20. Alarm AL-32",
      "bbox": {
        "l": 141.84,
        "t": 236.72029999999995,
        "r": 329.05008000000043,
        "b": 222.03230000000008
      },
      "content": "⇒ Replace the printed-circuit board."
    },
