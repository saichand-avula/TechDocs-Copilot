    {
      "type": "list_item",
      "id": "txt_0138",
      "reading_order": 159,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 99.299604,
        "t": 725.4146479999999,
        "r": 527.1185339999997,
        "b": 699.5630369281769
      },
      "content": "Do not change the position of nameplate attached to the machine. If damaged, purchase it with the item No. of Part List or one in the lower right of nameplate."
    },
    {
      "type": "list_item",
      "id": "txt_0139",
      "reading_order": 160,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 99.29960399999999,
        "t": 487.4556800000002,
        "r": 332.8678079999999,
        "b": 478.58396092817696
      },
      "content": "Always wear protective glasses during working."
    },
    {
      "type": "list_item",
      "id": "txt_0140",
      "reading_order": 161,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 99.29960399999999,
        "t": 470.4156680000002,
        "r": 241.09462800000009,
        "b": 461.543948928177
      },
      "content": "Always wear safety shoes."
    },
    {
      "type": "list_item",
      "id": "txt_0141",
      "reading_order": 162,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 99.29960399999999,
        "t": 453.4357760000002,
        "r": 386.7263099999994,
        "b": 444.56405692817697
      },
      "content": "Wear the safety cap and do not wear your uniforms loosely."
    },
    {
      "type": "list_item",
      "id": "txt_0142",
      "reading_order": 163,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 99.29960399999999,
        "t": 436.4558840000002,
        "r": 341.64933600000006,
        "b": 427.58416492817696
      },
      "content": "Never operate the machine while wearing gloves."
    },
    {
      "type": "list_item",
      "id": "txt_0143",
      "reading_order": 164,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 99.29960399999999,
        "t": 215.41668800000014,
        "r": 487.36718999999994,
        "b": 206.544968928177
      },
      "content": "Keep the workbench near the machine enough to be strong and not to be slippery."
    },
    {
      "type": "list_item",
      "id": "txt_0144",
      "reading_order": 165,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 92.15935199999998,
        "t": 198.4367960000002,
        "r": 404.48175000000094,
        "b": 189.56507692817695
      },
      "content": "Do not operate the machine while drinking of taking a medicine."
    },
    {
      "type": "list_item",
      "id": "txt_0145",
      "reading_order": 166,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 92.15935199999998,
        "t": 181.45690400000012,
        "r": 379.95579600000076,
        "b": 172.5851849281769
      },
      "content": "Do not operate the machine when feeling a sick or sleepy."
    },
    {
      "type": "list_item",
      "id": "txt_0146",
      "reading_order": 167,
      "section": "2. General Safety Precautions",
      "bbox": {
        "l": 92.15935199999998,
        "t": 164.4168920000002,
        "r": 527.1926820000009,
        "b": 138.5652809281769
      },
      "content": "The  max.  noise  of  this  machine  is  approximately  76  db.  It  is  recommended  to  wear earplugs."
    },
