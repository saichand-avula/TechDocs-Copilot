  "blocks": [
    {
      "type": "list_item",
      "id": "txt_0324",
      "reading_order": 427,
      "section": "3-1. Crane",
      "bbox": {
        "l": 99.299646,
        "t": 752.0545099999999,
        "r": 345.6072780000005,
        "b": 743.1827909281768
      },
      "content": "The crane-working method is shown in Figure 4-2."
    },
    {
      "type": "list_item",
      "id": "txt_0325",
      "reading_order": 428,
      "section": "3-1. Crane",
      "bbox": {
        "l": 99.299646,
        "t": 734.8341379999999,
        "r": 348.43392000000057,
        "b": 725.9624189281768
      },
      "content": "When transporting by crane, ensure the followings."
    },
    {
      "type": "list_item",
      "id": "txt_0326",
      "reading_order": 429,
      "section": "3-1. Crane",
      "bbox": {
        "l": 120.540042,
        "t": 717.553646,
        "r": 527.3510400000006,
        "b": 691.4615549281768
      },
      "content": "Adjust the center by moving the saddle and cross slide so that they are loaded at the center of hanged angle."
    },
    {
      "type": "list_item",
      "id": "txt_0327",
      "reading_order": 430,
      "section": "3-1. Crane",
      "bbox": {
        "l": 120.54104399999996,
        "t": 683.053784,
        "r": 403.2553439999992,
        "b": 674.1820649281768
      },
      "content": "Set the angle of wire rope within 90° and to 60° if possible."
    },
    {
      "type": "list_item",
      "id": "txt_0328",
      "reading_order": 431,
      "section": "3-1. Crane",
      "bbox": {
        "l": 120.54104399999996,
        "t": 665.833412,
        "r": 377.96987399999995,
        "b": 656.9616929281768
      },
      "content": "The capacities of wire rope and crane are as follows."
    },
    {
      "type": "list_item",
      "id": "txt_0329",
      "reading_order": 432,
      "section": "3-1. Crane",
      "bbox": {
        "l": 141.84,
        "t": 650.62034,
        "r": 325.33060799999976,
        "b": 638.4545
      },
      "content": "c Wire rope ... over 16mm in diameter"
    },
    {
      "type": "list_item",
      "id": "txt_0330",
      "reading_order": 433,
      "section": "3-1. Crane",
      "bbox": {
        "l": 141.84,
        "t": 632.32034,
        "r": 297.55216199999995,
        "b": 620.1545
      },
      "content": "d Crane    ...... over 5ton in load"
    },
    {
      "type": "list_item",
      "id": "txt_0331",
      "reading_order": 434,
      "section": "3-1. Crane",
      "bbox": {
        "l": 120.539844,
        "t": 611.9543299999999,
        "r": 334.9918919999999,
        "b": 603.0826109281768
      },
      "content": "Place where the wire rope is to be attached."
    },
    {
      "type": "list_item",
      "id": "txt_0332",
      "reading_order": 435,
      "section": "3-1. Crane",
      "bbox": {
        "l": 141.84,
        "t": 596.7403400000001,
        "r": 249.8359200000001,
        "b": 584.5745000000001
      },
      "content": "c Both edges of bed"
    },
    {
      "type": "list_item",
      "id": "txt_0333",
      "reading_order": 436,
      "section": "3-1. Crane",
      "bbox": {
        "l": 141.84,
        "t": 578.44034,
        "r": 266.53324799999996,
        "b": 566.2745
      },
      "content": "d Fixture for transporting"
    },
    {
      "type": "list_item",
      "id": "txt_0334",
      "reading_order": 437,
      "section": "3-1. Crane",
      "bbox": {
        "l": 70.92,
        "t": 479.714768,
        "r": 523.6045619999999,
        "b": 453.80303692817677
      },
      "content": "With the machine lifted slightly, check all sides for balance and the rope is reached to the cover or other parts."
    },
    {
      "type": "list_item",
      "id": "txt_0335",
      "reading_order": 438,
      "section": "3-1. Crane",
      "bbox": {
        "l": 70.92,
        "t": 445.694864,
        "r": 523.5785099999999,
        "b": 419.84325292817675
      },
      "content": "When more than 2 persons have to lift the machine, they should work together, communicating each other."
    },
    {
      "type": "list_item",
      "id": "txt_0336",
      "reading_order": 439,
      "section": "3-1. Crane",
      "bbox": {
        "l": 70.92,
        "t": 411.67496,
        "r": 267.1987740000001,
        "b": 402.80324092817676
      },
      "content": "Do not use rusty or shorted wire ropes."
    },
    {
      "type": "list_item",
      "id": "txt_0337",
      "reading_order": 440,
      "section": "3-1. Crane",
      "bbox": {
        "l": 70.92,
        "t": 394.695068,
        "r": 523.5965459999996,
        "b": 368.84345692817675
      },
      "content": "When lifting the machine, slowly do a job. If the wire rope is tightened, temporarily stop and check an eye bolt is clamped and then lift up to the desired height."
    },
    {
      "type": "list_item",
      "id": "txt_0338",
      "reading_order": 441,
      "section": "3-1. Crane",
      "bbox": {
        "l": 70.91999999999997,
        "t": 360.675164,
        "r": 523.5173880000008,
        "b": 334.82355292817675
      },
      "content": "When pulling down, also do it slowly. Just before reached the floor, stop it and  check the position and then pull down completely."
    },
    {
      "type": "list_item",
      "id": "txt_0339",
      "reading_order": 442,
      "section": "3-1. Crane",
      "bbox": {
        "l": 70.91999999999997,
        "t": 322.75547600000004,
        "r": 368.9709119999998,
        "b": 313.8837569281768
      },
      "content": "Only the experienced-personnel should perform a crane work."
    },
