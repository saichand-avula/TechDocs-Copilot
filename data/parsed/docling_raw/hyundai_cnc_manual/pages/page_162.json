        "r": 455.8719839999998,
        "b": 377.3629409281768
      },
      "content": "If assembling the cylinder with connecting tube, do it with pulled out."
    },
    {
      "type": "figure",
      "id": "fig_0289",
      "reading_order": 1503,
      "section": "3-7-2. Adjustment",
      "bbox": {
        "l": 224.62554931640625,
        "t": 330.69927978515625,
        "r": 343.71661376953125,
        "b": 299.92864990234375
      },
      "image_path": "figures/figure_0289.png",
      "previous_block_id": "txt_1166",
      "next_block_id": "txt_1167"
    },
    {
      "type": "paragraph",
      "id": "txt_1167",
      "reading_order": 1504,
      "section": "3-7-2. Adjustment",
      "bbox": {
        "l": 169.2,
        "t": 277.33475999999996,
        "r": 442.02355799999907,
        "b": 268.4630409281767
      },
      "content": "Turn OFF the power. Otherwise, it may cause personal injury."
    },
    {
      "type": "list_item",
      "id": "txt_1168",
      "reading_order": 1505,
      "section": "3-7-2. Adjustment",
      "bbox": {
        "l": 127.680294,
        "t": 240.854648,
        "r": 410.14008599999914,
        "b": 231.98292892817676
      },
      "content": "Put the assembled cylinder bundle into the hole of spindle."
    },
    {
      "type": "list_item",
      "id": "txt_1169",
      "reading_order": 1506,
      "section": "3-7-2. Adjustment",
      "bbox": {
        "l": 127.680294,
        "t": 223.87475599999993,
        "r": 511.7789579999998,
        "b": 215.0030369281768
      },
      "content": "Fit the cylinder adaptor to the spindle flange using bolts, (trembling less 0,01 mm)"
    },
    {
      "type": "list_item",
      "id": "txt_1170",
      "reading_order": 1507,
      "section": "3-7-2. Adjustment",
      "bbox": {
        "l": 127.680294,
        "t": 206.89486399999998,
        "r": 430.69511399999993,
        "b": 198.02314492817675
      },
      "content": "Fit the chuck to the connecting tube and assemble it to spindle."
    },
    {
      "type": "list_item",
      "id": "txt_1171",
      "reading_order": 1508,
      "section": "3-7-2. Adjustment",
      "bbox": {
        "l": 127.68029399999998,
        "t": 189.85485199999994,
        "r": 392.3175119999992,
        "b": 180.98313292817681
      },
      "content": "Adjust the trembling of chuck to be less than 0,02 mm."
    },
    {
      "type": "list_item",
      "id": "txt_1172",
      "reading_order": 1509,
      "section": "3-7-2. Adjustment",
      "bbox": {
        "l": 127.68029399999998,
        "t": 172.87496,
        "r": 536.809920000001,
        "b": 164.00324092817675
      },
      "content": "Engage with connecting tube handle until the stroke of jaw being within specified value."
    },
    {
      "type": "list_item",
      "id": "txt_1173",
      "reading_order": 1510,
      "section": "3-7-2. Adjustment",
      "bbox": {
        "l": 127.68029399999998,
        "t": 155.89506800000004,
        "r": 275.59853999999996,
        "b": 147.0233489281768
      },
      "content": "Connect the hydraulic hose."
    },
    {
      "type": "list_item",
      "id": "txt_1174",
      "reading_order": 1511,
      "section": "3-7-2. Adjustment",
      "bbox": {
        "l": 127.68029399999998,
        "t": 138.855056,
        "r": 356.84170199999994,
        "b": 129.98333692817675
      },
      "content": "Check the chuck is opened or closed properly."
    },
    {
      "type": "list_item",
      "id": "txt_1175",
      "reading_order": 1512,
      "section": "3-7-2. Adjustment",
      "bbox": {
        "l": 127.68029399999999,
        "t": 121.87516400000004,
        "r": 415.0929719999999,
        "b": 113.0034449281768
      },
      "content": "Raise the pressure of chuck up to the permissible pressure."
    }
  ]
