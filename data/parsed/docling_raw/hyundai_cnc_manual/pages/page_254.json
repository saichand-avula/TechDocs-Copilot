        "r": 479.9975219999999,
        "b": 148.4589089281767
      },
      "content": "=> The Alarm Message \" AL-133 POWER UNIT OFF REQUIRE \" is displayed."
    },
    {
      "type": "list_item",
      "id": "txt_1842",
      "reading_order": 2361,
      "section": "2-3. TOOL NO. SETTING",
      "bbox": {
