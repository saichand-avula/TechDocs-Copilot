        "t": 138.07018399999993,
        "r": 301.9912200000002,
        "b": 129.1984649281767
      },
      "content": "Turn off and then re-apply the power."
    },
    {
      "type": "paragraph",
      "id": "txt_1843",
      "reading_order": 2362,
      "section": "2-3. TOOL NO. SETTING",
      "bbox": {
