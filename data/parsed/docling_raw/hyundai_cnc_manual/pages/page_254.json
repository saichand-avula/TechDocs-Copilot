        "b": 360.2025509281768
      },
      "content": "Select the PMM (Power Mate CNC Manager) parameter screen."
    },
    {
      "type": "list_item",
      "id": "txt_1831",
      "reading_order": 2350,
      "section": "2-3. TOOL NO. SETTING",
      "bbox": {
        "l": 106.37977799999999,
        "t": 349.81482800000003,
        "r": 289.6185239999998,
        "b": 340.9431089281768
      },
      "content": "Set the basic parameter for turret."
    },
    {
      "type": "paragraph",
      "id": "txt_1832",
      "reading_order": 2351,
      "section": "2-3. TOOL NO. SETTING",
      "bbox": {
        "l": 134.69930399999998,
        "t": 330.554384,
        "r": 301.77779400000026,
        "b": 321.6826649281768
      },
      "content": "(Set PMM Parameter No.11#0 = \"0\")"
    },
    {
      "type": "list_item",
      "id": "txt_1833",
      "reading_order": 2352,
      "section": "2-3. TOOL NO. SETTING",
      "bbox": {
        "l": 106.37977799999996,
        "t": 311.35406,
        "r": 238.49448,
        "b": 302.48234092817677
      },
      "content": "Press the \"MDI\" mode."
    },
    {
      "type": "list_item",
      "id": "txt_1834",
      "reading_order": 2353,
      "section": "2-3. TOOL NO. SETTING",
      "bbox": {
        "l": 106.37977799999996,
        "t": 292.093616,
        "r": 340.2806459999996,
        "b": 283.22189692817676
      },
      "content": "Set the KEEP RELAY PARAMETER K5#0=1\""
    },
    {
      "type": "paragraph",
      "id": "txt_1835",
      "reading_order": 2354,
      "section": "2-3. TOOL NO. SETTING",
      "bbox": {
        "l": 134.69930399999996,
        "t": 272.833172,
        "r": 455.4505259999999,
        "b": 263.96145292817675
      },
      "content": "=> The Alarm Message \" AL-75 TURRET ADJUST MODE \" is displayed."
    },
    {
      "type": "list_item",
      "id": "txt_1836",
      "reading_order": 2355,
      "section": "2-3. TOOL NO. SETTING",
      "bbox": {
