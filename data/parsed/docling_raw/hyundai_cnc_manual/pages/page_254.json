        "t": 253.57272799999998,
        "r": 298.42410000000024,
        "b": 244.70100892817675
      },
      "content": "=> Unclamp the Turret compulsorily."
    },
    {
      "type": "list_item",
      "id": "txt_1837",
      "reading_order": 2356,
      "section": "2-3. TOOL NO. SETTING",
      "bbox": {
        "l": 106.3787759999999,
        "t": 234.31228399999998,
        "r": 340.246578,
        "b": 225.44056492817674
      },
      "content": "Turn the Turret by hand and set the No.1 tool."
