        "r": 457.7370899999999,
        "b": 109.99814092817678
      },
      "content": "=> The Alarm Message \" AL-61 TURRET SET UP ERROR \" is displayed."
    },
    {
      "type": "list_item",
      "id": "txt_1844",
      "reading_order": 2363,
      "section": "2-3. TOOL NO. SETTING",
      "bbox": {
