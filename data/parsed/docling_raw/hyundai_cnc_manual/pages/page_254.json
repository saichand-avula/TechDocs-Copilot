    {
      "type": "list_item",
      "id": "txt_1838",
      "reading_order": 2357,
      "section": "2-3. TOOL NO. SETTING",
      "bbox": {
        "l": 106.3787759999999,
        "t": 215.11195999999995,
        "r": 273.57149399999975,
        "b": 206.24024092817672
      },
      "content": "Clamp the Turret compulsorily."
    },
    {
      "type": "paragraph",
      "id": "txt_1839",
      "reading_order": 2358,
      "section": "2-3. TOOL NO. SETTING",
      "bbox": {
        "l": 134.6983019999999,
        "t": 195.85151599999995,
        "r": 360.97996199999955,
        "b": 186.9797969281767
      },
      "content": "=> Set the KEEP RELAY PARAMETER K5#0=\"0\""
    },
    {
      "type": "list_item",
      "id": "txt_1840",
      "reading_order": 2359,
      "section": "2-3. TOOL NO. SETTING",
      "bbox": {
        "l": 106.3777739999999,
        "t": 176.59107199999994,
        "r": 309.61944599999987,
        "b": 167.7193529281767
      },
      "content": "Set the PMM Parameter No.11#0='1'."
    },
    {
      "type": "paragraph",
      "id": "txt_1841",
      "reading_order": 2360,
      "section": "2-3. TOOL NO. SETTING",
      "bbox": {
