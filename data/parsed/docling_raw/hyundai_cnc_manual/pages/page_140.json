  "blocks": [
    {
      "type": "list_item",
      "id": "txt_0966",
      "reading_order": 1248,
      "section": "3-3-2. Tool Post Home Position Setting",
      "bbox": {
        "l": 99.3,
        "t": 755.71466,
        "r": 293.5196639999998,
        "b": 695.8431449281769
      },
      "content": "Press the 'CALL LIGHT OFF' switch. The  turret  is  clamped  and  ALARM '2067' disappears on the alarm screen."
    },
    {
      "type": "list_item",
      "id": "txt_0967",
      "reading_order": 1249,
      "section": "3-3-2. Tool Post Home Position Setting",
      "bbox": {
        "l": 99.3,
        "t": 636.675056,
        "r": 293.510646,
        "b": 593.843552928177
      },
      "content": "Verify  that  bit  \"7\"  of  X1000  has  been changed to \"1\" in the diagnostic screen."
    },
    {
      "type": "list_item",
      "id": "txt_0968",
      "reading_order": 1250,
      "section": "3-3-2. Tool Post Home Position Setting",
      "bbox": {
        "l": 99.3,
        "t": 551.7154760000002,
        "r": 293.4745739999999,
        "b": 491.84396092817695
      },
      "content": "With the Emergency stop switch pressed,  press  the  Spindle  'STOP' Mode  \"SELECT',  and  'FEED  HOLD' switches simultaneously."
    },
    {
      "type": "list_item",
      "id": "txt_0969",
      "reading_order": 1251,
      "section": "3-3-2. Tool Post Home Position Setting",
      "bbox": {
        "l": 99.3,
        "t": 398.7160880000002,
        "r": 293.50162800000015,
        "b": 338.84457292817694
      },
      "content": "Reset the Emergency Stop switch. Now the home position setting of tool post  is  completed  and  enables  the turret index."
    },
