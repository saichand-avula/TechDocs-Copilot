    {
      "type": "paragraph",
      "id": "txt_1006",
      "reading_order": 1299,
      "section": "3-4-2. Repairing Hydraulic Tank",
      "bbox": {
        "l": 99.29964599999994,
        "t": 721.694756,
        "r": 541.4782380000004,
        "b": 695.8431449281769
      },
      "content": "If there is an abnormal noise or high temperature in the hydraulic tank, check, repair and replace the pump and motor, if necessary."
    },
    {
      "type": "list_item",
      "id": "txt_1007",
      "reading_order": 1300,
      "section": "3-4-2. Repairing Hydraulic Tank",
      "bbox": {
        "l": 106.37977799999994,
        "t": 687.674852,
        "r": 220.435434,
        "b": 678.8031329281769
      },
      "content": "Turn OFF the power"
    },
    {
      "type": "list_item",
      "id": "txt_1008",
      "reading_order": 1301,
      "section": "3-4-2. Repairing Hydraulic Tank",
      "bbox": {
        "l": 106.37977799999994,
        "t": 670.69496,
        "r": 320.46208799999954,
        "b": 661.8232409281769
      },
      "content": "Disassemble the bolt installed in the pump."
    },
    {
      "type": "list_item",
      "id": "txt_1009",
      "reading_order": 1302,
      "section": "3-4-2. Repairing Hydraulic Tank",
      "bbox": {
        "l": 106.37977799999994,
        "t": 653.7150680000001,
        "r": 368.21339999999987,
        "b": 644.843348928177
      },
      "content": "Disassemble the bolt connected the motor with pump."
    },
    {
      "type": "list_item",
      "id": "txt_1010",
      "reading_order": 1303,
      "section": "3-4-2. Repairing Hydraulic Tank",
      "bbox": {
        "l": 106.37977799999994,
        "t": 636.675056,
        "r": 278.2728779999997,
        "b": 627.8033369281769
      },
      "content": "Disconnect the pump from motor."
    },
    {
      "type": "list_item",
      "id": "txt_1011",
      "reading_order": 1304,
      "section": "3-4-2. Repairing Hydraulic Tank",
      "bbox": {
        "l": 106.37977799999994,
        "t": 619.6951640000001,
        "r": 378.8867040000005,
        "b": 610.823444928177
      },
      "content": "Apply the power and check the motor for rotation sound."
    },
    {
      "type": "list_item",
      "id": "txt_1012",
      "reading_order": 1305,
      "section": "3-4-2. Repairing Hydraulic Tank",
      "bbox": {
        "l": 106.37977799999994,
        "t": 602.7152720000001,
        "r": 376.06607399999996,
        "b": 593.843552928177
      },
      "content": "If the rotation sound of motor is high, change the motor."
    },
    {
      "type": "list_item",
      "id": "txt_1013",
      "reading_order": 1306,
      "section": "3-4-2. Repairing Hydraulic Tank",
      "bbox": {
        "l": 106.37977799999994,
        "t": 585.6752600000001,
        "r": 309.969144,
        "b": 576.803540928177
      },
      "content": "If the motor is normal, change the pump."
    },
    {
