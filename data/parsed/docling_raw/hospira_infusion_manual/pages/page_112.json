{
  "page": 112,
  "document_id": "doc_37f23c38",
  "page_bbox": {
    "width": 612.0,
    "height": 792.0
  },
  "blocks": [
    {
      "type": "list_item",
      "id": "txt_1044",
      "reading_order": 1127,
      "section": "Ring, Cotter, Minipole",
      "bbox": {
        "l": 89.58,
        "t": 738.1227600000001,
        "r": 503.93093999999934,
        "b": 717.7673610491804
      },
      "content": "Grasp the cotter ring with thumb and finger. Twist, rotate, and remove the cotter ring from the rod hole."
    },
    {
      "type": "list_item",
      "id": "txt_1045",
      "reading_order": 1128,
      "section": "Ring, Cotter, Minipole",
      "bbox": {
        "l": 89.58000000000001,
        "t": 711.2427120000001,
        "r": 398.94656400000025,
        "b": 702.3472890491804
      },
      "content": "Replace the cotter ring in the exact reverse order of removal."
    },
    {
      "type": "paragraph",
      "id": "txt_1046",
      "reading_order": 1129,
      "section": "Ring, Cotter, Minipole",
      "bbox": {
        "l": 71.999604,
        "t": 687.7829280000001,
        "r": 504.01759199999896,
        "b": 654.8878890491803
      },
      "content": "Replacement  of  the  cotter  ring  is  routine  maintenance  and  no  verification  procedure is normally  required.  However,  if  the  infuser  may  have  been  damaged  during  the replacement procedure, perform the PVT as described in Section 5.2 ."
    },
    {
      "type": "heading",
      "id": "txt_1047",
      "reading_order": 1130,
      "section": "7.2.11.2",
      "bbox": {
        "l": 71.99960400000009,
        "t": 631.803744,
        "r": 104.46024000000006,
        "b": 622.4891273057851
      },
      "content": "7.2.11.2",
      "level": 2
    },
    {
      "type": "heading",
      "id": "txt_1048",
      "reading_order": 1131,
      "section": "BAG HANGER REPLACEMENT",
      "bbox": {
        "l": 72.0,
        "t": 619.90038,
        "r": 284.19403199999994,
        "b": 606.826249338843
      },
      "content": "BAG HANGER REPLACEMENT",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1049",
      "reading_order": 1132,
      "section": "BAG HANGER REPLACEMENT",
      "bbox": {
        "l": 72.0,
        "t": 591.78276,
        "r": 325.41725999999966,
        "b": 582.8873370491804
      },
      "content": "There are no recommended tools for this procedure."
    },
    {
      "type": "paragraph",
      "id": "txt_1050",
      "reading_order": 1133,
      "section": "BAG HANGER REPLACEMENT",
      "bbox": {
        "l": 72.0,
        "t": 567.783144,
        "r": 281.66397599999976,
        "b": 558.8877210491803
      },
      "content": "The replacement part for this procedure is:"
    },
    {
      "type": "heading",
      "id": "txt_1051",
      "reading_order": 1134,
      "section": "Hanger, Bag, Minipole",
      "bbox": {
        "l": 89.999712,
        "t": 549.783432,
        "r": 204.52576800000014,
        "b": 541.0270000327868
      },
      "content": "Hanger, Bag, Minipole",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1052",
      "reading_order": 1135,
      "section": "Hanger, Bag, Minipole",
      "bbox": {
        "l": 72.0,
        "t": 523.803768,
        "r": 402.37021199999975,
        "b": 514.9083450491803
      },
      "content": "To replace the bag hanger, see Figure 7-10 , then proceed as follows:"
    },
    {
      "type": "list_item",
      "id": "txt_1053",
      "reading_order": 1136,
      "section": "Hanger, Bag, Minipole",
      "bbox": {
        "l": 89.57939999999999,
        "t": 499.80415199999993,
        "r": 375.427416,
        "b": 490.90872904918024
      },
      "content": "Remove the cotter ring as described in Section 7.2.11.1 ."
    },
    {
      "type": "list_item",
      "id": "txt_1054",
      "reading_order": 1137,
      "section": "Hanger, Bag, Minipole",
      "bbox": {
        "l": 89.58039599999995,
        "t": 484.3840799999999,
        "r": 370.7053800000001,
        "b": 475.48865704918023
      },
      "content": "Remove the bag hanger from the pole clamp rod holes."
    },
    {
      "type": "list_item",
      "id": "txt_1055",
      "reading_order": 1138,
      "section": "Hanger, Bag, Minipole",
      "bbox": {
        "l": 89.58039599999995,
        "t": 468.90424799999994,
        "r": 411.59815199999997,
        "b": 460.00882504918025
      },
      "content": "Insert the replacement bag hanger in the pole clamp rod holes."
    },
    {
      "type": "list_item",
      "id": "txt_1056",
      "reading_order": 1139,
      "section": "Hanger, Bag, Minipole",
      "bbox": {
        "l": 89.58039599999995,
        "t": 453.48417599999993,
        "r": 208.69303199999968,
        "b": 444.58875304918024
      },
      "content": "Insert the cotter ring."
    },
    {
      "type": "paragraph",
      "id": "txt_1057",
      "reading_order": 1140,
      "section": "Hanger, Bag, Minipole",
      "bbox": {
        "l": 71.99999999999991,
        "t": 430.0243919999999,
        "r": 504.0956760000007,
        "b": 397.1293530491802
      },
      "content": "Replacement of the bag hanger is routine maintenance and no verification procedure is normally  required.  However,  if  the  infuser  may  have  been  damaged  during  the replacement procedure, perform the PVT in Section 5.2 ."
    },
    {
      "type": "heading",
      "id": "txt_1058",
      "reading_order": 1141,
      "section": "7.2.11.3",
      "bbox": {
        "l": 71.99999999999994,
        "t": 374.04520799999995,
        "r": 104.46063599999991,
        "b": 364.7305913057851
      },
      "content": "7.2.11.3",
      "level": 2
    },
    {
      "type": "heading",
      "id": "txt_1059",
      "reading_order": 1142,
      "section": "CLUTCH HOUSING REPLACEMENT",
      "bbox": {
        "l": 72.0,
        "t": 362.08038,
        "r": 319.9758419999999,
        "b": 349.00624933884296
      },
      "content": "CLUTCH HOUSING REPLACEMENT",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1060",
      "reading_order": 1143,
      "section": "CLUTCH HOUSING REPLACEMENT",
      "bbox": {
        "l": 72.0,
        "t": 334.02276,
        "r": 325.41725999999966,
        "b": 325.1273370491803
      },
      "content": "There are no recommended tools for this procedure."
    },
    {
      "type": "paragraph",
      "id": "txt_1061",
      "reading_order": 1144,
      "section": "CLUTCH HOUSING REPLACEMENT",
      "bbox": {
        "l": 72.0,
        "t": 310.023144,
        "r": 281.66397599999976,
        "b": 301.1277210491803
      },
      "content": "The replacement part for this procedure is:"
    },
    {
      "type": "heading",
      "id": "txt_1062",
      "reading_order": 1145,
      "section": "Housing, Clutch, Minipole",
      "bbox": {
        "l": 89.999712,
        "t": 292.023432,
        "r": 225.63997199999994,
        "b": 283.2670000327869
      },
      "content": "Housing, Clutch, Minipole",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1063",
      "reading_order": 1146,
      "section": "Housing, Clutch, Minipole",
      "bbox": {
        "l": 72.0,
        "t": 266.043768,
        "r": 420.71553599999976,
        "b": 257.1483450491803
      },
      "content": "To replace the clutch housing, see Figure 7-10 , then proceed as follows:"
    },
    {
      "type": "list_item",
      "id": "txt_1064",
      "reading_order": 1147,
      "section": "Housing, Clutch, Minipole",
      "bbox": {
        "l": 89.58039600000004,
        "t": 242.04415199999994,
        "r": 461.5883880000001,
        "b": 233.14872904918036
      },
      "content": "Remove the bag hanger from the infuser as described in Section 7.2.11.2 ."
    },
    {
      "type": "list_item",
      "id": "txt_1065",
      "reading_order": 1148,
      "section": "Housing, Clutch, Minipole",
      "bbox": {
        "l": 89.58139200000011,
        "t": 226.56431999999995,
        "r": 504.0528480000007,
        "b": 206.26868104918037
      },
      "content": "Turn  the  clutch  housing  knob  counterclockwise  to  loosen  the  clutch  spring, and slide the knob and spring downward to remove them."
    },
    {
      "type": "list_item",
      "id": "txt_1066",
      "reading_order": 1149,
      "section": "Housing, Clutch, Minipole",
      "bbox": {
        "l": 89.58139200000005,
        "t": 199.68427199999996,
        "r": 503.97615600000057,
        "b": 179.38863304918038
      },
      "content": "Work the clutch spring free from the clutch housing hole and install it into the replacement clutch housing."
    },
    {
      "type": "list_item",
      "id": "txt_1067",
      "reading_order": 1150,
      "section": "Housing, Clutch, Minipole",
      "bbox": {
        "l": 89.58139200000005,
        "t": 172.80422399999998,
        "r": 504.0229680000006,
        "b": 141.0486090491804
      },
      "content": "Install  the  replacement  clutch  housing  by  turning  the  clutch  housing  knob counterclockwise and sliding it up the short rod. Confirm the clutch spring slides up the long rod."
    },
    {
      "type": "list_item",
      "id": "txt_1068",
      "reading_order": 1151,
      "section": "Housing, Clutch, Minipole",
      "bbox": {
        "l": 89.58039600000009,
        "t": 134.52396,
        "r": 210.93801600000015,
        "b": 125.6285370491803
      },
      "content": "Install the cotter ring."
    },
    {
      "type": "paragraph",
      "id": "txt_1069",
      "reading_order": 1152,
      "section": "Housing, Clutch, Minipole",
      "bbox": {
        "l": 72.00000000000009,
        "t": 111.06417599999997,
        "r": 503.9084280000009,
        "b": 78.16913704918034
      },
      "content": "Replacement of the clutch housing is routine maintenance and no verification procedure is  normally  required.  However,  if  the  infuser  may  have  been  damaged  during  the replacement procedure, perform the PVT in Section 5.2 ."
    }
  ]
}