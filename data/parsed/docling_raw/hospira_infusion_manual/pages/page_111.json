      "section": "7.2.11.1 COTTER RING REPLACEMENT",
      "bbox": {
        "l": 108.0,
        "t": 233.10317999999995,
        "r": 321.70387199999976,
        "b": 208.12634933884306
      },
      "content": "7.2.11.1 COTTER RING REPLACEMENT",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1038",
      "reading_order": 1121,
      "section": "7.2.11.1 COTTER RING REPLACEMENT",
      "bbox": {
        "l": 108.0,
        "t": 193.08276,
        "r": 361.4302079999998,
        "b": 184.18733704918031
      },
      "content": "There are no recommended tools for this procedure."
    },
    {
      "type": "paragraph",
      "id": "txt_1039",
      "reading_order": 1122,
      "section": "7.2.11.1 COTTER RING REPLACEMENT",
      "bbox": {
        "l": 108.0,
        "t": 169.08314399999995,
        "r": 317.69684399999994,
        "b": 160.18772104918037
      },
      "content": "The replacement part for this procedure is:"
    },
    {
      "type": "heading",
      "id": "txt_1040",
      "reading_order": 1123,
      "section": "Ring, Cotter, Minipole",
      "bbox": {
        "l": 125.999712,
        "t": 151.08343200000002,
        "r": 241.9570200000001,
        "b": 142.32700003278694
      },
      "content": "Ring, Cotter, Minipole",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1041",
      "reading_order": 1124,
      "section": "Ring, Cotter, Minipole",
      "bbox": {
        "l": 108.0,
        "t": 125.10376800000006,
        "r": 434.3623079999996,
        "b": 116.20834504918037
      },
      "content": "To replace the cotter ring, see Figure 7-10 , then proceed as follows:"
    },
    {
      "type": "list_item",
      "id": "txt_1042",
      "reading_order": 1125,
      "section": "Ring, Cotter, Minipole",
      "bbox": {
        "l": 125.58039600000001,
        "t": 101.104152,
        "r": 444.2346599999992,
        "b": 92.2087290491803
      },
      "content": "Turn off the infuser and disconnect the device from AC power."
    },
    {
      "type": "list_item",
      "id": "txt_1043",
      "reading_order": 1126,
      "section": "Ring, Cotter, Minipole",
      "bbox": {
        "l": 125.58039600000001,
        "t": 85.68408,
        "r": 361.67821199999975,
        "b": 76.7886570491803
      },
      "content": "Place the infuser face down on a soft surface."
    }
  ]
}