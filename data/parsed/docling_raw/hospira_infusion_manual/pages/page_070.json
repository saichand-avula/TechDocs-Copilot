  "blocks": [
    {
      "type": "heading",
      "id": "txt_0653",
      "reading_order": 705,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 72.0,
        "t": 738.19196,
        "r": 284.33197303999987,
        "b": 709.2828958877272
      },
      "content": "5.2.14 DISTAL OCCLUSION TEST",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0654",
      "reading_order": 706,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 72.0,
        "t": 695.10277681,
        "r": 442.5667536546001,
        "b": 686.2073449280329
      },
      "content": "To perform the distal occlusion test, see Figure 5-4 , then proceed as follows:"
    },
    {
      "type": "list_item",
      "id": "txt_0655",
      "reading_order": 707,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 89.57941764999995,
        "t": 671.1030371139,
        "r": 503.99033452480126,
        "b": 650.8072781858328
      },
      "content": "Install the cassette and connect the distal tubing to the DPM through a three-way stopcock as illustrated in Figure 5-4 . Close the cassette door."
    },
    {
      "type": "list_item",
      "id": "txt_0656",
      "reading_order": 708,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 108.0,
        "t": 646.98004,
        "r": 503.9443322617996,
        "b": 617.9875548800329
      },
      "content": " Note: A  reflux  valve  may  be  attached  between  the  stopcock  and  the  DPM to keep moisture out of the DPM."
    },
    {
      "type": "list_item",
      "id": "txt_0657",
      "reading_order": 709,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 108.0,
        "t": 613.67999,
        "r": 504.02371354149955,
        "b": 584.6875048800329
      },
      "content": " Note: The height of the DPM must be 0 ± 30.5 cm from the midline of the pumping chamber."
    },
    {
      "type": "list_item",
      "id": "txt_0658",
      "reading_order": 710,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 89.57943063319999,
        "t": 573.603156702,
        "r": 203.2938608041999,
        "b": 564.7077248200328
      },
      "content": "Turn on the infuser."
    },
    {
      "type": "list_item",
      "id": "txt_0659",
      "reading_order": 711,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 89.57943063319999,
        "t": 554.1632091839999,
        "r": 368.84516302020006,
        "b": 545.2677773020328
      },
      "content": "A 'NEW PATIENT?' message may appear. Press [YES]."
    },
    {
      "type": "list_item",
      "id": "txt_0660",
      "reading_order": 712,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 89.57943063319999,
        "t": 538.6833616419999,
        "r": 384.0383614744002,
        "b": 529.7879297600327
      },
      "content": "Press [OPTIONS/VOL INF] to select the OPTIONS screen."
    },
    {
      "type": "list_item",
      "id": "txt_0661",
      "reading_order": 713,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 89.5793310331,
        "t": 523.2632741599999,
        "r": 395.21608229700007,
        "b": 514.3678422780328
      },
      "content": "Select Pressure/Post Infusion Rate , and press [CHOOSE]."
    },
    {
      "type": "list_item",
      "id": "txt_0662",
      "reading_order": 714,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 89.57923143300005,
        "t": 507.84318667799994,
        "r": 503.9873595050005,
        "b": 487.4877672900327
      },
      "content": "Verify the distal pressure limit is set at 6 psi. If the pressure limit is not 6 psi, enter 6, and press [ENTER]."
    },
    {
      "type": "list_item",
      "id": "txt_0663",
      "reading_order": 715,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 89.57913183290003,
        "t": 480.96311168999995,
        "r": 280.6479796689,
        "b": 472.0676798080327
      },
      "content": "Press the [A] softkey to select line A."
    },
    {
      "type": "list_item",
      "id": "txt_0664",
      "reading_order": 716,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 89.57913183290005,
        "t": 465.48326414799993,
        "r": 324.36784196429994,
        "b": 456.5878322660327
      },
      "content": "Enter a rate of 40 mL/hr and VTBI of 50 mL."
    },
    {
      "type": "list_item",
      "id": "txt_0665",
      "reading_order": 717,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 89.57913183290005,
        "t": 450.06317666599995,
        "r": 278.86912188289995,
        "b": 441.1677447840327
      },
      "content": "Open the three-way stopcock to air."
    },
    {
      "type": "list_item",
      "id": "txt_0666",
      "reading_order": 718,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 83.39894562790005,
        "t": 434.58332912399993,
        "r": 503.95349547099954,
        "b": 414.2875701959327
      },
      "content": "Press [START] and verify the 'CONFIRM PROGRAM?' message is displayed. If rate and VTBI are correct, press [YES]."
    },
    {
      "type": "list_item",
      "id": "txt_0667",
      "reading_order": 719,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 83.39914482810006,
        "t": 407.7031545358999,
        "r": 503.9405474580012,
        "b": 387.40739560783265
      },
      "content": "Verify fluid is pumping, the message 'PUMPING' is displayed in the line A status bar, and the line A LED flashes."
    },
    {
      "type": "list_item",
      "id": "txt_0668",
      "reading_order": 720,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 83.39914482810006,
        "t": 380.82297994779987,
        "r": 342.9958494670999,
        "b": 371.92754806583264
      },
      "content": "Set the three-way stopcock to measure pressure."
    },
    {
      "type": "list_item",
      "id": "txt_0669",
      "reading_order": 721,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 83.39914482810006,
        "t": 368.67973575579987,
        "r": 503.95269867020005,
        "b": 345.04747307783265
      },
      "content": "Verify the distal occlusion audible alarm occurs at 6 psi ± 3 psi. Verify the DISTAL OCCLUSION message is flashing on the screen."
    },
    {
      "type": "list_item",
      "id": "txt_0670",
      "reading_order": 722,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 83.39824842720009,
        "t": 338.5228174777999,
        "r": 278.8465126601998,
        "b": 329.62738559583266
      },
      "content": "Open the three-way stopcock to air."
    },
    {
      "type": "list_item",
      "id": "txt_0671",
      "reading_order": 723,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 83.39824842720009,
        "t": 323.1027299957999,
        "r": 441.4416839082008,
        "b": 314.2072981138327
      },
      "content": "Open and close the door. Press [NO] at the 'NEW PATIENT?' prompt."
    },
    {
      "type": "list_item",
      "id": "txt_0672",
      "reading_order": 724,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 83.39824842720009,
        "t": 307.6228824537999,
        "r": 384.03736547340026,
        "b": 298.72745057183266
      },
      "content": "Press [OPTIONS/VOL INF] to select the OPTIONS screen."
    },
    {
      "type": "list_item",
      "id": "txt_0673",
      "reading_order": 725,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 83.3981488271001,
        "t": 292.2027949717999,
        "r": 392.2301708990997,
        "b": 283.3073630898327
      },
      "content": "Select Pressure/Post Infusion Rate and press [CHOOSE]."
    },
    {
      "type": "list_item",
      "id": "txt_0674",
      "reading_order": 726,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 83.39804922700012,
        "t": 276.7827074897999,
        "r": 415.0863022469998,
        "b": 267.88727560783263
      },
      "content": "Select Distal Pressure Limit . Enter 10 psi, and press [ENTER]."
    },
    {
      "type": "list_item",
      "id": "txt_0675",
      "reading_order": 727,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 83.3979496269001,
        "t": 261.3028599477999,
        "r": 443.2012192747995,
        "b": 252.40742806583273
      },
      "content": "Set the three-way stopcock to measure pressure, then press [START]."
    },
    {
      "type": "list_item",
      "id": "txt_0676",
      "reading_order": 728,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 83.3979496269001,
        "t": 249.1596157557999,
        "r": 503.9514038689002,
        "b": 225.5273530778327
      },
      "content": "Verify the distal occlusion audible alarm occurs at 10 psi ± 3 psi. Verify the DISTAL OCCLUSION message is flashing on the screen."
    },
    {
      "type": "list_item",
      "id": "txt_0677",
      "reading_order": 729,
      "section": "5.2.14 DISTAL OCCLUSION TEST",
      "bbox": {
        "l": 83.39695362590021,
        "t": 219.00269747779987,
        "r": 298.6546817479002,
        "b": 210.1072655958327
      },
      "content": "Open the door and remove the cassette."
    }
  ]
}