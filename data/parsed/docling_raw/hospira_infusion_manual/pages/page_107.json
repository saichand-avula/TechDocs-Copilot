  "blocks": [
    {
      "type": "heading",
      "id": "txt_0974",
      "reading_order": 1055,
      "section": "7.2.9.2 FRONT/REAR ENCLOSURE GASKET REPLACEMENT",
      "bbox": {
        "l": 108.0,
        "t": 738.1227600000001,
        "r": 470.04285600000054,
        "b": 713.1462493388431
      },
      "content": "7.2.9.2 FRONT/REAR ENCLOSURE GASKET REPLACEMENT",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0975",
      "reading_order": 1056,
      "section": "7.2.9.2 FRONT/REAR ENCLOSURE GASKET REPLACEMENT",
      "bbox": {
        "l": 108.0,
        "t": 698.1027600000001,
        "r": 414.61561200000017,
        "b": 689.2073370491804
      },
      "content": "The recommended tool for this procedure is needle nose pliers."
    },
    {
      "type": "paragraph",
      "id": "txt_0976",
      "reading_order": 1057,
      "section": "7.2.9.2 FRONT/REAR ENCLOSURE GASKET REPLACEMENT",
      "bbox": {
        "l": 108.0,
        "t": 674.1031440000002,
        "r": 317.69684399999994,
        "b": 665.2077210491805
      },
      "content": "The replacement part for this procedure is:"
    },
    {
      "type": "heading",
      "id": "txt_0977",
      "reading_order": 1058,
      "section": "Gasket, Front/Rear Enclosure",
      "bbox": {
        "l": 125.999712,
        "t": 656.1034320000001,
        "r": 282.54003600000004,
        "b": 647.3470000327869
      },
      "content": "Gasket, Front/Rear Enclosure",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0978",
      "reading_order": 1059,
      "section": "Gasket, Front/Rear Enclosure",
      "bbox": {
        "l": 108.0,
        "t": 636.1236720000002,
        "r": 517.3301039999998,
        "b": 627.2282490491805
      },
      "content": "To replace the front/rear enclosure gaskets, see Figure 7-8 , then proceed as follows:"
    },
    {
      "type": "list_item",
      "id": "txt_0979",
      "reading_order": 1060,
      "section": "Gasket, Front/Rear Enclosure",
      "bbox": {
        "l": 125.57940000000002,
        "t": 618.1239600000001,
        "r": 444.23366399999924,
        "b": 609.2285370491804
      },
      "content": "Turn off the infuser and disconnect the device from AC power."
    },
    {
      "type": "list_item",
      "id": "txt_0980",
      "reading_order": 1061,
      "section": "Gasket, Front/Rear Enclosure",
      "bbox": {
        "l": 125.57940000000002,
        "t": 602.7038880000001,
        "r": 380.0464440000001,
        "b": 593.8084650491804
      },
      "content": "Remove the battery as described in Section 7.2.4 ."
    },
    {
      "type": "list_item",
      "id": "txt_0981",
      "reading_order": 1062,
      "section": "Gasket, Front/Rear Enclosure",
      "bbox": {
        "l": 125.57940000000008,
        "t": 587.2240560000001,
        "r": 539.9542439999997,
        "b": 566.9284170491804
      },
      "content": "Separate  the  front  enclosure,  rear  enclosure,  and  main  chassis  assembly as described in Section 7.2.8 ."
    },
    {
      "type": "list_item",
      "id": "txt_0982",
      "reading_order": 1063,
      "section": "Gasket, Front/Rear Enclosure",
      "bbox": {
        "l": 125.58039600000009,
        "t": 560.3440080000001,
        "r": 409.34179199999954,
        "b": 551.4485850491805
      },
      "content": "Remove the front/rear gasket from the front enclosure."
    },
    {
      "type": "list_item",
      "id": "txt_0983",
      "reading_order": 1064,
      "section": "Gasket, Front/Rear Enclosure",
      "bbox": {
        "l": 125.58039600000009,
        "t": 544.9239360000001,
        "r": 524.8100640000002,
        "b": 536.0285130491804
      },
      "content": "Install the replacement front/rear gasket in the exact reverse order of removal."
    },
    {
      "type": "list_item",
      "id": "txt_0984",
      "reading_order": 1065,
      "section": "Gasket, Front/Rear Enclosure",
      "bbox": {
        "l": 125.58039600000012,
        "t": 529.5038640000001,
        "r": 540.0578279999987,
        "b": 509.1484650491804
      },
      "content": "Join the front enclosure, main chassis assembly, and rear enclosure in the exact reverse order of separation."
    },
    {
      "type": "list_item",
      "id": "txt_0985",
      "reading_order": 1066,
      "section": "Gasket, Front/Rear Enclosure",
      "bbox": {
        "l": 125.58039600000012,
        "t": 502.6238160000001,
        "r": 420.4691040000003,
        "b": 493.7283930491804
      },
      "content": "Reinstall the battery and connect the device to AC power."
    },
    {
      "type": "paragraph",
      "id": "txt_0986",
      "reading_order": 1067,
      "section": "Gasket, Front/Rear Enclosure",
      "bbox": {
        "l": 108.00000000000011,
        "t": 479.1640320000001,
        "r": 539.9871120000004,
        "b": 458.26880104918035
      },
      "content": "To  verify  successful  front/rear  enclosure  gasket  replacement,  perform  the  PVT in Section 5.2 ."
    },
    {
      "type": "heading",
      "id": "txt_0987",
      "reading_order": 1068,
      "section": "7.2.10 REAR ENCLOSURE COMPONENT REPLACEMENT",
      "bbox": {
        "l": 108.0,
        "t": 435.192,
        "r": 501.9805799999995,
        "b": 406.342928429752
      },
      "content": "7.2.10 REAR ENCLOSURE COMPONENT REPLACEMENT",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0988",
      "reading_order": 1069,
      "section": "7.2.10 REAR ENCLOSURE COMPONENT REPLACEMENT",
      "bbox": {
        "l": 108.0,
        "t": 392.16276,
        "r": 508.2505679999994,
        "b": 383.2673370491803
      },
      "content": "Rear enclosure component replacement includes the replacement of the following:"
    },
    {
      "type": "list_item",
      "id": "txt_0989",
      "reading_order": 1070,
      "section": "7.2.10 REAR ENCLOSURE COMPONENT REPLACEMENT",
      "bbox": {
        "l": 116.99985600000002,
        "t": 374.163048,
        "r": 372.3214679999998,
        "b": 365.2676250491803
      },
      "content": "-Pole clamp extrusion, backing plate, and insulator"
    },
    {
      "type": "list_item",
      "id": "txt_0990",
      "reading_order": 1071,
      "section": "7.2.10 REAR ENCLOSURE COMPONENT REPLACEMENT",
      "bbox": {
        "l": 116.99985600000002,
        "t": 356.703168,
        "r": 351.45526800000005,
        "b": 347.8077450491803
      },
      "content": "Pole clamp shaft/knob assembly and shaft tip"
    },
    {
      "type": "list_item",
      "id": "txt_0991",
      "reading_order": 1072,
      "section": "7.2.10 REAR ENCLOSURE COMPONENT REPLACEMENT",
      "bbox": {
        "l": 116.99985600000002,
        "t": 339.303048,
        "r": 297.25991999999985,
        "b": 330.4076250491803
      },
      "content": "Rear enclosure and handle gaskets"
    },
    {
      "type": "paragraph",
      "id": "txt_0992",
      "reading_order": 1073,
      "section": "7.2.10 REAR ENCLOSURE COMPONENT REPLACEMENT",
      "bbox": {
        "l": 108.00000000000003,
        "t": 315.843264,
        "r": 539.9771519999999,
        "b": 294.9480330491803
      },
      "content": "To replace the rear enclosure components, see Figure 7-9 , then proceed as detailed in the following sections."
    }
  ]
}