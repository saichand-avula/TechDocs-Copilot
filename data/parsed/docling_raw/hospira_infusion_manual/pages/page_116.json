{
  "page": 116,
  "document_id": "doc_37f23c38",
  "page_bbox": {
    "width": 612.0,
    "height": 792.0
  },
  "blocks": [
    {
      "type": "list_item",
      "id": "txt_1109",
      "reading_order": 1194,
      "section": "7.2.12.2 KEYPAD REPLACEMENT",
      "bbox": {
        "l": 89.58,
        "t": 738.1227600000001,
        "r": 342.35882400000014,
        "b": 729.2273370491804
      },
      "content": "Disconnect the keypad cable from the CPU PWA."
    },
    {
      "type": "list_item",
      "id": "txt_1110",
      "reading_order": 1195,
      "section": "7.2.12.2 KEYPAD REPLACEMENT",
      "bbox": {
        "l": 89.58,
        "t": 722.7026880000001,
        "r": 504.01460400000116,
        "b": 702.3472890491804
      },
      "content": "Using the X-acto knife, lift the white insulation tape that secures the grounding tab to the lower main chassis."
    },
    {
      "type": "list_item",
      "id": "txt_1111",
      "reading_order": 1196,
      "section": "7.2.12.2 KEYPAD REPLACEMENT",
      "bbox": {
        "l": 89.57999999999998,
        "t": 695.8226400000001,
        "r": 503.92197599999974,
        "b": 675.4672410491804
      },
      "content": "Using  the  Phillips  screwdriver,  remove  the  screw  that  secures  the  keypad  and display to the main chassis."
    },
    {
      "type": "list_item",
      "id": "txt_1112",
      "reading_order": 1197,
      "section": "7.2.12.2 KEYPAD REPLACEMENT",
      "bbox": {
        "l": 89.57900399999997,
        "t": 668.9425920000001,
        "r": 503.90305200000046,
        "b": 648.5871930491804
      },
      "content": "Carefully disconnect the flex ribbon cable from the display assembly by pushing the connector locking tabs down."
    },
    {
      "type": "list_item",
      "id": "txt_1113",
      "reading_order": 1198,
      "section": "7.2.12.2 KEYPAD REPLACEMENT",
      "bbox": {
        "l": 89.57900399999997,
        "t": 642.0625440000001,
        "r": 504.023567999999,
        "b": 621.7071450491804
      },
      "content": "Using the flat blade screwdriver, separate the keypad and display by removing the screws and spacers that secure the keypad to the display assembly."
    },
    {
      "type": "list_item",
      "id": "txt_1114",
      "reading_order": 1199,
      "section": "7.2.12.2 KEYPAD REPLACEMENT",
      "bbox": {
        "l": 89.57999999999996,
        "t": 615.1824960000001,
        "r": 389.8998960000003,
        "b": 606.2870730491804
      },
      "content": "Inspect the keypad ground gasket and replace, if required."
    },
    {
      "type": "list_item",
      "id": "txt_1115",
      "reading_order": 1200,
      "section": "7.2.12.2 KEYPAD REPLACEMENT",
      "bbox": {
        "l": 83.39981999999998,
        "t": 599.7026640000001,
        "r": 439.5923280000008,
        "b": 590.8072410491804
      },
      "content": "Install the replacement keypad in the exact reverse order of removal."
    },
    {
      "type": "list_item",
      "id": "txt_1116",
      "reading_order": 1201,
      "section": "7.2.12.2 KEYPAD REPLACEMENT",
      "bbox": {
        "l": 83.39981999999995,
        "t": 584.2825920000001,
        "r": 484.7728800000002,
        "b": 575.3871690491804
      },
      "content": "Install the keypad and display assembly in the exact reverse order of removal."
    },
    {
      "type": "list_item",
      "id": "txt_1117",
      "reading_order": 1202,
      "section": "7.2.12.2 KEYPAD REPLACEMENT",
      "bbox": {
        "l": 83.39981999999992,
        "t": 568.8625200000001,
        "r": 503.92994399999867,
        "b": 548.5071210491805
      },
      "content": "Join the front enclosure, rear enclosure, and main chassis assembly in the exact reverse order of separation."
    },
    {
      "type": "list_item",
      "id": "txt_1118",
      "reading_order": 1203,
      "section": "7.2.12.2 KEYPAD REPLACEMENT",
      "bbox": {
        "l": 83.39981999999992,
        "t": 541.9824720000001,
        "r": 384.3681119999997,
        "b": 533.0870490491805
      },
      "content": "Reinstall the battery and connect the device to AC power."
    },
    {
      "type": "paragraph",
      "id": "txt_1119",
      "reading_order": 1204,
      "section": "7.2.12.2 KEYPAD REPLACEMENT",
      "bbox": {
        "l": 71.99960399999992,
        "t": 518.5226880000001,
        "r": 503.992692,
        "b": 497.62745704918035
      },
      "content": "To  verify  successful  keypad  and  ground  gasket  replacement,  perform  the  PVT in Section 5.2 ."
    },
    {
      "type": "heading",
      "id": "txt_1120",
      "reading_order": 1205,
      "section": "7.2.12.3",
      "bbox": {
        "l": 71.99960399999993,
        "t": 474.54331200000007,
        "r": 104.4602399999999,
        "b": 465.2286953057852
      },
      "content": "7.2.12.3",
      "level": 2
    },
    {
      "type": "heading",
      "id": "txt_1121",
      "reading_order": 1206,
      "section": "DISPLAY REPLACEMENT",
      "bbox": {
        "l": 72.0,
        "t": 462.58038,
        "r": 247.22671799999995,
        "b": 449.50624933884296
      },
      "content": "DISPLAY REPLACEMENT",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1122",
      "reading_order": 1207,
      "section": "DISPLAY REPLACEMENT",
      "bbox": {
        "l": 72.0,
        "t": 434.52276,
        "r": 503.9124120000009,
        "b": 413.6275290491803
      },
      "content": "The recommended tools for this procedure are a #2 Phillips screwdriver and a medium size flat blade screwdriver."
    },
    {
      "type": "paragraph",
      "id": "txt_1123",
      "reading_order": 1208,
      "section": "DISPLAY REPLACEMENT",
      "bbox": {
        "l": 72.0,
        "t": 398.523336,
        "r": 294.1378799999998,
        "b": 389.6279130491803
      },
      "content": "The replacement parts for this procedure are:"
    },
    {
      "type": "code",
      "id": "txt_1124",
      "reading_order": 1209,
      "section": "DISPLAY REPLACEMENT",
      "bbox": {
        "l": 89.999712,
        "t": 380.523624,
        "r": 184.13963999999993,
        "b": 371.76719203278685
      },
      "content": "Assembly, Display"
    },
    {
      "type": "paragraph",
      "id": "txt_1125",
      "reading_order": 1210,
      "section": "DISPLAY REPLACEMENT",
      "bbox": {
        "l": 89.999712,
        "t": 366.543768,
        "r": 361.06210799999997,
        "b": 357.78733603278687
      },
      "content": "Screw, 4-40 x 3/16, Hex Head, Slotted, with Washer"
    },
    {
      "type": "paragraph",
      "id": "txt_1126",
      "reading_order": 1211,
      "section": "DISPLAY REPLACEMENT",
      "bbox": {
        "l": 71.99999999999997,
        "t": 340.91170800000003,
        "r": 503.9891040000006,
        "b": 307.72072830936224
      },
      "content": "CAUTION: Use  proper  ESD  grounding  techniques  when  handling  components. Wear an antistatic wrist strap and use an ESD-protected workstation. Store the PWA in an antistatic bag before placing it on any surface."
    },
    {
      "type": "paragraph",
      "id": "txt_1127",
      "reading_order": 1212,
      "section": "DISPLAY REPLACEMENT",
      "bbox": {
        "l": 72.0,
        "t": 292.50411599999995,
        "r": 382.7231159999997,
        "b": 283.60869304918026
      },
      "content": "To replace the display, see Figure 7-12 , then proceed as follows:"
    },
    {
      "type": "list_item",
      "id": "txt_1128",
      "reading_order": 1213,
      "section": "DISPLAY REPLACEMENT",
      "bbox": {
        "l": 89.58039599999998,
        "t": 268.5045,
        "r": 408.23366399999946,
        "b": 259.6090770491803
      },
      "content": "Turn off the infuser and disconnect the device from AC power."
    },
    {
      "type": "list_item",
      "id": "txt_1129",
      "reading_order": 1214,
      "section": "DISPLAY REPLACEMENT",
      "bbox": {
        "l": 89.58039599999998,
        "t": 253.0844279999999,
        "r": 344.04744,
        "b": 244.1890050491803
      },
      "content": "Remove the battery as described in Section 7.2.4 ."
    },
    {
      "type": "list_item",
      "id": "txt_1130",
      "reading_order": 1215,
      "section": "DISPLAY REPLACEMENT",
      "bbox": {
        "l": 89.58039599999995,
        "t": 237.6045959999999,
        "r": 504.1494600000005,
        "b": 217.30895704918032
      },
      "content": "Separate  the  front  enclosure,  rear  enclosure,  and  main  chassis  assembly as described in Section 7.2.8 ."
    },
    {
      "type": "list_item",
      "id": "txt_1131",
      "reading_order": 1216,
      "section": "DISPLAY REPLACEMENT",
      "bbox": {
        "l": 89.58139199999994,
        "t": 210.7245479999999,
        "r": 483.34202399999947,
        "b": 201.82912504918033
      },
      "content": "Remove the keypad as described in Section 7.2.12.2 , then remove the display."
    },
    {
      "type": "list_item",
      "id": "txt_1132",
      "reading_order": 1217,
      "section": "DISPLAY REPLACEMENT",
      "bbox": {
        "l": 89.58139199999994,
        "t": 195.30447600000002,
        "r": 487.99035599999957,
        "b": 186.40905304918033
      },
      "content": "Install the replacement display assembly in the exact reverse order of removal."
    },
    {
      "type": "list_item",
      "id": "txt_1133",
      "reading_order": 1218,
      "section": "DISPLAY REPLACEMENT",
      "bbox": {
        "l": 89.58139199999997,
        "t": 179.8844039999999,
        "r": 330.484908,
        "b": 170.98898104918032
      },
      "content": "Reassemble the keypad and display assembly."
    },
    {
      "type": "list_item",
      "id": "txt_1134",
      "reading_order": 1219,
      "section": "DISPLAY REPLACEMENT",
      "bbox": {
        "l": 89.58139199999997,
        "t": 164.40457199999992,
        "r": 504.02595599999927,
        "b": 144.10893304918034
      },
      "content": "Join the front enclosure, rear enclosure, and main chassis assembly in the exact reverse order of separation."
    },
    {
      "type": "list_item",
      "id": "txt_1135",
      "reading_order": 1220,
      "section": "DISPLAY REPLACEMENT",
      "bbox": {
        "l": 89.58039599999995,
        "t": 137.52452399999993,
        "r": 384.51890399999945,
        "b": 128.62910104918035
      },
      "content": "Reinstall the battery and connect the device to AC power."
    },
    {
      "type": "paragraph",
      "id": "txt_1136",
      "reading_order": 1221,
      "section": "DISPLAY REPLACEMENT",
      "bbox": {
        "l": 71.99999999999994,
        "t": 114.12450000000001,
        "r": 426.78715200000005,
        "b": 105.22907704918032
      },
      "content": "To verify successful display replacement, perform the PVT in Section 5.2 ."
    }
  ]
}