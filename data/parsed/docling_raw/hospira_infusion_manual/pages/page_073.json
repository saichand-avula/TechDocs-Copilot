  "blocks": [
    {
      "type": "heading",
      "id": "txt_0707",
      "reading_order": 760,
      "section": "5.2.17 ELECTRICAL SAFETY TEST",
      "bbox": {
        "l": 108.0,
        "t": 738.19196,
        "r": 322.12907016599985,
        "b": 709.2828958877272
      },
      "content": "5.2.17 ELECTRICAL SAFETY TEST",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0708",
      "reading_order": 761,
      "section": "5.2.17 ELECTRICAL SAFETY TEST",
      "bbox": {
        "l": 108.0,
        "t": 695.10277681,
        "r": 378.4006262862999,
        "b": 686.2073449280329
      },
      "content": "To perform the electrical safety test, proceed as follows:"
    },
    {
      "type": "list_item",
      "id": "txt_0709",
      "reading_order": 762,
      "section": "5.2.17 ELECTRICAL SAFETY TEST",
      "bbox": {
        "l": 125.57941764999998,
        "t": 671.1030371139,
        "r": 374.70317177399954,
        "b": 662.2076052319328
      },
      "content": "Connect the AC power cord to a safety analyzer."
    },
    {
      "type": "list_item",
      "id": "txt_0710",
      "reading_order": 763,
      "section": "5.2.17 ELECTRICAL SAFETY TEST",
      "bbox": {
        "l": 125.57941764999998,
        "t": 655.6829496319,
        "r": 539.8833640174007,
        "b": 635.3275302439329
      },
      "content": "Connect the safety analyzer ground lead to the ground test-point located on the rear of the infuser."
    },
    {
      "type": "list_item",
      "id": "txt_0711",
      "reading_order": 764,
      "section": "5.2.17 ELECTRICAL SAFETY TEST",
      "bbox": {
        "l": 125.57832204889996,
        "t": 628.8028746439,
        "r": 539.8579659919005,
        "b": 608.4473949280328
      },
      "content": "Check the leakage current with the safety analyzer. Leakage current (both open and closed ground) must not exceed 100 microamperes AC rms ."
    },
    {
      "type": "list_item",
      "id": "txt_0712",
      "reading_order": 765,
      "section": "5.2.17 ELECTRICAL SAFETY TEST",
      "bbox": {
        "l": 125.58000866299994,
        "t": 601.922739328,
        "r": 540.0360443831006,
        "b": 580.761702082
      },
      "content": "Measure the resistance of the AC connector ground lug with the safety analyzer. Resistance should not exceed 0.1 Ω ."
    },
    {
      "type": "heading",
      "id": "txt_0713",
      "reading_order": 766,
      "section": "5.2.18 END OF THE PVT",
      "bbox": {
        "l": 108.0,
        "t": 559.09198,
        "r": 245.18155275330005,
        "b": 530.1830358877272
      },
      "content": "5.2.18 END OF THE PVT",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0714",
      "reading_order": 767,
      "section": "5.2.18 END OF THE PVT",
      "bbox": {
        "l": 108.0,
        "t": 520.02287681,
        "r": 482.33920704220066,
        "b": 511.12744492803273
      },
      "content": "If all performance verification tests have been successful, proceed as follows:"
    },
    {
      "type": "list_item",
      "id": "txt_0715",
      "reading_order": 768,
      "section": "5.2.18 END OF THE PVT",
      "bbox": {
        "l": 125.57931804989997,
        "t": 496.02313711389996,
        "r": 497.60063156490025,
        "b": 487.12770523193274
      },
      "content": "Press [OPTIONS/VOL INF]. Select Volume Infused and press [CHOOSE]."
    },
    {
      "type": "list_item",
      "id": "txt_0716",
      "reading_order": 769,
      "section": "5.2.18 END OF THE PVT",
      "bbox": {
        "l": 125.58041365099996,
        "t": 480.6030496319,
        "r": 349.36819313729995,
        "b": 471.70761774993275
      },
      "content": "Press [CLEAR] to clear the volume infused."
    },
    {
      "type": "list_item",
      "id": "txt_0717",
      "reading_order": 770,
      "section": "5.2.18 END OF THE PVT",
      "bbox": {
        "l": 125.58041365099996,
        "t": 465.1829621499,
        "r": 214.21354664000012,
        "b": 456.28753026793277
      },
      "content": "Press [ENTER]."
    },
    {
      "type": "list_item",
      "id": "txt_0718",
      "reading_order": 771,
      "section": "5.2.18 END OF THE PVT",
      "bbox": {
        "l": 125.58041365099996,
        "t": 449.7031146079,
        "r": 242.42059376029982,
        "b": 440.80768272593275
      },
      "content": "Press the [A] softkey."
    },
    {
      "type": "list_item",
      "id": "txt_0719",
      "reading_order": 772,
      "section": "5.2.18 END OF THE PVT",
      "bbox": {
        "l": 125.58041365099996,
        "t": 434.2830271259,
        "r": 412.5741177970006,
        "b": 425.38759524393276
      },
      "content": "Press [YES] at the 'CLEAR LINE A SETTINGS?' prompt."
    },
    {
      "type": "list_item",
      "id": "txt_0720",
      "reading_order": 773,
      "section": "5.2.18 END OF THE PVT",
      "bbox": {
        "l": 125.58041365099996,
        "t": 418.8629396439,
        "r": 466.6091640490001,
        "b": 409.9675077619328
      },
      "content": "Press the [CANCEL/BACK] softkey to return to the delivery screen."
    },
    {
      "type": "list_item",
      "id": "txt_0721",
      "reading_order": 774,
      "section": "5.2.18 END OF THE PVT",
      "bbox": {
        "l": 125.58041365099996,
        "t": 403.3830921019,
        "r": 243.01819436029982,
        "b": 394.48766021993276
      },
      "content": "Press the [B] softkey."
    },
    {
      "type": "list_item",
      "id": "txt_0722",
      "reading_order": 775,
      "section": "5.2.18 END OF THE PVT",
      "bbox": {
        "l": 125.58041365099996,
        "t": 387.9630046199,
        "r": 413.1717183970006,
        "b": 379.0675727379328
      },
      "content": "Press [YES] at the 'CLEAR LINE B SETTINGS?' prompt."
    },
    {
      "type": "list_item",
      "id": "txt_0723",
      "reading_order": 776,
      "section": "5.2.18 END OF THE PVT",
      "bbox": {
        "l": 125.58041365099996,
        "t": 372.5429171379,
        "r": 366.0608710970006,
        "b": 363.6474852559328
      },
      "content": "Reset the infuser to the original configuration."
    },
    {
      "type": "list_item",
      "id": "txt_0724",
      "reading_order": 777,
      "section": "5.2.18 END OF THE PVT",
      "bbox": {
        "l": 119.40022744599996,
        "t": 357.0630695959,
        "r": 399.6194315903005,
        "b": 348.1676377139328
      },
      "content": "Turn off the infuser, and return the device to service."
    },
    {
      "type": "paragraph",
      "id": "txt_0725",
      "reading_order": 778,
      "section": "5.2.18 END OF THE PVT",
      "bbox": {
        "l": 108.0,
        "t": 344.39999,
        "r": 399.4282701261,
        "b": 327.4073249280328
      },
      "content": " Note: If any tests fail, see Section 6 , or contact Hospira."
    },
    {
      "type": "heading",
      "id": "txt_0726",
      "reading_order": 779,
      "section": "5.3 PERIODIC MAINTENANCE INSPECTION",
      "bbox": {
        "l": 108.0,
        "t": 304.38884681,
        "r": 511.0305659999999,
        "b": 266.90101446280994
      },
      "content": "5.3 PERIODIC MAINTENANCE INSPECTION",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0727",
      "reading_order": 780,
      "section": "5.3 PERIODIC MAINTENANCE INSPECTION",
      "bbox": {
        "l": 107.99999999999994,
        "t": 253.44275681,
        "r": 540.0461105808006,
        "b": 208.54786478403275
      },
      "content": "Periodic  maintenance  inspections  should  be  performed  per  hospital  procedures  for compliance to accreditation requirements. It is recommended that JCAHO and/or hospital protocol be followed for establishing a periodic maintenance inspection schedule. Product specifications for this inspection are listed in Section 8 ."
    },
    {
      "type": "paragraph",
      "id": "txt_0728",
      "reading_order": 781,
      "section": "5.3 PERIODIC MAINTENANCE INSPECTION",
      "bbox": {
        "l": 107.99999999999994,
        "t": 193.4435569699,
        "r": 505.3873673828999,
        "b": 184.54812508793282
      },
      "content": "To perform the periodic maintenance inspection, complete the PVT in Section 5.2 ."
    }
  ]
}