    },
    {
      "type": "heading",
      "id": "txt_0915",
      "reading_order": 1055,
      "section": "WARNING:",
      "bbox": {
        "l": 144.0,
        "t": 183.65086999999994,
        "r": 197.11,
        "b": 172.41086999999993
      },
      "content": "WARNING:",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_0916",
      "reading_order": 1056,
      "section": "WARNING:",
      "bbox": {
        "l": 153.00002,
        "t": 169.92314999999996,
        "r": 532.4500000000003,
        "b": 134.68314999999996
      },
      "content": "Always disconnect and lock out power to the driver before you perform any installation or maintenance tasks. Failure to disconnect and lock out driver power will result in serious physical injury."
    },
    {
      "type": "list_item",
      "id": "txt_0917",
      "reading_order": 1057,
      "section": "WARNING:",
      "bbox": {
        "l": 153.00004,
        "t": 132.19543,
        "r": 552.9800400000005,
        "b": 96.95542999999998
      },
      "content": "Follow shaft alignment procedures in order to prevent catastrophic failure of  drive components or unintended contact of rotating parts. Follow the coupling installation and operation procedures from the coupling manufacturer."
    },
    {
      "type": "paragraph",
      "id": "txt_0918",
      "reading_order": 1058,
      "section": "WARNING:",
      "bbox": {
        "l": 143.99996,
        "t": 83.19542000000001,
        "r": 536.3799800000002,
        "b": 59.955420000000004
      },
      "content": "You must check the final alignment after the pump and driver are at operating temperature. For initial alignment instructions, see the Installation chapter."
    }
  ]
}