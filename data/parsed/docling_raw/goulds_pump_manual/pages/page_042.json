    {
      "type": "heading",
      "id": "txt_0581",
      "reading_order": 669,
      "section": "Precautions",
      "bbox": {
        "l": 54.0,
        "t": 472.64184,
        "r": 104.22,
        "b": 461.40184
      },
      "content": "Precautions",
      "level": 2
    },
    {
      "type": "heading",
      "id": "txt_0582",
      "reading_order": 670,
      "section": "WARNING:",
      "bbox": {
        "l": 144.0,
        "t": 638.64184,
        "r": 197.11,
        "b": 627.40184
      },
      "content": "WARNING:",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_0583",
      "reading_order": 671,
      "section": "WARNING:",
      "bbox": {
        "l": 153.00002,
        "t": 624.8418399999999,
        "r": 542.9100200000003,
        "b": 601.60184
      },
      "content": "Failure to follow these precautions before you start the unit will lead to serious personal injury and equipment failure."
    },
    {
      "type": "list_item",
      "id": "txt_0584",
      "reading_order": 672,
      "section": "WARNING:",
      "bbox": {
        "l": 153.0,
        "t": 599.04184,
        "r": 554.2499600000003,
        "b": 563.80184
      },
      "content": "Do not operate the pump below the minimum rated flows or with the suction or discharge valves closed. These conditions can create an explosive hazard due to vaporization of  pumped fluid and can quickly lead to pump failure and physical injury."
    },
    {
      "type": "list_item",
      "id": "txt_0585",
      "reading_order": 673,
      "section": "WARNING:",
      "bbox": {
        "l": 152.99998,
        "t": 561.2418399999999,
        "r": 437.3799800000001,
        "b": 550.0018399999999
      },
      "content": "Never operate the pump without the coupling guard correctly installed."
    },
    {
      "type": "list_item",
      "id": "txt_0586",
      "reading_order": 674,
      "section": "WARNING:",
      "bbox": {
        "l": 152.99998,
        "t": 547.44184,
        "r": 532.4499600000003,
        "b": 512.20184
      },
      "content": "Always disconnect and lock out power to the driver before you perform any installation or maintenance tasks. Failure to disconnect and lock out driver power will result in serious physical injury."
    },
    {
      "type": "list_item",
      "id": "txt_0587",
      "reading_order": 675,
      "section": "WARNING:",
      "bbox": {
        "l": 152.99998999999997,
        "t": 509.64183999999995,
        "r": 549.7999900000004,
        "b": 486.40183999999994
      },
      "content": "Operating the pump in reverse rotation can result in the contact of  metal parts, heat generation, and breach of containment."
    },
    {
      "type": "heading",
      "id": "txt_0588",
      "reading_order": 676,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.0,
        "t": 453.64184,
        "r": 187.45,
        "b": 442.40184
      },
      "content": "NOTICE:",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_0589",
      "reading_order": 677,
      "section": "NOTICE:",
      "bbox": {
        "l": 153.00002,
        "t": 439.84185,
        "r": 363.1800199999999,
        "b": 428.60185
      },
      "content": "Verify the driver settings before you start any pump."
    },
    {
      "type": "list_item",
      "id": "txt_0590",
      "reading_order": 678,
      "section": "NOTICE:",
      "bbox": {
        "l": 153.00002,
        "t": 426.04186000000004,
        "r": 453.4700200000001,
        "b": 414.80186000000003
      },
      "content": "Make sure that the warm-up rate does not exceed 2.5°F (1.4°C) per minute."
    },
    {
      "type": "list_item",
      "id": "txt_0591",
      "reading_order": 679,
      "section": "NOTICE:",
      "bbox": {
        "l": 153.0,
        "t": 412.24187000000006,
        "r": 538.9900000000004,
        "b": 377.00187000000005
      },
      "content": "Risk of  damage to the mechanical seal or shaft sleeve on units supplied with cartridge mechanical seals. Prior to startup, make sure to tighten the set screws in the seal locking ring and remove the centering clips."
    },
    {
      "type": "paragraph",
      "id": "txt_0592",
      "reading_order": 680,
      "section": "NOTICE:",
      "bbox": {
        "l": 143.99995,
        "t": 366.72188,
        "r": 384.1799499999999,
        "b": 355.48188
      },
      "content": "You must follow these precautions before you start the pump:"
    },
    {
      "type": "list_item",
      "id": "txt_0593",
      "reading_order": 681,
      "section": "NOTICE:",
      "bbox": {
        "l": 152.99997,
        "t": 351.72188,
        "r": 554.1899700000004,
        "b": 328.48188
      },
      "content": "Flush and clean the system thoroughly to remove dirt or debris in the pipe system in order to prevent premature failure at initial startup."
    },
    {
      "type": "list_item",
      "id": "txt_0594",
      "reading_order": 682,
      "section": "NOTICE:",
      "bbox": {
        "l": 152.99997,
        "t": 325.92189,
        "r": 427.33997,
        "b": 314.68189
      },
      "content": "Bring variable-speed drivers to the rated speed as quickly as possible."
    },
    {
      "type": "list_item",
      "id": "txt_0595",
      "reading_order": 683,
      "section": "NOTICE:",
      "bbox": {
        "l": 152.99997,
        "t": 312.12190000000004,
        "r": 550.2899700000005,
        "b": 288.88190000000003
      },
      "content": "Run a new or rebuilt pump at a speed that provides enough flow to flush and cool the close-running surfaces of  the stuffing-box bushing."
    },
    {
      "type": "list_item",
      "id": "txt_0596",
      "reading_order": 684,
      "section": "NOTICE:",
      "bbox": {
        "l": 153.0,
        "t": 286.32191000000006,
        "r": 551.1899700000004,
        "b": 251.0819100000001
      },
      "content": "If  temperatures of  the pumped fluid will exceed 200°F (93°C), then warm up the pump prior to operation. Circulate a small amount of  fluid through the pump until the casing temperature is within 100°F (38°C) of the fluid temperature."
    },
    {
      "type": "paragraph",
      "id": "txt_0597",
      "reading_order": 685,
      "section": "NOTICE:",
      "bbox": {
        "l": 143.99996999999996,
        "t": 247.8019200000001,
        "r": 554.6100100000006,
        "b": 212.5619200000001
      },
      "content": "At initial startup, do not adjust the variable-speed drivers or check for speed governor or over-speed trip settings while the variable-speed driver is coupled to the pump. If  the settings have not been verified, then uncouple the unit and refer to instructions supplied by the driver manufacturer."
    },
    {
      "type": "heading",
      "id": "txt_0598",
      "reading_order": 686,
      "section": "Remove the coupling guard",
      "bbox": {
        "l": 54.00393999999997,
        "t": 194.4307100000001,
        "r": 264.70794,
        "b": 176.5747100000001
      },
      "content": "Remove the coupling guard",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_0599",
      "reading_order": 687,
      "section": "Remove the coupling guard",
      "bbox": {
        "l": 143.99793999999997,
        "t": 166.8019200000001,
        "r": 519.8779400000004,
        "b": 155.5619200000001
      },
      "content": "Remove the nut, bolt, and washers from the slotted hole in the center of  the coupling guard."
    },
    {
      "type": "list_item",
      "id": "txt_0600",
      "reading_order": 688,
      "section": "Remove the coupling guard",
      "bbox": {
        "l": 143.99797999999998,
        "t": 153.00193000000013,
        "r": 396.80797999999993,
        "b": 141.76193000000012
      },
      "content": "Slide the driver half  of  the coupling guard toward the pump."
    }
  ]
}