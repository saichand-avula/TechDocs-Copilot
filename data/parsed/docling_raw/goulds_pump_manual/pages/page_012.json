    },
    {
      "type": "table",
      "id": "tbl_0006",
      "reading_order": 216,
      "section": "Table 1: Methods",
      "bbox": {
        "l": 142.93202209472656,
        "t": 148.69903564453125,
        "r": 558.5339965820312,
        "b": 65.43157958984375
      },
      "markdown": "| Pump type                           | Lifting method                                                                                      |\n|-------------------------------------|-----------------------------------------------------------------------------------------------------|\n| A bare pump without lifting handles | Use a suitable sling attached properly to solid points like the casing, the flanges, or the frames. |\n| A bare pump with lifting handles    | Lift the pump by the handles.                                                                       |\n| A base-mounted pump                 | Use slings under the pump casing and the drive unit, or under the base rails.                       |"
    }
  ]
