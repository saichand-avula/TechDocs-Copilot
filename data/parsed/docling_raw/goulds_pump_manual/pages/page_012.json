        "r": 412.3640000000001,
        "b": 643.88184
      },
      "content": "Inspect the package for damaged or missing items upon delivery."
    },
    {
      "type": "list_item",
      "id": "txt_0178",
      "reading_order": 195,
      "section": "Inspect the package",
      "bbox": {
        "l": 144.00402000000003,
        "t": 641.32184,
        "r": 418.0840200000003,
        "b": 630.0818399999999
      },
      "content": "Note any damaged or missing items on the receipt and freight bill."
    },
    {
      "type": "list_item",
      "id": "txt_0179",
      "reading_order": 196,
      "section": "Inspect the package",
      "bbox": {
        "l": 144.00402000000003,
        "t": 627.52184,
        "r": 509.3739800000002,
        "b": 601.76184
      },
      "content": "File a claim with the shipping company if  anything is out of  order. If  the product has been picked up at a distributor, make a claim directly to the distributor."
    },
    {
      "type": "heading",
      "id": "txt_0180",
      "reading_order": 197,
      "section": "Inspect the unit",
      "bbox": {
        "l": 53.99601000000001,
        "t": 593.5968,
        "r": 157.45601000000002,
        "b": 577.9728
      },
      "content": "Inspect the unit",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_0181",
      "reading_order": 198,
      "section": "Inspect the unit",
      "bbox": {
        "l": 143.99601,
        "t": 574.68183,
        "r": 428.3959900000002,
        "b": 548.92183
      },
      "content": "Remove packing materials from the product. Dispose of all packing materials in accordance with local regulations."
    },
    {
      "type": "list_item",
      "id": "txt_0182",
      "reading_order": 199,
      "section": "Inspect the unit",
      "bbox": {
        "l": 143.99599,
        "t": 546.3618299999999,
        "r": 474.30599,
        "b": 535.1218299999999
      },
      "content": "Inspect the product to determine if  any parts have been damaged or are missing."
    },
    {
      "type": "list_item",
      "id": "txt_0183",
      "reading_order": 200,
      "section": "Inspect the unit",
      "bbox": {
        "l": 143.99601,
        "t": 532.5618299999999,
        "r": 454.72601,
        "b": 506.80182999999994
      },
      "content": "If  applicable, unfasten the product by removing any screws, bolts, or straps. For your personal safety, be careful when you handle nails and straps."
    },
    {
      "type": "list_item",
      "id": "txt_0184",
      "reading_order": 201,
      "section": "Inspect the unit",
      "bbox": {
        "l": 143.99601,
        "t": 504.24182999999994,
        "r": 395.4660100000001,
        "b": 493.0018299999999
      },
      "content": "Contact your sales representative if  anything is out of  order."
    },
