    {
      "type": "heading",
      "id": "txt_0726",
      "reading_order": 842,
      "section": "WARNING:",
      "bbox": {
        "l": 144.0,
        "t": 399.95736,
        "r": 197.11,
        "b": 388.71736
      },
      "content": "WARNING:",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0727",
      "reading_order": 843,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00002,
        "t": 385.43737,
        "r": 548.7700200000002,
        "b": 362.19737
      },
      "content": "Make sure to properly lubricate the bearings. Failure to do so can result in excess heat generation, sparks, and premature failure."
    },
    {
      "type": "paragraph",
      "id": "txt_0728",
      "reading_order": 844,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00004,
        "t": 338.3019,
        "r": 546.9200500000004,
        "b": 315.0619
      },
      "content": "NOTICE: Be certain to check the greasing on a pump that has been out of  service for a long period of time and re-grease if  necessary."
    },
    {
      "type": "paragraph",
      "id": "txt_0729",
      "reading_order": 845,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00006000000002,
        "t": 304.78191,
        "r": 485.2900600000003,
        "b": 293.54191
      },
      "content": "Pumps are shipped without oil. You must lubricate oil-lubricated bearings at the job site."
    },
    {
      "type": "paragraph",
      "id": "txt_0730",
      "reading_order": 846,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00004,
        "t": 289.78191,
        "r": 357.2300400000001,
        "b": 278.5419099999999
      },
      "content": "Grease-lubricated bearings are lubricated at the factory."
    },
    {
      "type": "paragraph",
      "id": "txt_0731",
      "reading_order": 847,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00004,
        "t": 274.7819099999999,
        "r": 548.8500400000005,
        "b": 251.54190999999992
      },
      "content": "The bearing manufacturer fills greased-for-life bearings with grease and seals them at the factory. You do not need to lubricate or seal these bearings."
    },
    {
