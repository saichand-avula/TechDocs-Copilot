    },
    {
      "type": "heading",
      "id": "txt_0312",
      "reading_order": 363,
      "section": "Figure 8: Side view",
      "bbox": {
        "l": 161.99901,
        "t": 303.34975,
        "r": 243.53001,
        "b": 293.30575
      },
      "content": "Figure 8: Side view",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_0313",
      "reading_order": 364,
      "section": "Figure 8: Side view",
      "bbox": {
        "l": 144.00001,
        "t": 290.66982,
        "r": 378.76001,
        "b": 279.42982000000006
      },
      "content": "Lower the baseplate carefully onto the foundation bolts."
    },
    {
      "type": "list_item",
      "id": "txt_0314",
      "reading_order": 365,
      "section": "Figure 8: Side view",
      "bbox": {
        "l": 144.00001,
        "t": 277.30028000000004,
        "r": 557.8200100000004,
        "b": 266.06028000000003
      },
      "content": "Put the machinist's levels across the mounting pads of  the driver and the mounting pads of  the pump."
    },
    {
      "type": "paragraph",
      "id": "txt_0315",
      "reading_order": 366,
      "section": "Figure 8: Side view",
      "bbox": {
        "l": 161.99997000000002,
        "t": 255.78029000000004,
        "r": 528.7699800000003,
        "b": 232.54029000000003
      },
      "content": "NOTICE: Remove all dirt from the mounting pads in order to make sure that you achieve the correct leveling. Failure to do so can result in equipment damage or decreased performance."
    },
    {
      "type": "list_item",
      "id": "txt_0316",
      "reading_order": 367,
      "section": "Figure 8: Side view",
      "bbox": {
        "l": 143.99996,
        "t": 223.41075999999998,
        "r": 547.8299600000003,
        "b": 212.17075999999997
      },
      "content": "Level the baseplate both lengthwise and across by adding or removing shims or moving the wedges."
    },
    {
      "type": "list_item",
      "id": "txt_0317",
      "reading_order": 368,
      "section": "Figure 8: Side view",
      "bbox": {
        "l": 161.99992,
        "t": 208.89073999999994,
        "r": 289.5799199999999,
        "b": 197.65073999999993
      },
      "content": "These are the leveling tolerances:"
    },
    {
      "type": "list_item",
      "id": "txt_0318",
      "reading_order": 369,
      "section": "Figure 8: Side view",
      "bbox": {
        "l": 170.9999,
        "t": 194.60820999999999,
        "r": 398.2999000000001,
        "b": 183.36820999999998
      },
      "content": "A maximum difference of 0.125 in. (3.2 mm) lengthwise"
    },
    {
      "type": "list_item",
      "id": "txt_0319",
      "reading_order": 370,
      "section": "Figure 8: Side view",
      "bbox": {
        "l": 170.9999,
        "t": 181.2387,
        "r": 381.4198999999999,
        "b": 169.99869999999999
      },
      "content": "A maximum difference of 0.059 in. (1.5 mm) across"
    },
    {
      "type": "paragraph",
      "id": "txt_0320",
      "reading_order": 371,
      "section": "Figure 8: Side view",
      "bbox": {
        "l": 161.99988,
        "t": 166.95617000000004,
        "r": 445.5898800000001,
        "b": 155.71617000000003
      },
      "content": "You can use the baseplate-leveling worksheet when you take the readings."
    },
    {
      "type": "list_item",
      "id": "txt_0321",
      "reading_order": 372,
      "section": "Figure 8: Side view",
      "bbox": {
        "l": 143.99988,
        "t": 153.58666000000005,
        "r": 323.8398799999999,
        "b": 142.34666000000004
      },
      "content": "Hand-tighten the nuts for the foundation."
    },
