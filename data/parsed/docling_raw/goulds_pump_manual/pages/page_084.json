      "bbox": {
        "l": 144.00191999999998,
        "t": 521.68999,
        "r": 418.1419200000001,
        "b": 510.44998999999996
      },
      "content": "Remove the clamp screws (370C) and back off the jam nuts (423)."
    },
    {
      "type": "list_item",
      "id": "txt_1237",
      "reading_order": 1431,
      "section": "Disassemble the power end ( XLT-i and i17 )",
      "bbox": {
        "l": 144.00191999999998,
        "t": 507.88998999999995,
        "r": 543.5319200000004,
        "b": 484.65000999999995
      },
      "content": "Tighten the jack screws (370D) evenly to move the bearing housing (134) out of  the bearing frame (228A)."
    },
    {
      "type": "list_item",
      "id": "txt_1238",
      "reading_order": 1432,
      "section": "Disassemble the power end ( XLT-i and i17 )",
      "bbox": {
        "l": 144.00191,
        "t": 482.09002,
        "r": 390.93190999999996,
        "b": 470.85002
      },
      "content": "Remove the shaft assembly from the bearing frame (228A)."
    },
    {
      "type": "list_item",
      "id": "txt_1239",
      "reading_order": 1433,
      "section": "Disassemble the power end ( XLT-i and i17 )",
      "bbox": {
        "l": 144.00191,
        "t": 468.29003,
        "r": 470.35191000000015,
        "b": 457.05003
      },
      "content": "Remove the jack screws (370D), the nuts (423), and the bearing housing O-ring."
    },
    {
      "type": "list_item",
      "id": "txt_1240",
      "reading_order": 1434,
      "section": "Disassemble the power end ( XLT-i and i17 )",
      "bbox": {
        "l": 144.00189,
        "t": 454.49004,
        "r": 303.0918899999999,
        "b": 443.25004
      },
      "content": "Remove the inboard bearing (168A)."
    },
    {
      "type": "list_item",
      "id": "txt_1241",
      "reading_order": 1435,
      "section": "Disassemble the power end ( XLT-i and i17 )",
      "bbox": {
        "l": 144.00459999999998,
        "t": 288.32592,
        "r": 467.05460000000005,
        "b": 277.08592
      },
      "content": "Remove the bolts (371C), the bearing end cover (109A), and the gasket (360C)."
    },
    {
      "type": "list_item",
      "id": "txt_1242",
      "reading_order": 1436,
      "section": "Disassemble the power end ( XLT-i and i17 )",
      "bbox": {
        "l": 144.00459999999998,
        "t": 274.52593,
        "r": 449.31460000000004,
        "b": 263.28593
      },
      "content": "Remove the outboard labyrinth oil seal (332A) from the end cover (109A)."
    },
    {
      "type": "list_item",
      "id": "txt_1243",
      "reading_order": 1437,
      "section": "Disassemble the power end ( XLT-i and i17 )",
      "bbox": {
        "l": 144.00455,
        "t": 260.72594000000004,
        "r": 521.0146000000002,
        "b": 234.96595000000002
      },
      "content": "Remove the O-rings (497F and 497G) if it is necessary. Labyrinth oil-seal O-rings are part of  the 3196 maintenance kits, and they are sold separately."
    },
    {
      "type": "list_item",
      "id": "txt_1244",
      "reading_order": 1438,
      "section": "Disassemble the power end ( XLT-i and i17 )",
      "bbox": {
        "l": 143.99799000000002,
        "t": 80.04179999999997,
        "r": 468.9479900000001,
        "b": 68.80179999999996
      },
      "content": "Remove the bearing housing (134) and the bearing (112A) from the shaft (122)."
    },
