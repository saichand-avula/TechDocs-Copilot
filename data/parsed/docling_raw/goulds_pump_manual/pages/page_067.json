    {
      "type": "heading",
      "id": "txt_1026",
      "reading_order": 1178,
      "section": "WARNING:",
      "bbox": {
        "l": 144.0,
        "t": 437.48183,
        "r": 197.11,
        "b": 426.24183
      },
      "content": "WARNING:",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1027",
      "reading_order": 1179,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00002,
        "t": 422.96184,
        "r": 403.4000200000001,
        "b": 411.72184
      },
      "content": "Dynamic seals are not allowed in an ATEX-classified environment."
    },
    {
      "type": "heading",
      "id": "txt_1028",
      "reading_order": 1180,
      "section": "About the dynamic seal",
      "bbox": {
        "l": 54.0,
        "t": 382.82638,
        "r": 153.49,
        "b": 371.58637999999996
      },
      "content": "About the dynamic seal",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1029",
      "reading_order": 1181,
      "section": "About the dynamic seal",
      "bbox": {
        "l": 144.0,
        "t": 368.30638999999996,
        "r": 557.6000000000004,
        "b": 345.06638999999996
      },
      "content": "Dynamic seal parts do not wear substantially to affect operation and do not require maintenance unless the service is particularly abrasive or corrosive."
    },
    {
      "type": "heading",
      "id": "txt_1030",
      "reading_order": 1182,
      "section": "Repeller",
      "bbox": {
        "l": 53.999979999999994,
        "t": 338.30638999999996,
        "r": 89.10998,
        "b": 327.06638999999996
      },
      "content": "Repeller",
      "level": 2
    },
    {
      "type": "heading",
      "id": "txt_1031",
      "reading_order": 1183,
      "section": "Static seal",
      "bbox": {
        "l": 53.99993999999998,
        "t": 293.78639999999996,
        "r": 96.39993999999999,
        "b": 282.54639999999995
      },
      "content": "Static seal",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1032",
      "reading_order": 1184,
      "section": "Static seal",
      "bbox": {
        "l": 143.99996,
        "t": 323.78639999999996,
        "r": 542.0599800000002,
        "b": 300.54639999999995
      },
      "content": "The dynamic repeller prevents pumpage leaks through the stuffing box when the pump operates under published acceptable conditions."
    },
    {
      "type": "paragraph",
      "id": "txt_1033",
      "reading_order": 1185,
      "section": "Static seal",
      "bbox": {
        "l": 143.99994999999998,
        "t": 279.26640999999995,
        "r": 522.7499500000004,
        "b": 268.02640999999994
      },
      "content": "A static seal prevents leakage when the pump is shut down. A static seal is either of  the following:"
    },
    {
      "type": "list_item",
      "id": "txt_1034",
      "reading_order": 1186,
      "section": "Static seal",
      "bbox": {
        "l": 152.99992999999998,
        "t": 264.26640999999995,
        "r": 194.90992999999997,
        "b": 253.02640999999994
      },
      "content": "a lip seal"
    },
    {
      "type": "list_item",
      "id": "txt_1035",
      "reading_order": 1187,
      "section": "Static seal",
      "bbox": {
        "l": 152.99992999999998,
        "t": 250.46641999999997,
        "r": 252.9499299999999,
        "b": 239.22641999999996
      },
      "content": "an elastomeric-face seal"
    },
    {
      "type": "list_item",
      "id": "txt_1036",
      "reading_order": 1188,
      "section": "Static seal",
      "bbox": {
        "l": 152.99992999999998,
        "t": 236.66643,
        "r": 225.9599299999999,
        "b": 225.42642999999998
      },
      "content": "graphite packing"
    },
    {
      "type": "paragraph",
      "id": "txt_1037",
      "reading_order": 1189,
      "section": "Static seal",
      "bbox": {
        "l": 143.99988999999997,
        "t": 222.14640999999995,
        "r": 546.2099100000003,
        "b": 198.90640999999994
      },
      "content": "The only maintenance that the lip seal and the elastomeric-face seal require is replacement when leakage becomes excessive."
    },
    {
      "type": "paragraph",
      "id": "txt_1038",
      "reading_order": 1190,
      "section": "Static seal",
      "bbox": {
        "l": 143.99986999999996,
        "t": 195.14640999999995,
        "r": 497.88987000000014,
        "b": 183.90640999999994
      },
      "content": "The graphite packing should be installed as stuffing-box packing and is designed to run dry."
    }
  ]
}