    {
      "type": "list_item",
      "id": "txt_1093",
      "reading_order": 1250,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.0,
        "t": 743.64184,
        "r": 311.98999999999995,
        "b": 732.40184
      },
      "content": "Does your pump use a C-face adapter?"
    },
    {
      "type": "list_item",
      "id": "txt_1094",
      "reading_order": 1251,
      "section": "NOTICE:",
      "bbox": {
        "l": 161.99999,
        "t": 731.95476,
        "r": 555.6799900000002,
        "b": 710.71476
      },
      "content": "If  Yes: Place one sling from the hoist through the frame adapter (108) or frame (228A) for the  STi and a second sling from the hoist through the C-face adapter."
    },
    {
      "type": "list_item",
      "id": "txt_1095",
      "reading_order": 1252,
      "section": "NOTICE:",
      "bbox": {
        "l": 162.00004,
        "t": 711.2676799999999,
        "r": 544.8800400000002,
        "b": 690.0276799999999
      },
      "content": "If  No: Place a sling from the hoist through the frame adapter (108) or the frame (228A) for the STi."
    },
    {
      "type": "list_item",
      "id": "txt_1096",
      "reading_order": 1253,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.0,
        "t": 266.18233,
        "r": 378.53,
        "b": 254.94232999999997
      },
      "content": "Remove the hold-down bolts of the bearing frame foot."
    },
    {
      "type": "list_item",
      "id": "txt_1097",
      "reading_order": 1254,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.0,
        "t": 253.3578399999999,
        "r": 258.1799999999999,
        "b": 242.1178399999999
      },
      "content": "Remove the casing bolts."
    },
    {
      "type": "figure",
      "id": "fig_0104",
      "reading_order": 1255,
      "section": "NOTICE:",
      "bbox": {
        "l": 169.90760803222656,
        "t": 677.8790969848633,
        "r": 362.35687255859375,
        "b": 274.93975830078125
      },
      "image_path": "figures/figure_0104.png",
      "previous_block_id": "txt_1097",
      "next_block_id": "txt_1098"
    },
    {
      "type": "heading",
      "id": "txt_1098",
      "reading_order": 1256,
      "section": "WARNING:",
      "bbox": {
        "l": 144.0,
        "t": 228.35784,
        "r": 197.11,
        "b": 217.11784
      },
      "content": "WARNING:",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_1099",
      "reading_order": 1257,
      "section": "WARNING:",
      "bbox": {
        "l": 171.00002,
        "t": 215.53337999999997,
        "r": 538.9400200000002,
        "b": 204.29337999999996
      },
      "content": "Never use heat to disassemble the pump due to the risk of  an explosion from trapped liquid."
    },
    {
      "type": "list_item",
      "id": "txt_1100",
      "reading_order": 1258,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00004,
        "t": 178.87792000000002,
        "r": 532.2700400000003,
        "b": 155.63792
      },
      "content": "Tighten the jackscrews evenly, using an alternating pattern, in order to remove the back pull-out assembly."
    },
    {
      "type": "paragraph",
      "id": "txt_1101",
      "reading_order": 1259,
      "section": "WARNING:",
      "bbox": {
        "l": 162.00004,
        "t": 152.35789999999997,
        "r": 442.64004000000017,
        "b": 141.11789999999996
      },
      "content": "You can use penetrating oil if  the adapter to the casing joint is corroded."
    },
    {
      "type": "list_item",
      "id": "txt_1102",
      "reading_order": 1260,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00002999999998,
        "t": 139.53343999999993,
        "r": 386.37003000000004,
        "b": 128.29343999999992
      },
      "content": "Remove the back pull-out assembly from the casing (100)."
    },
    {
      "type": "list_item",
      "id": "txt_1103",
      "reading_order": 1261,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00005,
        "t": 124.18895999999995,
        "r": 493.5600500000002,
        "b": 112.94895999999994
      },
      "content": "Mark and remove the shims from under the frame foot and save them for reassembly."
    },
    {
      "type": "list_item",
      "id": "txt_1104",
      "reading_order": 1262,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00002999999998,
        "t": 111.36449999999991,
        "r": 309.8500299999999,
        "b": 100.1244999999999
      },
      "content": "Remove and discard the casing gasket."
    },
    {
      "type": "list_item",
      "id": "txt_1105",
      "reading_order": 1263,
      "section": "WARNING:",
      "bbox": {
        "l": 162.00001,
        "t": 96.84447999999986,
        "r": 369.6300099999999,
        "b": 85.60447999999985
      },
      "content": "You will insert a new casing gasket during reassembly."
    },
    {
      "type": "list_item",
      "id": "txt_1106",
      "reading_order": 1264,
      "section": "WARNING:",
      "bbox": {
        "l": 143.99999,
        "t": 84.02001999999982,
        "r": 253.23998999999992,
        "b": 72.78001999999981
      },
      "content": "Remove the jackscrews."
    },
    {
      "type": "list_item",
      "id": "txt_1107",
      "reading_order": 1265,
      "section": "WARNING:",
      "bbox": {
        "l": 143.99999,
        "t": 71.19555999999977,
        "r": 257.1199899999999,
        "b": 59.955559999999764
      },
      "content": "Clean all gasket surfaces."
    }
  ]
}