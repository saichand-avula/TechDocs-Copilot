      "section": "Warranty claim",
      "bbox": {
        "l": 143.99599999999998,
        "t": 485.57,
        "r": 449.2060000000001,
        "b": 474.33
      },
      "content": "ITT undertakes to remedy faults in products from ITT under these conditions:"
    },
    {
      "type": "list_item",
      "id": "txt_0156",
      "reading_order": 173,
      "section": "Warranty claim",
      "bbox": {
        "l": 152.99602,
        "t": 470.57,
        "r": 417.95601999999997,
        "b": 459.33
      },
      "content": "The faults are due to defects in design, materials, or workmanship."
    },
    {
      "type": "list_item",
      "id": "txt_0157",
      "reading_order": 174,
      "section": "Warranty claim",
      "bbox": {
        "l": 152.99602,
        "t": 456.77001,
        "r": 455.5060200000003,
        "b": 445.53001
      },
      "content": "The faults are reported to an ITT representative within the warranty period."
    },
    {
      "type": "list_item",
      "id": "txt_0158",
      "reading_order": 175,
      "section": "Warranty claim",
      "bbox": {
        "l": 152.99602,
        "t": 442.97002000000003,
        "r": 439.7260200000001,
        "b": 431.73002
      },
      "content": "The product is used only under the conditions described in this manual."
    },
    {
      "type": "list_item",
      "id": "txt_0159",
      "reading_order": 176,
      "section": "Warranty claim",
      "bbox": {
        "l": 152.99597999999997,
        "t": 429.17003000000005,
        "r": 508.15598000000034,
        "b": 417.93003000000004
      },
      "content": "The monitoring equipment incorporated in the product is correctly connected and in use."
    },
    {
      "type": "list_item",
      "id": "txt_0160",
      "reading_order": 177,
      "section": "Warranty claim",
      "bbox": {
        "l": 152.99597999999997,
        "t": 415.3700400000001,
        "r": 413.07598,
        "b": 404.13004000000006
      },
      "content": "All service and repair work is done by ITT-authorized personnel."
    },
