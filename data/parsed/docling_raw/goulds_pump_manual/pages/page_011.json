      "bbox": {
        "l": 152.99599999999998,
        "t": 387.7700600000001,
        "r": 549.7760000000001,
        "b": 376.5300600000001
      },
      "content": "Only Ex-approved spare parts and accessories authorized by ITT are used in Ex-approved products."
    },
