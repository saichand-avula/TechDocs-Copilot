      "bbox": {
        "l": 54.00199,
        "t": 715.64184,
        "r": 93.69199,
        "b": 704.40184
      },
      "content": "Checklist Check the bearing frame for these conditions:"
    },
    {
      "type": "list_item",
      "id": "txt_1333",
      "reading_order": 1546,
      "section": "Bearing-frame inspection",
      "bbox": {
        "l": 153.00197,
        "t": 686.12184,
        "r": 395.96196999999995,
        "b": 674.88184
      },
      "content": "Visually inspect the bearing frame and frame foot for cracks."
    },
    {
      "type": "list_item",
      "id": "txt_1334",
      "reading_order": 1547,
      "section": "Bearing-frame inspection",
      "bbox": {
        "l": 153.00197,
        "t": 672.32184,
        "r": 557.5219700000002,
        "b": 661.0818399999999
      },
      "content": "Check the inside surfaces of  the frame for rust, scale, or debris. Remove all loose and foreign material."
    },
    {
      "type": "list_item",
      "id": "txt_1335",
      "reading_order": 1548,
      "section": "Bearing-frame inspection",
      "bbox": {
        "l": 153.00195,
        "t": 658.52184,
        "r": 346.22194999999994,
        "b": 647.28184
      },
      "content": "Make sure that all lubrication passages are clear."
    },
    {
      "type": "list_item",
      "id": "txt_1336",
      "reading_order": 1549,
      "section": "Bearing-frame inspection",
      "bbox": {
        "l": 153.00195,
        "t": 644.7218399999999,
        "r": 511.93195000000037,
        "b": 633.48184
      },
      "content": "If  the frame has been exposed to pumped fluid, inspect the frame for corrosion or pitting."
    },
    {
      "type": "list_item",
      "id": "txt_1337",
      "reading_order": 1550,
      "section": "Bearing-frame inspection",
      "bbox": {
        "l": 153.00195,
        "t": 630.92184,
        "r": 295.1419499999999,
        "b": 619.68184
      },
      "content": "Inspect the inboard-bearing bores."
    },
    {
      "type": "list_item",
      "id": "txt_1338",
      "reading_order": 1551,
      "section": "Bearing-frame inspection",
      "bbox": {
        "l": 162.00195,
        "t": 616.40184,
        "r": 555.1819500000006,
        "b": 593.16184
      },
      "content": "If  any bores are outside the measurements in the Bearing fits and tolerances table, replace the bearing frame."
    },
    {
