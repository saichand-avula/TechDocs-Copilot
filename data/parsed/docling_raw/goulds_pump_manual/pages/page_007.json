      "bbox": {
        "l": 153.0,
        "t": 190.67998,
        "r": 219.28000000000003,
        "b": 179.43998
      },
      "content": "Cutting hazard"
    },
    {
      "type": "list_item",
      "id": "txt_0040",
      "reading_order": 51,
      "section": "Electrical Hazard:",
      "bbox": {
        "l": 153.0,
        "t": 176.87999000000002,
        "r": 225.61,
        "b": 165.63999
      },
      "content": "Arc flash hazard"
    },
    {
      "type": "paragraph",
      "id": "txt_0041",
      "reading_order": 52,
      "section": "Electrical Hazard:",
      "bbox": {
        "l": 143.99996,
        "t": 139.08000000000004,
        "r": 549.8699900000001,
        "b": 115.84000000000003
      },
      "content": "The Ex symbol indicates safety regulations for Ex-approved products when used in atmospheres that are potentially explosive or flammable."
