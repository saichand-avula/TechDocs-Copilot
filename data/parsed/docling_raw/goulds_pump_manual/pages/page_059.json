  "blocks": [
    {
      "type": "list_item",
      "id": "txt_0854",
      "reading_order": 985,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.0,
        "t": 743.64184,
        "r": 525.9900000000002,
        "b": 720.40184
      },
      "content": "If  the pump exceeds normal levels, then shut down the pump immediately and correct the problem."
    },
    {
      "type": "paragraph",
      "id": "txt_0855",
      "reading_order": 986,
      "section": "CAUTION:",
      "bbox": {
        "l": 176.16995,
        "t": 717.12184,
        "r": 553.0799500000003,
        "b": 693.88184
      },
      "content": "A pump can exceed normal levels for several reasons. See Troubleshooting for information about possible solutions to this problem."
    },
    {
      "type": "list_item",
      "id": "txt_0856",
      "reading_order": 987,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99996,
        "t": 691.32184,
        "r": 357.95995999999997,
        "b": 680.0818399999999
      },
      "content": "Repeat steps 5 and 6 until the pump runs properly."
    },
    {
      "type": "heading",
      "id": "txt_0857",
      "reading_order": 988,
      "section": "Activate the i-ALERT ™  Condition Monitor",
      "bbox": {
        "l": 54.00796,
        "t": 661.9506299999999,
        "r": 367.7893,
        "b": 644.0946299999999
      },
      "content": "Activate the i-ALERT ™  Condition Monitor",
      "level": 2
    },
