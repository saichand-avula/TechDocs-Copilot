    {
      "type": "heading",
      "id": "txt_0858",
      "reading_order": 991,
      "section": "WARNING:",
      "bbox": {
        "l": 144.0,
        "t": 630.32184,
        "r": 197.11,
        "b": 619.0818399999999
      },
      "content": "WARNING:",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0859",
      "reading_order": 992,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00002,
        "t": 615.80184,
        "r": 514.28002,
        "b": 592.56184
      },
      "content": "Never heat the condition monitor to temperatures in excess of  300°F (149°C). Heating to these temperatures could result in death or serious injury."
    },
    {
      "type": "heading",
      "id": "txt_0860",
      "reading_order": 993,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.00004,
        "t": 568.6663699999999,
        "r": 194.53003999999999,
        "b": 557.42637
      },
      "content": "CAUTION:",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0861",
      "reading_order": 994,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.00006000000002,
        "t": 554.1463699999999,
        "r": 440.4200600000003,
        "b": 542.9063699999999
      },
      "content": "Always wear protective gloves. The pump and condition monitor can be hot."
    },
    {
      "type": "heading",
      "id": "txt_0862",
      "reading_order": 995,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.00004,
        "t": 507.01092,
        "r": 187.45004,
        "b": 495.77092
      },
      "content": "NOTICE:",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0863",
      "reading_order": 996,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.00006000000002,
        "t": 492.4909,
        "r": 424.91006000000016,
        "b": 481.2509
      },
      "content": "Do not use the condition monitor in atmospheres containing acetic acid."
    },
    {
      "type": "paragraph",
      "id": "txt_0864",
      "reading_order": 997,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.00006000000002,
        "t": 467.4909,
        "r": 542.2500600000003,
        "b": 444.2509
      },
      "content": "The condition monitor is ready for activation when the pump is running and has reached a steady flow, pressure, and temperature. This process only takes a few minutes."
    },
    {
      "type": "paragraph",
      "id": "txt_0865",
      "reading_order": 998,
      "section": "NOTICE:",
      "bbox": {
        "l": 162.00004,
        "t": 440.4909,
        "r": 554.4900600000003,
        "b": 417.2509
      },
      "content": "Place a small magnet on the condition monitor over the ITT logo and then remove it, as this example shows."
    },
    {
      "type": "figure",
      "id": "fig_0088",
      "reading_order": 999,
      "section": "NOTICE:",
      "bbox": {
        "l": 207.02734375,
        "t": 387.0562744140625,
        "r": 322.940185546875,
        "b": 217.73333740234375
      },
      "image_path": "figures/figure_0088.png",
      "previous_block_id": "txt_0865",
      "next_block_id": "txt_0866"
    },
    {
      "type": "paragraph",
      "id": "txt_0866",
      "reading_order": 1000,
      "section": "NOTICE:",
      "bbox": {
        "l": 162.0,
        "t": 190.33903999999995,
        "r": 328.4299999999999,
        "b": 179.09903999999995
      },
      "content": "When the condition monitor is activated it:"
    },
    {
      "type": "list_item",
      "id": "txt_0867",
      "reading_order": 1001,
      "section": "NOTICE:",
      "bbox": {
        "l": 162.0,
        "t": 175.33903999999995,
        "r": 419.26000000000016,
        "b": 164.09903999999995
      },
      "content": "Displays a series of  red LEDs followed by a solid green LED."
    },
    {
      "type": "list_item",
      "id": "txt_0868",
      "reading_order": 1002,
      "section": "NOTICE:",
      "bbox": {
        "l": 161.99998,
        "t": 161.53904999999997,
        "r": 396.65998,
        "b": 150.29904999999997
      },
      "content": "Collects eight samples that are spaced one second apart."
    },
    {
      "type": "list_item",
      "id": "txt_0869",
      "reading_order": 1003,
      "section": "NOTICE:",
      "bbox": {
        "l": 161.99998,
        "t": 147.73906,
        "r": 425.5599800000002,
        "b": 136.49906
      },
      "content": "Averages these readings to establish the baseline vibration level."
    },
    {
      "type": "list_item",
      "id": "txt_0870",
      "reading_order": 1004,
      "section": "NOTICE:",
      "bbox": {
        "l": 161.99996,
        "t": 133.93907000000002,
        "r": 401.2499600000001,
        "b": 122.69907
      },
      "content": "Flashes a green LED after approximately twelve seconds."
    },
    {
      "type": "paragraph",
      "id": "txt_0871",
      "reading_order": 1005,
      "section": "NOTICE:",
      "bbox": {
        "l": 161.99984999999998,
        "t": 119.41904999999997,
        "r": 548.6098900000002,
        "b": 84.17904999999996
      },
      "content": "For the first ten minutes, the green LED flashes every second for five consecutive flashes and then pauses to take a vibration reading. More frequent measurements (every six seconds) are taken in this startup period so that an alarm can be immediately detected."
    }
  ]
}