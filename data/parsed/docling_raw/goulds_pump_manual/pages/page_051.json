    {
      "type": "list_item",
      "id": "txt_0715",
      "reading_order": 826,
      "section": "Required parts:",
      "bbox": {
        "l": 162.0,
        "t": 743.64184,
        "r": 508.86000000000024,
        "b": 717.88184
      },
      "content": "Place the driver half  of  the coupling guard over the pump half  of  the coupling guard. The annular groove in the coupling guard half  must face the motor."
    },
    {
      "type": "list_item",
      "id": "txt_0716",
      "reading_order": 827,
      "section": "Required parts:",
      "bbox": {
        "l": 144.0,
        "t": 431.09286,
        "r": 362.3299999999999,
        "b": 419.85285999999996
      },
      "content": "Place the driver-side end plate over the motor shaft."
    },
    {
      "type": "list_item",
      "id": "txt_0717",
      "reading_order": 828,
      "section": "Required parts:",
      "bbox": {
        "l": 144.0,
        "t": 169.06389000000001,
        "r": 522.9100000000003,
        "b": 157.82389
      },
      "content": "Place the driver-side end plate in the annular groove of  the driver-half  of  the coupling guard."
    },
    {
      "type": "list_item",
      "id": "txt_0718",
      "reading_order": 829,
      "section": "Required parts:",
      "bbox": {
        "l": 143.99996,
        "t": 155.26390000000004,
        "r": 544.3799600000004,
        "b": 132.02390000000003
      },
      "content": "Use a bolt, a nut, and two washers to secure the coupling guard half  to the end plate. Hand-tighten only."
    },
    {
      "type": "list_item",
      "id": "txt_0719",
      "reading_order": 830,
      "section": "Required parts:",
      "bbox": {
        "l": 161.99996,
        "t": 128.74388,
        "r": 412.01996000000014,
        "b": 117.50387999999998
      },
      "content": "The hole is located on the driver-side of  the coupling guard half."
    },
    {
      "type": "list_item",
      "id": "txt_0720",
      "reading_order": 831,
      "section": "Required parts:",
      "bbox": {
        "l": 143.99995,
        "t": 114.94389000000001,
        "r": 548.7199500000004,
        "b": 91.70389
      },
      "content": "Slide the driver-half  of  the coupling guard towards the motor so that the coupling guard completely covers the shafts and coupling."
    },
