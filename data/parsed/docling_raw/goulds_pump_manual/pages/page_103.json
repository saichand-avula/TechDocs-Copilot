{
  "page": 103,
  "document_id": "doc_b0587846",
  "page_bbox": {
    "width": 612.0,
    "height": 792.0
  },
  "blocks": [
    {
      "type": "list_item",
      "id": "txt_1511",
      "reading_order": 1751,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.0,
        "t": 743.64184,
        "r": 364.20000000000005,
        "b": 732.40184
      },
      "content": "Remove the bearings (112) from their packaging."
    },
    {
      "type": "list_item",
      "id": "txt_1512",
      "reading_order": 1752,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99998,
        "t": 730.14184,
        "r": 447.95998000000003,
        "b": 718.90184
      },
      "content": "Wipe the preservative from the bearing (112) bore and outer diameter."
    },
    {
      "type": "list_item",
      "id": "txt_1513",
      "reading_order": 1753,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.0,
        "t": 716.64184,
        "r": 543.8500000000006,
        "b": 693.40184
      },
      "content": "Use an induction heater with a demagnetizing cycle to heat both bearings (112) to an inner ring temperature of 230 °F (110 °C)."
    },
    {
      "type": "list_item",
      "id": "txt_1514",
      "reading_order": 1754,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.0,
        "t": 691.14184,
        "r": 540.9400000000004,
        "b": 679.90184
      },
      "content": "Place both bearings (112) on the shaft (122) with the large outer races together (back-to-back)."
    },
    {
      "type": "list_item",
      "id": "txt_1515",
      "reading_order": 1755,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99996,
        "t": 677.64184,
        "r": 536.5699600000003,
        "b": 666.40184
      },
      "content": "Position the bearings (112) on the shaft (122) against the shoulder and snug the locknut (136)"
    },
    {
      "type": "list_item",
      "id": "txt_1516",
      "reading_order": 1756,
      "section": "CAUTION:",
      "bbox": {
        "l": 176.16998999999998,
        "t": 665.64184,
        "r": 554.7800100000004,
        "b": 639.88184
      },
      "content": "against the bearings until they are cool. The locknut prevents the bearings from moving away from the shaft shoulder as they cool. Rotate"
    },
    {
      "type": "list_item",
      "id": "txt_1517",
      "reading_order": 1757,
      "section": "CAUTION:",
      "bbox": {
        "l": 176.16998999999998,
        "t": 639.12184,
        "r": 525.7499900000003,
        "b": 615.88184
      },
      "content": "the outer bearing rings relative to each other as they are placed on the shaft to assure good alignment."
    },
    {
      "type": "list_item",
      "id": "txt_1518",
      "reading_order": 1758,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99999,
        "t": 613.62185,
        "r": 434.6299900000001,
        "b": 602.38185
      },
      "content": "Remove the bearing locknut (136) after the bearings (112) are cool."
    },
    {
      "type": "list_item",
      "id": "txt_1519",
      "reading_order": 1759,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99997,
        "t": 599.82185,
        "r": 339.4899699999999,
        "b": 588.58185
      },
      "content": "Put the lockwasher (382) onto the shaft (122)."
    },
    {
      "type": "list_item",
      "id": "txt_1520",
      "reading_order": 1760,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99994999999998,
        "t": 586.02185,
        "r": 449.9999500000002,
        "b": 574.78185
      },
      "content": "Thread the locknut (136) onto the shaft (122) and tighten it until it is snug."
    },
    {
      "type": "list_item",
      "id": "txt_1521",
      "reading_order": 1761,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99992999999998,
        "t": 572.2218499999999,
        "r": 405.24993000000006,
        "b": 560.9818499999999
      },
      "content": "Bend the tangs of the lockwasher into the slots of  the locknut."
    },
    {
      "type": "list_item",
      "id": "txt_1522",
      "reading_order": 1762,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99989,
        "t": 558.42185,
        "r": 371.10989,
        "b": 547.1818499999999
      },
      "content": "Coat the inner surfaces of  the bearings with lubricant."
    },
    {
      "type": "list_item",
      "id": "txt_1523",
      "reading_order": 1763,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99989,
        "t": 544.62185,
        "r": 357.5298899999999,
        "b": 533.38185
      },
      "content": "Put the inboard bearing (168) onto the shaft (122)."
    },
    {
      "type": "list_item",
      "id": "txt_1524",
      "reading_order": 1764,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.00459999999998,
        "t": 378.45772,
        "r": 386.44460000000004,
        "b": 367.21772
      },
      "content": "Install the bearing housing as follows (see the illustration):"
    },
    {
      "type": "list_item",
      "id": "txt_1525",
      "reading_order": 1765,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.00461,
        "t": 363.45772,
        "r": 398.7246100000001,
        "b": 352.21772
      },
      "content": "Coat the outside of  the outboard bearing (112A) with oil."
    },
    {
      "type": "list_item",
      "id": "txt_1526",
      "reading_order": 1766,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.00457,
        "t": 349.95772,
        "r": 376.7345700000001,
        "b": 338.71772
      },
      "content": "Coat the bore of the bearing housing (134) with oil."
    },
    {
      "type": "list_item",
      "id": "txt_1527",
      "reading_order": 1767,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.00459,
        "t": 336.45772,
        "r": 349.93458999999996,
        "b": 310.69773
      },
      "content": "Put the bearing housing (134) onto the shaft. Do not use force."
    },
    {
      "type": "list_item",
      "id": "txt_1528",
      "reading_order": 1768,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.00006000000002,
        "t": 198.29332999999997,
        "r": 401.2800600000001,
        "b": 187.05332999999996
      },
      "content": "Prepare the shaft for assembly as follows (see the illustration):"
    },
    {
      "type": "list_item",
      "id": "txt_1529",
      "reading_order": 1769,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.00004,
        "t": 183.29332999999997,
        "r": 352.22003999999987,
        "b": 142.53330999999991
      },
      "content": "Fasten the clamp-ring bolts (236A) crosswise. See the specified torque values. Make sure that the shaft rotates freely."
    },
    {
      "type": "list_item",
      "id": "txt_1530",
      "reading_order": 1770,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.00005000000002,
        "t": 140.27330999999992,
        "r": 278.2600499999999,
        "b": 129.03330999999991
      },
      "content": "Install a new O-ring (496)."
    },
    {
      "type": "list_item",
      "id": "txt_1531",
      "reading_order": 1771,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.00005000000002,
        "t": 126.77330999999992,
        "r": 534.2700400000002,
        "b": 74.01328999999987
      },
      "content": "Install the outboard labyrinth oil-seal (332A) into the bearing housing (134). Place the drain slots of  the oil seal at the bottom position (6 o'clock). Make sure that the edges of  the keyway are free from burrs. To protect the O-ring, cover the keyway lengthwise with a piece of  electrical tape before you install the oil seal."
    },
