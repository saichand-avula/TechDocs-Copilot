  "blocks": [
    {
      "type": "figure",
      "id": "fig_0171",
      "reading_order": 1690,
      "section": "CAUTION:",
      "bbox": {
        "l": 175.8378448486328,
        "t": 741.0965461730957,
        "r": 317.3495178222656,
        "b": 645.3833465576172
      },
      "image_path": "figures/figure_0171.png",
      "previous_block_id": "txt_1456",
      "next_block_id": "txt_1457"
    },
    {
      "type": "list_item",
      "id": "txt_1457",
      "reading_order": 1691,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99946999999997,
        "t": 638.2973999999999,
        "r": 385.26947000000007,
        "b": 627.0574
      },
      "content": "Lightly coat the bearing seating with a thin film of  oil."
    },
    {
      "type": "list_item",
      "id": "txt_1458",
      "reading_order": 1692,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99946999999997,
        "t": 624.7973999999999,
        "r": 364.19947,
        "b": 613.5573999999999
      },
      "content": "Remove the bearings (112) from their packaging."
    },
    {
      "type": "list_item",
      "id": "txt_1459",
      "reading_order": 1693,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99944999999997,
        "t": 611.2973999999999,
        "r": 447.95945000000006,
        "b": 600.0573999999999
      },
      "content": "Wipe the preservative from the bearing (112) bore and outer diameter."
    },
    {
      "type": "list_item",
      "id": "txt_1460",
      "reading_order": 1694,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99946999999997,
        "t": 597.7973999999999,
        "r": 543.8494700000005,
        "b": 574.5573999999999
      },
      "content": "Use an induction heater with a demagnetizing cycle to heat both bearings (112) to an inner ring temperature of 230 °F (110 °C)."
    },
    {
      "type": "list_item",
      "id": "txt_1461",
      "reading_order": 1695,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99945,
        "t": 572.2973999999999,
        "r": 540.9394500000003,
        "b": 561.0573999999999
      },
      "content": "Place both bearings (112) on the shaft (122) with the large outer races together (back-to-back)."
    },
    {
      "type": "list_item",
      "id": "txt_1462",
      "reading_order": 1696,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99941,
        "t": 558.7973999999999,
        "r": 536.5694100000002,
        "b": 547.5573999999999
      },
      "content": "Position the bearings (112) on the shaft (122) against the shoulder and snug the locknut (136)"
    },
    {
      "type": "list_item",
      "id": "txt_1463",
      "reading_order": 1697,
      "section": "CAUTION:",
      "bbox": {
        "l": 176.16944,
        "t": 546.7973999999999,
        "r": 554.7794600000003,
        "b": 497.03739999999993
      },
      "content": "against the bearings until they are cool. The locknut prevents the bearings from moving away from the shaft shoulder as they cool. Rotate the outer bearing rings relative to each other as they are placed on the shaft to assure good alignment."
    },
    {
      "type": "list_item",
      "id": "txt_1464",
      "reading_order": 1698,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99945,
        "t": 494.77739999999994,
        "r": 434.62945000000013,
        "b": 483.53739999999993
      },
      "content": "Remove the bearing locknut (136) after the bearings (112) are cool."
    },
    {
      "type": "list_item",
      "id": "txt_1465",
      "reading_order": 1699,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99943000000002,
        "t": 480.97740999999996,
        "r": 339.4894299999999,
        "b": 469.73740999999995
      },
      "content": "Put the lockwasher (382) onto the shaft (122)."
    },
    {
      "type": "list_item",
      "id": "txt_1466",
      "reading_order": 1700,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99943000000002,
        "t": 467.17742,
        "r": 449.9994300000002,
        "b": 455.93742
      },
      "content": "Thread the locknut (136) onto the shaft (122) and tighten it until it is snug."
    },
    {
      "type": "list_item",
      "id": "txt_1467",
      "reading_order": 1701,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99941,
        "t": 453.37743,
        "r": 405.2494100000001,
        "b": 442.13743
      },
      "content": "Bend the tangs of the lockwasher into the slots of  the locknut."
    },
    {
      "type": "list_item",
      "id": "txt_1468",
      "reading_order": 1702,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99939,
        "t": 439.57744,
        "r": 421.32937000000004,
        "b": 413.81745
      },
      "content": "Place the bearing-clamp ring (253B) onto the shaft (122). Make sure that the orientation of  the bearing-clamp ring is correct."
    },
    {
      "type": "list_item",
      "id": "txt_1469",
      "reading_order": 1703,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99937,
        "t": 411.25746000000004,
        "r": 371.10937,
        "b": 400.01746
      },
      "content": "Coat the inner surfaces of  the bearings with lubricant."
    },
    {
      "type": "list_item",
      "id": "txt_1470",
      "reading_order": 1704,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99937,
        "t": 397.45747000000006,
        "r": 357.5293699999999,
        "b": 386.21747000000005
      },
      "content": "Put the inboard bearing (168) onto the shaft (122)."
    },
    {
      "type": "list_item",
      "id": "txt_1471",
      "reading_order": 1705,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99837,
        "t": 231.29339000000004,
        "r": 386.44837000000007,
        "b": 220.05339000000004
      },
      "content": "Install the bearing housing as follows (see the illustration):"
    },
    {
      "type": "list_item",
      "id": "txt_1472",
      "reading_order": 1706,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.9984,
        "t": 216.29339000000004,
        "r": 398.7184000000001,
        "b": 205.05339000000004
      },
      "content": "Coat the outside of  the outboard bearing (112A) with oil."
    },
    {
      "type": "list_item",
      "id": "txt_1473",
      "reading_order": 1707,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99838,
        "t": 202.79339000000004,
        "r": 376.7283800000001,
        "b": 191.55339000000004
      },
      "content": "Coat the bore of the bearing housing (134) with oil."
    },
    {
      "type": "list_item",
      "id": "txt_1474",
      "reading_order": 1708,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.9984,
        "t": 189.29339000000004,
        "r": 349.92839999999995,
        "b": 163.53337
      },
      "content": "Put the bearing housing (134) onto the shaft. Do not use force."
    },
    {
      "type": "figure",
      "id": "fig_0172",
      "reading_order": 1709,
      "section": "CAUTION:",
      "bbox": {
