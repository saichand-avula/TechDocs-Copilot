        "r": 477.36000000000035,
        "b": 732.40184
      },
      "content": "Turn the shaft to ensure that there is contact between the impeller and the casing."
    },
    {
      "type": "list_item",
      "id": "txt_0651",
      "reading_order": 750,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00004,
        "t": 729.8418399999999,
        "r": 454.23004000000026,
        "b": 718.6018399999999
      },
      "content": "Set the indicator to zero and loosen the locking bolt (370C) about one turn."
    },
    {
      "type": "list_item",
      "id": "txt_0652",
      "reading_order": 751,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00004,
        "t": 716.04184,
        "r": 488.1600400000003,
        "b": 704.80184
      },
      "content": "Thread in the jack bolts (370D) until the jack bolts evenly contact the bearing frame."
    },
    {
      "type": "list_item",
      "id": "txt_0653",
      "reading_order": 752,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00008,
        "t": 702.24184,
        "r": 549.9600800000003,
        "b": 679.00184
      },
      "content": "Tighten the jack bolts evenly about one flat at a time, moving the bearing housing (134A) away from the bearing frame until the indicator shows the correct clearance."
    },
    {
      "type": "list_item",
      "id": "txt_0654",
      "reading_order": 753,
      "section": "WARNING:",
      "bbox": {
        "l": 162.00002,
        "t": 675.72185,
        "r": 437.92002000000014,
        "b": 664.48185
      },
      "content": "Refer to the impeller clearance table to determine the correct clearance."
    },
    {
      "type": "list_item",
      "id": "txt_0655",
      "reading_order": 754,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00002,
        "t": 661.92185,
        "r": 307.5800199999999,
        "b": 650.6818499999999
      },
      "content": "Tighten the bolts evenly in this order:"
    },
    {
      "type": "list_item",
      "id": "txt_0656",
      "reading_order": 755,
      "section": "WARNING:",
      "bbox": {
        "l": 162.00002999999998,
        "t": 646.92185,
        "r": 304.0700299999998,
        "b": 635.6818499999999
      },
      "content": "Tighten the locking bolts (370C)."
    },
    {
      "type": "list_item",
      "id": "txt_0657",
      "reading_order": 756,
      "section": "WARNING:",
      "bbox": {
        "l": 162.00002999999998,
        "t": 633.42185,
        "r": 292.48002999999983,
        "b": 622.1818499999999
      },
      "content": "Tighten the jack bolts (370D)."
    },
    {
      "type": "list_item",
      "id": "txt_0658",
      "reading_order": 757,
      "section": "WARNING:",
      "bbox": {
        "l": 162.00002999999998,
        "t": 618.42184,
        "r": 397.77003000000013,
        "b": 607.18184
      },
      "content": "Make sure to keep the indicator reading at the proper setting."
    },
    {
      "type": "list_item",
      "id": "txt_0659",
      "reading_order": 758,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00002,
        "t": 604.62184,
        "r": 285.6500199999999,
        "b": 593.38184
      },
      "content": "Make sure the shaft turns freely."
    },
    {
      "type": "heading",
      "id": "txt_0660",
      "reading_order": 759,
      "section": "Set the impeller clearance - feeler gauge method (all except CV 3196)",
