    },
    {
      "type": "heading",
      "id": "txt_0661",
      "reading_order": 761,
      "section": "WARNING:",
      "bbox": {
        "l": 144.0,
        "t": 555.82183,
        "r": 197.11,
        "b": 544.58183
      },
      "content": "WARNING:",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0662",
      "reading_order": 762,
      "section": "WARNING:",
      "bbox": {
        "l": 144.0,
        "t": 541.3018299999999,
        "r": 544.6800200000005,
        "b": 518.06183
      },
      "content": "Always disconnect and lock out power to the driver before you perform any installation or maintenance tasks. Failure to disconnect and lock out driver power will result in serious physical injury."
    },
    {
      "type": "list_item",
      "id": "txt_0663",
      "reading_order": 763,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00004,
        "t": 501.16637,
        "r": 388.35004000000015,
        "b": 489.92637
      },
      "content": "Lock out the driver power and remove the coupling guard."
    },
    {
      "type": "list_item",
      "id": "txt_0664",
      "reading_order": 764,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00004,
        "t": 487.36638,
        "r": 541.8800400000002,
        "b": 476.12638
      },
      "content": "Loosen the jam nuts (423B) on the jack bolts (371A), and then back the bolts out about two turns."
    },
    {
      "type": "list_item",
      "id": "txt_0665",
      "reading_order": 765,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00348,
        "t": 321.20225999999997,
        "r": 553.7134800000003,
        "b": 297.96225999999996
      },
      "content": "Evenly tighten the locking bolts (370C), bringing the bearing housing (134A) towards the frame (228) until the impeller contacts the casing."
    },
    {
      "type": "list_item",
      "id": "txt_0666",
      "reading_order": 766,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00344,
        "t": 295.40227,
        "r": 477.36344000000037,
        "b": 284.16227
      },
      "content": "Turn the shaft to ensure that there is contact between the impeller and the casing."
    },
    {
      "type": "list_item",
      "id": "txt_0667",
      "reading_order": 767,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00348,
        "t": 281.60228,
        "r": 534.9034800000004,
        "b": 243.84229000000005
      },
      "content": "Use a feeler gauge to set the gap between the three locking bolts (370C) and the bearing housing (134A) to the correct impeller clearance. Refer to the impeller clearance table to determine the correct clearance."
    },
    {
      "type": "list_item",
      "id": "txt_0668",
      "reading_order": 768,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00339,
        "t": 241.28230000000008,
        "r": 533.3733900000004,
        "b": 218.04233
      },
      "content": "Use the three jack bolts (370D) to evenly loosen the bearing housing (134A) until it contacts the locking bolts (370C)."
    },
    {
      "type": "list_item",
      "id": "txt_0669",
      "reading_order": 769,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00338,
        "t": 215.48234000000002,
        "r": 299.15337999999986,
        "b": 204.24234
      },
      "content": "Evenly tighten the jam nuts (423B)."
    },
    {
      "type": "list_item",
      "id": "txt_0670",
      "reading_order": 770,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00338,
        "t": 201.68235000000004,
        "r": 441.07338000000027,
        "b": 190.44235000000003
      },
      "content": "Set the indicator to zero and turn back the locking bolt (370C) one turn."
    },
    {
      "type": "list_item",
      "id": "txt_0671",
      "reading_order": 771,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00336,
        "t": 187.88236000000006,
        "r": 467.52336000000037,
        "b": 176.64236000000005
      },
      "content": "Thread the adjuster bolts (371A) in until they evenly contact the bearing frame."
    },
    {
      "type": "list_item",
      "id": "txt_0672",
      "reading_order": 772,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00333999999998,
        "t": 174.08237000000008,
        "r": 552.4233400000003,
        "b": 138.84237000000007
      },
      "content": "Tighten the adjuster bolts evenly (about one flat at a time) and back the bearing housing (134A) away from the bearing frame until the indicator shows the proper clearance per the Cold temperature axial clearance (open and closed impeller) table."
    },
    {
      "type": "list_item",
      "id": "txt_0673",
      "reading_order": 773,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00336,
        "t": 136.2823800000001,
        "r": 555.4233600000005,
        "b": 113.0423800000001
      },
      "content": "Evenly tighten the locking bolts (370C) and then the adjuster bolts (371A) while keeping the indicator reading at the proper setting."
    },
    {
      "type": "list_item",
      "id": "txt_0674",
      "reading_order": 774,
      "section": "WARNING:",
      "bbox": {
        "l": 144.00338,
        "t": 110.48239000000012,
        "r": 285.64337999999987,
        "b": 99.24239000000011
      },
      "content": "Make sure the shaft turns freely."
    },
