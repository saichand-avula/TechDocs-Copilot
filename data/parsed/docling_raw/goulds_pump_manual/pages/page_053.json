    },
    {
      "type": "heading",
      "id": "txt_0740",
      "reading_order": 859,
      "section": "Lubricate the bearings with oil",
      "bbox": {
        "l": 54.0,
        "t": 413.6229499999999,
        "r": 227.37600000000006,
        "b": 400.2309499999999
      },
      "content": "Lubricate the bearings with oil",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0741",
      "reading_order": 860,
      "section": "Lubricate the bearings with oil",
      "bbox": {
        "l": 143.99599999999998,
        "t": 393.4618199999999,
        "r": 390.06600000000014,
        "b": 382.22181999999987
      },
      "content": "Use a high-quality turbine oil with rust and oxidation inhibitors."
    },
    {
      "type": "list_item",
      "id": "txt_0742",
      "reading_order": 861,
      "section": "Lubricate the bearings with oil",
      "bbox": {
        "l": 143.99597999999997,
        "t": 378.4618199999999,
        "r": 241.8259799999999,
        "b": 367.22181999999987
      },
      "content": "Remove the fill plug."
    },
    {
      "type": "list_item",
      "id": "txt_0743",
      "reading_order": 862,
      "section": "Lubricate the bearings with oil",
      "bbox": {
        "l": 143.99597999999997,
        "t": 364.6618299999999,
        "r": 543.5359800000008,
        "b": 341.4218299999999
      },
      "content": "Fill the bearing frame with oil through the filler connection, which is located on top of  the bearing frame."
    },
    {
      "type": "paragraph",
      "id": "txt_0744",
      "reading_order": 863,
      "section": "Lubricate the bearings with oil",
      "bbox": {
        "l": 161.99594,
        "t": 338.1418399999999,
        "r": 511.3359400000003,
        "b": 326.9018399999999
      },
      "content": "Fill the bearing frame with oil until the oil level reaches the middle of  the sight glass (319)."
    },
