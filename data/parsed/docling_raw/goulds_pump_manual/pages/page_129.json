    {
      "type": "heading",
      "id": "txt_1862",
      "reading_order": 2172,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.00198,
        "t": 264.98153,
        "r": 187.45198,
        "b": 253.74153
      },
      "content": "NOTICE:",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_1863",
      "reading_order": 2173,
      "section": "NOTICE:",
      "bbox": {
        "l": 153.002,
        "t": 251.18154000000004,
        "r": 556.4120000000004,
        "b": 215.94151
      },
      "content": "Never mix greases of different consistencies (NLGI 1 or 3 with NLGI 2) or with different thickeners. For example, never mix a lithium-based grease with a polyurea-based grease. Doing so may result in decreased performance."
    },
    {
      "type": "list_item",
      "id": "txt_1864",
      "reading_order": 2174,
      "section": "NOTICE:",
      "bbox": {
        "l": 153.00199,
        "t": 213.38152000000002,
        "r": 546.8619900000003,
        "b": 190.14152
      },
      "content": "Remove the bearings and old grease if you need to change the grease type or consistency. Failure to do so may result in equipment damage or decreased performance."
    },
    {
      "type": "paragraph",
      "id": "txt_1865",
      "reading_order": 2175,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.00184000000002,
        "t": 179.86149999999998,
        "r": 553.4818800000003,
        "b": 144.62149999999997
      },
      "content": "Use a grease that is suitable for high temperatures when you have frame pumpage temperatures greater than 350°F (177°C). Ensure that mineral-oil greases have oxidation stabilizers and a consistency of  NLGI 3."
    },
    {
      "type": "paragraph",
      "id": "txt_1866",
      "reading_order": 2176,
      "section": "NOTICE:",
      "bbox": {
        "l": 144.00184000000002,
        "t": 141.86149999999998,
        "r": 542.8218400000002,
        "b": 120.62149999999997
      },
      "content": "Most pumps use Sunoco 2EP grease. High temperature units with a pumpage temperature greater than 350° F (177°C) use Mobil SCH32."
    }
  ]
}