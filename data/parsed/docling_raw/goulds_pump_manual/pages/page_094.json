      "level": 2
    },
    {
      "type": "heading",
      "id": "txt_1365",
      "reading_order": 1585,
      "section": "Condition of  bearings",
      "bbox": {
        "l": 54.00199,
        "t": 715.64184,
        "r": 147.65199,
        "b": 704.40184
      },
      "content": "Condition of  bearings",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1366",
      "reading_order": 1586,
      "section": "Condition of  bearings",
      "bbox": {
        "l": 144.00195000000002,
        "t": 701.12184,
        "r": 556.2019800000005,
        "b": 677.88184
      },
      "content": "Do not reuse bearings. The condition of the bearings provides useful information on operating conditions in the bearing frame."
    },
    {
      "type": "heading",
      "id": "txt_1367",
      "reading_order": 1587,
      "section": "Checklist",
      "bbox": {
        "l": 54.00195000000001,
        "t": 671.12184,
        "r": 93.69195000000002,
        "b": 659.88184
      },
      "content": "Checklist",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1368",
      "reading_order": 1588,
      "section": "Checklist",
      "bbox": {
        "l": 144.00195000000002,
        "t": 656.60184,
        "r": 348.8019499999999,
        "b": 645.36184
      },
      "content": "Perform these checks when you inspect the bearings:"
    },
    {
      "type": "list_item",
      "id": "txt_1369",
      "reading_order": 1589,
      "section": "Checklist",
      "bbox": {
        "l": 153.00193000000002,
        "t": 641.60184,
        "r": 363.3919299999999,
        "b": 630.36184
      },
      "content": "Inspect the bearings for contamination and damage."
    },
    {
      "type": "list_item",
      "id": "txt_1370",
      "reading_order": 1590,
      "section": "Checklist",
      "bbox": {
        "l": 153.00193000000002,
        "t": 627.80184,
        "r": 322.63192999999984,
        "b": 616.56184
      },
      "content": "Note any lubricant condition and residue."
    },
    {
      "type": "list_item",
      "id": "txt_1371",
      "reading_order": 1591,
      "section": "Checklist",
      "bbox": {
        "l": 153.00193000000002,
        "t": 614.0018399999999,
        "r": 499.3919300000002,
        "b": 602.76184
      },
      "content": "Inspect the ball bearings to see if  they are loose, rough, or noisy when you rotate them."
    },
    {
      "type": "list_item",
      "id": "txt_1372",
      "reading_order": 1592,
      "section": "Checklist",
      "bbox": {
        "l": 153.00195000000002,
        "t": 600.20184,
        "r": 545.6619500000003,
        "b": 576.9618399999999
      },
      "content": "Investigate any bearing damage to determine the cause. If  the cause is not normal wear, correct the issue before you return the pump to service."
    },
    {
      "type": "heading",
      "id": "txt_1373",
      "reading_order": 1593,
      "section": "Bearing-housing inspection",
      "bbox": {
        "l": 53.99997000000002,
        "t": 568.7968,
        "r": 239.13597000000001,
        "b": 553.1727999999999
      },
      "content": "Bearing-housing inspection",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1374",
      "reading_order": 1594,
      "section": "Bearing-housing inspection",
      "bbox": {
        "l": 53.99598000000002,
        "t": 546.40184,
        "r": 93.68598000000003,
        "b": 535.16184
      },
      "content": "Checklist"
    },
    {
      "type": "list_item",
      "id": "txt_1375",
      "reading_order": 1595,
      "section": "Bearing-housing inspection",
      "bbox": {
        "l": 152.99598000000003,
        "t": 532.60184,
        "r": 504.9159800000004,
        "b": 521.36184
      },
      "content": "Inspect the bearing-housing (134) bore according to the bearing fits and tolerances table."
    },
    {
      "type": "list_item",
      "id": "txt_1376",
      "reading_order": 1596,
      "section": "Bearing-housing inspection",
      "bbox": {
        "l": 152.99598000000003,
        "t": 518.80184,
        "r": 548.7359800000003,
        "b": 495.56183999999996
      },
      "content": "Replace the bearing housing if  the dimensions exceed acceptable values. Reference: see Bearings fits and tolerances."
    },
    {
      "type": "list_item",
      "id": "txt_1377",
      "reading_order": 1597,
      "section": "Bearing-housing inspection",
      "bbox": {
        "l": 152.99596000000003,
        "t": 493.00183999999996,
        "r": 376.6859599999999,
        "b": 481.76183999999995
      },
      "content": "Visually inspect the bearing housing for cracks and pits."
    },
    {
      "type": "heading",
      "id": "txt_1378",
      "reading_order": 1598,
      "section": "Checklist for specific models",
      "bbox": {
        "l": 53.99594000000002,
        "t": 475.00183999999996,
        "r": 175.98594000000003,
        "b": 463.76183999999995
      },
      "content": "Checklist for specific models",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_1379",
      "reading_order": 1599,
      "section": "Checklist for specific models",
      "bbox": {
        "l": 143.99594000000002,
        "t": 463.00183999999996,
        "r": 483.3959400000001,
        "b": 451.76183999999995
      },
      "content": "This table shows bearing-housing checks that are required for specific models of  pump."
    },
    {
      "type": "table",
      "id": "tbl_0062",
      "reading_order": 1600,
      "section": "Checklist for specific models",
      "bbox": {
        "l": 142.6314697265625,
        "t": 452.37713623046875,
        "r": 558.9695434570312,
        "b": 385.278076171875
      },
      "markdown": "| Frame         | Bearing-housing check                            |\n|---------------|--------------------------------------------------|\n| STi and MTi   | Ensure that the snap-ring groove is not cracked. |\n| LTi           | Clear all grooves and holes.                     |\n| XLT-i and i17 | Clean the gasket surface.                        |"
    },
