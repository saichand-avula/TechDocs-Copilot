    },
    {
      "type": "heading",
      "id": "txt_0927",
      "reading_order": 1067,
      "section": "Maintenance inspections",
      "bbox": {
        "l": 54.00201,
        "t": 673.64184,
        "r": 160.06201,
        "b": 662.40184
      },
      "content": "Maintenance inspections",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0928",
      "reading_order": 1068,
      "section": "Maintenance inspections",
      "bbox": {
        "l": 144.00200999999998,
        "t": 659.12184,
        "r": 377.39200999999997,
        "b": 647.88184
      },
      "content": "A maintenance schedule includes these types of inspections:"
    },
    {
      "type": "list_item",
      "id": "txt_0929",
      "reading_order": 1069,
      "section": "Maintenance inspections",
      "bbox": {
        "l": 153.00199,
        "t": 644.12184,
        "r": 243.83198999999993,
        "b": 632.88184
      },
      "content": "Routine maintenance"
    },
    {
      "type": "list_item",
      "id": "txt_0930",
      "reading_order": 1070,
      "section": "Maintenance inspections",
      "bbox": {
        "l": 153.00199,
        "t": 630.32184,
        "r": 238.52198999999993,
        "b": 619.0818399999999
      },
      "content": "Routine inspections"
    },
    {
      "type": "list_item",
      "id": "txt_0931",
      "reading_order": 1071,
      "section": "Maintenance inspections",
      "bbox": {
        "l": 153.00199,
        "t": 616.52184,
        "r": 260.17198999999994,
        "b": 605.28184
      },
      "content": "Three-month inspections"
    },
    {
      "type": "list_item",
      "id": "txt_0932",
      "reading_order": 1072,
      "section": "Maintenance inspections",
      "bbox": {
        "l": 153.00199,
        "t": 602.7218399999999,
        "r": 236.13198999999992,
        "b": 591.4818399999999
      },
      "content": "Annual inspections"
    },
    {
      "type": "paragraph",
      "id": "txt_0933",
      "reading_order": 1073,
      "section": "Maintenance inspections",
      "bbox": {
        "l": 144.002,
        "t": 588.20184,
        "r": 525.5120000000002,
        "b": 564.9618399999999
      },
      "content": "Shorten the inspection intervals appropriately if  the pumped fluid is abrasive or corrosive or if  the environment is classified as potentially explosive."
    },
    {
      "type": "heading",
      "id": "txt_0934",
      "reading_order": 1074,
      "section": "Routine maintenance",
      "bbox": {
        "l": 54.00198,
        "t": 558.20184,
        "r": 144.85198,
        "b": 546.9618399999999
      },
      "content": "Routine maintenance",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0935",
      "reading_order": 1075,
      "section": "Routine maintenance",
      "bbox": {
        "l": 144.00198,
        "t": 543.68184,
        "r": 395.4819800000001,
        "b": 532.44184
      },
      "content": "Perform these tasks whenever you perform routine maintenance:"
    },
    {
      "type": "list_item",
      "id": "txt_0936",
      "reading_order": 1076,
      "section": "Routine maintenance",
      "bbox": {
        "l": 153.00198,
        "t": 528.68184,
        "r": 249.8519799999999,
        "b": 517.44184
      },
      "content": "Lubricate the bearings."
    },
    {
      "type": "list_item",
      "id": "txt_0937",
      "reading_order": 1077,
      "section": "Routine maintenance",
      "bbox": {
        "l": 153.002,
        "t": 514.88184,
        "r": 224.20199999999994,
        "b": 503.64183999999995
      },
      "content": "Inspect the seal."
    },
    {
      "type": "paragraph",
      "id": "txt_0938",
      "reading_order": 1078,
      "section": "Routine maintenance",
      "bbox": {
        "l": 144.00201,
        "t": 482.36184999999995,
        "r": 447.4720100000001,
        "b": 471.12184999999994
      },
      "content": "Perform these tasks whenever you check the pump during routine inspections:"
    },
    {
      "type": "list_item",
      "id": "txt_0939",
      "reading_order": 1079,
      "section": "Routine maintenance",
      "bbox": {
        "l": 153.002,
        "t": 467.36184999999995,
        "r": 491.30200000000025,
        "b": 456.12184999999994
      },
      "content": "Check the level and condition of  the oil through the sight glass on the bearing frame."
    },
    {
      "type": "list_item",
      "id": "txt_0940",
      "reading_order": 1080,
      "section": "Routine maintenance",
      "bbox": {
        "l": 153.002,
        "t": 453.56185999999997,
        "r": 399.54200000000003,
        "b": 442.32185999999996
      },
      "content": "Check for unusual noise, vibration, and bearing temperatures."
    },
    {
      "type": "list_item",
      "id": "txt_0941",
      "reading_order": 1081,
      "section": "Routine maintenance",
      "bbox": {
        "l": 153.002,
        "t": 439.76187,
        "r": 307.2019999999999,
        "b": 428.52187
      },
      "content": "Check the pump and piping for leaks."
    },
    {
      "type": "list_item",
      "id": "txt_0942",
      "reading_order": 1082,
      "section": "Routine maintenance",
      "bbox": {
        "l": 153.002,
        "t": 425.96188,
        "r": 247.09199999999993,
        "b": 414.72188
      },
      "content": "Analyze the vibration."
    },
    {
      "type": "list_item",
      "id": "txt_0943",
      "reading_order": 1083,
      "section": "Routine maintenance",
      "bbox": {
        "l": 153.002,
        "t": 412.16189,
        "r": 280.9119999999999,
        "b": 400.92189
      },
      "content": "Inspect the discharge pressure."
    },
    {
      "type": "list_item",
      "id": "txt_0944",
      "reading_order": 1084,
      "section": "Routine maintenance",
      "bbox": {
        "l": 153.002,
        "t": 398.36190000000005,
        "r": 256.62199999999996,
        "b": 387.12190000000004
      },
      "content": "Inspect the temperature."
    },
    {
      "type": "list_item",
      "id": "txt_0945",
      "reading_order": 1085,
      "section": "Routine maintenance",
      "bbox": {
        "l": 153.002,
        "t": 384.56191000000007,
        "r": 357.092,
        "b": 373.32191000000006
      },
      "content": "Check the seal chamber and stuffing box for leaks."
    },
    {
      "type": "list_item",
      "id": "txt_0946",
      "reading_order": 1086,
      "section": "Routine maintenance",
      "bbox": {
        "l": 162.00202000000002,
        "t": 370.7619200000001,
        "r": 387.43202000000014,
        "b": 359.5219200000001
      },
      "content": "Ensure that there are no leaks from the mechanical seal."
    },
    {
      "type": "list_item",
      "id": "txt_0947",
      "reading_order": 1087,
      "section": "Routine maintenance",
      "bbox": {
        "l": 162.00202000000002,
        "t": 356.9619300000001,
        "r": 479.2020200000003,
        "b": 345.7219300000001
      },
      "content": "Adjust or replace the packing in the stuffing box if  you notice excessive leaking."
    },
    {
      "type": "heading",
      "id": "txt_0948",
      "reading_order": 1088,
      "section": "Routine inspections",
      "bbox": {
        "l": 54.00200000000001,
        "t": 496.88183999999995,
        "r": 138.502,
        "b": 485.64183999999995
      },
      "content": "Routine inspections",
      "level": 2
    },
    {
      "type": "heading",
      "id": "txt_0949",
      "reading_order": 1089,
      "section": "Three-month inspections",
      "bbox": {
        "l": 54.00196000000001,
        "t": 338.9619300000001,
        "r": 161.30196,
        "b": 327.7219300000001
      },
      "content": "Three-month inspections",
      "level": 2
    },
    {
      "type": "paragraph",
      "id": "txt_0950",
      "reading_order": 1090,
      "section": "Three-month inspections",
      "bbox": {
        "l": 144.00196,
        "t": 324.4419400000001,
        "r": 300.13195999999994,
        "b": 313.2019400000001
      },
      "content": "Perform these tasks every three months:"
    },
    {
      "type": "list_item",
      "id": "txt_0951",
      "reading_order": 1091,
      "section": "Three-month inspections",
      "bbox": {
        "l": 153.00195000000002,
        "t": 309.4419400000001,
        "r": 398.0619500000001,
        "b": 298.2019400000001
      },
      "content": "Check that the foundation and the hold-down bolts are tight."
    },
    {
      "type": "list_item",
      "id": "txt_0952",
      "reading_order": 1092,
      "section": "Three-month inspections",
      "bbox": {
        "l": 153.00195000000002,
        "t": 295.6419500000001,
        "r": 445.9519500000001,
        "b": 284.4019500000001
      },
      "content": "Check the packing if  the pump has been left idle, and replace as required."
    },
    {
      "type": "list_item",
      "id": "txt_0953",
      "reading_order": 1093,
      "section": "Three-month inspections",
      "bbox": {
        "l": 153.00197000000003,
        "t": 281.84196000000014,
        "r": 438.16197,
        "b": 270.6019600000002
      },
      "content": "Change the oil every three months (2000 operating hours) at minimum."
    },
    {
      "type": "list_item",
      "id": "txt_0954",
      "reading_order": 1094,
      "section": "Three-month inspections",
      "bbox": {
        "l": 162.00195000000002,
        "t": 268.0419700000002,
        "r": 519.9419500000002,
        "b": 244.8019700000002
      },
      "content": "Change the oil more often if  there are adverse atmospheric or other conditions that might contaminate or break down the oil."
    },
    {
      "type": "list_item",
      "id": "txt_0955",
      "reading_order": 1095,
      "section": "Three-month inspections",
      "bbox": {
        "l": 153.00191,
        "t": 242.24198000000024,
        "r": 357.18190999999985,
        "b": 231.00198000000012
      },
      "content": "Check the shaft alignment, and realign as required."
    },
    {
      "type": "paragraph",
      "id": "txt_0956",
      "reading_order": 1096,
      "section": "Three-month inspections",
      "bbox": {
        "l": 144.00191,
        "t": 209.7219600000002,
        "r": 322.11190999999985,
        "b": 198.48196000000019
      },
      "content": "Perform these inspections one time each year:"
    },
    {
      "type": "list_item",
      "id": "txt_0957",
      "reading_order": 1097,
      "section": "Three-month inspections",
      "bbox": {
        "l": 153.00191,
        "t": 194.7219600000002,
        "r": 261.1619099999999,
        "b": 183.48196000000019
      },
      "content": "Check the pump capacity."
    },
    {
      "type": "list_item",
      "id": "txt_0958",
      "reading_order": 1098,
      "section": "Three-month inspections",
      "bbox": {
        "l": 153.00191,
        "t": 180.92197000000021,
        "r": 263.15191000000004,
        "b": 169.6819700000002
      },
      "content": "Check the pump pressure."
    },
    {
      "type": "list_item",
      "id": "txt_0959",
      "reading_order": 1099,
      "section": "Three-month inspections",
      "bbox": {
        "l": 153.00191,
        "t": 167.12198000000024,
        "r": 254.76191,
        "b": 155.88198000000023
      },
      "content": "Check the pump power."
    },
    {
      "type": "paragraph",
      "id": "txt_0960",
      "reading_order": 1100,
      "section": "Three-month inspections",
      "bbox": {
        "l": 144.00190000000003,
        "t": 152.6019600000002,
        "r": 549.8519000000001,
        "b": 129.36196000000018
      },
      "content": "If  the pump performance does not satisfy your process requirements, and the process requirements have not changed, then perform these steps:"
    },
    {
      "type": "list_item",
      "id": "txt_0961",
      "reading_order": 1101,
      "section": "Three-month inspections",
      "bbox": {
        "l": 144.00188000000003,
        "t": 125.60196000000019,
        "r": 252.21187999999995,
        "b": 114.36196000000018
      },
      "content": "Disassemble the pump."
    },
    {
      "type": "list_item",
      "id": "txt_0962",
      "reading_order": 1102,
      "section": "Three-month inspections",
      "bbox": {
        "l": 144.00188000000003,
        "t": 111.80197000000021,
        "r": 200.55187999999995,
        "b": 100.5619700000002
      },
      "content": "Inspect it."
    },
    {
      "type": "list_item",
      "id": "txt_0963",
      "reading_order": 1103,
      "section": "Three-month inspections",
      "bbox": {
        "l": 144.00188000000003,
        "t": 98.00198000000023,
        "r": 238.30187999999995,
        "b": 86.76198000000022
      },
      "content": "Replace worn parts."
    },
    {
      "type": "heading",
      "id": "txt_0964",
      "reading_order": 1104,
      "section": "Annual inspections",
      "bbox": {
        "l": 54.001910000000024,
        "t": 224.24198000000024,
        "r": 135.15191000000002,
        "b": 213.00198000000023
      },
      "content": "Annual inspections",
      "level": 2
    }
  ]
}