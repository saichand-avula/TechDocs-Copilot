    {
      "type": "heading",
      "id": "txt_1438",
      "reading_order": 1670,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.0,
        "t": 692.64184,
        "r": 194.52999999999997,
        "b": 681.40184
      },
      "content": "CAUTION:",
      "level": 2
    },
    {
      "type": "list_item",
      "id": "txt_1439",
      "reading_order": 1671,
      "section": "CAUTION:",
      "bbox": {
        "l": 153.00002,
        "t": 678.8418399999999,
        "r": 546.8600200000003,
        "b": 667.60184
      },
      "content": "Wear insulated gloves when you use a bearing heater. Bearings get hot and can cause physical injury."
    },
    {
      "type": "list_item",
      "id": "txt_1440",
      "reading_order": 1672,
      "section": "CAUTION:",
      "bbox": {
        "l": 153.0,
        "t": 665.04184,
        "r": 549.7400000000002,
        "b": 641.80184
      },
      "content": "Use care when you handle the shaft because it can be heavy. Failure to do so could result in personal injury."
    },
    {
      "type": "paragraph",
      "id": "txt_1441",
      "reading_order": 1673,
      "section": "CAUTION:",
      "bbox": {
        "l": 143.99998999999997,
        "t": 621.04183,
        "r": 544.7800000000004,
        "b": 597.80183
      },
      "content": "NOTICE: Make sure that the pipe threads are clean, and that you apply thread sealant to the plugs and fittings. Failure to do so may result in equipment damage or decreased performance."
    },
    {
      "type": "paragraph",
      "id": "txt_1442",
      "reading_order": 1674,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.0,
        "t": 583.04183,
        "r": 529.2800100000003,
        "b": 559.80183
      },
      "content": "NOTICE: Use an induction heater that heats as well as demagnetizes the bearings when you install bearings. Failure to do so may result in decreased performance."
    },
    {
      "type": "list_item",
      "id": "txt_1443",
      "reading_order": 1675,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.00002,
        "t": 550.2418299999999,
        "r": 406.80002000000013,
        "b": 539.0018299999999
      },
      "content": "Prepare the bearing frame (228) as follows (see the illustration):"
    },
    {
      "type": "list_item",
      "id": "txt_1444",
      "reading_order": 1676,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.00002,
        "t": 535.2418299999999,
        "r": 290.7600199999998,
        "b": 524.0018299999999
      },
      "content": "Install the oil-fill plug (113A)."
    },
    {
      "type": "list_item",
      "id": "txt_1445",
      "reading_order": 1677,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.00002,
        "t": 521.7418299999999,
        "r": 300.4400199999999,
        "b": 510.50183
      },
      "content": "Install the oil-drain plug (408A)."
    },
    {
      "type": "list_item",
      "id": "txt_1446",
      "reading_order": 1678,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.00002,
        "t": 508.24183,
        "r": 280.8800199999999,
        "b": 497.00183
      },
      "content": "Install the sight glass (319)."
    },
    {
      "type": "list_item",
      "id": "txt_1447",
      "reading_order": 1679,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.00002,
        "t": 494.74181,
        "r": 302.53001999999987,
        "b": 483.50181
      },
      "content": "Install the sight oiler plug (408J)."
    },
    {
      "type": "list_item",
      "id": "txt_1448",
      "reading_order": 1680,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.00002,
        "t": 481.24181,
        "r": 351.9000199999999,
        "b": 470.00181
      },
      "content": "Install the plug for the oil-cooler inlet (408L)."
    },
    {
      "type": "list_item",
      "id": "txt_1449",
      "reading_order": 1681,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.00002,
        "t": 467.74181,
        "r": 360.0300199999999,
        "b": 456.50181
      },
      "content": "Install the plug for the oil-cooler outlet (408M)."
    },
    {
      "type": "list_item",
      "id": "txt_1450",
      "reading_order": 1682,
      "section": "CAUTION:",
      "bbox": {
        "l": 162.00004,
        "t": 454.24181,
        "r": 351.8000399999999,
        "b": 443.00181
      },
      "content": "Install four oil-mist connection plugs (408H)."
    },
    {
      "type": "list_item",
      "id": "txt_1451",
      "reading_order": 1683,
      "section": "CAUTION:",
      "bbox": {
        "l": 176.17002000000002,
        "t": 439.72182,
        "r": 443.09002000000004,
        "b": 428.48181999999997
      },
      "content": "Or: Install two grease fittings (193) and two grease-relief  plugs (113)."
    },
    {
      "type": "list_item",
      "id": "txt_1452",
      "reading_order": 1684,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99997000000002,
        "t": 426.22182,
        "r": 456.7599700000002,
        "b": 414.98181999999997
      },
      "content": "Attach the bearing-frame foot (241) and fasten the bolts (370F) by hand."
    },
    {
      "type": "list_item",
      "id": "txt_1453",
      "reading_order": 1685,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.0,
        "t": 189.27000999999996,
        "r": 375.86000000000007,
        "b": 178.03000999999995
      },
      "content": "Install the outboard bearings (112A) on the shaft (122)."
    },
    {
      "type": "figure",
      "id": "fig_0170",
      "reading_order": 1686,
      "section": "CAUTION:",
      "bbox": {
        "l": 172.2849884033203,
        "t": 397.8072204589844,
        "r": 355.0748596191406,
        "b": 196.37396240234375
      },
      "image_path": "figures/figure_0170.png",
      "previous_block_id": "txt_1453",
      "next_block_id": "txt_1454"
    },
    {
      "type": "paragraph",
      "id": "txt_1454",
      "reading_order": 1687,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99996,
        "t": 174.7499899999999,
        "r": 556.0299800000005,
        "b": 151.5099899999999
      },
      "content": "The regreasable bearing has a single shield. Make sure that the bearing is installed with the shield away from the impeller."
    },
    {
      "type": "paragraph",
      "id": "txt_1455",
      "reading_order": 1688,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99989,
        "t": 147.7499899999999,
        "r": 541.7999600000004,
        "b": 124.5099899999999
      },
      "content": "The duplex bearings are mounted back-to-back. Make sure that the orientation of the bearings are correct."
    },
    {
      "type": "list_item",
      "id": "txt_1456",
      "reading_order": 1689,
      "section": "CAUTION:",
      "bbox": {
        "l": 161.99989,
        "t": 120.74998999999991,
        "r": 541.2698900000003,
        "b": 97.5099899999999
      },
      "content": "Inspect the shaft (122) to ensure that it is clean, dimensionally correct, and is free of  nicks and burrs."
    }
  ]
}