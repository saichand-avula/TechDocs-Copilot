      "section": "Before performing service",
      "content": "Before performing service",
      "level": 2,
      "role": "section"
    },
    {
      "type": "heading",
      "id": "txt_0180",
      "reading_order": 200,
      "section": "Turn the printer power off",
      "content": "Turn the printer power off",
      "level": 2,
      "role": "section"
    },
    {
      "type": "paragraph",
      "id": "txt_0181",
      "reading_order": 201,
      "section": "/page/28/SectionHeader/10",
      "content": "○ Disconnect the power cable."
    },
    {
      "type": "admonition",
      "id": "txt_0182",
      "reading_order": 202,
      "section": "/page/28/SectionHeader/10",
      "content": "WARNING! To avoid damage to the printer, turn the printer off, wait 30 seconds, and then remove the power cord before attempting to service the printer.",
      "severity": "warning"
    },
    {
      "type": "admonition",
      "id": "txt_0183",
      "reading_order": 203,
      "section": "/page/28/SectionHeader/10",
      "content": "CAUTION: This part contains components that are electrostatic discharge (ESD) sensitive. To reduce the possibility of ESD damage, always touch the sheet-metal chassis to ground yourself before touching an ESD sensitive part.",
      "severity": "caution"
    },
    {
      "type": "admonition",
      "id": "txt_0184",
      "reading_order": 204,
      "section": "/page/28/SectionHeader/10",
      "content": "IMPORTANT: Do not replace the formatter, DC controller, and eMMC PCA simultaneously during a single printer servicing. Doing so might cause the printer to become unstable or inoperable.",
      "severity": "important"
    },
    {
      "type": "admonition",
      "id": "txt_0185",
      "reading_order": 205,
      "section": "/page/28/SectionHeader/10",
      "content": "NOTE: Data stored on the eMMC is not secure and cannot be encrypted.",
      "severity": "note"
    },
    {
      "type": "paragraph",
      "id": "txt_0186",
      "reading_order": 206,
      "section": "/page/28/SectionHeader/10",
      "content": "Use the table below to identify the correct part number for your printer. To order the part, go to www.hp.com/buy/parts."
    }
  ]
