      "reading_order": 4892,
      "section": "Post service test",
      "bbox": {
        "l": 122.0,
        "t": 732.29,
        "r": 549.7800000000003,
        "b": 708.7
      },
      "content": "Use the small flat-blade screwdriver supplied in the kit to release the control-panel screws cover, and then remove the cover."
    },
    {
      "type": "list_item",
      "id": "txt_3596",
      "reading_order": 4893,
      "section": "Post service test",
      "bbox": {
        "l": 144.0,
        "t": 696.79,
        "r": 519.7300000000002,
        "b": 673.2
      },
      "content": "TIP: The screwdriver has a reversible shaft. Simply pull the shaft out of the handle, and then reinstall it with the desired end facing out."
    },
    {
      "type": "list_item",
      "id": "txt_3597",
      "reading_order": 4894,
      "section": "Post service test",
      "bbox": {
        "l": 122.0,
        "t": 383.56371,
        "r": 484.8900000000003,
        "b": 371.97371
      },
      "content": "Use the small Phillips screwdriver supplied in the kit to remove two screws (callout 1)."
    },
    {
      "type": "list_item",
      "id": "txt_3598",
      "reading_order": 4895,
      "section": "Post service test",
      "bbox": {
        "l": 144.0,
        "t": 360.06371,
        "r": 515.5200000000001,
        "b": 348.47371
      },
      "content": "IMPORTANT: Store the screws in a secure place where they cannot fall down into the printer."
    },
