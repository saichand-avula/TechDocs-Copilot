      "next_block_id": "txt_0101"
    },
    {
      "type": "admonition",
      "id": "txt_0101",
      "reading_order": 119,
      "severity": "caution",
      "content": "CAUTION: Some parts are sensitive to electrostatic discharge (ESD). Look for the ESD reminder when",
      "section": "CAUTION:",
      "bbox": {
        "l": 91.0,
        "t": 203.40499,
        "r": 128.75,
        "b": 191.81498999999997
      }
    },
    {
      "type": "figure",
      "id": "fig_0014",
      "reading_order": 121,
      "section": "CAUTION:",
      "bbox": {
        "l": 140.28416479924115,
        "t": 207.8536376953125,
        "r": 160.4565075290366,
        "b": 185.92706298828125
      },
      "image_path": "figures/figure_0014.png",
      "width": 20,
      "height": 21,
      "image_hash": "847b32faf51e34fc3e766ae462574b0b0cefa179ec8fa65303f3786f5d846ca5",
      "previous_block_id": "txt_0102",
      "next_block_id": "txt_0103"
    },
    {
      "type": "paragraph",
      "id": "txt_0103",
      "reading_order": 122,
      "section": "CAUTION:",
      "bbox": {
        "l": 91.0,
        "t": 184.78999999999996,
        "r": 536.7900800000002,
        "b": 149.20000000000005
      },
      "content": "removing printer parts. Always perform service work at an ESD-protected workstation or mat. If an ESD workstation or mat is not available, touch the sheet-metal chassis to provide a static ground before touching an ESD-sensitive assembly."
    },
    {
      "type": "paragraph",
      "id": "txt_0104",
      "reading_order": 123,
      "section": "CAUTION:",
      "bbox": {
        "l": 91.00012,
        "t": 139.78999999999996,
        "r": 499.2501200000001,
        "b": 128.20000000000005
      },
      "content": "Protect the ESD-sensitive assemblies by placing them in ESD pouches when they are out of the printer."
    },
    {
