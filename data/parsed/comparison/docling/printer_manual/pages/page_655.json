    {
      "type": "heading",
      "id": "txt_4926",
      "reading_order": 6832,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.0,
        "t": 304.53499,
        "r": 181.75,
        "b": 292.94499
      },
      "content": "CAUTION:",
      "level": 2,
      "role": "section"
    },
    {
      "type": "list_item",
      "id": "txt_4927",
      "reading_order": 6833,
      "section": "CAUTION:",
      "bbox": {
        "l": 210.61,
        "t": 304.53499999999997,
        "r": 537.65,
        "b": 292.945
      },
      "content": "Some parts are sensitive to electrostatic discharge (ESD). Always perform service"
    },
    {
      "type": "figure",
      "id": "fig_1861",
      "reading_order": 6834,
      "section": "CAUTION:",
      "bbox": {
        "l": 191.29208913786698,
        "t": 308.7916259765625,
        "r": 210.5824008003707,
        "b": 287.5500183105469
      },
      "image_path": "figures/figure_1861.png",
      "decorative": true,
      "width": 19,
      "height": 21,
      "image_hash": "9c3d1e9dff1343b14be815b47adacaa443adb9322fa33dc3917979b75f8d59f2",
      "previous_block_id": "txt_4927",
      "next_block_id": "txt_4928"
    },
    {
      "type": "paragraph",
      "id": "txt_4928",
      "reading_order": 6835,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.0,
        "t": 285.92,
        "r": 549.7700400000001,
        "b": 250.32999999999993
      },
      "content": "work at an ESD-protected workstation or mat. If an ESD workstation or mat is not available, touch the sheet-metal chassis to provide a static ground before touching an ESD-sensitive assembly. Protect the ESD-sensitive assemblies by placing them in ESD pouches when they are out of the printer."
    },
    {
      "type": "paragraph",
      "id": "txt_4929",
      "reading_order": 6836,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.00004,
        "t": 240.92000000000007,
        "r": 548.6300400000002,
        "b": 205.32999999999993
      },
      "content": "If the replacement part is a roller or pad, avoid touching the spongy part of it. Skin oils on the roller or pad can cause paper pickup and/or print-quality problems. HP recommends using disposable gloves when handling rollers or pads or washing your hands before touching rollers or pads."
    },
    {
      "type": "list_item",
      "id": "txt_4930",
      "reading_order": 6837,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.0,
        "t": 195.91999999999996,
        "r": 541.73,
        "b": 172.32999999999993
      },
      "content": "IMPORTANT: Make sure that all of the shipping materials (for example shipping tape) are removed from the replacement part prior to installation."
    },
    {
      "type": "list_item",
      "id": "txt_4931",
      "reading_order": 6838,
      "section": "CAUTION:",
      "bbox": {
        "l": 122.0,
        "t": 161.41999999999996,
        "r": 343.02,
        "b": 149.83000000000004
      },
      "content": "To install an assembly, reverse the removal steps."
    },
    {
      "type": "paragraph",
      "id": "txt_4932",
      "reading_order": 6839,
      "section": "CAUTION:",
      "bbox": {
        "l": 144.00002,
        "t": 140.41999999999996,
        "r": 551.6100400000003,
        "b": 104.83000000000004
      },
      "content": "When applicable, special installation instructions are provided for an assembly at the end of the removal procedure. Always completely read the removal instructions and follow all special installation instructions."
    }
  ],
